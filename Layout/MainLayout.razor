@inherits LayoutComponentBase
@implements IAsyncDisposable
@inject NavigationManager Nav
@inject IJSRuntime JS

<div class="app-container @(Focus ? "focus-mode" : "")">
    <main class="main-content">
        <div class="page-shell" @key="currentUri">
            @Body
        </div>
    </main>
    @if (!Focus)
    {
        <NavBar />
    }
</div>

<div id="toast-container"></div>
<div id="confetti-container"></div>
<XpHud />

@code {
    private string currentUri = "";
    private DotNetObjectReference<MainLayout>? _selfRef;

    // Lessons, quizzes, runs and onboarding get the whole screen: no bottom nav to tap away from mid-question.
    // Every page listed here has its own back button (run encounters rely on the system back gesture).
    private static readonly System.Text.RegularExpressions.Regex FocusRoute = new(
        @"^/(topic/[^/]+/lesson/|topic/[^/]+/run/encounter/|quiz/|mastery/|synthesis/[^/]+$|welcome$|daily$|review$)",
        System.Text.RegularExpressions.RegexOptions.IgnoreCase);

    private bool Focus => FocusRoute.IsMatch(new Uri(currentUri).AbsolutePath);

    protected override void OnInitialized()
    {
        currentUri = Nav.Uri;
        Nav.LocationChanged += OnLocationChanged;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        try
        {
            // Cold-start deep link: a notification tap or shortcut stashes the
            // target route into sessionStorage before Blazor boots.
            var route = await JS.InvokeAsync<string?>("Notifications.consumePendingDeepLink");
            if (!string.IsNullOrWhiteSpace(route)) NavigateIfDifferent(route!);

            // Warm deep link: subscribe to nous:deeplink so notification taps
            // and shortcut launches that arrive while the app is alive route too.
            _selfRef = DotNetObjectReference.Create(this);
            await JS.InvokeVoidAsync("MathCanvas.addWindowListener", "nous:deeplink", "OnDeepLink", _selfRef);
        }
        catch { /* JS bridge unavailable: ignore */ }
    }

    [JSInvokable]
    public void OnDeepLink(string? route)
    {
        if (string.IsNullOrWhiteSpace(route)) return;
        InvokeAsync(() =>
        {
            NavigateIfDifferent(route!);
            return Task.CompletedTask;
        });
    }

    private void NavigateIfDifferent(string route)
    {
        var current = new Uri(Nav.Uri).AbsolutePath;
        if (!string.Equals(current, route, StringComparison.OrdinalIgnoreCase))
        {
            Nav.NavigateTo(route);
        }
    }

    private void OnLocationChanged(object? sender, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs e)
    {
        currentUri = e.Location;
        InvokeAsync(StateHasChanged);
    }

    public async ValueTask DisposeAsync()
    {
        Nav.LocationChanged -= OnLocationChanged;
        try { await JS.InvokeVoidAsync("MathCanvas.removeWindowListener", "nous:deeplink", "OnDeepLink"); }
        catch { /* JS bridge may already be disposed */ }
        _selfRef?.Dispose();
    }
}
