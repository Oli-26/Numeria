@page "/molecule-builder"
@using System.Text.RegularExpressions
@inject NavigationManager Nav
@inject IJSRuntime JS

<div class="page-header">
    <button class="back-btn" aria-label="Back to home" @onclick='() => Nav.NavigateTo("/")'><Icon Name="arrow-left" Size="18" /></button>
    <h1>Molecule Builder</h1>
</div>

<div class="mb-modes">
    <button class="mb-mode @(mode == "atom" ? "active" : "")" @onclick='() => SetMode("atom")'>
        <Icon Name="target" Size="16" /> Add Atom
    </button>
    <button class="mb-mode @(mode == "bond" ? "active" : "")" @onclick='() => SetMode("bond")'>
        <Icon Name="puzzle" Size="16" /> Add Bond
    </button>
    <button class="mb-mode @(mode == "erase" ? "active" : "")" @onclick='() => SetMode("erase")'>
        <Icon Name="x-mark" Size="16" /> Erase
    </button>
</div>

@if (mode == "atom")
{
    <div class="mb-palette">
        @foreach (var el in elements)
        {
            var elem = el;
            <button class="mb-elem @(selectedElement == elem.Symbol ? "selected" : "")"
                    style="background: @elem.Color; color: @elem.TextColor; border-color: @(selectedElement == elem.Symbol ? "var(--primary)" : elem.Border);"
                    @onclick="() => selectedElement = elem.Symbol">
                @elem.Symbol
            </button>
        }
    </div>
}
else if (mode == "bond")
{
    <div class="mb-bond-controls">
        <span class="mb-hint">Bond order:</span>
        <button class="mb-bond-btn @(bondOrder == 1 ? "active" : "")" @onclick="() => bondOrder = 1">Single</button>
        <button class="mb-bond-btn @(bondOrder == 2 ? "active" : "")" @onclick="() => bondOrder = 2">Double</button>
        <button class="mb-bond-btn @(bondOrder == 3 ? "active" : "")" @onclick="() => bondOrder = 3">Triple</button>
        <span class="mb-hint">Tap two atoms, or tap a bond to change it.</span>
    </div>
}
else
{
    <div class="mb-bond-controls">
        <span class="mb-hint">Tap an atom to delete it with its bonds, or tap a bond to delete just that bond.</span>
    </div>
}

@{
    var complete = graph.IsComplete && graph.ComponentCount() == 1;
}

<div class="mb-canvas-wrap card">
    <svg class="mb-canvas" viewBox="0 0 400 300" preserveAspectRatio="xMidYMid meet"
         @onpointerdown="OnPointerDown" @onpointermove="OnPointerMove"
         @onpointerup="OnPointerUp" @onpointercancel="OnPointerCancel">
        <defs>
            <linearGradient id="mb-bg-grad" x1="0" y1="0" x2="0" y2="1">
                <stop offset="0%" stop-color="var(--bg-card)" stop-opacity="0.6" />
                <stop offset="100%" stop-color="var(--bg-surface)" stop-opacity="1" />
            </linearGradient>
            <pattern id="mb-grid" x="0" y="0" width="20" height="20" patternUnits="userSpaceOnUse">
                <circle cx="10" cy="10" r="0.7" fill="var(--border)" opacity="0.55" />
            </pattern>
            <filter id="mb-bond-shadow" x="-20%" y="-20%" width="140%" height="140%">
                <feGaussianBlur in="SourceAlpha" stdDeviation="0.6" />
                <feOffset dx="0" dy="0.6" result="off" />
                <feComponentTransfer><feFuncA type="linear" slope="0.55" /></feComponentTransfer>
                <feMerge><feMergeNode /><feMergeNode in="SourceGraphic" /></feMerge>
            </filter>
            <filter id="mb-atom-shadow" x="-50%" y="-50%" width="200%" height="200%">
                <feGaussianBlur in="SourceAlpha" stdDeviation="1.4" />
                <feOffset dx="0" dy="1.5" result="off" />
                <feComponentTransfer><feFuncA type="linear" slope="0.55" /></feComponentTransfer>
                <feMerge><feMergeNode /><feMergeNode in="SourceGraphic" /></feMerge>
            </filter>
            <filter id="mb-hetero-glow" x="-80%" y="-80%" width="260%" height="260%">
                <feGaussianBlur stdDeviation="2.5" />
            </filter>
            @foreach (var elem in elements)
            {
                <radialGradient id="@($"mb-grad-{elem.Symbol}")" cx="35%" cy="32%" r="75%">
                    <stop offset="0%" stop-color="@elem.Highlight" stop-opacity="1" />
                    <stop offset="45%" stop-color="@elem.Color" stop-opacity="1" />
                    <stop offset="100%" stop-color="@elem.Shadow" stop-opacity="1" />
                </radialGradient>
            }
        </defs>

        <rect x="0" y="0" width="400" height="300" fill="url(#mb-bg-grad)" />
        <rect x="0" y="0" width="400" height="300" fill="url(#mb-grid)" />
        <rect x="1" y="1" width="398" height="298" fill="none" rx="6"
              stroke="@(complete ? "var(--success)" : "var(--border)")" stroke-width="@(complete ? 2 : 1)" opacity="0.7" />

        @foreach (var b in graph.Bonds)
        {
            <g filter="url(#mb-bond-shadow)">
                @foreach (var ln in GetBondLines(graph.Atoms[b.A], graph.Atoms[b.B], b.Order))
                {
                    <line x1="@F(ln.X1)" y1="@F(ln.Y1)" x2="@F(ln.X2)" y2="@F(ln.Y2)"
                          stroke="var(--text-secondary)" stroke-width="2.4" stroke-linecap="round" opacity="0.92" />
                }
            </g>
        }

        @for (int i = 0; i < graph.Atoms.Count; i++)
        {
            var atom = graph.Atoms[i];
            var elem = GetElement(atom.Element);
            var radius = elem.Radius;
            var open = graph.OpenValence(i);
            var decor = Decor(i);
            var isFirstBondPick = bondFirst == i;
            var isHetero = atom.Element is "O" or "N" or "S" or "P";
            <g @key="atom" class="mb-atom @(isFirstBondPick ? "selected" : "")">
                @if (isHetero)
                {
                    <circle cx="@F(atom.X)" cy="@F(atom.Y)" r="@(radius + 6)" fill="@elem.Color" opacity="0.18" filter="url(#mb-hetero-glow)" />
                }
                @if (isFirstBondPick)
                {
                    <circle cx="@F(atom.X)" cy="@F(atom.Y)" r="@(radius + 7)" fill="none" stroke="var(--primary)" stroke-width="2" stroke-dasharray="3 3" opacity="0.9" />
                    <circle cx="@F(atom.X)" cy="@F(atom.Y)" r="@(radius + 3)" fill="none" stroke="var(--primary)" stroke-width="1" opacity="0.4" />
                }
                @if (showLonePairs)
                {
                    @foreach (var (dx, dy) in LonePairDots(atom, radius, decor.Pairs))
                    {
                        <circle cx="@F(dx)" cy="@F(dy)" r="1.2" fill="var(--text-secondary)" opacity="0.8" />
                    }
                }
                <g filter="url(#mb-atom-shadow)">
                    <circle cx="@F(atom.X)" cy="@F(atom.Y)" r="@radius" fill="@($"url(#mb-grad-{atom.Element})")" stroke="@elem.Shadow" stroke-width="0.8" />
                </g>
                <ellipse cx="@F(atom.X - radius * 0.32)" cy="@F(atom.Y - radius * 0.4)"
                         rx="@F(radius * 0.42)" ry="@F(radius * 0.26)"
                         fill="#ffffff" opacity="0.35" />
                <text x="@F(atom.X)" y="@F(atom.Y + radius * 0.3)" text-anchor="middle"
                      font-size="@F(radius * 0.95)" font-weight="800"
                      fill="@elem.TextColor" stroke="@(elem.TextColor == "#FFF" ? "rgba(0,0,0,0.45)" : "rgba(255,255,255,0.85)")"
                      stroke-width="0.5" paint-order="stroke" style="font-family: 'Segoe UI', system-ui, sans-serif; letter-spacing: -0.5px;">@atom.Element</text>
                @if (open > 0)
                {
                    var bx = atom.X + Math.Cos(decor.Badge * Math.PI / 180) * (radius + 2);
                    var by = atom.Y + Math.Sin(decor.Badge * Math.PI / 180) * (radius + 2);
                    <g>
                        <circle class="mb-open" cx="@F(bx)" cy="@F(by)" r="6.5" />
                        <text class="mb-open-num" x="@F(bx)" y="@F(by + 3)" text-anchor="middle">@open</text>
                    </g>
                }
            </g>
        }
    </svg>
</div>

<div class="mb-status @StatusClass" role="status" aria-live="polite">
    @if (message != null)
    {
        <Icon Name="x-mark" Size="16" />
        <span>@message</span>
    }
    else if (recognition.IsMatch)
    {
        var m = recognition.Molecule!;
        <Icon Name="checkmark-circle" Size="18" />
        <div class="mb-status-body">
            <span>@(loaded ? "Library model:" : "You built") <strong>@(loaded ? m.Name : m.Name.ToLowerInvariant())</strong> <span class="mb-formula">@Formula(m.Formula)</span></span>
            @if (recognition.Kind == MatchKind.Resonance)
            {
                <small>Your double bonds sit in a different resonance structure of the same molecule.</small>
            }
            @if (m.Note != null)
            {
                <small>@m.Note</small>
            }
        </div>
    }
    else if (recognition.Kind == MatchKind.Isomer)
    {
        var m = recognition.Molecule!;
        <Icon Name="lightbulb" Size="18" />
        <span>Same formula as @m.Name.ToLowerInvariant() (<span class="mb-formula">@Formula(m.Formula)</span>), different structure: an isomer.</span>
    }
    else if (graph.Atoms.Count == 0)
    {
        <Icon Name="target" Size="16" />
        <span>Pick an element and tap the canvas to place it. Drag any atom to move it.</span>
    }
    else
    {
        var open = graph.OpenValenceTotal;
        var parts = graph.ComponentCount();
        <Icon Name="atom" Size="16" />
        <div class="mb-status-body">
            @if (open > 0)
            {
                <span>@open open bond@(open == 1 ? "" : "s") left. The numbered badges show which atoms still need bonds.</span>
            }
            else if (parts > 1)
            {
                <span>Every valence is filled, but these are @parts separate molecules.</span>
            }
            else
            {
                <span>Every valence is filled: a complete molecule, just not one in the library.</span>
            }
            @if (recognition.Kind == MatchKind.SameAtoms)
            {
                <small>These are exactly the atoms of @recognition.Molecule!.Name.ToLowerInvariant() (@Formula(recognition.Molecule.Formula)).</small>
            }
        </div>
    }
</div>

<div class="mb-stats card">
    <div class="mb-stat">
        <span class="mb-stat-label">@(recognition.IsMatch ? "Formula" : "Hill formula")</span>
        <strong class="mb-formula">@Formula(graph.Atoms.Count == 0 ? "-" : recognition.IsMatch ? recognition.Molecule!.Formula : graph.HillFormula())</strong>
    </div>
    <div class="mb-stat">
        <span class="mb-stat-label">Atoms</span>
        <strong>@graph.Atoms.Count</strong>
    </div>
    <div class="mb-stat">
        <span class="mb-stat-label">Bonds</span>
        <strong>@graph.Bonds.Count</strong>
    </div>
    <div class="mb-stat">
        <span class="mb-stat-label">Open</span>
        <strong>@graph.OpenValenceTotal</strong>
    </div>
</div>

<div class="mb-actions">
    <button class="btn btn-outline btn-sm" @onclick="FillHydrogens" disabled="@(!CanFill)">
        <Icon Name="sparkles" Size="16" /> Fill hydrogens
    </button>
    <button class="btn btn-outline btn-sm" @onclick="() => showLonePairs = !showLonePairs" aria-pressed="@(showLonePairs ? "true" : "false")">
        <Icon Name="eye" Size="16" /> Lone pairs
    </button>
    <button class="btn btn-outline btn-sm" @onclick="ClearCanvas">
        <Icon Name="x-mark" Size="16" /> Clear
    </button>
</div>

<div class="mb-challenges">
    <h3 class="mb-section-title">Challenges <span class="mb-count">@solved.Count / @challenges.Length</span></h3>
    <p class="mb-section-sub">Build each one yourself. It is ticked when the builder recognises it.</p>
    <div class="mb-chal-grid">
        @foreach (var name in challenges)
        {
            var m = MoleculeLibrary.Get(name);
            var done = solved.Contains(name);
            <div class="mb-chal @(done ? "done" : "")">
                <span class="mb-chal-tick">@if (done) {<Icon Name="check" Size="14" />}</span>
                <strong>@m.Name</strong>
                <small>@Formula(m.Formula)</small>
            </div>
        }
    </div>
</div>

<div class="mb-library">
    <h3 class="mb-section-title">Library</h3>
    <p class="mb-section-sub">Tap any molecule to load it.</p>
    <div class="mb-lib-grid">
        @foreach (var lib in MoleculeLibrary.All)
        {
            var item = lib;
            <button class="mb-lib-btn" @onclick="() => LoadLibrary(item)">
                <strong>@item.Name</strong>
                <small>@Formula(item.Formula)</small>
            </button>
        }
    </div>
</div>

@code {
    private const double AtomReach = 6, BondReach = 9, DragThreshold = 5;

    private static readonly string[] challenges = { "Water", "Methane", "Ammonia", "Carbon dioxide", "Ethanol", "Ethene" };

    private MoleculeGraph graph = new();
    private string mode = "atom";
    private string selectedElement = "C";
    private int bondOrder = 1;
    private int? bondFirst;
    private bool showLonePairs = true;
    private bool loaded;
    private string? message;
    private Recognition recognition = Recognition.Nothing;
    private readonly HashSet<string> solved = new();

    private double[]? canvasRect;
    private Task? pendingDown;
    private Press? press;
    private bool skipRender;

    private sealed class Press
    {
        public double X, Y, AtomX, AtomY;
        public int Atom, Bond;
        public bool Moved;
    }

    protected override bool ShouldRender()
    {
        if (!skipRender) return true;
        skipRender = false;
        return false;
    }

    private void SetMode(string m)
    {
        mode = m;
        bondFirst = null;
        message = null;
    }

    private Task OnPointerDown(PointerEventArgs e)
    {
        if (e.Button != 0)
        {
            press = null;
            return Task.CompletedTask;
        }
        pendingDown = BeginPress(e);
        return pendingDown;
    }

    private async Task BeginPress(PointerEventArgs e)
    {
        press = null;
        // Capture keeps move/up events coming while a dragged atom leaves the canvas.
        canvasRect = await JS.TryInvokeAsync<double[]>("eval",
            $"(function(){{var s=document.querySelector('.mb-canvas');if(!s)return null;try{{s.setPointerCapture({e.PointerId});}}catch(x){{}}var r=s.getBoundingClientRect();return [r.left,r.top,r.width,r.height];}})()");
        if (canvasRect is not { Length: 4 } || canvasRect[2] <= 0 || canvasRect[3] <= 0) return;
        var (x, y) = ToCanvas(e);
        var (atom, bond) = HitTest(x, y);
        press = new Press
        {
            X = x, Y = y, Atom = atom, Bond = bond,
            AtomX = atom >= 0 ? graph.Atoms[atom].X : 0,
            AtomY = atom >= 0 ? graph.Atoms[atom].Y : 0,
        };
    }

    private void OnPointerMove(PointerEventArgs e)
    {
        if (press is not { Atom: >= 0 } p) { skipRender = true; return; }
        if (e.Buttons == 0) { press = null; skipRender = true; return; }
        var (x, y) = ToCanvas(e);
        if (!p.Moved && Math.Abs(x - p.X) + Math.Abs(y - p.Y) < DragThreshold) { skipRender = true; return; }
        p.Moved = true;
        if (!graph.MoveAtom(p.Atom, ClampX(p.AtomX + x - p.X), ClampY(p.AtomY + y - p.Y))) skipRender = true;
    }

    private async Task OnPointerUp(PointerEventArgs e)
    {
        if (pendingDown != null) await pendingDown;
        var p = press;
        press = null;
        if (p == null || p.Moved) return;

        message = null;
        if (p.Atom >= 0) TapAtom(p.Atom);
        else if (p.Bond >= 0) TapBond(p.Bond);
        else TapEmpty(p.X, p.Y);
    }

    // Whichever drawn shape is nearer wins, so the short gap of a C-H bond is still tappable.
    private (int Atom, int Bond) HitTest(double x, double y)
    {
        var atom = graph.AtomAt(x, y, AtomReach, Radius);
        var bond = graph.BondAt(x, y, BondReach);
        if (atom >= 0 && bond >= 0)
            return graph.DistanceToAtom(atom, x, y, Radius) <= graph.DistanceToBond(bond, x, y) ? (atom, -1) : (-1, bond);
        return (atom, bond);
    }

    private void OnPointerCancel(PointerEventArgs e) => press = null;

    private void TapAtom(int atom)
    {
        if (mode == "erase")
        {
            graph.RemoveAtom(atom);
            Changed();
        }
        else if (mode == "bond")
        {
            if (bondFirst == null) bondFirst = atom;
            else if (bondFirst == atom) bondFirst = null;
            else
            {
                message = graph.SetBond(bondFirst.Value, atom, bondOrder);
                bondFirst = null;
                if (message == null) Changed();
            }
        }
    }

    private void TapBond(int bond)
    {
        if (mode == "erase")
        {
            graph.RemoveBond(bond);
            Changed();
        }
        else if (mode == "bond")
        {
            var b = graph.Bonds[bond];
            bondFirst = null;
            message = graph.SetBond(b.A, b.B, bondOrder);
            if (message == null) Changed();
        }
    }

    private void TapEmpty(double x, double y)
    {
        bondFirst = null;
        if (mode != "atom") return;
        message = graph.AddAtom(selectedElement, ClampX(x), ClampY(y));
        if (message == null) Changed();
    }

    private bool CanFill => Enumerable.Range(0, graph.Atoms.Count).Any(i => graph.Atoms[i].Element != "H" && graph.OpenValence(i) > 0);

    private void FillHydrogens()
    {
        bondFirst = null;
        var unplaced = graph.FillHydrogens();
        message = unplaced > 0 ? $"No room for {unplaced} hydrogen{(unplaced == 1 ? "" : "s")}. Drag atoms apart and try again." : null;
        Changed();
    }

    private void ClearCanvas()
    {
        graph.Clear();
        bondFirst = null;
        message = null;
        Changed();
    }

    private void LoadLibrary(LibraryMolecule m)
    {
        graph = m.Graph.Clone();
        bondFirst = null;
        message = null;
        Changed(fromLibrary: true);
    }

    // An untouched library load is labelled as such and does not tick a challenge.
    private void Changed(bool fromLibrary = false)
    {
        loaded = fromLibrary;
        recognition = MoleculeLibrary.Recognise(graph);
        if (!loaded && recognition.IsMatch && challenges.Contains(recognition.Molecule!.Name)) solved.Add(recognition.Molecule.Name);
    }

    private (double X, double Y) ToCanvas(PointerEventArgs e)
    {
        var r = canvasRect!;
        return ((e.ClientX - r[0]) * MoleculeGraph.Width / r[2], (e.ClientY - r[1]) * MoleculeGraph.Height / r[3]);
    }

    private static double ClampX(double x) => Math.Clamp(x, MoleculeGraph.Edge, MoleculeGraph.Width - MoleculeGraph.Edge);
    private static double ClampY(double y) => Math.Clamp(y, MoleculeGraph.Edge, MoleculeGraph.Height - MoleculeGraph.Edge);

    private string StatusClass =>
        message != null ? "warn"
        : recognition.IsMatch ? "ok"
        : recognition.Kind == MatchKind.Isomer ? "info"
        : "";

    // Lone pairs sit in the widest gaps between bonds; the open-valence badge takes the next widest.
    private (List<double> Pairs, double Badge) Decor(int i)
    {
        var open = graph.OpenValence(i);
        var pairs = graph.LonePairs(i);
        if (graph.Degree(i) == 0)
        {
            var slots = MoleculeGraph.LoneAtomSlots(open, pairs);
            return (slots.Skip(open).ToList(), open > 0 ? slots[0] : 0);
        }
        var neighbors = graph.NeighborAngles(i);
        var pairAngles = MoleculeGraph.SpreadAngles(neighbors, pairs);
        return (pairAngles, MoleculeGraph.SpreadAngles(neighbors.Concat(pairAngles).ToList(), 1)[0]);
    }

    private static IEnumerable<(double X, double Y)> LonePairDots(MolAtom atom, double radius, List<double> angles)
    {
        foreach (var deg in angles)
        {
            var rad = deg * Math.PI / 180;
            var ux = Math.Cos(rad);
            var uy = Math.Sin(rad);
            var cx = atom.X + ux * (radius + 4.5);
            var cy = atom.Y + uy * (radius + 4.5);
            yield return (cx - uy * 2.4, cy + ux * 2.4);
            yield return (cx + uy * 2.4, cy - ux * 2.4);
        }
    }

    private static string F(double v) => v.ToString("0.#");

    private static MarkupString Formula(string f) => new(Regex.Replace(f, @"\d+", "<sub>$0</sub>"));

    private record BondLine(double X1, double Y1, double X2, double Y2);

    private List<BondLine> GetBondLines(MolAtom a, MolAtom b, int order)
    {
        var dx = b.X - a.X;
        var dy = b.Y - a.Y;
        var len = Math.Sqrt(dx * dx + dy * dy);
        if (len < 0.001) return new List<BondLine>();
        var ux = dx / len;
        var uy = dy / len;
        var rA = GetElement(a.Element).Radius;
        var rB = GetElement(b.Element).Radius;
        var x1 = a.X + ux * rA;
        var y1 = a.Y + uy * rA;
        var x2 = b.X - ux * rB;
        var y2 = b.Y - uy * rB;

        var px = -uy;
        var py = ux;

        var result = new List<BondLine>();
        if (order == 2)
        {
            var off = 3.2;
            result.Add(new BondLine(x1 + px * off, y1 + py * off, x2 + px * off, y2 + py * off));
            var inner = (len - rA - rB) * 0.18;
            result.Add(new BondLine(x1 + ux * inner - px * off, y1 + uy * inner - py * off,
                                     x2 - ux * inner - px * off, y2 - uy * inner - py * off));
        }
        else if (order == 3)
        {
            var off = 4.2;
            result.Add(new BondLine(x1, y1, x2, y2));
            var inner = (len - rA - rB) * 0.22;
            result.Add(new BondLine(x1 + ux * inner + px * off, y1 + uy * inner + py * off,
                                     x2 - ux * inner + px * off, y2 - uy * inner + py * off));
            result.Add(new BondLine(x1 + ux * inner - px * off, y1 + uy * inner - py * off,
                                     x2 - ux * inner - px * off, y2 - uy * inner - py * off));
        }
        else
        {
            result.Add(new BondLine(x1, y1, x2, y2));
        }
        return result;
    }

    private static double Radius(string symbol) => GetElement(symbol).Radius;

    private static Element GetElement(string symbol) =>
        elements.FirstOrDefault(e => e.Symbol == symbol) ?? new Element("?", "#888", "#555", "#fff", "#bbb", "#444", 13);

    private record Element(string Symbol, string Color, string Border, string TextColor, string Highlight, string Shadow, double Radius);

    private static readonly List<Element> elements = new()
    {
        new("H",  "#FFFFFF", "#999999", "#222", "#FFFFFF", "#9AA0A6", 10),
        new("C",  "#3A3A3A", "#1B1B1B", "#FFF", "#7A7A7A", "#0E0E0E", 14),
        new("N",  "#3060E8", "#1E3FA8", "#FFF", "#7BA0FF", "#142776", 14),
        new("O",  "#E63946", "#A02530", "#FFF", "#FF8B85", "#7A1820", 13.5),
        new("F",  "#2EB872", "#1F8650", "#FFF", "#74E2A6", "#155E36", 12),
        new("P",  "#E89A2C", "#A86A18", "#FFF", "#FFC274", "#7A4A0E", 15),
        new("S",  "#F4D03F", "#B89B1F", "#222", "#FFEE82", "#8B7615", 15),
        new("Cl", "#A8E6A1", "#6FB46A", "#222", "#D8F5D2", "#4F8A4A", 14),
    };
}

<style>
    .mb-modes {
        display: flex; gap: 4px; background: var(--bg-surface); border-radius: var(--radius-md);
        padding: 4px; margin-bottom: 12px;
    }
    .mb-mode {
        flex: 1; padding: 8px 6px; border: none; background: transparent; color: var(--text-muted);
