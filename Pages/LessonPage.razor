@page "/topic/{TopicId}/lesson/{LessonId}"
@inject IContentRepository Content
@inject IProgressService Progress
@inject IGamificationService Gamification
@inject ISessionStateService SessionState
@inject ITtsService Tts
@inject IJSRuntime JS
@inject NavigationManager Nav
@inject IConnectionsService Connections
@implements IDisposable

<div class="page-header">
    <button class="back-btn" @onclick="GoBack"><Icon Name="arrow-left" Size="18" /></button>
    <h1>@(lesson?.Title ?? "Lesson")</h1>
</div>

@if (lesson != null)
{
    @if (!showQuiz)
    {
        <div class="concept-viewer">
            <!-- Progress dots -->
            <div class="concept-dots">
                @for (int i = 0; i < lesson.Concepts.Count; i++)
                {
                    var idx = i;
                    var isActive = i == currentConceptIndex;
                    var isViewed = profile?.ConceptsViewed.Contains(lesson.Concepts[i].Id) ?? false;
                    <button class="concept-dot @(isActive ? "active" : "") @(isViewed ? "viewed" : "")"
                            @onclick="() => JumpToConcept(idx)">
                        @(idx + 1)
                    </button>
                }
                <button class="concept-dot quiz-dot @(currentConceptIndex >= lesson.Concepts.Count ? "active" : "")"
                        @onclick="StartQuiz"><Icon Name="zap" Size="16" /></button>
            </div>

            @if (HasDepthLayers)
            {
                <div class="depth-toggle" role="group" aria-label="Reading depth">
                    @foreach (var (key, label) in new[] { ("simple", "Simpler"), ("standard", "Standard"), ("deep", "Deeper") })
                    {
                        var k = key;
                        <button class="depth-btn @(depth == k ? "active" : "")" @onclick="() => SetDepth(k)">@label</button>
                    }
                </div>
            }

            @if (currentConceptIndex < lesson.Concepts.Count)
            {
                var concept = lesson.Concepts[currentConceptIndex];
                var awaitingGuess = concept.Discovery != null && !guessed.Contains(concept.Id);
                <div class="concept-card card anim-slide" @key="concept.Id">
                    <h2>@concept.Title</h2>

                    @if (awaitingGuess)
                    {
                        <DiscoveryCard Question="concept.Discovery!" OnDone="() => guessed.Add(concept.Id)" />
                    }
                    else
                    {
                    <div class="concept-content">
                        @((MarkupString)ContentFor(concept))
                    </div>

                    @if (concept.MathExpressions.Count > 0)
                    {
                        @foreach (var (expr, i) in concept.MathExpressions.Select((e, i) => (e, i)))
                        {
                            <div class="math-display" id="math-@concept.Id-@i"></div>
                        }
                    }

                    @if (concept.VisualizationType != null)
                    {
                        <CanvasVisualization CanvasId="@($"viz-{concept.Id}")"
                                             VisualizationType="@concept.VisualizationType"
                                             Config="@concept.VisualizationConfig" />
                    }

                    @if (simulators.TryGetValue(concept.Id, out var sim))
                    {
                        <div class="try-it-card card-clickable" @onclick="() => OpenSimulator(sim)">
                            <div class="try-it-icon"><Icon Name="@sim.Icon" Size="22" /></div>
                            <div class="try-it-text">
                                <small>Try it</small>
                                <strong>@sim.Name</strong>
                                <span>@sim.Blurb</span>
                            </div>
                            <Icon Name="chevron-right" Size="18" />
                        </div>
                    }

                    <div class="explain-back">
                        @if (explainOpenFor != concept.Id)
                        {
                            <button class="explain-toggle" @onclick="() => OpenExplain(concept)">
                                <Icon Name="pencil" Size="14" /> @(profile?.ConceptNotes.ContainsKey(concept.Id) == true ? "Your note on this" : "Explain it back in your own words")
                            </button>
                        }
                        else
                        {
                            <textarea class="explain-input" rows="3" @bind="noteDraft" @bind:event="oninput"
                                      placeholder="In a sentence or two, what is the key idea here?" aria-label="Your explanation"></textarea>
                            <div class="explain-actions">
                                <button class="btn btn-sm btn-primary" disabled="@string.IsNullOrWhiteSpace(noteDraft)" @onclick="() => SaveNote(concept)">Save to notebook</button>
                                <button class="btn btn-sm btn-outline" @onclick="() => explainOpenFor = null">Close</button>
                            </div>
                            @if (noteSaved && !string.IsNullOrEmpty(concept.ModelSummary))
                            {
                                <div class="explain-model">
                                    <small>Compare with a model answer</small>
                                    <p>@concept.ModelSummary</p>
                                </div>
                            }
                            else if (noteSaved)
                            {
                                <small class="explain-saved">Saved. Find it in your notebook.</small>
                            }
                        }
                    </div>
                    }

                    <!-- TTS control bar (only when TTS is enabled and supported) -->
                    @if (ttsEnabled && ttsSupported)
                    {
                        <div class="tts-bar">
                            <!-- Play / Pause -->
                            <button class="tts-btn tts-playpause @(ttsSpeaking && !ttsPaused ? "active" : "")"
                                    @onclick="TogglePlayPause"
                                    title="@(ttsSpeaking && !ttsPaused ? "Pause" : "Play")">
                                @if (ttsSpeaking && !ttsPaused)
                                {
                                    <!-- Pause icon -->
                                    <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24"
                                         fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                        <rect x="6" y="4" width="4" height="16"/><rect x="14" y="4" width="4" height="16"/>
                                    </svg>
                                }
                                else
                                {
                                    <!-- Play icon -->
                                    <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24"
                                         fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                        <polygon points="5 3 19 12 5 21"/>
                                    </svg>
                                }
                            </button>

                            <!-- Stop -->
                            <button class="tts-btn" @onclick="StopTts" title="Stop"
                                    disabled="@(!ttsSpeaking && !ttsPaused)">
                                <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24"
                                     fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                    <rect x="3" y="3" width="18" height="18" rx="2"/>
                                </svg>
                            </button>

                            <!-- Skip next concept -->
                            <button class="tts-btn" @onclick="TtsSkipNext" title="Next concept"
                                    disabled="@(currentConceptIndex >= lesson.Concepts.Count - 1)">
                                <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24"
                                     fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                    <polygon points="5 4 15 12 5 20"/><line x1="19" y1="5" x2="19" y2="19"/>
                                </svg>
                            </button>

                            <!-- Speed picker -->
                            <div class="tts-speed-group">
                                @foreach (var sp in new double[] { 0.75, 1.0, 1.25, 1.5 })
                                {
                                    var speed = sp;
                                    <button class="tts-speed-btn @(ttsRate == speed ? "active" : "")"
                                            @onclick="() => SetTtsRate(speed)">
                                        @(speed)x
                                    </button>
                                }
                            </div>

                            <!-- Auto-advance indicator -->
                            @if (ttsAutoAdvance)
                            {
                                <span class="tts-auto-label" title="Auto-advance is on">AUTO</span>
                            }
                        </div>
                    }

                    <div class="concept-nav">
                        @if (currentConceptIndex > 0)
                        {
                            <button class="btn btn-outline" @onclick="PrevConcept"><Icon Name="arrow-left" Size="16" /> Previous</button>
                        }
                        else
                        {
                            <div></div>
                        }
                        @if (currentConceptIndex < lesson.Concepts.Count - 1)
                        {
                            <button class="btn btn-primary" @onclick="NextConcept">Next ></button>
                        }
                        else
                        {
                            <button class="btn btn-accent" @onclick="StartQuiz">Take Quiz <Icon Name="zap" Size="16" /></button>
                        }
                    </div>
                </div>
            }
        </div>
    }
    else if (outcome == LessonOutcome.Passed)
    {
        <div class="card post-quiz anim-slide">
            <div class="post-quiz-head">
                <Icon Name="checkmark-circle" Size="28" />
                <div>
                    <h2>Lesson complete</h2>
                    <small>@lastCorrect / @lastTotal correct</small>
                </div>
            </div>

            @if (echoes.Count > 0)
            {
                <div class="echoes">
                    <h3>Echoes</h3>
                    <p class="echoes-sub">Where this idea turns up in other fields</p>
                    @foreach (var echo in echoes)
                    {
                        var ec = echo;
                        <div class="echo-card card-clickable" @onclick="() => OpenEcho(ec)">
                            <div>
                                <strong>@(ec.SynthesisTitle ?? ec.TopicName)</strong>
                                <small class="echo-domain">@(ec.SynthesisQuizId != null ? $"Synthesis quiz with {ec.TopicName}" : ec.Domain)</small>
                                <p>@ec.Why</p>
                            </div>
                            <Icon Name="chevron-right" Size="16" />
                        </div>
                    }
                </div>
            }

            <div class="post-quiz-actions">
                @if (pathForLesson != null)
                {
                    <button class="btn btn-accent" @onclick='() => Nav.NavigateTo($"/path/{pathForLesson.Id}")'>
                        Continue path: @pathForLesson.Question
                    </button>
                }
                @if (nextLesson != null)
                {
                    <button class="btn btn-primary" @onclick='() => Nav.NavigateTo($"/topic/{TopicId}/lesson/{nextLesson.Id}", forceLoad: false)'>
                        Next lesson: @nextLesson.Title
                    </button>
                }
                <button class="btn btn-outline" @onclick='() => Nav.NavigateTo($"/topic/{TopicId}")'>Back to topic</button>
            </div>
        </div>
    }
    else if (outcome == LessonOutcome.NotYet)
    {
        <div class="card post-quiz anim-slide">
            <div class="post-quiz-head">
                <Icon Name="rotate" Size="28" />
                <div>
                    <h2>Almost there</h2>
                    <small>@lastCorrect / @lastTotal correct. You need @PassMark(lastTotal) to complete this lesson.</small>
                </div>
            </div>
            @if (missedConcepts.Count > 0)
            {
                <p class="echoes-sub">Worth another look before you retry:</p>
                @foreach (var idx in missedConcepts)
                {
                    var i = idx;
                    <button class="missed-concept" @onclick="() => RevisitConcept(i)">
                        <Icon Name="book" Size="14" /> @lesson.Concepts[i].Title
                    </button>
                }
            }
            <div class="post-quiz-actions">
                <button class="btn btn-primary" @onclick="RetryQuiz">Retry quiz</button>
                <button class="btn btn-outline" @onclick='() => Nav.NavigateTo($"/topic/{TopicId}")'>Back to topic</button>
            </div>
        </div>
    }
    else
    {
        <QuizComponent @key="quizAttempt" TopicId="@TopicId" LessonId="@LessonId" OnResults="OnQuizResults" OnComplete="OnQuizComplete" />
    }
}
else
{
    <div class="loading">Loading lesson...</div>
}

@code {
    [Parameter] public string TopicId { get; set; } = "";
    [Parameter] public string LessonId { get; set; } = "";

    private Lesson? lesson;
    private UserProfile? profile;
    private int currentConceptIndex;
    private bool showQuiz;

    private enum LessonOutcome { None, Passed, NotYet }
    private LessonOutcome outcome;
    private List<QuizResult>? lastResults;
    private int lastCorrect, lastTotal, quizAttempt;
    private List<int> missedConcepts = new();
    private List<Echo> echoes = new();
    private Lesson? nextLesson;
    private LearningPath? pathForLesson;

    private Dictionary<string, SimulatorInfo> simulators = new();
    private readonly HashSet<string> guessed = new();
    private string depth = "standard";
    private string? explainOpenFor;
    private string noteDraft = "";
    private bool noteSaved;

    // Three of five, rounded up for other quiz lengths.
    private static int PassMark(int total) => (int)Math.Ceiling(total * 0.6);

    private bool HasDepthLayers => lesson?.Concepts.Any(c => c.ContentHtmlSimple != null || c.ContentHtmlDeep != null) == true;

    private string ContentFor(Concept c) => depth switch
    {
        "simple" => c.ContentHtmlSimple ?? c.ContentHtml,
        "deep" => c.ContentHtmlDeep ?? c.ContentHtml,
        _ => c.ContentHtml
    };

    // ── TTS state ────────────────────────────────────────────────────────────
    private bool ttsEnabled;
    private bool ttsSupported;
    private bool ttsSpeaking;
    private bool ttsPaused;
    private double ttsRate = 1.0;
    private string ttsVoice = "";
    private bool ttsAutoAdvance;

    private CancellationTokenSource? _ttsCts;
    private System.Timers.Timer? _ttsStateTimer;

    private string? loadedKey;

    // "Next lesson" navigates to this same page with new parameters, so the component is reused.
    protected override void OnParametersSet()
    {
        if (loadedKey != null && loadedKey != TopicId + "/" + LessonId)
        {
            lesson = null;
            outcome = LessonOutcome.None;
            showQuiz = false;
            currentConceptIndex = 0;
            lastResults = null;
            guessed.Clear();
            simulators.Clear();
            explainOpenFor = null;
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (loadedKey != TopicId + "/" + LessonId)
        {
            var isFirstLoad = loadedKey == null;
            loadedKey = TopicId + "/" + LessonId;
            lesson = await Content.GetLessonAsync(TopicId, LessonId);
            profile = await Progress.GetProfileAsync();
            depth = profile.ContentDepth is "simple" or "deep" ? profile.ContentDepth : "standard";
            if (lesson != null)
            {
                simulators = SimulatorCatalog.PlaceInLesson(lesson, TopicId);
                // Guess-first only on a first read; revisits go straight to the text.
                foreach (var c in lesson.Concepts.Where(c => c.Discovery != null && profile.ConceptsViewed.Contains(c.Id)))
                    guessed.Add(c.Id);
            }

            // Load TTS prefs from profile
            ttsEnabled = profile.TtsEnabled;
            ttsRate = profile.TtsRate > 0 ? profile.TtsRate : 1.0;
            ttsVoice = profile.TtsVoice ?? "";
            ttsAutoAdvance = profile.TtsAutoAdvance;

            // Check support
            ttsSupported = await Tts.IsSupportedAsync();

            // Restore saved session state
            var session = await SessionState.LoadSessionStateAsync();
            if (session != null && session.ActiveTopicId == TopicId && session.ActiveLessonId == LessonId)
            {
                currentConceptIndex = Math.Min(session.ConceptIndex, (lesson?.Concepts.Count ?? 1) - 1);
                showQuiz = session.InQuiz;
            }

            // Poll TTS speaking state every 500 ms so the UI stays in sync
            if (isFirstLoad && ttsEnabled && ttsSupported)
            {
                _ttsStateTimer = new System.Timers.Timer(500);
                _ttsStateTimer.Elapsed += async (_, _) => await RefreshTtsStateAsync();
                _ttsStateTimer.AutoReset = true;
                _ttsStateTimer.Start();
            }

            StateHasChanged();
        }

        if (lesson != null && !showQuiz && currentConceptIndex < lesson.Concepts.Count)
        {
            var concept = lesson.Concepts[currentConceptIndex];
            for (int i = 0; i < concept.MathExpressions.Count; i++)
            {
                await JS.TryInvokeVoidAsync("renderMath", $"math-{concept.Id}-{i}", concept.MathExpressions[i], true);
            }
        }
    }

    // ── TTS helpers ───────────────────────────────────────────────────────────

    private async Task RefreshTtsStateAsync()
    {
        var speaking = await Tts.IsSpeakingAsync();
        var paused = await Tts.IsPausedAsync();

        var changed = speaking != ttsSpeaking || paused != ttsPaused;
        ttsSpeaking = speaking;
        ttsPaused = paused;

        if (changed)
            await InvokeAsync(StateHasChanged);
    }

    private async Task TogglePlayPause()
    {
        if (!ttsEnabled || !ttsSupported || lesson == null) return;

        if (ttsSpeaking && !ttsPaused)
        {
            await Tts.PauseAsync();
            ttsPaused = true;
            StateHasChanged();
            return;
        }

        if (ttsPaused)
        {
            await Tts.ResumeAsync();
            ttsPaused = false;
            StateHasChanged();
            return;
        }

        // Start speaking current concept
        await StartSpeakingCurrentConceptAsync();
    }

    private async Task StartSpeakingCurrentConceptAsync()
    {
        if (lesson == null || currentConceptIndex >= lesson.Concepts.Count) return;

        // Cancel any previous session
        _ttsCts?.Cancel();
        _ttsCts?.Dispose();
        _ttsCts = new CancellationTokenSource();
        var token = _ttsCts.Token;

        ttsSpeaking = true;
        ttsPaused = false;
        StateHasChanged();

        var concept = lesson.Concepts[currentConceptIndex];
        await Tts.SpeakConceptAsync(concept, ttsRate, string.IsNullOrEmpty(ttsVoice) ? null : ttsVoice, token);

        if (token.IsCancellationRequested) return;

        ttsSpeaking = false;
        ttsPaused = false;

        // Auto-advance
        if (ttsAutoAdvance && currentConceptIndex < lesson.Concepts.Count - 1)
        {
            await NextConcept();
            await InvokeAsync(StateHasChanged);
            // Brief pause before auto-starting next
            await Task.Delay(600, token);
            if (!token.IsCancellationRequested)
                await StartSpeakingCurrentConceptAsync();
        }
        else
        {
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task StopTts()
    {
        _ttsCts?.Cancel();
        await Tts.StopAsync();
        ttsSpeaking = false;
        ttsPaused = false;
        StateHasChanged();
    }

    private async Task TtsSkipNext()
    {
        if (lesson == null || currentConceptIndex >= lesson.Concepts.Count - 1) return;
        var wasActive = ttsSpeaking;
        await StopTts();
        await NextConcept();
        StateHasChanged();
        if (wasActive)
            await StartSpeakingCurrentConceptAsync();
    }

    private async Task SetTtsRate(double rate)
    {
        ttsRate = rate;
        var p = await Progress.GetProfileAsync();
        p.TtsRate = rate;
        await Progress.SaveProfileAsync(p);

        // Restart speech at new rate if currently playing
        if (ttsSpeaking)
        {
            await StopTts();
            await StartSpeakingCurrentConceptAsync();
        }
    }

    // ── Existing navigation (unchanged behaviour) ─────────────────────────────

    private async Task SaveState()
    {
        await SessionState.SaveLessonStateAsync(TopicId, LessonId, currentConceptIndex, showQuiz);
    }

    private async Task NextConcept()
    {
        if (lesson == null) return;
        var concept = lesson.Concepts[currentConceptIndex];
        await Progress.MarkConceptViewedAsync(concept.Id);
        currentConceptIndex++;
        await SaveState();
        await JS.TryInvokeVoidAsync("Sounds.playClick");
    }

    private async Task PrevConcept()
    {
        if (ttsSpeaking) await StopTts();
        if (currentConceptIndex > 0)
            currentConceptIndex--;
        await SaveState();
        await JS.TryInvokeVoidAsync("Sounds.playClick");
    }

    private async Task JumpToConcept(int index)
    {
        if (lesson == null || index == currentConceptIndex) return;
        if (ttsSpeaking) await StopTts();
        if (currentConceptIndex < lesson.Concepts.Count)
            await Progress.MarkConceptViewedAsync(lesson.Concepts[currentConceptIndex].Id);
        currentConceptIndex = index;
        await SaveState();
    }

    private async Task StartQuiz()
    {
        if (lesson == null) return;
        await StopTts();
        if (currentConceptIndex < lesson.Concepts.Count)
        {
            var concept = lesson.Concepts[currentConceptIndex];
            await Progress.MarkConceptViewedAsync(concept.Id);
        }
        showQuiz = true;
        await SaveState();
    }

    private async Task GoBack()
    {
        await StopTts();
        await SessionState.ClearSessionStateAsync();
        Nav.NavigateTo($"/topic/{TopicId}");
    }

    private void OnQuizResults(List<QuizResult> results) => lastResults = results;

    private async Task OnQuizComplete(int xpEarned)
    {
        if (lesson == null) return;

        // An empty quiz (no questions authored yet) must not complete the lesson.
        if (lastResults == null || lastResults.Count == 0)
        {
            showQuiz = false;
            currentConceptIndex = 0;
            await SessionState.ClearSessionStateAsync();
            Nav.NavigateTo($"/topic/{TopicId}");
            return;
        }

        lastTotal = lastResults.Count;
        lastCorrect = lastResults.Count(r => r.IsCorrect);
        if (lastCorrect < PassMark(lastTotal))
        {
            missedConcepts = lastResults
                .Where(r => !r.IsCorrect)
                .Select(r => lesson.Concepts.FindIndex(c => c.Id == r.Question.ConceptId))
                .Where(i => i >= 0)
                .Distinct()
                .OrderBy(i => i)
                .ToList();
            outcome = LessonOutcome.NotYet;
            await SessionState.ClearSessionStateAsync();
            return;
        }

        await Progress.MarkLessonCompletedAsync(lesson.Id);

        var topics = await Content.GetTopicsAsync();
        var topic = topics.FirstOrDefault(t => t.Id == TopicId);
        if (topic != null)
        {
            var lessons = await Content.GetLessonsAsync(TopicId);
            var profile = await Progress.GetProfileAsync();
            if (lessons.All(l => profile.LessonsCompleted.Contains(l.Id)))
            {
                if (!profile.TopicsCompleted.Contains(TopicId))
                {
                    profile.TopicsCompleted.Add(TopicId);
                    if (!profile.CompletionCards.Any(c => c.TopicId == TopicId))
                    {
                        profile.CompletionCards.Add(new CompletionCard
                        {
                            TopicId = TopicId,
                            EarnedDate = DateTime.Now.ToString("yyyy-MM-dd")
                        });
                    }
                    await Progress.SaveProfileAsync(profile);
                    await JS.TryInvokeVoidAsync("Confetti.launch", 100);
                    await JS.TryInvokeVoidAsync("Sounds.playAchievement");
                    await JS.TryInvokeVoidAsync("showToast", $"Topic complete! New card earned!", "achievement");
                }
            }
        }

        await SessionState.ClearSessionStateAsync();

        var all = await Content.GetLessonsAsync(TopicId);
        nextLesson = all.OrderBy(l => l.Order).FirstOrDefault(l => l.Order > lesson.Order && l.Concepts.Count > 0);
        var p = await Progress.GetProfileAsync();
        var paths = await Connections.GetPathsAsync();
        pathForLesson = paths.FirstOrDefault(pa => p.PathsStarted.Contains(pa.Id) && pa.Steps.Any(st => st.LessonId == lesson.Id && st.TopicId == TopicId));
        echoes = await Connections.GetEchoesAsync(TopicId);
        outcome = LessonOutcome.Passed;
    }

    private void RevisitConcept(int index)
    {
        outcome = LessonOutcome.None;
        showQuiz = false;
        currentConceptIndex = index;
        _ = SaveState();
    }

    private async Task RetryQuiz()
    {
        outcome = LessonOutcome.None;
        lastResults = null;
        quizAttempt++;
        showQuiz = true;
        await SaveState();
    }

    private void OpenEcho(Echo e) =>
        Nav.NavigateTo(e.SynthesisQuizId != null ? $"/synthesis/{e.SynthesisQuizId}" : $"/topic/{e.TopicId}");

    private void OpenSimulator(SimulatorInfo sim) => Nav.NavigateTo(sim.Route);

    private async Task SetDepth(string d)
    {
        depth = d;
        var p = await Progress.GetProfileAsync();
        p.ContentDepth = d;
        await Progress.SaveProfileAsync(p);
    }

    private void OpenExplain(Concept c)
    {
        explainOpenFor = c.Id;
        noteSaved = false;
        noteDraft = profile?.ConceptNotes.TryGetValue(c.Id, out var n) == true ? n.Text : "";
    }

    private async Task SaveNote(Concept c)
    {
        if (string.IsNullOrWhiteSpace(noteDraft)) return;
        var p = await Progress.GetProfileAsync();
        p.ConceptNotes[c.Id] = new ConceptNote
        {
            TopicId = TopicId,
            LessonId = LessonId,
            ConceptTitle = c.Title,
            Text = noteDraft.Trim(),
            Updated = DateTime.Now.ToString("yyyy-MM-dd")
        };
        await Progress.SaveProfileAsync(p);
        noteSaved = true;
    }

    public void Dispose()
    {
        _ttsStateTimer?.Stop();
        _ttsStateTimer?.Dispose();
        _ttsCts?.Cancel();
        _ttsCts?.Dispose();
        // Best-effort stop — fire-and-forget
        _ = Tts.StopAsync();
    }
}

<style>
    .depth-toggle { display: flex; justify-content: center; gap: 4px; margin: -4px 0 12px; }
