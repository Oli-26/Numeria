        // Glucose + yeast-style fermentation analog (no enzymes listed but okay)
        new(new[] { "Glu", "H2O" },
            "C<sub>6</sub>H<sub>12</sub>O<sub>6</sub> &rarr; 2 C<sub>2</sub>H<sub>5</sub>OH + 2 CO<sub>2</sub>",
            "Ethanol and carbon dioxide",
            "Fermentation",
            "Yeasts convert glucose dissolved in water into ethanol and CO<sub>2</sub> - the basis of brewing.",
            "gas"),

        // Cu + AgNO3 single replacement
        new(new[] { "Cu", "AgNO3" },
            "Cu + 2 AgNO<sub>3</sub> &rarr; Cu(NO<sub>3</sub>)<sub>2</sub> + 2 Ag",
            "Copper(II) nitrate (blue) and silver metal",
