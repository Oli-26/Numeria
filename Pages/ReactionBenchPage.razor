            "none"),

        // Rusting / corrosion (3 reagents)
        new(new[] { "Fe", "O2", "H2O" },
            "4 Fe + 3 O<sub>2</sub> + 6 H<sub>2</sub>O &rarr; 4 Fe(OH)<sub>3</sub>",
            "Iron(III) hydroxide (rust)",
