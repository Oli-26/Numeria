}

<style>
    .rb-intro { padding: 12px 14px; margin-bottom: 14px; }
    .rb-intro-row { display: flex; align-items: center; gap: 8px; color: var(--text-secondary); font-size: 0.9rem; }
    .rb-mystery {
        display: flex; align-items: center; gap: 6px; margin-top: 10px;
        font-size: 0.85rem; color: var(--text-secondary); cursor: pointer;
    }
    .rb-mystery input { accent-color: var(--primary); }

    .rb-section-title {
        font-size: 0.78rem; text-transform: uppercase; letter-spacing: 0.6px;
        color: var(--text-muted); margin: 4px 2px 8px;
    }

    .reagent-grid {
        display: grid; grid-template-columns: repeat(auto-fill, minmax(96px, 1fr));
        gap: 8px; margin-bottom: 14px;
    }
    .reagent-chip {
        display: flex; flex-direction: column; align-items: center; justify-content: center;
        padding: 10px 6px; background: var(--bg-card); border: 1px solid var(--border);
        border-radius: var(--radius-sm); cursor: pointer; transition: all 0.15s ease;
        -webkit-tap-highlight-color: transparent; min-height: 60px;
    }
    .reagent-chip:active { transform: scale(0.96); }
    .reagent-chip.chip-active { background: rgba(74,95,224,0.10); border-color: var(--primary); box-shadow: 0 0 0 2px rgba(74,95,224,0.18); }
    .reagent-chip.chip-disabled { opacity: 0.45; cursor: not-allowed; }
    .reagent-formula { font-weight: 700; color: var(--text-primary); font-size: 0.95rem; }
    .reagent-name { color: var(--text-muted); font-size: 0.7rem; margin-top: 2px; text-align: center; }

    .rb-tray { padding: 12px 14px; margin-bottom: 14px; }
    .rb-tray-row { display: flex; align-items: center; gap: 8px; flex-wrap: wrap; margin-bottom: 10px; }
    .rb-tray-label { font-size: 0.8rem; color: var(--text-muted); text-transform: uppercase; letter-spacing: 0.5px; }
    .rb-tray-empty { color: var(--text-muted); font-style: italic; font-size: 0.85rem; }
    .rb-tray-chip {
        display: inline-flex; align-items: center; gap: 6px;
        padding: 4px 10px; background: var(--bg-surface); border: 1px solid var(--border);
        border-radius: 999px; font-size: 0.85rem; color: var(--text-primary); cursor: pointer;
    }
    .rb-tray-chip:hover { border-color: var(--error); }
