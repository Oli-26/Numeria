@page "/deep-time"
@inject NavigationManager Nav
@inject IJSRuntime JS
@implements IAsyncDisposable

<div class="page-header">
    <button class="back-btn" aria-label="Back to home" @onclick='() => Nav.NavigateTo("/")'><Icon Name="arrow-left" Size="18" /></button>
    <h1>Deep Time Scroller</h1>
</div>

<p class="dt-intro">
    <Icon Name="scroll" Size="14" /> Scroll down through 4.54 billion years of Earth's history. Row spacing here is compressed, not to scale: the Precambrian (Hadean, Archean and Proterozoic) is about 88% of Earth's history. The strip below shows the true proportions.
</p>

<div class="dt-strip-legend">
    @foreach (var span in eonSpans)
    {
        <span><i style="background: @span.Color"></i>@span.Name @(SpanPct(span.StartMya, span.EndMya))%</span>
    }
    <span><i class="dt-strip-hair"></i>Humans: thinner than a hairline</span>
</div>

<div class="dt-filter">
    <button class="chip @(eonFilter == null ? "chip-active" : "")" @onclick="() => eonFilter = null">All</button>
    <button class="chip @(eonFilter == "hadean" ? "chip-active" : "")" @onclick='() => eonFilter = "hadean"'>Hadean</button>
    <button class="chip @(eonFilter == "archean" ? "chip-active" : "")" @onclick='() => eonFilter = "archean"'>Archean</button>
    <button class="chip @(eonFilter == "proterozoic" ? "chip-active" : "")" @onclick='() => eonFilter = "proterozoic"'>Proterozoic</button>
    <button class="chip @(eonFilter == "phanerozoic" ? "chip-active" : "")" @onclick='() => eonFilter = "phanerozoic"'>Phanerozoic</button>
</div>

<div class="dt-gauge-slot" id="dt-gauge-slot">
<div class="dt-gauge" id="dt-gauge">
    <div class="dt-g-top">
        <div class="dt-g-age" aria-live="off"><b id="dt-g-num">4.54</b> <span id="dt-g-unit">billion years ago</span></div>
        <span class="dt-g-eon" id="dt-g-eon" style="background: color-mix(in oklab, #1a1a1a 65%, black)">Hadean eon</span>
    </div>
    <div class="dt-g-bar" id="dt-g-bar" role="img" aria-label="Earth's history to scale: Hadean 12%, Archean 33%, Proterozoic 43%, Phanerozoic 12%. Humans are a hairline at the end.">
        @foreach (var band in coreBands)
        {
            <div class="dt-g-seg" data-start="@Inv(band.StartMya)" data-end="@Inv(band.EndMya)"
                 style="left: @Inv((4540 - band.StartMya) / 45.4)%; width: @Inv((band.StartMya - band.EndMya) / 45.4)%; background: @band.Color"></div>
        }
        <div class="dt-g-humans" id="dt-g-humans"></div>
        <div class="dt-g-mark" id="dt-g-mark"></div>
    </div>
    <div class="dt-g-scale"><span id="dt-g-scale">All 4.54 billion years, to scale</span><span class="dt-g-hum">Humans</span></div>
    <div class="dt-g-line" aria-hidden="true"></div>
</div>
</div>

<div class="dt-scroller" id="dt-scroller">
    <div class="dt-axis"></div>
    @{
        string? lastEon = null;
    }
    @foreach (var ev in GetFilteredEvents())
    {
        var color = EonColor(ev.Eon);
        var eonLabel = EonLabel(ev.Eon);
        var showHeader = ev.Eon != lastEon;
        lastEon = ev.Eon;

        if (showHeader)
        {
            <div class="dt-eon-header" style="border-left: 4px solid @color">
                <span class="dt-eon-dot" style="background: @color"></span>
                <strong>@eonLabel</strong>
            </div>
        }

        <div class="dt-row" data-age="@Inv(ev.YearsAgo)" data-eon="@ev.Eon" style="--band: @color; min-height: @(VisualSpacing(ev))px">
            <div class="dt-band" style="background: @color"></div>
            <div class="dt-marker" style="background: @color"></div>
            <div class="dt-card card">
                <div class="dt-card-head">
                    <div class="dt-time">
                        <Icon Name="clock" Size="14" />
                        <span>@ev.TimeLabel</span>
                    </div>
                    <span class="dt-eon-tag" style="background: color-mix(in oklab, @color 65%, black)">@eonLabel</span>
                </div>
                <h3 class="dt-title">@ev.Title</h3>
                <p class="dt-desc">@ev.Description</p>
            </div>
        </div>
    }

    <div class="dt-end">
        <Icon Name="calendar" Size="18" />
        <span>End of the timeline. The next entry hasn't happened yet.</span>
    </div>
</div>
<div class="dt-runout" aria-hidden="true"></div>

@code {
    private string? eonFilter;

    protected override Task OnAfterRenderAsync(bool firstRender) => JS.TryInvokeVoidAsync("DeepTime.init").AsTask();

    public ValueTask DisposeAsync() => JS.TryInvokeVoidAsync("DeepTime.dispose");

    private static string Inv(double v) => v.ToString("0.####", System.Globalization.CultureInfo.InvariantCulture);

    // The gauge's core: the four eons, with the Phanerozoic split into its eras so the bands match the cards.
    private static readonly (string Color, double StartMya, double EndMya)[] coreBands =
    {
        ("#1a1a1a", 4540, 4000), ("#4a4a4a", 4000, 2500), ("#7B3FA0", 2500, 539),
        ("#2E8B57", 539, 252), ("#E67E22", 252, 66), ("#F1C40F", 66, 0)
    };

    private IEnumerable<DeepEvent> GetFilteredEvents() => events;

    // Eon boundaries in Mya; widths of the to-scale strip derive from these.
    private static readonly (string Name, string Color, double StartMya, double EndMya)[] eonSpans =
    {
        ("Hadean", "#1a1a1a", 4540, 4000),
        ("Archean", "#4a4a4a", 4000, 2500),
        ("Proterozoic", "#7B3FA0", 2500, 539),
        ("Phanerozoic", "linear-gradient(90deg, #2E8B57, #E67E22, #F1C40F)", 539, 0)
    };

    private static string SpanPct(double startMya, double endMya) =>
        ((startMya - endMya) / 4540.0 * 100.0).ToString("0.##", System.Globalization.CultureInfo.InvariantCulture);

    // Visual spacing per row in pixels. We compress ancient time slightly and
    // leave normal spacing for recent rows so the deep past doesn't dominate.
    // Years-ago is mapped to a log-ish height bucket.
    private int VisualSpacing(DeepEvent ev)
    {
        // ev.YearsAgo is in years. Use log10 scaling clamped into a band.
        var years = Math.Max(1.0, ev.YearsAgo);
        var l = Math.Log10(years); // ~0..9.66
        // Recent rows (small l) get more vertical space, ancient rows are tighter.
        // Map: l=0 (today) -> 130, l=9.66 (4.5 Gya) -> 70
        var px = 130 - (l / 9.66) * 60;
        return (int)Math.Round(px);
    }

    private static string EonColor(string eon) => eon switch
    {
        "hadean" => "#1a1a1a",
        "archean" => "#4a4a4a",
        "proterozoic" => "#7B3FA0",
        "paleozoic" => "#2E8B57",
        "mesozoic" => "#E67E22",
        "cenozoic" => "#F1C40F",
        "phanerozoic" => "#3498DB",
        _ => "var(--border)"
    };

    private static string EonLabel(string eon) => eon switch
    {
        "hadean" => "Hadean",
        "archean" => "Archean",
        "proterozoic" => "Proterozoic",
        "paleozoic" => "Paleozoic",
        "mesozoic" => "Mesozoic",
        "cenozoic" => "Cenozoic",
        "phanerozoic" => "Phanerozoic",
        _ => eon
    };

    private record DeepEvent(double YearsAgo, string TimeLabel, string Eon, string Title, string Description);

    // Eon mapping note: Paleozoic, Mesozoic and Cenozoic are eras within the
    // Phanerozoic eon. We tag each with the more specific era for color, and
    // the filter "phanerozoic" matches any of these via PhanerozoicEras.
    private static readonly HashSet<string> PhanerozoicEras = new() { "paleozoic", "mesozoic", "cenozoic", "phanerozoic" };

    private IEnumerable<DeepEvent> events => allEvents.Where(e =>
        eonFilter == null
        || e.Eon == eonFilter
        || (eonFilter == "phanerozoic" && PhanerozoicEras.Contains(e.Eon))
    );

    private static readonly List<DeepEvent> allEvents = new()
    {
        new(4_540_000_000, "4.54 Gya", "hadean", "Earth forms from the solar nebula",
            "Dust and gas around the young Sun accrete into a molten proto-Earth. The planet is a hellish ocean of magma, bombarded by leftover planetesimals. No crust, no atmosphere we'd recognize."),
        new(4_510_000_000, "4.51 Gya", "hadean", "Theia impact creates the Moon",
            "A Mars-sized body called Theia smashes into the proto-Earth. The debris coalesces in orbit to form the Moon. The collision strips Earth's early atmosphere and resets the surface to molten rock."),
        new(4_400_000_000, "4.4 Gya", "hadean", "Oldest known minerals (Jack Hills zircons)",
            "Tiny zircon crystals from Western Australia are dated to this age, hinting that liquid water and a solid crust may have existed surprisingly early in Earth's history."),
        new(4_280_000_000, "4.28 Gya", "hadean", "Possible earliest crust",
            "Rocks from the Nuvvuagittuq belt in Quebec may date from this period. Earth begins to look more like a planet and less like a lava lamp, with proto-continents forming and reforming."),
        new(4_100_000_000, "4.1 Gya", "hadean", "Late Heavy Bombardment intensifies",
            "A spike in asteroid and comet impacts batters the inner solar system. The Moon's largest craters date from this time. Earth's surface is repeatedly sterilized and remade."),
        new(3_800_000_000, "3.8 Gya", "archean", "Earliest possible life",
            "Carbon isotope ratios in rocks from Greenland suggest biological activity. Whatever was alive was simple, single-celled, and probably anaerobic, living off chemistry rather than sunlight."),
        new(3_500_000_000, "3.5 Gya", "archean", "Stromatolites: early microbial mats",
            "Layered microbial mats called stromatolites appear in the rock record. Some may have been built by photosynthetic microbes; exactly when oxygen-producing photosynthesis began is still debated, with firmer evidence from around 3.0-2.7 Gya."),
        new(3_200_000_000, "3.2 Gya", "archean", "Stable continental crust",
            "Plate tectonics may begin in earnest. The first true continents (cratons) become stable enough to survive to the present day. Microbial life thrives in shallow seas."),
        new(2_700_000_000, "2.7 Gya", "archean", "Oxygenic photosynthesis widespread",
            "Cyanobacteria pump oxygen into the oceans. For hundreds of millions of years it is absorbed by dissolved iron, producing the famous banded iron formations. The atmosphere itself remains anoxic."),
        new(2_400_000_000, "2.4 Gya", "proterozoic", "Great Oxygenation Event",
            "Free oxygen finally accumulates in the atmosphere. To most existing life this is a catastrophic toxin, triggering possibly the largest mass extinction in history. The sky turns blue."),
        new(2_300_000_000, "2.3 Gya", "proterozoic", "Huronian glaciation",
            "With methane stripped from the atmosphere by oxygen, the greenhouse weakens and Earth freezes. Glaciers reach the tropics in one of the longest ice ages ever recorded."),
        new(1_800_000_000, "~1.8 Gya", "proterozoic", "Eukaryotes appear",
            "Cells with nuclei and membrane-bound organelles are clearly in the fossil record by about 1.6-1.8 Gya, and may be older. They arose probably via one cell engulfing another (endosymbiosis). Mitochondria are descended from these captured bacteria."),
        new(1_500_000_000, "1.5 Gya", "proterozoic", "Multicellular experiments",
            "Some eukaryotes start clumping together, with hints of cell specialization. The fossil record from this time is sparse but suggestive."),
        new(1_050_000_000, "~1.05 Gya", "proterozoic", "Sexual reproduction",
            "The red alga Bangiomorpha, preserved in Arctic Canada, is one of the oldest organisms with clear evidence of sexual reproduction. Genetic shuffling supercharges evolution."),
        new(717_000_000, "~717 Mya", "proterozoic", "Snowball Earth begins",
            "The Sturtian glaciation begins, the first of a series of extreme glaciations may have left the entire planet ice-covered, oceans frozen to the equator. Life clings on around hydrothermal vents and beneath thin ice."),
        new(575_000_000, "~575 Mya", "proterozoic", "Ediacaran biota",
            "The Ediacaran Period opens 635 Mya as the ice retreats, and by about 575 Mya strange soft-bodied multicellular organisms appear: fronds, discs, quilted creatures unlike anything alive today. The first complex animal communities."),
        new(540_000_000, "540 Mya", "paleozoic", "Cambrian Explosion",
            "Within a geological eyeblink, virtually every modern animal phylum appears in the fossil record. Eyes, shells, jaws, predation, complex food webs all arrive in a burst of evolutionary creativity."),
        new(485_000_000, "485 Mya", "paleozoic", "First land plants",
            "Mosses and liverworts begin colonizing the bare continents. Without competing animals, primitive plants spread to wherever there is moisture and rock to grip."),
        new(450_000_000, "450 Mya", "paleozoic", "End-Ordovician extinction",
            "Massive glaciation drops sea levels and chills the oceans. Around 85% of marine species disappear, the second-largest extinction in Earth's history."),
        new(420_000_000, "420 Mya", "paleozoic", "Vascular plants and arthropods on land",
            "Plants evolve internal plumbing and lignin, growing taller. Arthropods follow them onto land. The continents finally turn green and start to crawl."),
        new(375_000_000, "375 Mya", "paleozoic", "Late Devonian extinction; tetrapods on land",
            "A long pulse of extinctions reshapes marine life. At the same time, lobe-finned fish like Tiktaalik are flopping into the shallows. Their descendants will become every land vertebrate."),
        new(300_000_000, "300 Mya", "paleozoic", "Pangaea forms",
            "All the major continents collide into a single supercontinent surrounded by one global ocean (Panthalassa). Vast coal swamps blanket the equator, locking up the carbon we now burn."),
        new(252_000_000, "252 Mya", "paleozoic", "End-Permian extinction",
            "The Great Dying. Huge volcanic eruptions in Siberia poison the air and oceans. Around 96% of marine species and 70% of land vertebrates vanish. Life takes 10 million years to recover."),
        new(230_000_000, "230 Mya", "mesozoic", "First dinosaurs",
            "In the recovering Triassic ecosystems, small bipedal archosaurs evolve into the first true dinosaurs. They will dominate the planet for the next 165 million years."),
        new(201_000_000, "201 Mya", "mesozoic", "End-Triassic extinction",
            "Another volcanic episode, this time as Pangaea begins to rift apart, wipes out around three quarters of all species. The survivors include the dinosaurs, who now have the world to themselves."),
        new(150_000_000, "150 Mya", "mesozoic", "Archaeopteryx",
            "A feathered dinosaur the size of a raven, preserved in Jurassic limestone in Bavaria, shows that birds are essentially small flying dinosaurs. They will outlive the rest of the lineage."),
        new(125_000_000, "125 Mya", "mesozoic", "Flowering plants diversify",
            "Angiosperms had appeared earlier, but in the Cretaceous they explode in diversity. Co-evolution with insects produces flowers, fruits, and the green world we'd recognize."),
        new(66_000_000, "66 Mya", "mesozoic", "K-Pg asteroid impact",
            "A 10-kilometer asteroid slams into what is now the Yucatan. The blast, fires, and impact winter wipe out the non-avian dinosaurs and around 75% of species. Mammals inherit the wreckage."),
        new(55_000_000, "55 Mya", "cenozoic", "PETM warming event",
            "A massive release of carbon (perhaps from methane hydrates) spikes global temperatures by 5-8 degrees Celsius in a few thousand years. The ocean acidifies. A natural analogue for today's emissions."),
        new(34_000_000, "34 Mya", "cenozoic", "Antarctic ice sheet forms",
            "Falling atmospheric CO2 and new ocean gateways around Antarctica (the Drake Passage and Tasmanian gateway) isolate the continent, already sitting over the pole, and permanent ice sheets form. Earth shifts from a hothouse to an icehouse climate that has persisted, with wobbles, ever since."),
        new(23_000_000, "23 Mya", "cenozoic", "Grasslands spread; mammals diversify",
            "Grasses, which had been minor players, expand into vast plains. Grazing mammals (horses, antelope, elephants) co-evolve with them. The savannahs that will shape human evolution begin to form."),
        new(7_000_000, "7 Mya", "cenozoic", "Hominin and chimp lineages split",
            "Somewhere in Africa, the last common ancestor of chimps and humans gives rise to two lineages. Sahelanthropus and other early hominins begin walking, sometimes, on two legs."),
        new(3_300_000, "3.3 Mya", "cenozoic", "Oldest stone tools",
            "At Lomekwi in Kenya, hominins are deliberately knapping stone into cutting edges, predating the genus Homo. Technology is older than us."),
        new(300_000, "300 Kya", "cenozoic", "Anatomically modern humans",
            "Fossils from Jebel Irhoud in Morocco show Homo sapiens as a recognizable species. We share the planet with Neanderthals, Denisovans, and other now-extinct human cousins."),
        new(70_000, "70 Kya", "cenozoic", "Out of Africa",
            "A small group of modern humans leaves Africa and, within tens of thousands of years, reaches every habitable continent. Behavioral modernity, art, and complex language are in full swing."),
        new(12_000, "12 Kya", "cenozoic", "Agriculture begins",
            "In the Fertile Crescent, the Yangtze valley, and several other places independently, people domesticate plants and animals. Sedentary villages, surplus food, and population growth follow."),
        new(5_000, "5 Kya", "cenozoic", "First cities and writing",
            "Uruk, Memphis, Mohenjo-daro, and other urban centers appear, supported by agriculture and irrigation. Writing emerges to track grain, taxes, and gods. History, in the literal sense, begins."),
        new(2_000, "2 Kya", "cenozoic", "Classical empires at peak",
            "Rome, Han China, the Kushan Empire, and the Parthians rule huge populations connected by roads and trade. Most of humanity now lives in stratified, literate, agrarian states."),
        new(200, "200 ya", "cenozoic", "Industrial Revolution",
            "Coal-powered steam engines transform manufacturing and transport, starting in Britain. Atmospheric carbon dioxide begins its sharp rise. Human population starts the climb from one billion towards eight."),
        new(70, "70 ya", "cenozoic", "Great Acceleration",
            "Post-WWII, almost every measure of human activity (energy use, fertilizer, plastics, vehicles, dam-building, atmospheric CO2) hockey-sticks upward. Some geologists proposed this as the start of the Anthropocene, though the IUGS rejected a formal Anthropocene epoch in March 2024."),
        new(1, "Today", "cenozoic", "You, reading this",
            "Roughly 8 billion humans share the planet with the descendants of every survivor of every event above. Everything in the timeline led to this moment. The next chapter is being written now.")
    };
}

<style>
    .dt-intro {
        display: flex; align-items: center; gap: 8px; color: var(--text-secondary);
        font-size: 0.88rem; line-height: 1.5; margin: 0 0 14px;
        background: var(--bg-surface); padding: 10px 12px; border-radius: var(--radius-sm);
        border-left: 3px solid var(--primary);
    }

    .dt-strip-legend {
        display: flex; flex-wrap: wrap; gap: 4px 12px; margin: 0 0 12px;
        font-size: 0.7rem; color: var(--text-muted);
    }
    .dt-strip-legend span { display: inline-flex; align-items: center; gap: 4px; }
    .dt-strip-legend i { width: 8px; height: 8px; border-radius: 2px; display: inline-block; border: 1px solid var(--border); }
    .dt-strip-legend i.dt-strip-hair { width: 1px; height: 10px; border: 0; background: var(--accent); border-radius: 0; }

    .dt-filter { display: flex; gap: 10px 6px; margin-bottom: 10px; flex-wrap: wrap; }
    .dt-filter .chip { padding: 7px 11px; }
    .dt-filter .chip-active { background: var(--primary) !important; color: var(--on-primary) !important; }

    .dt-gauge-slot { margin-bottom: 18px; }
    .dt-gauge {
        position: relative; z-index: 6;
        margin: 0 -16px; padding: 10px 16px 8px;
        background: var(--bg-main);
        border-bottom: 1px solid var(--border);
        box-shadow: 0 6px 14px -10px var(--shadow);
    }
    .dt-g-top { display: flex; align-items: baseline; justify-content: space-between; gap: 8px; margin-bottom: 7px; }
    .dt-g-age { color: var(--text-secondary); font-size: 0.9rem; font-weight: 600; white-space: nowrap; }
    .dt-g-age b {
        font-family: var(--font-heading); font-size: 1.75rem; font-weight: 800; color: var(--text-primary);
        font-variant-numeric: tabular-nums; letter-spacing: -0.5px;
    }
    .dt-g-eon {
        flex-shrink: 0; color: #fff; font-size: 0.7rem; font-weight: 800; padding: 3px 9px; border-radius: 10px;
        text-transform: uppercase; letter-spacing: 0.6px; transform-origin: 50% 50%;
    }
    .dt-g-eon.dt-flip { animation: dt-flip 0.38s var(--ease-spring); }
    @@keyframes dt-flip { from { transform: perspective(200px) rotateX(-90deg); opacity: 0.2; } }
    .dt-g-bar {
        position: relative; height: 18px; border-radius: 4px; overflow: hidden;
        border: 1px solid var(--border); background: var(--bg-surface);
    }
    .dt-g-seg { position: absolute; top: 0; bottom: 0; }
    .dt-gauge.dt-pinned { position: fixed; top: 0; margin: 0; }
    .dt-g-humans { position: absolute; top: 0; bottom: 0; right: 0; width: 1px; background: var(--accent); z-index: 1; }
    .dt-zoomed .dt-g-humans { background: #161616; }
    .dt-g-mark { transition: opacity 0.3s ease; }
    .dt-zoomed .dt-g-mark { opacity: 0; }
    .dt-g-mark {
        position: absolute; top: -1px; bottom: -1px; left: 0; width: 3px; margin-left: -1.5px; z-index: 2;
        background: #fff; box-shadow: 0 0 0 1px rgba(0,0,0,0.65); border-radius: 1px;
    }
    .dt-g-scale { display: flex; justify-content: space-between; gap: 8px; margin-top: 4px; font-size: 0.7rem; color: var(--text-muted); }
    .dt-g-hum {
        display: none; position: relative; padding-right: 2px; font-weight: 800; color: var(--text-primary);
    }
    .dt-g-hum::after {
        content: ""; position: absolute; right: -4px; top: -7px;
        border-bottom: 6px solid var(--text-primary); border-left: 5px solid transparent; border-right: 5px solid transparent;
    }
    .dt-zoomed .dt-g-hum { display: inline; }
    .dt-g-line {
        position: absolute; left: 6px; top: calc(100% + 26px); width: 30px; height: 3px; border-radius: 2px;
        background: var(--text-primary); pointer-events: none;
    }
    .dt-g-line::after {
        content: ""; position: absolute; right: -6px; top: -3.5px;
        border-left: 7px solid var(--text-primary); border-top: 5px solid transparent; border-bottom: 5px solid transparent;
    }
    .dt-row.dt-now .dt-marker { transform: scale(1.3); box-shadow: 0 0 0 2px var(--text-primary); }
    .dt-row.dt-now .dt-card { box-shadow: 0 2px 10px var(--shadow), 0 0 0 1px var(--band); }
    .dt-marker { transition: transform 0.18s ease; }
    .dt-runout { height: max(0px, calc(100vh - 480px)); }
    @@media (prefers-reduced-motion: reduce) { .dt-g-eon.dt-flip { animation: none; } }

    .dt-scroller {
        position: relative;
        padding-left: 36px;
        padding-bottom: 24px;
    }

    .dt-axis {
        position: absolute;
        left: 18px; top: 0; bottom: 24px;
        width: 3px;
        background: linear-gradient(
            to bottom,
            #1a1a1a 0%, #1a1a1a 12%,
            #4a4a4a 12%, #4a4a4a 28%,
            #7B3FA0 28%, #7B3FA0 60%,
            #2E8B57 60%, #2E8B57 73%,
            #E67E22 73%, #E67E22 86%,
            #F1C40F 86%, #F1C40F 100%
        );
        border-radius: 2px;
    }

    .dt-eon-header {
        margin: 18px 0 6px -36px;
        padding: 6px 12px;
        background: var(--bg-surface);
        border-radius: var(--radius-sm);
        display: flex; align-items: center; gap: 8px;
        font-size: 0.8rem; color: var(--text-primary);
        text-transform: uppercase; letter-spacing: 1px;
    }
    .dt-eon-header strong { font-weight: 700; }
    .dt-eon-dot { width: 10px; height: 10px; border-radius: 50%; display: inline-block; }

    .dt-row {
        position: relative;
        margin-bottom: 4px;
        display: flex;
        align-items: flex-start;
    }

    .dt-band {
        position: absolute;
        left: -24px; top: 0; bottom: 0;
        width: 6px;
        opacity: 0.35;
        border-radius: 3px;
    }

    .dt-marker {
        position: absolute;
        left: -32px;
        top: 18px;
        width: 14px; height: 14px;
        border-radius: 50%;
        border: 2px solid var(--bg-card);
        box-shadow: 0 0 0 1px var(--border);
        z-index: 2;
    }

    .dt-card {
