@page "/welcome"
@inject IContentRepository Content
@inject IProgressService Progress
@inject IUsageCounter Usage
@inject NavigationManager Nav
@inject IJSRuntime JS

<div class="onboarding">
    <div class="ob-step ob-fade-in">
        <img class="ob-mark" src="nous-mark.svg" alt="" />
        <h1 class="ob-welcome-title">Stories the textbooks skip</h1>
        <p class="ob-tagline">Short, accurate lessons on the strange side of every subject. No account needed. Tap one to start.</p>

        <div class="ob-starters">
            @foreach (var (topic, hook) in starters)
            {
                <button class="ob-starter" style="--topic-color: @topic.Color" disabled="@starting" @onclick="() => Start(topic)">
                    <span class="ob-starter-icon">@((MarkupString)TopicArt.For(topic.Id))</span>
                    <strong>@topic.Name.Replace("Strange ", "")</strong>
                    <small>@hook</small>
                </button>
            }
        </div>

        <button class="ob-link" disabled="@starting" @onclick="BrowseAll">Or browse all subjects</button>

        <div class="ob-name">
            @if (editingName)
            {
                <input @ref="nameInput" class="ob-input" @bind="userName" @bind:event="oninput" maxlength="30"
                       aria-label="Your name" @onkeydown="NameKeydown" @onblur="FinishEditing" />
            }
            else
            {
                <span>Playing as <strong>@userName</strong></span>
                <button class="ob-link" @onclick="EditName">Change</button>
            }
        </div>
    </div>
</div>

@code {
    // Lesson 1 of each delivers the hook on its card.
    private static readonly (string TopicId, string Hook)[] StarterPicks =
    {
        ("history-strange", "The 1518 dancing plague"),
        ("bio-strange", "A shark that may be 400 years old"),
        ("physics-strange", "The world's slowest experiments"),
        ("psych-strange", "A woman sure she had no brain"),
        ("math-strange", "The “illegal” prime number"),
        ("geology-strange", "The town above the fire"),
    };

    private readonly string generatedName = StarterName.Generate(Random.Shared);
    private string userName = "";
    private bool editingName;
    private bool focusName;
    private bool starting;
    private ElementReference nameInput;
    private List<(Topic Topic, string Hook)> starters = new();

    protected override void OnInitialized() => userName = generatedName;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            var topics = await Content.GetTopicsAsync();
            starters = StarterPicks
                .Select(p => (Topic: topics.FirstOrDefault(t => t.Id == p.TopicId), p.Hook))
                .Where(p => p.Topic != null)
                .Select(p => (p.Topic!, p.Hook))
                .ToList();
            StateHasChanged();
        }
        if (focusName)
        {
            focusName = false;
            try { await nameInput.FocusAsync(); } catch { }
        }
    }

    private void EditName()
    {
        editingName = true;
        focusName = true;
    }

    private void FinishEditing()
    {
        userName = userName.Trim();
        if (userName.Length == 0) userName = generatedName;
        editingName = false;
    }

    private void NameKeydown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") FinishEditing();
    }

    // One tap from first launch to the first lesson; onboarding is replaced in history so Back lands on home.
    private async Task Start(Topic topic)
    {
        if (starting) return;
        starting = true;
        await JS.TryInvokeVoidAsync("Sounds.playClick");
        var first = (await Content.GetLessonsAsync(topic.Id)).OrderBy(l => l.Order).FirstOrDefault();
        await SaveChoices(topic.Domain, topic.Id);
        await Usage.CountAsync("topic", topic.Id);
        Nav.NavigateTo(first != null ? $"/topic/{topic.Id}/lesson/{first.Id}" : $"/topic/{topic.Id}", replace: true);
    }

    private async Task BrowseAll()
    {
        if (starting) return;
        starting = true;
        await JS.TryInvokeVoidAsync("Sounds.playClick");
        await SaveChoices("history", null);
        Nav.NavigateTo("/domains", replace: true);
    }

    private async Task SaveChoices(string domain, string? topicId)
    {
        FinishEditing();
        var profile = await Progress.GetProfileAsync();
        profile.DisplayName = userName;
        if (topicId != null) profile.SuggestedTopicIds = new List<string> { topicId };
        profile.CurrentDomain = domain;
        await JS.TryInvokeVoidAsync("applyDomain", domain);
        await Progress.SaveProfileAsync(profile);
    }
}

<style>
    .onboarding {
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        min-height: calc(100vh - 100px);
        padding: 20px 16px;
        text-align: center;
    }

    .ob-step {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 12px;
        max-width: 560px;
        width: 100%;
    }

    .ob-fade-in {
        animation: obFadeIn 0.25s ease-out;
    }

    .ob-mark { height: 64px; }
    .ob-step h1.ob-welcome-title {
        font-family: Georgia, 'Noto Serif', serif; font-size: 1.85rem; line-height: 1.2; text-wrap: balance;
        margin: 0; color: var(--text-primary);
    }

    .ob-tagline {
        color: var(--text-secondary);
        font-size: 1rem;
        line-height: 1.5;
        margin: 0 0 4px;
        text-wrap: balance;
    }

    .ob-starters {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: 10px;
        width: 100%;
    }

    .ob-starter {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 4px;
        padding: 12px 8px;
        background: var(--bg-card);
        border: 2px solid transparent;
        border-radius: var(--radius-md);
        font: inherit;
        color: var(--text-primary);
        cursor: pointer;
        transition: background 0.15s ease, transform 0.1s ease, border-color 0.15s ease;
        -webkit-tap-highlight-color: transparent;
    }
    .ob-starter:hover { background: var(--bg-surface); border-color: color-mix(in srgb, var(--topic-color) 45%, transparent); }
    .ob-starter:active { transform: scale(0.97); }
    .ob-starter:disabled { cursor: default; }

    .ob-starter-icon {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 44px;
        height: 44px;
        padding: 8px;
        box-sizing: border-box;
        border-radius: 12px;
        color: var(--topic-color);
        background: color-mix(in srgb, var(--topic-color) 14%, transparent);
    }

    .ob-starter strong { font-size: 0.95rem; }
    .ob-starter small { font-size: 0.78rem; line-height: 1.3; color: var(--text-muted); text-wrap: balance; }

    .ob-link {
        min-height: 44px;
        padding: 0 10px;
        background: none;
        border: none;
        border-radius: var(--radius-sm);
        font: inherit;
        font-size: 0.95rem;
        color: var(--primary);
        cursor: pointer;
    }
    .ob-link:hover { background: var(--bg-surface); }

    .ob-name {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 4px;
        min-height: 48px;
        width: 100%;
        font-size: 0.9rem;
        color: var(--text-muted);
    }
    .ob-name strong { color: var(--text-secondary); }

    .ob-input {
        width: 100%;
        max-width: 320px;
        padding: 10px 14px;
        border: 2px solid var(--border);
        border-radius: var(--radius-sm);
        font-size: 1rem;
        font-family: var(--font-main);
        background: var(--bg-card);
        color: var(--text-primary);
        outline: none;
        text-align: center;
        box-sizing: border-box;
    }
    .ob-input:focus { border-color: var(--primary); }

    @@keyframes obFadeIn {
        from { opacity: 0; transform: translateY(8px); }
        to { opacity: 1; transform: translateY(0); }
    }

    @@media (max-height: 780px) {
        .ob-mark { display: none; }
        .ob-starter-icon { width: 38px; height: 38px; padding: 7px; }
    }

    @@media (max-width: 400px) {
        .ob-step h1.ob-welcome-title { font-size: 1.5rem; }
        .ob-mark { height: 48px; }
        .ob-step { gap: 10px; }
        .ob-tagline { font-size: 0.92rem; }
    }
</style>
