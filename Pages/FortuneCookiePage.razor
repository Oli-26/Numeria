@page "/fortune"
@inject IProgressService Progress
@inject IContentRepository Content
@inject IJSRuntime JS
@inject NavigationManager Nav
@inject HttpClient Http

<div class="page-header">
    <button class="back-btn" aria-label="Back to home" @onclick='() => Nav.NavigateTo("/")'><Icon Name="arrow-left" Size="18" /></button>
    <h1>Fortune Cookie</h1>
</div>

@if (todayCookie != null)
{
    @if (!revealed)
    {
        <button class="cookie-card cookie-closed" @onclick="RevealCookie">
            <span class="cookie-icon"><Icon Name="cookie" Size="34" StrokeWidth="1.6" /></span>
            <span class="cookie-tap">Tap to open today's cookie</span>
            <span class="cookie-subject">@SubjectName(todayDomain)</span>
        </button>
    }
    else
    {
        <div class="cookie-card cookie-open">
            <div class="cookie-category"><Icon Name="@GetCategoryIcon(todayCookie.Category)" Size="14" /> @CookieLabel(todayCookie.Category, todayDomain)</div>
            <p class="cookie-text">@todayCookie.Text</p>
            <div class="cookie-date">@DateTime.Now.ToString("MMMM d, yyyy")</div>
        </div>
    }

    <div class="section" style="margin-top: 24px">
        <h3>Recent Cookies</h3>
        @if (history.Count == 0)
        {
            <p style="color: var(--text-muted); font-size: 0.9rem">Come back each day for a new cookie. It comes from whichever subject you have selected.</p>
        }
        else
        {
            <div class="cookie-history">
                @foreach (var item in history)
                {
                    <div class="card cookie-history-item @(item.Date == today ? "cookie-today" : "")">
                        <div class="cookie-hist-header">
                            <span class="cookie-hist-cat"><Icon Name="@GetCategoryIcon(item.Cookie.Category)" Size="12" /> @CookieLabel(item.Cookie.Category, item.Domain)</span>
                            <small>@item.Date</small>
                        </div>
                        <p>@item.Cookie.Text</p>
                    </div>
                }
            </div>
        }
    </div>
}
else
{
    <div class="loading">Loading...</div>
}

@code {
    private readonly Dictionary<string, List<FortuneCookie>> sets = new();
    private Dictionary<string, string> subjectNames = new();
    private FortuneCookie? todayCookie;
    private string todayDomain = "math";
    private string currentDomain = "math";
    private bool revealed;
    private string today = "";
    private List<HistoryItem> history = new();

    private class FortuneCookie
    {
        public int Id { get; set; }
        public string Text { get; set; } = "";
        public string Category { get; set; } = "";
    }

    private record HistoryItem(string Date, string Domain, FortuneCookie Cookie);

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        today = DateTime.Now.ToString("yyyy-MM-dd");
        var profile = await Progress.GetProfileAsync();
        currentDomain = string.IsNullOrEmpty(profile.CurrentDomain) ? "math" : profile.CurrentDomain;
        subjectNames = (await Content.GetDomainsAsync()).ToDictionary(d => d.Id, d => d.Name);

        (todayDomain, todayCookie) = await CookieFor(profile, DateTime.Now);
        revealed = profile.ViewedCookieDates.Contains(today);

        history.Clear();
        for (int i = 0; i < 14; i++)
        {
            var day = DateTime.Now.AddDays(-i);
            if (!profile.ViewedCookieDates.Contains(day.ToString("yyyy-MM-dd"))) continue;
            var (domain, cookie) = await CookieFor(profile, day);
            if (cookie != null) history.Add(new HistoryItem(day.ToString("yyyy-MM-dd"), domain, cookie));
        }
        StateHasChanged();
    }

    // A viewed day keeps the cookie it showed; days viewed before subjects had cookies were math.
    private async Task<(string Domain, FortuneCookie? Cookie)> CookieFor(UserProfile profile, DateTime day)
    {
        var date = day.ToString("yyyy-MM-dd");
        if (profile.ViewedCookies.TryGetValue(date, out var key)
            && key.Split(':') is [var savedDomain, var idText] && int.TryParse(idText, out var id)
            && (await LoadSet(savedDomain)).FirstOrDefault(c => c.Id == id) is { } saved)
            return (savedDomain, saved);

        var domain = profile.ViewedCookieDates.Contains(date) ? "math" : currentDomain;
        var set = await LoadSet(domain);
        if (set.Count == 0) set = await LoadSet(domain = "math");
        if (set.Count == 0) return (domain, null);
        var dayIndex = (int)(day.Date - new DateTime(2024, 1, 1)).TotalDays;
        return (domain, set[dayIndex % set.Count]);
    }

    private async Task<List<FortuneCookie>> LoadSet(string domain)
    {
        if (sets.TryGetValue(domain, out var set)) return set;
        try { set = await Http.GetFromJsonAsync<List<FortuneCookie>>($"data/fortunes/{domain}.json") ?? new(); }
        catch { set = new(); }
        if (set.Count == 0 && domain == "math")
        {
            try { set = await Http.GetFromJsonAsync<List<FortuneCookie>>("data/fortune-cookies.json") ?? new(); }
            catch { set = new(); }
        }
        return sets[domain] = set;
    }

    private string SubjectName(string domain) => subjectNames.GetValueOrDefault(domain, domain);

    private string CookieLabel(string category, string domain) =>
        GetCategoryLabel(category) is var label && label == SubjectName(domain) ? label : $"{label} · {SubjectName(domain)}";

    private async Task RevealCookie()
    {
        revealed = true;
        await JS.TryInvokeVoidAsync("Sounds.playReveal");

        var profile = await Progress.GetProfileAsync();
        if (todayCookie == null || profile.ViewedCookieDates.Contains(today)) return;
        profile.ViewedCookieDates.Add(today);
        profile.ViewedCookies[today] = $"{todayDomain}:{todayCookie.Id}";
        await Progress.SaveProfileAsync(profile);
        history.Insert(0, new HistoryItem(today, todayDomain, todayCookie));
    }

    private string GetCategoryLabel(string cat) => cat switch
    {
        "paradox" => "Paradox",
        "fact" => "Fact",
        "quote" => "Quote",
        "fun" => "Fun",
        "history" => "History",
        "beauty" => "Beauty",
        "probability" => "Probability",
        "topology" => "Topology",
        "mystery" => "Mystery",
        _ => "Fact"
    };

    private string GetCategoryIcon(string cat) => cat switch
    {
        "paradox" => "bolt",
        "fact" => "lightbulb",
        "quote" => "message",
        "fun" => "star",
        "history" => "scroll",
        "beauty" => "star-filled",
        "probability" => "dice",
        "topology" => "search",
        "mystery" => "help",
        _ => "lightbulb"
    };
}

<style>
    .cookie-card {
        display: flex; flex-direction: column; align-items: center; gap: 10px;
        width: 100%; max-width: 380px; margin: 20px auto 0; padding: 32px 24px;
        border-radius: var(--radius-lg); border: 1px solid var(--border);
        background: var(--bg-card); color: var(--text-primary); text-align: center; font: inherit;
    }

    .cookie-closed {
        cursor: pointer; -webkit-tap-highlight-color: transparent;
        transition: transform 0.15s ease, border-color 0.15s ease;
    }
    .cookie-closed:hover { border-color: var(--primary-light); }
    .cookie-closed:active { transform: scale(0.98); }

    .cookie-icon {
        display: grid; place-items: center; width: 76px; height: 76px; margin-bottom: 4px;
        border-radius: 50%; color: var(--accent);
        background: color-mix(in srgb, var(--accent) 15%, transparent);
        animation: cookieBob 3s ease-in-out infinite;
    }
    .cookie-tap { font-weight: 600; font-size: 1rem; }
    .cookie-subject { font-size: 0.82rem; color: var(--text-muted); }

    @@keyframes cookieBob {
        0%, 100% { transform: translateY(0) rotate(-4deg); }
        50% { transform: translateY(-5px) rotate(4deg); }
    }

    .cookie-open { align-items: stretch; animation: cookieReveal 0.4s ease both; }

    @@keyframes cookieReveal {
        from { opacity: 0; transform: translateY(8px) scale(0.98); }
        to { opacity: 1; transform: none; }
    }

    @@media (prefers-reduced-motion: reduce) {
        .cookie-icon, .cookie-open { animation: none; }
    }

    .cookie-category {
        display: flex; justify-content: center; align-items: center; gap: 6px;
        font-size: 0.8rem; font-weight: 600; color: var(--primary);
    }

    .cookie-text {
        font-family: Georgia, 'Noto Serif', serif; font-size: 1.12rem; line-height: 1.6;
        color: var(--text-primary); margin: 4px 0 6px;
    }

    .cookie-date { font-size: 0.75rem; color: var(--text-muted); }

    .cookie-history { display: flex; flex-direction: column; gap: 8px; }
    .cookie-history-item { padding: 12px 14px; }
    .cookie-history-item:hover { transform: none; }
    .cookie-history-item p {
        margin: 6px 0 0; font-size: 0.88rem; color: var(--text-secondary); line-height: 1.5;
    }
    .cookie-today { border-color: var(--primary-light); }

    .cookie-hist-header { display: flex; justify-content: space-between; align-items: center; gap: 8px; }
    .cookie-hist-cat { display: inline-flex; align-items: center; gap: 4px; font-size: 0.75rem; font-weight: 600; color: var(--primary); }
    .cookie-hist-header small { color: var(--text-muted); font-size: 0.75rem; }
</style>
