@page "/leaderboard"
@using System.Text.Json
@inject ILeaderboardService Leaderboard
@inject IProgressService Progress
@inject IGamificationService Gamification
@inject IJSRuntime JS

<div class="lb-page">
<div class="page-header lb-head">
    <h1>Leaderboard</h1>
</div>
@if (!loading && !loadFailed && entries.Count > 0)
{
    <p class="lb-sub">All-time XP · @entries.Count @(entries.Count == 1 ? "scholar" : "scholars")</p>
}

@if (!Leaderboard.IsConfigured)
{
    <div class="demo-banner card">
        <small>Demo data. Connect a leaderboard service to see real scores.</small>
    </div>
}

@if (loading)
{
    <div class="loading">Loading leaderboard...</div>
}
else if (loadFailed)
{
    <div class="empty-state card">
        <div class="empty-icon"><Icon Name="award" Size="36" /></div>
        <p>Couldn't load the leaderboard. Check your connection and try again.</p>
        <button class="btn btn-primary btn-sm" @onclick="ReloadLeaderboard">Retry</button>
    </div>
}
else
{
    @if (entries.Count == 0)
    {
        <div class="empty-state card">
            <div class="empty-icon"><Icon Name="award" Size="36" /></div>
            <p>No scores yet. Be the first!</p>
        </div>
    }
    else
    {
        <div class="card lb-podium">
            <div class="podium-banner">
                <span class="podium-banner-rule"></span>
                <span class="podium-banner-text">Top Scholars</span>
                <span class="podium-banner-rule"></span>
            </div>
            <div class="pod-cols">
                @PodiumSpot(1)
                @PodiumSpot(0)
                @PodiumSpot(2)
            </div>
        </div>
    }

    @if (profile != null)
    {
        var myCard = HallOfFame.Resolve(profile.SelectedAvatar);
        var move = myIndex >= 0 ? LeaderboardRanks.Moved(previousRanks, entries[myIndex].Name, myRank) : null;
        <div class="card lb-you">
            <div class="you-row">
                @if (myCard != null)
                {
                    <FigureMedallion Card="myCard" Size="46" />
                }
                else
                {
                    <div class="lb-initial" style="width:46px;height:46px;font-size:19px;background:var(--primary)">@Initial(playerName)</div>
                }
                <div class="you-text">
                    <strong>You · @Display(playerName)</strong>
                    <small>@(myIndex >= 0 ? $"#{myRank} of {entries.Count}" : $"Not posted yet, you'd be #{myRank}") · Lvl @myLevel · <span data-count>@profile.TotalXp.ToString("N0")</span> XP</small>
                </div>
                @if (move > 0)
                {
                    <span class="move-chip up">▲ @move since last visit</span>
                }
                else if (move < 0)
                {
                    <span class="move-chip down">▼ @(-move) since last visit</span>
                }
            </div>

            @if (nameTaken)
            {
                <p class="you-note">Someone else on the board already has this name. Pick another to post your score.</p>
            }
            else if (above != null)
            {
                <div class="you-gap"><strong>@((above.Score - profile.TotalXp).ToString("N0")) XP</strong> to pass @Display(above.Name) for #@(entries.IndexOf(above) + 1)</div>
                <div class="you-bar"><i style="width: @GapPercent()%"></i></div>
            }
            else if (myIndex == 0)
            {
                <div class="you-gap top"><Icon Name="trophy" Size="16" /> You're top of the board</div>
            }
            else if (entries.Count > 0)
            {
                <div class="you-gap top"><Icon Name="trophy" Size="16" /> Post now to take #1</div>
            }

            <div class="you-actions">
                @if (nameTaken)
                {
                    <button class="btn btn-primary you-post" @onclick="OpenNameSheet">Choose a name</button>
                }
                else if (UpToDate)
                {
                    <span class="you-done"><Icon Name="checkmark-circle" Size="16" /> Your score is up to date</span>
                    <button type="button" class="you-edit" @onclick="OpenNameSheet">Edit name</button>
                }
                else
                {
                    <button class="btn btn-primary you-post" @onclick="SubmitScore" disabled="@(submitting || string.IsNullOrWhiteSpace(playerName))">@(submitting ? "Posting..." : PostLabel)</button>
                    <button type="button" class="you-edit" @onclick="OpenNameSheet">Edit name</button>
                }
            </div>
        </div>
    }

    @if (entries.Count > 3)
    {
        <div class="card lb-list">
            @for (int i = 3; i < entries.Count; i++)
            {
                var e = entries[i];
                var rank = i + 1;
                var isYou = i == myIndex;
                <div class="lb-row @(isYou ? "me" : "")" style="animation-delay: @(Math.Min(i - 3, 12) * 40)ms">
                    <span class="lb-rank">#@rank</span>
                    @Avatar(e, rank, 38, isYou)
                    <div class="lb-mid">
                        <div class="lb-name"><strong>@Display(e.Name)@(isYou ? " (you)" : "")</strong>@Move(e.Name, rank)</div>
                        <small>Lvl @e.Seconds · @e.Text</small>
                        <div class="lb-rel"><i style="width: @PercentOfLeader(e.Score)%"></i></div>
                    </div>
                    <div class="lb-xp"><span data-count>@e.Score.ToString("N0")</span><small>XP</small></div>
                </div>
            }
        </div>
    }
}
</div>

@if (nameSheetOpen)
{
    <div class="sheet-backdrop" @onclick="() => nameSheetOpen = false"></div>
    <div class="bottom-sheet" role="dialog" aria-modal="true" aria-label="Your name on the board">
        <div class="bottom-sheet-head"><h3>Your name on the board</h3></div>
        <p class="bottom-sheet-sub">Up to 20 letters and numbers. Posting under a new name starts a new entry.</p>
        <input class="fill-input lb-name-input" @bind="nameDraft" @bind:event="oninput" maxlength="20" placeholder="Your display name" />
        <div class="sheet-actions">
            <button class="btn btn-outline" @onclick="() => nameSheetOpen = false">Cancel</button>
            <button class="btn btn-primary" @onclick="SaveName" disabled="@string.IsNullOrWhiteSpace(nameDraft)">Save</button>
        </div>
    </div>
}

@code {
    private const string RanksKey = "nous-lb-ranks";
    private const string Laurel = "<ellipse cx='33.3' cy='103.5' rx='3.4' ry='7.4' transform='rotate(122 33.3 103.5)'/><ellipse cx='22.0' cy='94.0' rx='3.4' ry='7.4' transform='rotate(138 22.0 94.0)'/><ellipse cx='13.9' cy='81.8' rx='3.4' ry='7.4' transform='rotate(155 13.9 81.8)'/><ellipse cx='9.6' cy='67.7' rx='3.4' ry='7.4' transform='rotate(171 9.6 67.7)'/><ellipse cx='9.5' cy='52.9' rx='3.4' ry='7.4' transform='rotate(188 9.5 52.9)'/><ellipse cx='13.6' cy='38.8' rx='3.4' ry='7.4' transform='rotate(205 13.6 38.8)'/><ellipse cx='21.6' cy='26.4' rx='3.4' ry='7.4' transform='rotate(221 21.6 26.4)'/><ellipse cx='32.8' cy='16.8' rx='3.4' ry='7.4' transform='rotate(238 32.8 16.8)'/><ellipse cx='86.7' cy='103.5' rx='3.4' ry='7.4' transform='rotate(-122 86.7 103.5)'/><ellipse cx='98.0' cy='94.0' rx='3.4' ry='7.4' transform='rotate(-138 98.0 94.0)'/><ellipse cx='106.1' cy='81.8' rx='3.4' ry='7.4' transform='rotate(-155 106.1 81.8)'/><ellipse cx='110.4' cy='67.7' rx='3.4' ry='7.4' transform='rotate(-171 110.4 67.7)'/><ellipse cx='110.5' cy='52.9' rx='3.4' ry='7.4' transform='rotate(-188 110.5 52.9)'/><ellipse cx='106.4' cy='38.8' rx='3.4' ry='7.4' transform='rotate(-205 106.4 38.8)'/><ellipse cx='98.4' cy='26.4' rx='3.4' ry='7.4' transform='rotate(-221 98.4 26.4)'/><ellipse cx='87.2' cy='16.8' rx='3.4' ry='7.4' transform='rotate(-238 87.2 16.8)'/>";

    private UserProfile? profile;
    private List<LeaderboardEntry> entries = new();
    private bool loading = true;
    private bool loadFailed;
    private string playerName = "";
    private string nameDraft = "";
    private bool nameSheetOpen;
    private bool submitting;
    private bool countPending;
    private int myLevel;
    private int myIndex = -1;
    private int myRank;
    private bool nameTaken;
    private LeaderboardEntry? above;
    private int belowXp;
    private Dictionary<string, int>? previousRanks;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            profile = await Progress.GetProfileAsync();
            playerName = profile.DisplayName;
            myLevel = Gamification.GetLevel(profile.TotalXp);
            previousRanks = ParseRanks(await JS.TryInvokeAsync<string?>("localStorage.getItem", RanksKey));

            await ReloadLeaderboard();
            loading = false;
            countPending = true;
            StateHasChanged();
        }
        else if (countPending)
        {
            countPending = false;
            await JS.TryInvokeVoidAsync("CountUp.run", ".lb-page", 800);
        }
    }

    private async Task ReloadLeaderboard()
    {
        var result = await Leaderboard.GetLeaderboardAsync(50);
        loadFailed = result == null;
        entries = result ?? new();
        ComputeStanding();
        // previousRanks keeps the last visit's ranks for the arrows; this visit's become the next baseline.
        if (entries.Count > 0)
            await JS.TryInvokeVoidAsync("localStorage.setItem", RanksKey, JsonSerializer.Serialize(LeaderboardRanks.Of(entries)));
        StateHasChanged();
    }

    private void ComputeStanding()
    {
        myIndex = -1; myRank = 0; above = null; belowXp = 0; nameTaken = false;
        if (profile == null) return;
        var key = LeaderboardRanks.Key(playerName);
        var matched = entries.FindIndex(e => LeaderboardRanks.Key(e.Name) == key);
        // More XP under our name than we have means it is another player's entry, not ours.
        nameTaken = matched >= 0 && entries[matched].Score > profile.TotalXp;
        myIndex = nameTaken ? -1 : matched;
        myRank = myIndex >= 0 ? myIndex + 1 : entries.Count(e => e.Score > profile.TotalXp) + 1;
        var others = entries.Where((_, i) => i != matched).ToList();
        above = others.Where(e => e.Score > profile.TotalXp).OrderBy(e => e.Score).FirstOrDefault();
        belowXp = others.Where(e => e.Score <= profile.TotalXp).Select(e => e.Score).DefaultIfEmpty(0).Max();
    }

    private bool UpToDate => profile != null && myIndex >= 0 && entries[myIndex].Score >= profile.TotalXp
        && HallOfFame.Resolve(entries[myIndex].Avatar)?.Id == HallOfFame.Resolve(profile.SelectedAvatar)?.Id;

    private string PostLabel
    {
        get
        {
            if (myIndex < 0) return entries.Count == 0 ? "Be the first on the board" : "Post my score";
            var pending = profile!.TotalXp - entries[myIndex].Score;
            return pending > 0 ? $"Update my score (+{pending:N0} XP)" : "Update my avatar";
        }
    }

    private int GapPercent() => above == null || profile == null ? 0
        : (int)Math.Clamp((profile.TotalXp - belowXp) * 100.0 / Math.Max(1, above.Score - belowXp), 3, 100);

    private int PercentOfLeader(int score) => entries.Count > 0 && entries[0].Score > 0 ? score * 100 / entries[0].Score : 0;

    private void OpenNameSheet()
    {
        nameDraft = playerName;
        nameSheetOpen = true;
    }

    private async Task SaveName()
    {
        if (profile == null || string.IsNullOrWhiteSpace(nameDraft)) return;
        playerName = nameDraft.Trim();
        profile.DisplayName = playerName;
        await Progress.SaveProfileAsync(profile);
        nameSheetOpen = false;
        ComputeStanding();
    }

    private async Task SubmitScore()
    {
        if (profile == null || string.IsNullOrWhiteSpace(playerName)) return;
        submitting = true;
        StateHasChanged();

        var done = profile.TopicsCompleted.Count;
        var topicsText = $"{done} {(done == 1 ? "topic" : "topics")}";
        if (await Leaderboard.SubmitScoreAsync(playerName, profile.TotalXp, myLevel, topicsText, profile.SelectedAvatar))
        {
            await JS.TryInvokeVoidAsync("showToast", "Score posted!", "");
            await JS.TryInvokeVoidAsync("Haptics.light");
            await ReloadLeaderboard();
        }
        else
        {
            await JS.TryInvokeVoidAsync("showToast", "Couldn't post. Check your connection.", "");
        }

        submitting = false;
        StateHasChanged();
    }

    private static Dictionary<string, int>? ParseRanks(string? json)
    {
        if (string.IsNullOrEmpty(json)) return null;
        try { return JsonSerializer.Deserialize<Dictionary<string, int>>(json); }
        catch (JsonException) { return null; }
    }

    private static string Display(string name) => name.Replace("_", " ");

    private static char Initial(string name) => name.Length > 0 ? char.ToUpperInvariant(name[0]) : '?';

    private static string RomanNumeral(int n) => n switch { 1 => "I", 2 => "II", 3 => "III", _ => n.ToString() };

    private static string InitialColor(int rank) => rank switch
    {
        1 => "#BC8434",
        2 => "#8F887B",
        3 => "#A86A44",
        _ => "var(--primary)"
    };

    private RenderFragment PodiumSpot(int i) => __builder =>
    {
        if (i >= entries.Count)
        {
            <div class="pod-col empty"></div>
            return;
        }
        var e = entries[i];
        var rank = i + 1;
        var metal = rank == 1 ? "gold" : rank == 2 ? "silver" : "bronze";
        <div class="pod-col @metal">
            <div class="pod-top">
                <div class="pod-avatar">
                    @if (rank == 1)
                    {
                        <svg class="pod-laurel" viewBox="0 0 120 120" fill="currentColor" aria-hidden="true">@((MarkupString)Laurel)</svg>
                    }
                    @Avatar(e, rank, rank == 1 ? 72 : 56, i == myIndex)
                </div>
                <div class="pod-name"><span>@Display(e.Name)</span>@Move(e.Name, rank)</div>
                <div class="pod-xp"><span data-count>@e.Score.ToString("N0")</span> <small>XP</small></div>
                <div class="pod-lvl">Lvl @e.Seconds</div>
            </div>
            <div class="pod-block">@RomanNumeral(rank)</div>
        </div>
    };

    // Entries come from other players' devices, so the avatar id is resolved here rather than trusted.
    private RenderFragment Avatar(LeaderboardEntry e, int rank, int size, bool isYou) => __builder =>
    {
        var card = HallOfFame.Resolve(isYou && profile != null ? profile.SelectedAvatar : e.Avatar);
        if (card != null)
        {
            <FigureMedallion Card="card" Size="size" />
        }
        else
        {
            <div class="lb-initial" style="width:@(size)px;height:@(size)px;font-size:@(size * 2 / 5)px;background:@InitialColor(rank)">@Initial(e.Name)</div>
        }
    };

    private RenderFragment Move(string name, int rank) => __builder =>
    {
        var m = LeaderboardRanks.Moved(previousRanks, name, rank);
        if (m > 0)
        {
            <span class="mv up" title="Up @m since your last visit">▲@m</span>
        }
        else if (m < 0)
        {
            <span class="mv down" title="Down @(-m) since your last visit">▼@(-m)</span>
        }
        else if (LeaderboardRanks.IsNew(previousRanks, name))
        {
            <span class="mv new">New</span>
        }
    };
}

<style>
    .demo-banner {
        text-align: center;
        padding: 8px;
        background: color-mix(in srgb, var(--accent) 10%, transparent);
        border-color: var(--accent);
        margin-bottom: 12px;
    }
    .demo-banner small { color: var(--accent); }

    .lb-head { margin-bottom: 0; }
    .lb-sub { margin: 2px 0 14px; color: var(--text-muted); font-size: .85rem; }

    /* ── Podium ── */
    .lb-podium { padding: 14px 10px 0; margin-bottom: 12px; overflow: hidden; }
    .podium-banner { display: flex; align-items: center; gap: 10px; }
    .podium-banner-rule { flex: 1; height: 1px; background: var(--accent); opacity: .4; }
    .podium-banner-text { font-size: .72rem; font-weight: 800; letter-spacing: 2.5px; color: var(--accent); text-transform: uppercase; }
    .pod-cols { display: grid; grid-template-columns: 1fr 1.2fr 1fr; gap: 8px; align-items: end; max-width: 460px; margin: 10px auto 0; }
    .pod-col { display: flex; flex-direction: column; align-items: center; min-width: 0; }
    .pod-col.gold { padding-top: 18px; }
    .pod-top { display: flex; flex-direction: column; align-items: center; min-width: 0; max-width: 100%; animation: podDrop .45s var(--ease-out) backwards; }
    .pod-avatar { position: relative; display: flex; align-items: center; justify-content: center; margin-bottom: 8px; }
    .pod-avatar > * { position: relative; }
    .pod-avatar > .pod-laurel { position: absolute; width: 106px; height: 106px; left: 50%; top: 50%; transform: translate(-50%, -50%); color: var(--accent); }
    .silver .pod-avatar::before, .bronze .pod-avatar::before { content: ''; position: absolute; inset: -5px; border-radius: 50%; opacity: .5; }
    .silver .pod-avatar::before { background: #B8B0A2; }
    .bronze .pod-avatar::before { background: #C98A62; }
    .pod-name { display: flex; align-items: baseline; justify-content: center; gap: 4px; max-width: 100%; font: 700 .95rem Georgia, 'Times New Roman', serif; color: var(--text-primary); }
    .pod-name > span:first-child { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
    .pod-xp { font: 700 .92rem Georgia, 'Times New Roman', serif; color: var(--xp-text, var(--accent)); white-space: nowrap; }
    .pod-xp small { font: 600 .62rem var(--font-main); color: var(--text-muted); }
    .pod-lvl { font-size: .72rem; color: var(--text-muted); margin-bottom: 8px; }
    .pod-block {
        width: 100%; border-radius: 10px 10px 0 0; display: flex; justify-content: center; padding-top: 8px;
        font: 700 1.35rem Georgia, 'Times New Roman', serif; color: rgba(255, 255, 255, .9); text-shadow: 0 1px 0 rgba(0, 0, 0, .18);
        transform-origin: bottom; animation: plinthRise .55s var(--ease-out) backwards;
    }
    .gold .pod-block { height: 84px; background: linear-gradient(#D8A85C, #BC8434); animation-delay: .25s; }
    .silver .pod-block { height: 60px; background: linear-gradient(#C9C2B5, #A39A8A); animation-delay: .12s; }
    .bronze .pod-block { height: 44px; background: linear-gradient(#C98A62, #A86A44); animation-delay: .04s; }
    .gold .pod-top { animation-delay: .5s; }
    .silver .pod-top { animation-delay: .36s; }
    .bronze .pod-top { animation-delay: .28s; }
    @@keyframes plinthRise { from { transform: scaleY(0); } }
    @@keyframes podDrop { from { opacity: 0; transform: translateY(-14px) scale(.9); } }

    /* ── Your standing ── */
    .lb-you { padding: 14px; margin-bottom: 12px; border: 1.5px solid var(--primary); }
    .you-row { display: flex; align-items: center; gap: 12px; }
    .you-text { flex: 1; min-width: 0; display: flex; flex-direction: column; }
    .you-text strong { font-size: 1rem; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
    .you-text small { color: var(--text-muted); font-size: .78rem; }
    .move-chip { flex-shrink: 0; font-size: .72rem; font-weight: 700; padding: 4px 9px; border-radius: 20px; }
    .move-chip.up { color: var(--success); background: color-mix(in srgb, var(--success) 14%, transparent); }
    .move-chip.down { color: var(--error); background: color-mix(in srgb, var(--error) 12%, transparent); }
    .you-gap { margin: 12px 0 6px; font-size: .84rem; color: var(--text-secondary); display: flex; align-items: center; gap: 6px; }
    .you-gap strong { color: var(--primary); }
    .you-gap.top { color: var(--xp-text, var(--accent)); font-weight: 700; margin-bottom: 0; }
    .you-bar { height: 8px; border-radius: 5px; background: var(--bg-surface); overflow: hidden; }
    .you-bar i { display: block; height: 100%; border-radius: 5px; background: linear-gradient(90deg, var(--primary), var(--accent)); transform-origin: left; animation: barGrow .9s var(--ease-out) .3s backwards; }
    @@keyframes barGrow { from { transform: scaleX(0); } }
    .you-note { margin: 10px 0 0; font-size: .84rem; color: var(--error); }
    .you-actions { display: flex; align-items: center; gap: 10px; margin-top: 12px; }
    .you-post { flex: 1; }
    .you-done { flex: 1; display: inline-flex; align-items: center; gap: 6px; color: var(--success); font-weight: 600; font-size: .88rem; }
    .you-edit { background: none; border: none; color: var(--primary); font-weight: 600; font-size: .85rem; padding: 8px 4px; cursor: pointer; font-family: inherit; }

    /* ── Everyone else ── */
    .lb-list { padding: 4px 0; overflow: hidden; }
    .lb-row { position: relative; display: flex; align-items: center; gap: 12px; padding: 10px 14px; animation: rowIn .35s var(--ease-out) backwards; }
    .lb-row + .lb-row { border-top: 1px solid var(--border); }
    .lb-row.me { background: color-mix(in srgb, var(--primary) 9%, transparent); }
    .lb-row.me::before { content: ''; position: absolute; left: 0; top: 6px; bottom: 6px; width: 4px; border-radius: 0 3px 3px 0; background: var(--primary); }
    .lb-rank { width: 30px; flex-shrink: 0; font: 700 .9rem Georgia, 'Times New Roman', serif; color: var(--text-muted); }
    .lb-mid { flex: 1; min-width: 0; }
    .lb-name { display: flex; align-items: baseline; gap: 6px; min-width: 0; }
    .lb-name strong { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; font-size: .95rem; }
    .lb-mid small { color: var(--text-muted); font-size: .74rem; }
    .lb-rel { height: 3px; border-radius: 2px; background: var(--bg-surface); margin-top: 5px; overflow: hidden; }
    .lb-rel i { display: block; height: 100%; border-radius: 2px; background: var(--accent); opacity: .8; }
    .lb-xp { flex-shrink: 0; text-align: right; font: 700 .95rem Georgia, 'Times New Roman', serif; color: var(--xp-text, var(--accent)); }
    .lb-xp small { display: block; font: 600 .62rem var(--font-main); color: var(--text-muted); }
    @@keyframes rowIn { from { opacity: 0; transform: translateY(8px); } }
    .mv { flex-shrink: 0; font-size: .7rem; font-weight: 700; font-family: var(--font-main); }
    .mv.up { color: var(--success); }
    .mv.down { color: var(--error); }
    .mv.new { color: var(--primary); background: color-mix(in srgb, var(--primary) 12%, transparent); padding: 1px 6px; border-radius: 8px; text-transform: uppercase; letter-spacing: .04em; font-size: .6rem; }
    .lb-initial {
        flex-shrink: 0; border-radius: 50%; display: flex; align-items: center; justify-content: center;
        color: #FBF8F2; font-weight: 800; font-family: Georgia, 'Times New Roman', serif; box-shadow: inset 0 0 0 3px rgba(255, 255, 255, .22);
    }

    .lb-name-input { width: 100%; }
    .sheet-actions { display: flex; gap: 10px; justify-content: flex-end; margin-top: 14px; }

    .empty-state { text-align: center; padding: 40px 24px; margin-bottom: 12px; }
    .empty-state .empty-icon { margin-bottom: 12px; color: var(--text-muted); }
    .empty-state p { color: var(--text-secondary); margin: 0; }

    .fill-input {
        padding: 10px 14px;
        border: 2px solid var(--border);
        border-radius: var(--radius-sm);
        font-size: 0.95rem;
        background: var(--bg-surface);
        color: var(--text-primary);
        outline: none;
    }
    .fill-input:focus { border-color: var(--primary); }
</style>
