@page "/hall-of-fame"
@inject IProgressService Progress
@inject NavigationManager Nav

@if (loaded)
{
    @if (figures.Count == 0)
    {
        <div class="page-header">
            <button class="back-btn" aria-label="Back to home" @onclick='() => Nav.NavigateTo("/")'><Icon Name="arrow-left" Size="18" /></button>
            <h1>Hall of Fame</h1>
        </div>
        <div class="card" style="text-align: center; padding: 40px 24px">
            <Icon Name="star-filled" Size="40" Stroke="var(--text-muted)" />
            <h2 style="margin-top: 12px">No Hall of Fame for this subject yet</h2>
            <p style="color: var(--text-secondary)">Figures for this subject are still being researched. Check back later.</p>
            <button class="btn btn-accent" @onclick='() => Nav.NavigateTo("/")'>Back to home</button>
        </div>
    }
    else if (!unlocked)
    {
        <div class="page-header">
            <button class="back-btn" aria-label="Back to home" @onclick='() => Nav.NavigateTo("/")'><Icon Name="arrow-left" Size="18" /></button>
            <h1>Hall of Fame: @DomainLabel</h1>
        </div>
        <div class="card" style="text-align: center; padding: 40px 24px">
            <Icon Name="lock" Size="40" Stroke="var(--text-muted)" />
            <h2 style="margin-top: 12px">Locked</h2>
            <p style="color: var(--text-secondary)">Purchase "Hall of Fame: @DomainLabel" from the Shop to unlock.</p>
            <button class="btn btn-accent" @onclick='() => Nav.NavigateTo("/shop")'>Go to Shop</button>
        </div>
    }
    else
    {
        var visible = GetVisibleFigures();
        var eras = AvailableEras();

        <div class="page-header">
            <button class="back-btn" aria-label="Back to home" @onclick='() => Nav.NavigateTo("/")'><Icon Name="arrow-left" Size="18" /></button>
            <h1>Hall of Fame: @DomainLabel</h1>
        </div>

        @if (eras.Count > 1)
        {
            <div class="era-filter">
                <button class="chip @(eraFilter == null ? "chip-active" : "")" @onclick="() => eraFilter = null">All</button>
                @foreach (var era in eras)
                {
                    var key = era.Key;
                    <button class="chip @(eraFilter == key ? "chip-active" : "")" @onclick="() => eraFilter = key">@era.Label</button>
                }
            </div>
        }

        @if (visible.Count == 0)
        {
            <p class="hof-empty">No figures in this era yet.</p>
        }

        <div class="timeline">
            @foreach (var m in visible)
            {
                var person = m;
                var expanded = selectedPerson?.Name == person.Name;
                <div class="timeline-item">
                    <div class="timeline-dot" style="background: @person.Color"></div>
                    <div class="timeline-card card">
                        <button type="button" class="timeline-toggle" aria-expanded="@(expanded ? "true" : "false")" @onclick="() => TogglePerson(person)">
                            <span class="timeline-header">
                                <span class="timeline-medal" aria-hidden="true"><FigureMedallion Card="HallOfFame.Card(currentDomain, person)" Size="44" /></span>
                                <span class="timeline-info">
                                    <strong>@person.Name</strong>
                                    <small>@person.Years | @person.Origin</small>
                                </span>
                            </span>
                            <span class="timeline-tagline">@person.Tagline</span>
                        </button>

                        @if (expanded)
                        {
                            <div class="timeline-expanded">
                                <div class="hof-section">
                                    <h4>Contribution</h4>
                                    <p>@((MarkupString)person.Contribution)</p>
                                </div>
                                <div class="hof-section">
                                    <h4>Why It's Amazing</h4>
                                    <p>@((MarkupString)person.WhyAmazing)</p>
                                </div>
                                @if (person.Drama != null)
                                {
                                    <div class="hof-drama">
                                        <Icon Name="star-filled" Size="14" Fill="var(--accent)" /> @person.Drama
                                    </div>
                                }
                            </div>
                        }
                    </div>
                </div>
            }
        </div>
    }
}

@code {
    private bool loaded;
    private bool unlocked;
    private string currentDomain = "math";
    private string? eraFilter;
    private HallOfFame.Figure? selectedPerson;
    private List<HallOfFame.Figure> figures = new();

    private static readonly (string Key, string Label)[] eraBuckets =
    {
        ("ancient", "Ancient"),
        ("medieval", "Medieval"),
        ("renaissance", "1400-1600"),
        ("enlightenment", "1600-1800"),
        ("modern", "1800+")
    };

    private string DomainLabel => HallOfFame.Label(currentDomain);

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            var profile = await Progress.GetProfileAsync();
            currentDomain = string.IsNullOrEmpty(profile.CurrentDomain) ? "math" : profile.CurrentDomain;
            figures = HallOfFame.ForDomain(currentDomain).OrderBy(f => f.Birth).ToList();
            unlocked = profile.ShopPurchases.Contains($"unlock-halloffame-{currentDomain}");
            loaded = true;
            StateHasChanged();
        }
    }

    private void TogglePerson(HallOfFame.Figure f) => selectedPerson = selectedPerson?.Name == f.Name ? null : f;

    private List<HallOfFame.Figure> GetVisibleFigures() =>
        eraFilter == null ? figures : figures.Where(f => f.Era == eraFilter).ToList();

    private List<(string Key, string Label)> AvailableEras() =>
        eraBuckets.Where(b => figures.Any(f => f.Era == b.Key)).ToList();

}

<style>
    .era-filter { display: flex; gap: 6px; margin-bottom: 14px; flex-wrap: wrap; }
    .chip-active { background: var(--primary) !important; color: white !important; }

    .hof-empty { text-align: center; color: var(--text-muted); font-size: 0.9rem; margin: 24px 0; }

    /* Timeline */
    .timeline { position: relative; padding-left: 20px; }
    .timeline::before { content: ''; position: absolute; left: 8px; top: 0; bottom: 0; width: 2px; background: var(--border); }

    .timeline-item { position: relative; margin-bottom: 12px; }
    .timeline-dot { position: absolute; left: -16px; top: 18px; width: 12px; height: 12px; border-radius: 50%; z-index: 1; }

    .timeline-card { padding: 12px 14px; transition: border-color 0.2s ease; }
    .timeline-card:hover { transform: none; }

    .timeline-toggle {
        display: block; width: 100%; padding: 0; border: none; background: none; color: inherit;
        font: inherit; text-align: left; cursor: pointer; -webkit-tap-highlight-color: transparent;
    }
    .timeline-toggle:focus-visible { outline: 2px solid var(--primary); outline-offset: 4px; border-radius: var(--radius-sm); }

    .timeline-header { display: flex; align-items: center; gap: 10px; }
    .timeline-medal { width: 44px; height: 44px; flex-shrink: 0; filter: drop-shadow(0 1px 2px rgba(42, 33, 27, .18)); }
    .timeline-info strong { display: block; font-size: 0.95rem; }
    .timeline-info small { display: block; color: var(--text-muted); font-size: 0.8rem; }

    .timeline-tagline { display: block; color: var(--text-secondary); font-style: italic; font-size: 0.85rem; margin-top: 6px; }

    .timeline-expanded { margin-top: 12px; padding-top: 12px; border-top: 1px solid var(--border); animation: expandIn 0.25s ease; }

    .hof-section { margin-bottom: 10px; }
    .hof-section h4 { font-size: 0.8rem; color: var(--text-muted); text-transform: uppercase; letter-spacing: 0.5px; margin: 0 0 4px; }
    .hof-section p { margin: 0; font-size: 0.85rem; color: var(--text-secondary); line-height: 1.6; }

    .hof-drama {
        display: flex; align-items: flex-start; gap: 6px; padding: 8px 10px;
        background: color-mix(in srgb, var(--accent) 8%, transparent); border-radius: var(--radius-sm);
        font-size: 0.82rem; color: var(--text-secondary); line-height: 1.5;
    }

    @@keyframes expandIn { from { opacity: 0; } to { opacity: 1; } }

    @@media (prefers-reduced-motion: reduce) {
        .timeline-expanded { animation: none; }
    }
</style>
