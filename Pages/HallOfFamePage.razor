@page "/hall-of-fame"
@inject IProgressService Progress
@inject IJSRuntime JS
@inject NavigationManager Nav

@if (!unlocked)
{
    <div class="page-header">
        <button class="back-btn" aria-label="Back to home" @onclick='() => Nav.NavigateTo("/")'><Icon Name="arrow-left" Size="18" /></button>
        <h1>Hall of Fame: @DomainLabel</h1>
    </div>
    <div class="card" style="text-align: center; padding: 40px 24px">
        <Icon Name="lock" Size="40" Stroke="var(--text-muted)" />
        <h2 style="margin-top: 12px">Locked</h2>
        <p style="color: var(--text-secondary)">Purchase "Hall of Fame: @DomainLabel" from the Shop to unlock.</p>
        <button class="btn btn-accent" @onclick='() => Nav.NavigateTo("/shop")'>Go to Shop</button>
    </div>
}
else
{

<div class="page-header">
    <button class="back-btn" aria-label="Back to home" @onclick='() => Nav.NavigateTo("/")'><Icon Name="arrow-left" Size="18" /></button>
    <h1>Hall of Fame: @DomainLabel</h1>
</div>

<div class="hof-tabs">
    <button class="tab @(mode == "timeline" ? "active" : "")" @onclick='() => mode = "timeline"'>Timeline</button>
    <button class="tab @(mode == "trumps" ? "active" : "")" @onclick='() => mode = "trumps"'>Top Trumps</button>
</div>

@if (mode == "timeline")
{
    <div class="era-filter">
        <button class="chip @(eraFilter == null ? "chip-active" : "")" @onclick="() => eraFilter = null">All</button>
        <button class="chip @(eraFilter == "ancient" ? "chip-active" : "")" @onclick='() => eraFilter = "ancient"'>Ancient</button>
        <button class="chip @(eraFilter == "medieval" ? "chip-active" : "")" @onclick='() => eraFilter = "medieval"'>Medieval</button>
        <button class="chip @(eraFilter == "enlightenment" ? "chip-active" : "")" @onclick='() => eraFilter = "enlightenment"'>1600-1800</button>
        <button class="chip @(eraFilter == "modern" ? "chip-active" : "")" @onclick='() => eraFilter = "modern"'>1800+</button>
    </div>

    <div class="timeline">
        @foreach (var m in GetFilteredMathematicians())
        {
            var person = m;
            <div class="timeline-item" @onclick="() => TogglePerson(person)">
                <div class="timeline-dot" style="background: @person.Color"></div>
                <div class="timeline-card card">
                    <div class="timeline-header">
                        <div class="timeline-initial" style="background: @person.Color">@person.Name[0]</div>
                        <div class="timeline-info">
                            <strong>@person.Name</strong>
                            <small>@person.Years | @person.Origin</small>
                        </div>
                    </div>
                    <div class="timeline-tagline">@person.Tagline</div>

                    @if (selectedPerson?.Name == person.Name)
                    {
                        <div class="timeline-expanded">
                            <div class="hof-section">
                                <h4>Contribution</h4>
                                <p>@((MarkupString)person.Contribution)</p>
                            </div>
                            <div class="hof-section">
                                <h4>Why It's Amazing</h4>
                                <p>@((MarkupString)person.WhyAmazing)</p>
                            </div>
                            @if (person.Drama != null)
                            {
                                <div class="hof-drama">
                                    <Icon Name="star-filled" Size="14" Fill="var(--accent)" /> @person.Drama
                                </div>
                            }
                            <div class="trump-stats-mini">
                                <span title="Genius">G:@person.Genius</span>
                                <span title="Impact">I:@person.Impact</span>
                                <span title="Breadth">B:@person.Breadth</span>
                                <span title="Drama">D:@person.DramaStat</span>
                            </div>
                        </div>
                    }
                </div>
            </div>
        }
    </div>
}
else
{
    <p class="trumps-intro">Tap two cards to compare. Highest stat wins!</p>

    @if (trumpBattle)
    {
        <div class="trump-battle">
            <div class="trump-card @(trumpWinner == 1 ? "trump-winner" : trumpWinner == 2 ? "trump-loser" : "")"
                 style="border-color: @trumpCard1!.Color">
                <div class="trump-name" style="background: @trumpCard1!.Color">@trumpCard1!.Name</div>
                <div class="trump-years">@trumpCard1!.Years</div>
                <div class="trump-stat-list">
                    <div class="trump-stat @(trumpCategory == "genius" && trumpCard1!.Genius >= trumpCard2!.Genius ? "stat-win" : "")">
                        <span>Genius</span><strong>@trumpCard1!.Genius</strong>
                    </div>
                    <div class="trump-stat @(trumpCategory == "impact" && trumpCard1!.Impact >= trumpCard2!.Impact ? "stat-win" : "")">
                        <span>Impact</span><strong>@trumpCard1!.Impact</strong>
                    </div>
                    <div class="trump-stat @(trumpCategory == "breadth" && trumpCard1!.Breadth >= trumpCard2!.Breadth ? "stat-win" : "")">
                        <span>Breadth</span><strong>@trumpCard1!.Breadth</strong>
                    </div>
                    <div class="trump-stat @(trumpCategory == "drama" && trumpCard1!.DramaStat >= trumpCard2!.DramaStat ? "stat-win" : "")">
                        <span>Drama</span><strong>@trumpCard1!.DramaStat</strong>
                    </div>
                </div>
            </div>
            <div class="trump-vs">VS</div>
            <div class="trump-card @(trumpWinner == 2 ? "trump-winner" : trumpWinner == 1 ? "trump-loser" : "")"
                 style="border-color: @trumpCard2!.Color">
                <div class="trump-name" style="background: @trumpCard2!.Color">@trumpCard2!.Name</div>
                <div class="trump-years">@trumpCard2!.Years</div>
                <div class="trump-stat-list">
                    <div class="trump-stat @(trumpCategory == "genius" && trumpCard2!.Genius >= trumpCard1!.Genius ? "stat-win" : "")">
                        <span>Genius</span><strong>@trumpCard2!.Genius</strong>
                    </div>
                    <div class="trump-stat @(trumpCategory == "impact" && trumpCard2!.Impact >= trumpCard1!.Impact ? "stat-win" : "")">
                        <span>Impact</span><strong>@trumpCard2!.Impact</strong>
                    </div>
                    <div class="trump-stat @(trumpCategory == "breadth" && trumpCard2!.Breadth >= trumpCard1!.Breadth ? "stat-win" : "")">
                        <span>Breadth</span><strong>@trumpCard2!.Breadth</strong>
                    </div>
                    <div class="trump-stat @(trumpCategory == "drama" && trumpCard2!.DramaStat >= trumpCard1!.DramaStat ? "stat-win" : "")">
                        <span>Drama</span><strong>@trumpCard2!.DramaStat</strong>
                    </div>
                </div>
            </div>
        </div>
        @if (trumpWinner > 0)
        {
            <div class="trump-result">
                @(trumpWinner == 1 ? trumpCard1!.Name : trumpCard2!.Name) wins on @trumpCategory!
            </div>
        }
        <div class="trump-actions">
            @if (trumpWinner == 0)
            {
                <button class="btn btn-sm btn-primary" @onclick='() => CompareStat("genius")'>Genius</button>
                <button class="btn btn-sm btn-accent" @onclick='() => CompareStat("impact")'>Impact</button>
                <button class="btn btn-sm btn-outline" @onclick='() => CompareStat("breadth")'>Breadth</button>
                <button class="btn btn-sm btn-outline" @onclick='() => CompareStat("drama")'>Drama</button>
            }
            else
            {
                <button class="btn btn-primary" @onclick="NewTrumpRound">New Round</button>
            }
        </div>
    }
    else
    {
        <div class="trump-pick-grid">
            @foreach (var m in mathematicians)
            {
                var person = m;
                var isSelected = trumpPick1?.Name == person.Name || trumpPick2?.Name == person.Name;
                <div class="trump-pick @(isSelected ? "picked" : "")" style="border-color: @person.Color"
                     @onclick="() => PickTrump(person)">
                    <strong>@person.Name</strong>
                    <small>@person.Years</small>
                </div>
            }
        </div>
        @if (trumpPick1 != null && trumpPick2 != null)
        {
            <button class="btn btn-primary btn-lg" style="width: 100%; margin-top: 12px" @onclick="StartBattle">
                Battle!
            </button>
        }
        else
        {
            <small class="pick-hint">Pick @(trumpPick1 == null ? "first" : "second") mathematician</small>
        }
    }
}

}

@code {
    private bool unlocked;
    private string currentDomain = "math";
    private string mode = "timeline";
    private string? eraFilter;

    private string DomainLabel => currentDomain switch
    {
        "philosophy" => "Philosophers",
        "physics" => "Physicists",
        "biology" => "Biologists",
        "chemistry" => "Chemists",
        "geology" => "Geologists",
        "history" => "Historians",
        "linguistics" => "Linguists",
        "materials" => "Materials Scientists",
        "cs" => "Computer Scientists",
        "misc" => "Esoterica",
        "politics" => "Political Thinkers",
        "economics" => "Economists",
        "media" => "Media Pioneers",
        "literature" => "Writers",
        _ => "Mathematicians"
    };

    // Timeline
    private Mathematician? selectedPerson;

    // Top Trumps
    private Mathematician? trumpPick1;
    private Mathematician? trumpPick2;
    private Mathematician? trumpCard1;
    private Mathematician? trumpCard2;
    private bool trumpBattle;
    private int trumpWinner;
    private string? trumpCategory;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            var profile = await Progress.GetProfileAsync();
            currentDomain = string.IsNullOrEmpty(profile.CurrentDomain) ? "math" : profile.CurrentDomain;
            unlocked = profile.ShopPurchases.Contains($"unlock-halloffame-{currentDomain}");
            StateHasChanged();
        }
    }

    private void TogglePerson(Mathematician m) => selectedPerson = selectedPerson?.Name == m.Name ? null : m;

    private List<Mathematician> GetFilteredMathematicians() =>
        eraFilter == null ? mathematicians : mathematicians.Where(m => m.Era == eraFilter).ToList();

    private void PickTrump(Mathematician m)
    {
        if (trumpPick1 == null) trumpPick1 = m;
        else if (trumpPick1.Name == m.Name) trumpPick1 = null;
        else if (trumpPick2 == null) trumpPick2 = m;
        else if (trumpPick2.Name == m.Name) trumpPick2 = null;
    }

    private void StartBattle()
    {
        trumpCard1 = trumpPick1;
        trumpCard2 = trumpPick2;
        trumpBattle = true;
        trumpWinner = 0;
        trumpCategory = null;
    }

    private void CompareStat(string stat)
    {
        trumpCategory = stat;
        var v1 = stat switch { "genius" => trumpCard1!.Genius, "impact" => trumpCard1!.Impact, "breadth" => trumpCard1!.Breadth, _ => trumpCard1!.DramaStat };
        var v2 = stat switch { "genius" => trumpCard2!.Genius, "impact" => trumpCard2!.Impact, "breadth" => trumpCard2!.Breadth, _ => trumpCard2!.DramaStat };
        trumpWinner = v1 > v2 ? 1 : v2 > v1 ? 2 : 0;
    }

    private void NewTrumpRound()
    {
        trumpPick1 = null; trumpPick2 = null; trumpBattle = false; trumpWinner = 0; trumpCategory = null;
    }

    private record Mathematician(string Name, string Years, string Origin, string Era, string Color, string Tagline,
        string Contribution, string WhyAmazing, string? Drama, int Genius, int Impact, int Breadth, int DramaStat);

    private List<Mathematician> mathematicians => GetFiguresForDomain(currentDomain);

    private static List<Mathematician> GetFiguresForDomain(string domain) => domain switch
    {
        "philosophy" => philosophyFigures,
        "physics" => physicsFigures,
        "biology" => biologyFigures,
        "chemistry" => chemistryFigures,
        "geology" => geologyFigures,
        "history" => historyFigures,
        "linguistics" => linguisticsFigures,
        "materials" => materialsFigures,
        "cs" => csFigures,
        "misc" => miscFigures,
        "politics" => politicsFigures,
        "economics" => economicsFigures,
        "media" => mediaFigures,
        "literature" => literatureFigures,
        _ => mathFigures
    };

    private static readonly List<Mathematician> mathFigures = new()
    {
        new("Euclid", "~300 BC", "Alexandria", "ancient", "#4A90D9",
            "The father of geometry",
            "Wrote <strong>The Elements</strong>, history's most influential textbook. Axiomatized geometry: 5 postulates, hundreds of theorems built rigorously from them. Created the template for all of mathematics that followed.",
            "2,300 years later, The Elements is still the second most printed book (after the Bible). His axiomatic method -- start with self-evident truths, derive everything else -- became the foundation of ALL mathematics. Every proof you've ever seen follows Euclid's blueprint.",
            "His 5th postulate (parallel lines) seemed too complex. For 2,000 years mathematicians tried to prove it from the others. Failing led to the discovery of non-Euclidean geometry -- curved space!", 8, 10, 7, 5),

        new("Archimedes", "~287-212 BC", "Syracuse", "ancient", "#E74C3C",
            "The greatest mind of antiquity",
            "Discovered the principles of levers, buoyancy, and the method of exhaustion (proto-calculus). Calculated pi to remarkable accuracy. Invented the Archimedean screw and war machines.",
            "He was doing calculus 2,000 years before Newton and Leibniz. His <strong>Method of Mechanical Theorems</strong> (lost for centuries, rediscovered in 1906 on a palimpsest) shows he understood integration conceptually. He might be the most ahead-of-his-time scientist ever.",
            "Killed by a Roman soldier during the siege of Syracuse, reportedly saying \"Do not disturb my circles!\" His tomb bore a sphere inscribed in a cylinder -- his proudest theorem.", 10, 9, 8, 9),

        new("Al-Khwarizmi", "~780-850", "Persia", "medieval", "#2ECC71",
            "The father of algebra",
            "Wrote <strong>Al-Kitab al-Mukhtasar</strong>, which gave us the word \"algebra\" (al-jabr = restoring). Systematized solving linear and quadratic equations. Introduced Hindu-Arabic numerals to the Islamic world.",
            "The word \"algorithm\" comes from his name (Algoritmi). He transformed math from geometric reasoning into symbolic manipulation. Every equation you solve, every line of code that runs -- the conceptual framework traces back to this one book.",
            null, 8, 10, 6, 3),

        new("Fibonacci", "1170-1250", "Italy", "medieval", "#F39C12",
            "He brought numbers to Europe",
            "Wrote <strong>Liber Abaci</strong> (1202), introducing Hindu-Arabic numerals (0-9) to Europe, replacing Roman numerals. Described the Fibonacci sequence: 1, 1, 2, 3, 5, 8, 13... where each number is the sum of the previous two.",
            "Europe was STILL using Roman numerals for commerce until Fibonacci showed that 0-9 was vastly superior. Try multiplying XLVII by MCMXII. His sequence appears in sunflower spirals, pinecone patterns, and the golden ratio. He didn't discover it (Indian mathematicians knew it), but he brought it to the West.",
            null, 6, 9, 5, 4),

        new("Newton", "1643-1727", "England", "enlightenment", "#4A5FE0",
            "Invented calculus and decoded the universe",
            "Co-invented calculus (independently from Leibniz). Discovered the laws of motion and universal gravitation. Developed the generalized binomial theorem. Made foundational contributions to optics.",
