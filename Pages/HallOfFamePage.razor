        new("Socrates", "~470-399 BC", "Athens", "ancient", "#4A90D9",
            "The original gadfly",
            "Invented the elenchus -- the method of relentless questioning that exposes contradictions in confident beliefs. Wrote nothing; everything we have is via Plato and Xenophon.",
            "He shifted philosophy's attention from cosmology to ethics and the examined life. Every Socratic seminar, every cross-examination in court, descends from his style.",
            "Sentenced to death by Athens for \"corrupting the youth\" and impiety. Could have escaped. Drank the hemlock instead, arguing that fleeing would betray the laws he had lived under.", 9, 10, 7, 10),

        new("Plato", "~428-348 BC", "Athens", "ancient", "#E74C3C",
            "Founder of the Academy",
