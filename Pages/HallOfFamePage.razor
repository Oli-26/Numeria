    private static readonly List<Mathematician> philosophyFigures = new()
    {
        new("Confucius", "551-479 BC", "China", "ancient", "#F39C12",
            "Sage of social harmony",
            "Codified an ethics built on <strong>ren</strong> (humaneness), <strong>li</strong> (ritual propriety), and the cultivation of the <em>junzi</em> (exemplary person). His Analects shaped East Asian civic life for 2,500 years.",
            "He turned ethics into a practical training program rather than abstract theory. Imperial China selected its bureaucracy via exams on his texts for over a millennium -- the longest-running meritocratic system in history.",
