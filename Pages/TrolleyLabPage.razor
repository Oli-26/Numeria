@page "/trolley-lab"
@inject NavigationManager Nav
@inject IJSRuntime JS

@{
    var dilemma = dilemmas[index];
}

<div class="page-header">
    <button class="back-btn" aria-label="Back to home" @onclick='() => Nav.NavigateTo("/")'><Icon Name="arrow-left" Size="18" /></button>
    <h1>Trolley Lab</h1>
</div>

<div class="card tl-intro">
    <Icon Name="puzzle" Size="22" Stroke="var(--accent)" />
    <p>Each scenario forces a choice. After each verdict you see where the four major frameworks tend to land, and a profile at the end shows how often you sided with each: utilitarian, deontological, virtue, or contractualist.</p>
</div>

<div class="card tl-dilemma">
    <div class="tl-tag">@dilemma.Title (@(index + 1)/@dilemmas.Count)</div>
    <p class="tl-prompt">@((MarkupString)dilemma.Prompt)</p>

    @if (dilemma.Tracks)
    {
        var bridge = dilemma.OptionA.StartsWith("Push");
        <div class="tl-tracks">
            <svg viewBox="0 0 320 120" class="tl-svg" @key="@($"{index}-{verdict}")" @ref="trackSvg">
                @if (bridge)
                {
                    @Sleepers(14, 70, 306, 70)
                    <line x1="14" y1="70" x2="306" y2="70" stroke="var(--text-secondary)" stroke-width="3" />
                    <rect x="112" y="34" width="96" height="4" rx="1" fill="var(--text-muted)" />
                    <line x1="118" y1="38" x2="118" y2="58" stroke="var(--text-muted)" stroke-width="2" />
                    <line x1="202" y1="38" x2="202" y2="58" stroke="var(--text-muted)" stroke-width="2" />
                    <g class="tl-fig tl-fig-a tl-stranger"><circle cx="160" cy="27" r="6.5" fill="var(--accent)" /></g>
                    <g class="tl-fig tl-fig-b">@Figures(5, 268, 66, 7, 0)</g>
                    <g><text x="160" y="12" text-anchor="middle" font-size="10" fill="var(--text-muted)">@dilemma.OptionACost</text></g>
                    <g><text x="306" y="88" text-anchor="end" font-size="10" fill="var(--text-muted)">@dilemma.OptionBCost</text></g>
                }
                else
                {
                    @Sleepers(14, 60, 150, 60)
                    <line x1="14" y1="60" x2="150" y2="60" stroke="var(--text-secondary)" stroke-width="3" />
                    <line x1="150" y1="60" x2="306" y2="28" stroke="var(--accent)" stroke-width="3" />
                    <line x1="150" y1="60" x2="306" y2="92" stroke="var(--error)" stroke-width="3" />
                    <line class="tl-blade tl-blade-a" x1="150" y1="60" x2="172" y2="55.5" stroke="var(--text-primary)" stroke-width="4.5" stroke-linecap="round" opacity="0" />
                    <line class="tl-blade tl-blade-b" x1="150" y1="60" x2="172" y2="64.5" stroke="var(--text-primary)" stroke-width="4.5" stroke-linecap="round" />
                    <g class="tl-fig tl-fig-a">@Figures(Count(dilemma.OptionACost), 294, 31, -6.6, 1.35)</g>
                    <g class="tl-fig tl-fig-b">@Figures(Count(dilemma.OptionBCost), 294, 89, -6.6, -1.35)</g>
                    <g><text x="300" y="16" text-anchor="end" font-size="10" fill="var(--text-muted)">@dilemma.OptionACost</text></g>
                    <g><text x="300" y="112" text-anchor="end" font-size="10" fill="var(--text-muted)">@dilemma.OptionBCost</text></g>
                    <g class="tl-lever" transform="translate(122 104)">
                        <rect x="-9" y="-2" width="18" height="6" rx="2" fill="var(--text-muted)" />
                        <g class="tl-lever-arm" transform="rotate(-32)">
                            <line x1="0" y1="0" x2="0" y2="-22" stroke="var(--text-secondary)" stroke-width="2.5" stroke-linecap="round" />
                            <circle cx="0" cy="-23" r="3.6" fill="var(--accent)" />
                        </g>
                    </g>
                }
                <g class="tl-trolley" transform="@(bridge ? "translate(30 70)" : "translate(30 60)")">
                    <rect x="-13" y="-17" width="26" height="13" rx="3" fill="var(--primary)" />
                    <rect x="-9" y="-14" width="18" height="5" rx="1.5" fill="var(--bg-card)" opacity="0.85" />
                    <circle cx="-7" cy="-2.5" r="2.6" fill="var(--text-primary)" />
                    <circle cx="7" cy="-2.5" r="2.6" fill="var(--text-primary)" />
                </g>
            </svg>
        </div>
    }
    else
    {
        <p class="tl-stakes">At stake: @dilemma.OptionACost (first option) versus @dilemma.OptionBCost (second option).</p>
    }

    @if (verdict == null)
    {
        <div class="tl-actions">
            <button class="btn btn-accent" @onclick="() => Choose(0)">@dilemma.OptionA</button>
            <button class="btn btn-outline" @onclick="() => Choose(1)">@dilemma.OptionB</button>
        </div>
    }
    else
    {
        var baseDelay = dilemma.Tracks ? 1.7 : 0.1;
        <div class="tl-result" style="@($"--tl-base:{Sec(baseDelay)}")">
            <strong>You chose: @(verdict == 0 ? dilemma.OptionA : dilemma.OptionB)</strong>
            <p>@dilemma.Resolution</p>
            <div class="tl-frames">
                @for (int f = 0; f < FrameworkNames.Length; f++)
                {
                    <div class="tl-frame" style="@($"--tl-d:{Sec(baseDelay + 0.14 * f)}")">
                        <div class="tl-frame-head">
                            <span>@FrameworkNames[f]</span>
                            <strong class="tl-stamp tl-stamp-@LeanKind(dilemma, f, verdict.Value)">@LeanText(dilemma, f, verdict.Value)</strong>
                        </div>
                        <p>@dilemma.Why[f]</p>
                    </div>
                }
            </div>
            <button class="btn btn-primary" style="margin-top:12px;width:100%" @onclick="Next">@(index < dilemmas.Count - 1 ? "Next dilemma" : "See profile")</button>
        </div>
    }

    @if (picks.Count > 0)
    {
        <button class="btn btn-outline tl-undo" @onclick="Undo">Undo (back one dilemma)</button>
    }
</div>

@if (showProfile)
{
    <div class="card tl-profile">
        <h3>Your ethical profile</h3>
        <p class="tl-stakes">How often your choices matched what each framework tends to favor. Dilemmas where a framework is divided are not counted for it.</p>
        <div class="tl-bars">
            @foreach (var (label, agree, total) in Scores())
            {
                <div class="tl-bar-row">
                    <span>@label</span>
                    <div class="tl-bar"><div class="tl-bar-fill" style="@($"width:{(total == 0 ? 0 : agree * 100 / total)}%")"></div></div>
                    <strong>@agree / @total</strong>
                </div>
            }
        </div>
        <button class="btn btn-outline" style="margin-top:12px;width:100%" @onclick="Reset">Restart</button>
    </div>
}

@code {
    private static readonly string[] FrameworkNames = { "Utilitarian", "Deontological", "Virtue", "Contractualist" };

    private int index;
    private int? verdict;
    private ElementReference trackSvg;
    private bool animatePending;
    private bool showProfile;
    private readonly List<int> picks = new();

    private void Choose(int v)
    {
        verdict = v;
        picks.Add(v);
        animatePending = true;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!animatePending || verdict is not int v) return;
        animatePending = false;
        var d = dilemmas[index];
        try
        {
            if (d.Tracks) await JS.InvokeVoidAsync("TrolleyLab.run", trackSvg, d.OptionA.StartsWith("Push") ? "bridge" : "switch", v);
            var kinds = Enumerable.Range(0, FrameworkNames.Length).Select(f => LeanKind(d, f, v)).ToArray();
            await JS.InvokeVoidAsync("TrolleyLab.verdicts", kinds, d.Tracks ? 1.7 : 0.1);
        }
        catch (JSException) { }
    }

    private static string LeanKind(Dilemma d, int f, int pick) => d.Lean[f] is not int lean ? "divided" : lean == pick ? "agrees" : "differs";

    private static int Count(string cost) => int.TryParse(new string(cost.TakeWhile(char.IsDigit).ToArray()), out var n) ? Math.Clamp(n, 1, 5) : 1;

    private static string N(double v) => v.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture);
    private static string Sec(double s) => N(s) + "s";

    private static RenderFragment Sleepers(double x1, double y1, double x2, double y2) => __builder =>
    {
        for (double x = x1 + 4; x < x2; x += 9)
        {
            var y = y1 + (y2 - y1) * (x - x1) / (x2 - x1);
            <line x1="@N(x)" y1="@N(y - 4)" x2="@N(x)" y2="@N(y + 4)" stroke="var(--border)" stroke-width="2" />
        }
    };

    // n small figures from (x, y), each the next step (dx, dy) along the track.
    private static RenderFragment Figures(int n, double x, double y, double dx, double dy) => __builder =>
    {
        for (int i = 0; i < n; i++)
        {
            <circle cx="@N(x + dx * i)" cy="@N(y + dy * i)" r="3.4" />
        }
    };

    private void Next()
    {
        if (index < dilemmas.Count - 1) { index++; verdict = null; }
        else showProfile = true;
    }

    private void Undo()
    {
        if (picks.Count == 0) return;
        if (verdict == null) index--;
        picks.RemoveAt(picks.Count - 1);
        verdict = null;
        showProfile = false;
    }

    private void Reset() { index = 0; verdict = null; showProfile = false; picks.Clear(); }

    private static string LeanText(Dilemma d, int f, int pick)
    {
        var lean = d.Lean[f];
        if (lean == null) return "Divided";
        return lean == pick ? "Agrees with you" : "Differs from you";
    }

    private List<(string, int, int)> Scores()
    {
        var result = new List<(string, int, int)>();
        for (int f = 0; f < FrameworkNames.Length; f++)
        {
            int agree = 0, total = 0;
            for (int i = 0; i < picks.Count; i++)
            {
                var lean = dilemmas[i].Lean[f];
                if (lean == null) continue;
                total++;
                if (picks[i] == lean) agree++;
            }
            result.Add((FrameworkNames[f], agree, total));
        }
        return result;
    }

    // Lean and Why are indexed utilitarian, deontological, virtue, contractualist; null lean = divided.
    private record Dilemma(string Title, string Prompt, string OptionA, string OptionB,
        string OptionACost, string OptionBCost, bool Tracks, int?[] Lean, string[] Why, string Resolution);

    private static readonly List<Dilemma> dilemmas = new()
    {
        new("The Switch", "A runaway trolley will kill <strong>five</strong> workers. You can pull a lever to divert it to a side track where it kills <strong>one</strong>.",
            "Pull the lever", "Do nothing", "1 dies", "5 die", true,
            new int?[] { 0, null, null, 0 },
            new[]
            {
                "Five lives outweigh one, so divert.",
                "Divided: the death is a foreseen side effect, not your means, so many deontologists permit it; strict ones still object to killing.",
                "Divided: acting decisively to save five can be compassion, but taking a life by choice can also be a vice.",
                "Few would reject a rule that lets the lever be pulled, since anyone could be one of the five."
            },
            "Most people pull. Utilitarians say yes. Many deontologists also allow it, because the death is a side effect rather than the means (the doctrine of double effect). Foot's 1967 case had a tram driver steering; the bystander at a lever is Thomson's (1976, 1985) version."),
        new("The Footbridge", "Same trolley, five workers. The only way to stop it is to push a <strong>large stranger</strong> off a footbridge into its path. His mass will stop it.",
            "Push the stranger", "Do nothing", "1 dies (by your hand)", "5 die", true,
            new int?[] { 0, 1, 1, 1 },
            new[]
            {
                "The sums are the same as the Switch: five outweigh one.",
                "Using the stranger's body as a means to save others treats him as a mere tool.",
                "Shoving someone to his death is callous; a person of good character recoils.",
                "A principle allowing people to be used as stopping devices is one no one could accept."
            },
            "Most people refuse. The arithmetic matches the Switch, but here the victim's death is the means of saving the five, not a side effect. Greene's account points instead to the personal force of pushing."),
        new("The Surgeon", "Five patients will die without organ transplants. A healthy traveler walks in for a checkup. Their organs would save all five.",
            "Harvest organs", "Let five die", "1 dies", "5 die", false,
            new int?[] { 0, 1, 1, 1 },
            new[]
            {
                "The bare sums favor harvesting, though rule utilitarians stress the damage to trust in medicine.",
                "It treats a patient as spare parts and violates the duty not to kill.",
                "It betrays the trust and care that define a doctor's role.",
                "No one could accept a medical system that might sacrifice them; the objection is strongest here."
            },
            "Almost no one accepts this. The sums look utilitarian, but trust in institutions collapses if surgeons calculate."),
        new("The Crying Baby", "Soldiers will find your hiding village if they hear a sound. Your baby cries. You can smother her, or all 30 villagers, including her, will be killed.",
            "Smother the baby", "Risk discovery", "1 dies", "30 die", false,
            new int?[] { 0, null, null, null },
            new[]
            {
                "One death rather than thirty, and the baby likely dies either way.",
                "Divided: killing an innocent is forbidden, but some argue she would die regardless and the soldiers are the killers.",
                "Divided: it is hard to say what a loving, courageous person does here; many call it tragic rather than right.",
                "Divided: reasonable principles pull in opposite directions."
            },
            "An impossible choice, familiar from M*A*S*H and used in Greene and colleagues' fMRI studies of moral judgment. The act feels monstrous; the alternative is worse. Philosophers disagree over whether it is permitted or merely tragic."),
        new("Ticking Bomb", "A captured terrorist knows where a bomb is hidden that will kill thousands. Torture might extract the location.",
            "Authorize torture", "Refuse torture", "1 person harmed", "Thousands at risk", false,
            new int?[] { null, 1, 1, 1 },
            new[]
            {
                "Divided: the thought experiment favors torture, but real-world effects (unreliable information, abuse, lost trust) lead many utilitarians to reject it.",
                "Torture violates a person's dignity; many deontologists treat the ban as absolute.",
                "Deliberate cruelty corrodes the character of the people and institutions that practise it.",
                "A rule allowing torture could be abused against anyone, so it is hard to justify to all."
            },
            "Philosophical versions stipulate that the information is guaranteed, which is the trick. In practice, reviews of real interrogation programs, including the 2014 US Senate Intelligence Committee report, found little evidence that torture produced intelligence that could not be obtained otherwise. Most ethicists reject the framing."),
        new("Self-Driving Car", "A self-driving car must choose: hit five jaywalking pedestrians, or swerve into a wall, killing its single passenger.",
            "Save pedestrians (kill passenger)", "Save passenger (hit pedestrians)", "1 dies", "5 die", false,
            new int?[] { 0, null, null, null },
            new[]
            {
                "Minimise deaths: one passenger rather than five pedestrians.",
                "Divided: swerving deliberately kills the passenger, while staying the course kills the pedestrians; the doing/allowing line is unclear for a programmed car.",
                "Divided: the designer must weigh care for the passenger against responsibility to others.",
                "Divided: pedestrians and passengers can each claim a fair rule favors them, and jaywalking adds a further complication."
            },
            "Bonnefon, Shariff and Rahwan (Science, 2016) found people approve of cars that sacrifice their passenger for the greater number, but prefer to buy cars that protect them. The Moral Machine experiment (Awad et al., Nature, 2018) later collected millions of such judgments worldwide. Markets respond accordingly."),
        new("Famine Relief", "Charity evaluators estimate that a few thousand dollars can save a child's life from preventable disease. You could donate that amount, or spend it on something for yourself.",
            "Donate", "Keep the money", "Several thousand dollars", "A child's life at risk", false,
            new int?[] { 0, null, 0, 0 },
            new[]
            {
                "A child's life is worth far more than the comfort the money would buy.",
                "Divided: there is a duty of beneficence, but how demanding it is, and whether it is owed in this specific case, is disputed.",
                "Generosity and compassion are virtues; ignoring a child you could easily help is a vice.",
                "Few could reject a modest principle of rescue when the cost to you is small."
            },
            "Peter Singer's drowning child argument extends to this. Early versions (Unger and Singer in the 1990s) quoted figures near $200 per life; current estimates are several thousand dollars. Almost everyone says donating is right, almost no one consistently does it. Demandingness is the deepest objection to utilitarianism."),
        new("Lying Murderer", "A killer asks where your friend is hiding. You know. The killer will believe whatever you say.",
            "Lie", "Tell the truth", "Friend lives", "Friend dies", false,
            new int?[] { 0, 1, 0, 0 },
            new[]
            {
                "Saving a life far outweighs the small harm of a lie.",
                "Kant held that lying is wrong even here, though many later deontologists disagree.",
                "Honesty does not oblige you to help a murderer; loyalty and courage point to lying.",
                "No one could reasonably demand that you hand over a victim to a killer."
            },
            "Kant famously said you must not lie even here. Almost everyone disagrees. Some Kantians have spent two centuries trying to rescue him from his own example.")
    };
}

<style>
    .tl-intro { display: flex; align-items: flex-start; gap: 12px; padding: 14px; }
    .tl-intro p { margin: 0; font-size: 0.9rem; color: var(--text-secondary); line-height: 1.5; }

    .tl-dilemma { padding: 16px; }
    .tl-tag { display: inline-block; padding: 3px 10px; background: color-mix(in srgb, var(--primary) 10%, transparent); color: var(--primary); border-radius: 10px; font-size: 0.75rem; font-weight: 700; margin-bottom: 10px; }
    .tl-prompt { font-size: 0.95rem; line-height: 1.55; color: var(--text-primary); margin: 0 0 14px; }

    .tl-svg { width: 100%; height: auto; max-width: 360px; display: block; margin: 0 auto 12px; }
    .tl-actions { display: flex; gap: 8px; }
    .tl-actions button { flex: 1; }

    .tl-fig-a circle { fill: var(--accent); }
    .tl-fig-b circle { fill: var(--error); }
    .tl-fig { transition: opacity 0.6s ease; }
    .tl-fig-dim { opacity: 0.28; }
    .tl-stranger { transform-box: fill-box; transform-origin: center; }

    .tl-result > strong, .tl-result > p { animation: tl-rise 0.35s ease-out both; animation-delay: var(--tl-base, 0s); }
    .tl-result strong { display: block; font-size: 0.95rem; margin-bottom: 6px; }
    .tl-result p { font-size: 0.85rem; color: var(--text-secondary); line-height: 1.55; margin: 0 0 12px; }
    .tl-frames { display: flex; flex-direction: column; gap: 6px; perspective: 700px; }
    .tl-frame { background: var(--bg-surface); padding: 8px 10px; border-radius: var(--radius-sm);
        transform-origin: 50% 0; animation: tl-flip 0.42s cubic-bezier(.2,.8,.3,1.15) both; animation-delay: var(--tl-d, 0s); }
    .tl-stamp { display: inline-block; padding: 1px 7px; border: 1.5px solid currentColor; border-radius: 4px; text-transform: uppercase;
        letter-spacing: 0.04em; font-size: 0.66rem !important; transform: rotate(-3deg);
        animation: tl-stamp 0.3s cubic-bezier(.3,1.6,.5,1) both; animation-delay: calc(var(--tl-d, 0s) + 0.2s); }
    .tl-result .tl-stamp-agrees { color: var(--success); }
    .tl-result .tl-stamp-differs { color: var(--error); }
    .tl-result .tl-stamp-divided { color: var(--text-muted); }
    @@keyframes tl-flip { from { opacity: 0; transform: rotateX(-80deg); } to { opacity: 1; transform: none; } }
    @@keyframes tl-stamp { from { opacity: 0; transform: scale(1.9) rotate(-10deg); } to { opacity: 1; transform: rotate(-3deg); } }
    @@keyframes tl-rise { from { opacity: 0; transform: translateY(6px); } to { opacity: 1; transform: none; } }
    .tl-frame-head { display: flex; justify-content: space-between; align-items: baseline; gap: 8px; margin-bottom: 2px; }
    .tl-frame-head span { font-size: 0.75rem; font-weight: 700; color: var(--text-muted); }
    .tl-result .tl-frame-head strong { font-size: 0.8rem; margin: 0; color: var(--text-primary); }
    .tl-result .tl-frame p { font-size: 0.78rem; margin: 0; }
    .tl-stakes { font-size: 0.8rem; color: var(--text-muted); margin: 0 0 12px; }
    .tl-undo { margin-top: 8px; width: 100%; }

    .tl-profile { padding: 16px; }
    .tl-profile h3 { margin: 0 0 12px; font-size: 1rem; }
    .tl-bars { display: flex; flex-direction: column; gap: 10px; }
    .tl-bar-row { display: grid; grid-template-columns: 100px 1fr 44px; align-items: center; gap: 8px; font-size: 0.8rem; }
    .tl-bar { height: 8px; background: var(--bg-surface); border-radius: 4px; overflow: hidden; }
    .tl-bar-fill { height: 100%; background: var(--accent); transition: width 0.4s ease; }
    .tl-bar-row strong { text-align: right; font-weight: 700; color: var(--primary); }

    @@media (prefers-reduced-motion: reduce) {
        .tl-bar-fill, .tl-fig { transition: none; }
        .tl-frame, .tl-stamp, .tl-result > strong, .tl-result > p { animation: none; }
    }
</style>
