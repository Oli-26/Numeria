@page "/whats-new"
@using System.Net.Http.Json
@using System.Globalization
@inject HttpClient Http
@inject NavigationManager Nav
@inject IJSRuntime JS

<div class="page-header">
    <button class="back-btn" aria-label="Back to settings" @onclick='() => Nav.NavigateTo("/settings")'><Icon Name="arrow-left" Size="18" /></button>
    <h1>What's New</h1>
</div>

@if (entries == null)
{
    <div class="loading">Loading updates...</div>
}
else
{
    <div class="wn-list">
        @foreach (var e in entries)
        {
            var isCurrent = current != null && WhatsNew.Compare(e.Version, current) == 0;
            <section class="card wn-release @(isCurrent ? "current" : "")">
                <div class="wn-release-head">
                    <span class="wn-version">@WhatsNew.Short(e.Version)</span>
                    <span class="wn-date">@FormatDate(e.Date)</span>
                    @if (isCurrent)
                    {
                        <span class="wn-yours">Your version</span>
                    }
                </div>
                <h2>@e.Title</h2>
                <ul>
                    @foreach (var item in e.Items)
                    {
                        <li>
                            @item.Text
                            @if (item.Link != null)
                            {
                                <button class="wn-go" @onclick="() => Nav.NavigateTo(item.Link)">@(item.Action ?? "Take a look") <Icon Name="chevron-right" Size="14" /></button>
                            }
                        </li>
                    }
                </ul>
            </section>
        }
    </div>
}

@code {
    private List<WhatsNewEntry>? entries;
    private string? current;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var all = await Http.GetFromJsonAsync<List<WhatsNewEntry>>("data/whatsnew.json") ?? new();
            entries = all.OrderByDescending(e => e, Comparer<WhatsNewEntry>.Create((a, b) => WhatsNew.Compare(a.Version, b.Version))).ToList();
        }
        catch (Exception ex)
        {
            entries = new();
            await JS.LogErrorAsync("WhatsNewPage.load", ex);
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        try
        {
            var native = await JS.InvokeAsync<string?>("appVersion");
            if (native != null) { current = WhatsNew.Clean(native); StateHasChanged(); }
        }
        catch { /* the web build has no installed version to mark */ }
    }

    private static string FormatDate(string iso) =>
        DateTime.TryParseExact(iso, "yyyy-MM-dd", CultureInfo.InvariantCulture, DateTimeStyles.None, out var d)
            ? d.ToString("MMM d, yyyy", CultureInfo.InvariantCulture) : iso;   // the app runs in invariant mode: no named cultures
}

<style>
    .wn-list { display: flex; flex-direction: column; gap: 12px; }
    .wn-release h2 { font-size: 1.1rem; margin: 2px 0 8px; }
    .wn-release.current { border-color: var(--primary); }
    .wn-release-head { display: flex; align-items: baseline; gap: 10px; flex-wrap: wrap; }
    .wn-version { font-weight: 800; color: var(--primary); font-variant-numeric: tabular-nums; }
    .wn-date { color: var(--text-muted); font-size: 0.82rem; }
    .wn-yours {
        margin-left: auto; font-size: 0.72rem; font-weight: 700; letter-spacing: 0.04em; text-transform: uppercase;
        color: var(--on-primary); background: var(--primary); padding: 2px 8px; border-radius: 999px;
    }
    .wn-release ul { margin: 0; padding-left: 1.2em; color: var(--text-secondary); line-height: 1.55; font-size: 0.92rem; }
    .wn-release li { margin-bottom: 6px; }
    .wn-release li::marker { color: var(--primary); }
    .wn-release .wn-go { display: flex; }
</style>
