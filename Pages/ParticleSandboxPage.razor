@page "/particle-sandbox"
@inject NavigationManager Nav

<div class="page-header">
    <button class="back-btn" aria-label="Back to home" @onclick='() => Nav.NavigateTo("/")'><Icon Name="arrow-left" Size="18" /></button>
    <h1>Particle Sandbox</h1>
</div>

<p class="ps-intro">Pick a beam, a target and a collision energy, then smash them together. Each result shows what comes out and checks that charge, lepton number and baryon number balance.</p>

<div class="ps-layout">
    <div class="ps-main">
        <div class="card ps-config">
            <div class="ps-row">
                <label class="ps-label"><Icon Name="zap" Size="16" /> Beam</label>
                <div class="ps-chips">
                    @foreach (var b in ParticleSandbox.Beams)
                    {
                        var bb = b;
                        var col = Col(bb.Particle);
                        <button class="ps-chip @(beam == bb.Id ? "ps-chip-active" : "")"
                                style="@(beam == bb.Id ? $"border-color:{col};color:{col}" : "")"
                                @onclick="() => Pick(bb.Id, target)">
                            <span class="ps-dot" style="background:@col"></span>@bb.Label
                        </button>
                    }
                </div>
            </div>

            <div class="ps-row">
                <label class="ps-label"><Icon Name="target" Size="16" /> Target</label>
                <div class="ps-chips">
                    @foreach (var tg in ParticleSandbox.Targets)
                    {
                        var tt = tg;
                        var col = Col(tt.Particle);
                        <button class="ps-chip @(target == tt.Id ? "ps-chip-active" : "")"
                                style="@(target == tt.Id ? $"border-color:{col};color:{col}" : "")"
                                @onclick="() => Pick(beam, tt.Id)">
                            <span class="ps-dot" style="background:@col"></span>@tt.Label
                        </button>
                    }
                </div>
            </div>

            <div class="ps-row">
                <label class="ps-label"><Icon Name="rocket" Size="16" /> Collision energy</label>
                <div class="ps-chips">
                    @foreach (var bd in ParticleSandbox.Bands)
                    {
                        var band = bd;
                        var ok = ParticleSandbox.Lookup(beam, target, band).Hit != null;
                        <button class="ps-chip @(ok && energy == band ? "ps-chip-active" : "") @(ok ? "" : "ps-chip-off")"
                                disabled="@(!ok)"
                                @onclick="() => { energy = band; result = null; }">
                            @ParticleSandbox.BandLabel(band)
                        </button>
                    }
                </div>
                @{
                    var off = ParticleSandbox.Bands
                        .Select(b => (Band: b, Why: ParticleSandbox.Lookup(beam, target, b).Reason))
                        .Where(x => x.Why != null).ToList();
                }
                @if (off.Count > 0)
                {
                    <ul class="ps-off-list">
                        @foreach (var o in off)
                        {
                            <li><strong>@ParticleSandbox.BandLabel(o.Band) unavailable:</strong> @o.Why</li>
                        }
                    </ul>
                }
                <p class="ps-note">Collision energy is the kinetic energy available in the centre-of-mass frame. For a heavy target such as an atom it is about the beam's energy; with a light target at rest, much of the beam's energy goes into moving the debris forward, which is why big colliders aim two beams at each other.</p>
            </div>

            <button class="btn btn-primary btn-lg ps-collide-btn" @onclick="Collide">
                <Icon Name="fire" Size="18" /> Collide!
            </button>
        </div>

        @if (result != null)
        {
            var c = result;
            var after = c.Outcome.After;
            var before = c.Before;
            var tb = ParticleSandbox.Sum(before);
            var ta = ParticleSandbox.Sum(after);
            var heavyTarget = c.Target == "atom";
            var beamCol = Col(before[0]);
            var targetCol = Col(before[1]);
            <div class="card ps-result" @key="resultKey">
                <h3 class="ps-result-title">@c.Outcome.Title</h3>
                <p class="ps-setup">@c.Setup</p>

                <div class="ps-svg-wrap">
                    <svg viewBox="0 0 400 200" class="ps-svg" preserveAspectRatio="xMidYMid meet"
                         role="img" aria-label="@ParticleSandbox.Equation(before, after)">
                        <defs>
                            <radialGradient id="vertexGlow">
                                <stop offset="0%" stop-color="var(--accent)" stop-opacity="1" />
                                <stop offset="100%" stop-color="var(--accent)" stop-opacity="0" />
                            </radialGradient>
                        </defs>

                        <line class="ps-axis" x1="0" y1="100" x2="400" y2="100" />

                        <line class="@(before[0].Charge3 == 0 ? "ps-in-line-neutral" : "ps-in-line")" x1="0" y1="100" x2="200" y2="100"
                              stroke="@beamCol" stroke-width="2" stroke-dasharray="@(before[0].Charge3 == 0 ? "5 4" : null)" />
                        <circle class="ps-in-dot ps-in-left" cx="0" cy="100" r="6" fill="@beamCol" />

                        @if (heavyTarget)
                        {
                            <circle class="ps-target-atom" cx="216" cy="100" r="7" fill="@targetCol" />
                        }
                        else
                        {
                            <line class="@(before[1].Charge3 == 0 ? "ps-in-line-neutral" : "ps-in-line")" x1="400" y1="100" x2="200" y2="100"
                                  stroke="@targetCol" stroke-width="2" />
                            <circle class="ps-in-dot ps-in-right" cx="400" cy="100" r="6" fill="@targetCol" />
                        }

                        <circle class="ps-vertex" cx="200" cy="100" r="30" fill="url(#vertexGlow)" />
                        <circle class="ps-vertex-core" cx="200" cy="100" r="6" fill="var(--accent)" />

                        @for (int i = 0; i < c.Outcome.Tracks.Count; i++)
                        {
                            var tr = c.Outcome.Tracks[i];
                            var sh = ParticleSandboxGeometry.Shape(tr, c.Band);
                            var col = Col(tr.P);
                            var delay = $"animation-delay:{(1.0 + i * 0.08).ToString("F2", System.Globalization.CultureInfo.InvariantCulture)}s";
                            <g>
                                @switch (sh.Style)
                                {
                                    case TrackStyle.Charged:
                                        <path class="ps-trk" d="@sh.Path" stroke="@col" stroke-width="2" fill="none" pathLength="1" style="@delay" />
                                        break;
                                    case TrackStyle.Neutral:
                                        <path class="ps-trk-fade" d="@sh.Path" stroke="@col" stroke-width="2" stroke-dasharray="5 4" fill="none" style="@delay" />
                                        break;
                                    case TrackStyle.Jet:
                                        <path class="ps-trk-fade" d="@sh.Path" stroke="@col" stroke-width="1.5" fill="@col" fill-opacity="0.25" style="@delay" />
                                        break;
                                    default:
                                        <path class="ps-trk-fade" d="@sh.Path" stroke="@col" stroke-width="5" stroke-linecap="round" fill="none" style="@delay" />
                                        break;
                                }
                                <text class="ps-trk-label" x="@ParticleSandboxGeometry.F(sh.LabelX)" y="@ParticleSandboxGeometry.F(sh.LabelY)"
                                      fill="@col" text-anchor="middle" dominant-baseline="middle">@tr.P.Symbol</text>
                            </g>
                        }
                    </svg>
                </div>
                <p class="ps-legend">Centre-of-mass view, with a magnetic field out of the screen: positive tracks bend clockwise, negative ones anticlockwise, and faster ones bend less. Dashed lines are neutral particles, which leave no track (drawn only to show where they go). Cones are jets of hadrons; short thick stubs are heavy recoils.</p>

                <h4 class="ps-section-h">Conservation check</h4>
                <p class="ps-equation">@ParticleSandbox.Equation(before, after)</p>
                <div class="ps-ledger-wrap">
                    <table class="ps-ledger">
                        <thead>
                            <tr><th></th><th>Charge</th><th>Lepton no.</th><th>Baryon no.</th></tr>
                        </thead>
                        <tbody>
                            <tr class="ps-ledger-group"><td colspan="4">Before</td></tr>
                            @foreach (var pt in before)
                            {
                                @Row(pt)
                            }
                            <tr class="ps-ledger-total">
                                <td>Total</td><td>@ParticleSandbox.Thirds(tb.Charge3)</td><td>@ParticleSandbox.Signed(tb.Lepton)</td><td>@ParticleSandbox.Thirds(tb.Baryon3)</td>
                            </tr>
                            <tr class="ps-ledger-group"><td colspan="4">After</td></tr>
                            @foreach (var pt in after)
                            {
                                @Row(pt)
                            }
                            <tr class="ps-ledger-total">
                                <td>Total</td><td>@ParticleSandbox.Thirds(ta.Charge3)</td><td>@ParticleSandbox.Signed(ta.Lepton)</td><td>@ParticleSandbox.Thirds(ta.Baryon3)</td>
                            </tr>
                            <tr class="ps-ledger-check">
                                <td>Conserved</td>
                                <td>@Tick(tb.Charge3 == ta.Charge3)</td>
                                <td>@Tick(tb.Lepton == ta.Lepton)</td>
                                <td>@Tick(tb.Baryon3 == ta.Baryon3)</td>
                            </tr>
                        </tbody>
                    </table>
                </div>
                <p class="ps-ledger-note">Quarks carry charge in thirds and baryon number 1/3 each; an atom's lepton number counts its electrons.</p>

                <h4 class="ps-section-h">Products</h4>
                <ul class="ps-products">
                    @foreach (var prod in c.Outcome.Products)
                    {
                        <li>
                            <span class="ps-prod-dot" style="background:@Col(prod.P)"></span>
                            <strong>@prod.P.Symbol</strong><span class="ps-prod-name">@prod.P.Name</span>
                            <span class="ps-prod-desc">@prod.Description</span>
                        </li>
                    }
                </ul>

                <h4 class="ps-section-h">What happened</h4>
                <p class="ps-explain">@c.Outcome.Explanation</p>

                @if (c.Outcome.Also.Count > 0)
                {
                    <h4 class="ps-section-h">Also possible</h4>
                    <ul class="ps-also">
                        @foreach (var r in c.Outcome.Also)
                        {
                            var rb = ParticleSandbox.Sum(r.Before);
                            var ra = ParticleSandbox.Sum(r.After);
                            <li>
                                <span class="ps-also-eq">@ParticleSandbox.Equation(r.Before, r.After)</span>
                                <span class="ps-also-note">@r.Note</span>
                                <span class="ps-also-check">
                                    <span>Q @ParticleSandbox.Thirds(rb.Charge3) → @ParticleSandbox.Thirds(ra.Charge3) @Tick(rb.Charge3 == ra.Charge3)</span>
                                    <span>L @ParticleSandbox.Signed(rb.Lepton) → @ParticleSandbox.Signed(ra.Lepton) @Tick(rb.Lepton == ra.Lepton)</span>
                                    <span>B @ParticleSandbox.Thirds(rb.Baryon3) → @ParticleSandbox.Thirds(ra.Baryon3) @Tick(rb.Baryon3 == ra.Baryon3)</span>
                                </span>
                            </li>
                        }
                    </ul>
                }
            </div>
        }
        else
        {
            <div class="card ps-placeholder">
                <Icon Name="brain" Size="32" Stroke="var(--text-muted)" />
                <p>Pick a beam, target and energy, then press Collide.</p>
            </div>
        }
    </div>

    <aside class="ps-side">
        <div class="card ps-history">
            <h4 class="ps-section-h"><Icon Name="dice" Size="14" /> Recent Collisions</h4>
            @if (history.Count == 0)
            {
                <p class="ps-history-empty">No collisions yet.</p>
            }
            else
            {
                <ul class="ps-history-list">
                    @foreach (var h in history)
                    {
                        <li>
                            <strong>@h.Title</strong>
                            <small>@h.Setup</small>
                        </li>
                    }
                </ul>
            }
        </div>
    </aside>
</div>

@code {
    private string beam = "e-";
    private string target = "e-";
    private Band energy = Band.KeV;

    private Collision? result;
    private int resultKey;
    private readonly List<HistoryEntry> history = new();

    private void Pick(string newBeam, string newTarget)
    {
        beam = newBeam;
        target = newTarget;
        result = null;
        if (ParticleSandbox.Lookup(beam, target, energy).Hit == null)
            energy = ParticleSandbox.Bands.First(b => ParticleSandbox.Lookup(beam, target, b).Hit != null);
    }

    private void Collide()
    {
        var hit = ParticleSandbox.Lookup(beam, target, energy).Hit;
        if (hit == null) return;
        result = hit;
        resultKey++;

        var setup = $"{Label(ParticleSandbox.Beams, beam)} + {Label(ParticleSandbox.Targets, target)} · {ParticleSandbox.BandLabel(energy)}";
        history.Insert(0, new HistoryEntry(hit.Outcome.Title, setup));
        if (history.Count > 5) history.RemoveAt(history.Count - 1);
    }

    private RenderFragment Row(Particle p) =>
        @<tr>
            <td><span class="ps-prod-dot" style="background:@Col(p)"></span><strong>@p.Symbol</strong> <span class="ps-prod-name">@p.Name</span></td>
            <td>@ParticleSandbox.Thirds(p.Charge3)</td>
            <td>@ParticleSandbox.Signed(p.Lepton)</td>
            <td>@ParticleSandbox.Thirds(p.Baryon3)</td>
        </tr>;

    private static RenderFragment Tick(bool ok) =>
        @<span class="ps-tick" aria-label="@(ok ? "conserved" : "not conserved")"><Icon Name="@(ok ? "check" : "x-mark")" Size="14" Stroke="@(ok ? "var(--success)" : "var(--error)")" StrokeWidth="3" /></span>;

    private static string Label(IReadOnlyList<Choice> list, string id) => list.First(c => c.Id == id).Label;

    private static string Col(Particle p) => p.Kind switch
    {
        PKind.Electron => "#4A90D9",
        PKind.Muon => "#E84393",
        PKind.Neutrino => "#9B59B6",
        PKind.Photon => "#D4A017",
        PKind.Nucleon => "#E74C3C",
        PKind.Meson => "#F08A24",
        PKind.Quark => "#27AE60",
        PKind.Gluon => "#8BC34A",
        PKind.Remnant => "#B08968",
        PKind.Boson => "#C0392B",
        _ => "#7F8C8D",
    };

    private record HistoryEntry(string Title, string Setup);
}

<style>
    .ps-intro { color: var(--text-secondary); font-size: 0.9rem; margin: 0 0 14px; }

    .ps-layout { display: grid; grid-template-columns: 1fr; gap: 14px; }
    @@media (min-width: 760px) {
        .ps-layout { grid-template-columns: 1fr 240px; }
    }

    .ps-main { display: flex; flex-direction: column; gap: 14px; min-width: 0; }
    .ps-side { display: flex; flex-direction: column; gap: 14px; }

    .ps-config { padding: 14px 16px; }
    .ps-row { margin-bottom: 12px; }
    .ps-label {
        display: flex; align-items: center; gap: 6px; font-size: 0.78rem;
        text-transform: uppercase; letter-spacing: 0.6px; color: var(--text-muted);
        font-weight: 700; margin-bottom: 6px;
    }
    .ps-chips { display: flex; flex-wrap: wrap; gap: 6px; }
    .ps-chip {
        display: inline-flex; align-items: center; gap: 6px;
        padding: 6px 10px; border: 1px solid var(--border); background: var(--bg-card);
        color: var(--text-secondary); border-radius: 999px; font-size: 0.82rem; font-weight: 600;
        cursor: pointer; transition: all 0.15s ease; -webkit-tap-highlight-color: transparent;
    }
    .ps-chip:active { transform: scale(0.96); }
    .ps-chip-active { background: var(--bg-surface); border-color: var(--primary); color: var(--primary); }
    .ps-chip-off, .ps-chip:disabled { opacity: 0.45; cursor: not-allowed; text-decoration: line-through; }
    .ps-chip:disabled:active { transform: none; }
    .ps-dot { width: 8px; height: 8px; border-radius: 50%; display: inline-block; }

    .ps-off-list { list-style: none; padding: 0; margin: 8px 0 0; display: flex; flex-direction: column; gap: 4px; }
    .ps-off-list li { font-size: 0.78rem; color: var(--text-muted); line-height: 1.4; }
    .ps-off-list strong { color: var(--text-secondary); }
    .ps-note { font-size: 0.76rem; color: var(--text-muted); line-height: 1.45; margin: 8px 0 0; }

    .ps-collide-btn { width: 100%; margin-top: 6px; display: inline-flex; align-items: center; justify-content: center; gap: 8px; }

    .ps-placeholder { text-align: center; padding: 30px 16px; color: var(--text-muted); }
    .ps-placeholder p { margin: 10px 0 0; font-size: 0.88rem; }

    .ps-result { padding: 14px 16px; animation: psFadeIn 0.3s ease; }
    .ps-result-title { margin: 0 0 4px; font-size: 1.05rem; color: var(--text-primary); }
    .ps-setup { margin: 0 0 10px; font-size: 0.82rem; color: var(--text-secondary); line-height: 1.45; }

    .ps-svg-wrap { background: var(--bg-surface); border-radius: var(--radius-sm); padding: 6px; overflow: hidden; }
    .ps-svg { width: 100%; height: auto; display: block; }
    .ps-legend { font-size: 0.74rem; color: var(--text-muted); line-height: 1.45; margin: 6px 0 4px; }

    .ps-axis { stroke: var(--border); stroke-width: 1; stroke-dasharray: 2 4; }

    .ps-in-line { stroke-dasharray: 200; stroke-dashoffset: 200; animation: psDraw 0.7s ease forwards, psDim 0.4s ease 1.1s forwards; }
    .ps-in-line-neutral { opacity: 0; animation: psFade 0.7s ease forwards, psDim 0.4s ease 1.1s forwards; }
    .ps-in-dot { opacity: 0; }
    .ps-in-left { animation: psFlyRight 0.7s linear forwards; }
    .ps-in-right { animation: psFlyLeft 0.7s linear forwards; }
    .ps-target-atom { opacity: 0; animation: psAtom 0.7s ease forwards; }

    .ps-vertex { opacity: 0; transform-origin: 200px 100px; animation: psFlash 0.6s ease 0.7s forwards; }
    .ps-vertex-core { opacity: 0; animation: psCore 0.6s ease 0.7s forwards; }

    .ps-trk { stroke-dasharray: 1; stroke-dashoffset: 1; animation: psDraw 0.8s ease forwards; }
    .ps-trk-fade { opacity: 0; animation: psFade 0.6s ease forwards; }
    .ps-trk-label { font-size: 11px; font-weight: 700; opacity: 0; animation: psFade 0.4s ease 1.6s forwards; }

    .ps-section-h {
        font-size: 0.78rem; color: var(--text-muted); text-transform: uppercase;
        letter-spacing: 0.6px; margin: 14px 0 6px; display: flex; align-items: center; gap: 6px;
    }

    .ps-equation { margin: 0 0 6px; font-size: 0.95rem; font-weight: 700; color: var(--text-primary); }
    .ps-ledger-wrap { overflow-x: auto; }
    .ps-ledger { width: 100%; border-collapse: collapse; font-size: 0.8rem; color: var(--text-secondary); }
    .ps-ledger th { font-size: 0.7rem; text-transform: uppercase; letter-spacing: 0.4px; color: var(--text-muted); font-weight: 700; text-align: right; padding: 4px 6px; }
    .ps-ledger td { padding: 3px 6px; text-align: right; border-top: 1px solid var(--border); }
    .ps-ledger td:first-child, .ps-ledger th:first-child { text-align: left; }
    .ps-ledger-group td { background: var(--bg-surface); font-size: 0.7rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.4px; color: var(--text-muted); text-align: left; }
    .ps-ledger-total td { font-weight: 700; color: var(--text-primary); }
    .ps-ledger-check td { font-weight: 700; color: var(--success); }
    .ps-tick { display: inline-flex; vertical-align: middle; }
    .ps-ledger-note { font-size: 0.74rem; color: var(--text-muted); margin: 6px 0 0; line-height: 1.4; }

    .ps-products { list-style: none; padding: 0; margin: 0; display: flex; flex-direction: column; gap: 8px; }
    .ps-products li {
        background: var(--bg-surface); border-radius: var(--radius-sm); padding: 8px 10px;
        font-size: 0.85rem; color: var(--text-secondary); line-height: 1.45;
    }
    .ps-products strong { color: var(--text-primary); margin-right: 6px; }
    .ps-prod-name { font-size: 0.78rem; color: var(--text-muted); }
    .ps-prod-dot { display: inline-block; width: 8px; height: 8px; border-radius: 50%; margin-right: 8px; vertical-align: middle; }
    .ps-prod-desc { display: block; margin-top: 2px; font-size: 0.82rem; }

    .ps-explain {
        margin: 0; padding: 10px 12px; background: var(--bg-surface);
        border-left: 3px solid var(--primary); border-radius: var(--radius-sm);
        font-size: 0.85rem; color: var(--text-secondary); line-height: 1.55;
    }

    .ps-also { list-style: none; padding: 0; margin: 0; display: flex; flex-direction: column; gap: 8px; }
    .ps-also li { background: var(--bg-surface); border-radius: var(--radius-sm); padding: 8px 10px; font-size: 0.82rem; color: var(--text-secondary); line-height: 1.45; }
    .ps-also-eq { display: block; font-weight: 700; color: var(--text-primary); font-size: 0.88rem; }
    .ps-also-note { display: block; margin-top: 2px; }
    .ps-also-check { display: flex; flex-wrap: wrap; gap: 4px 12px; margin-top: 4px; font-size: 0.74rem; color: var(--text-muted); }
    .ps-also-check span { display: inline-flex; align-items: center; gap: 3px; }

    .ps-history { padding: 12px 14px; }
    .ps-history-empty { color: var(--text-muted); font-size: 0.82rem; margin: 4px 0 0; }
    .ps-history-list { list-style: none; padding: 0; margin: 0; display: flex; flex-direction: column; gap: 6px; }
    .ps-history-list li { padding: 6px 8px; background: var(--bg-surface); border-radius: var(--radius-sm); font-size: 0.8rem; }
    .ps-history-list strong { display: block; color: var(--text-primary); font-size: 0.83rem; }
    .ps-history-list small { color: var(--text-muted); font-size: 0.74rem; }

    @@keyframes psDraw { to { stroke-dashoffset: 0; } }
    @@keyframes psFade { to { opacity: 1; } }
    @@keyframes psDim { from { opacity: 1; } to { opacity: 0.3; } }
    @@keyframes psAtom { to { opacity: 1; transform: translateX(-16px); } }
    @@keyframes psFlyRight {
        0% { opacity: 1; transform: translateX(0); }
        99% { opacity: 1; transform: translateX(200px); }
        100% { opacity: 0; transform: translateX(200px); }
    }
    @@keyframes psFlyLeft {
        0% { opacity: 1; transform: translateX(0); }
        99% { opacity: 1; transform: translateX(-200px); }
        100% { opacity: 0; transform: translateX(-200px); }
    }
    @@keyframes psFlash {
        0% { opacity: 0; transform: scale(0.2); }
        40% { opacity: 1; transform: scale(1.4); }
        100% { opacity: 0; transform: scale(2); }
    }
    @@keyframes psCore {
        0% { opacity: 0; r: 2; }
        40% { opacity: 1; r: 8; }
        100% { opacity: 0; r: 4; }
    }
    @@keyframes psFadeIn {
        from { opacity: 0; transform: translateY(6px); }
        to { opacity: 1; transform: none; }
    }

    /* jump straight to each animation's end state so the drawn tracks still appear */
    @@media (prefers-reduced-motion: reduce) {
        .ps-result, .ps-in-line, .ps-in-line-neutral, .ps-in-left, .ps-in-right, .ps-target-atom,
        .ps-vertex, .ps-vertex-core, .ps-trk, .ps-trk-fade, .ps-trk-label {
            animation-duration: 0.01ms !important; animation-delay: 0s !important;
        }
    }
</style>
