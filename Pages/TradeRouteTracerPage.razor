        box-shadow: inset 0 0 40px rgba(40,20,5,0.4), 0 2px 12px rgba(0,0,0,0.45);
    }

    .trt-route-active {
        animation: trt-dash-flow 4s linear infinite;
    }
    @@media (prefers-reduced-motion: reduce) {
        .trt-route-active { animation: none; }
    }

    @@keyframes trt-dash-flow {
        from { stroke-dashoffset: 0; }
        to { stroke-dashoffset: -30; }
    }

    .trt-city { cursor: pointer; }
    .trt-city circle { transition: r 0.18s ease; }
