@page "/graph"
@inject IProgressService Progress
@inject IContentRepository Content
@inject NavigationManager Nav
@inject IJSRuntime JS
@inject HttpClient Http
@inject IConnectionsService Connections
@implements IAsyncDisposable

<div class="graph-page">
    <div class="graph-header">
        <button class="back-btn" @onclick='() => Nav.NavigateTo("/")'><Icon Name="arrow-left" Size="18" /></button>
        <h1><span class="graph-title-icon"><Icon Name="graph" Size="20" /></span> Knowledge Graph</h1>
        <div class="graph-controls">
            <select class="domain-filter" @onchange="OnLayoutChanged" value="@selectedLayout" title="Layout">
                <option value="force">Force</option>
                <option value="circular">Circular</option>
                <option value="grid">Grid</option>
                <option value="hierarchical">Hierarchical</option>
                <option value="radial">Radial</option>
            </select>
            <select class="domain-filter" @onchange="OnDomainChanged" value="@selectedDomain" title="Filter">
                <option value="all">All Domains</option>
                @foreach (var d in domains)
                {
                    <option value="@d.Id">@d.Name</option>
                }
            </select>
        </div>
    </div>

    <div class="graph-container" id="graph-container">
        <canvas id="topic-graph-canvas"></canvas>

        @if (!graphReady)
        {
            <div class="graph-loading">
                <div class="spinner"></div>
                <p>Building graph…</p>
            </div>
        }

        @if (selectedNodeId != null)
        {
            <div class="node-tooltip card" @onclick="NavigateToSelected">
                <div class="tooltip-color-bar" style="background: @GetNodeColor(selectedNodeId)"></div>
                <div class="tooltip-body">
                    <strong>@GetNodeName(selectedNodeId)</strong>
                    <small>@GetNodeDomain(selectedNodeId)</small>
                    @if (completedTopics.Contains(selectedNodeId))
                    {
                        <span class="tooltip-badge completed"><Icon Name="checkmark-circle" Size="12" /> Completed</span>
                    }
                    else
                    {
                        <span class="tooltip-badge">Tap to study →</span>
                    }
                    @{ var links = LinksFor(selectedNodeId); }
                    @if (links.Count > 0)
                    {
                        <div class="tooltip-links" @onclick:stopPropagation="true">
                            @foreach (var (otherId, edge) in links)
                            {
                                <button class="tooltip-link" @onclick='() => Nav.NavigateTo($"/topic/{otherId}")'>
                                    <span class="tooltip-link-name" style="color: @GetNodeColor(otherId)">
                                        @(edge.Type == "prereq" ? (edge.To == selectedNodeId ? "Needs " : "Leads to ") : "Linked to ")@GetNodeName(otherId)
                                    </span>
                                    <small>@edge.Why</small>
                                </button>
                            }
                        </div>
                    }
                </div>
            </div>
        }
    </div>

    <div class="graph-legend">
        @foreach (var d in domains)
        {
            <div class="legend-item">
                <span class="legend-dot" style="background: @DomainHue(d.Id)"></span>
                <span class="legend-label">@d.Name</span>
            </div>
        }
        <div class="legend-item legend-key">
            <span class="legend-line prereq"></span><span class="legend-label">prereq</span>
        </div>
        <div class="legend-item legend-key">
            <span class="legend-line related"></span><span class="legend-label">related</span>
        </div>
        <div class="legend-item legend-key">
            <span class="legend-node filled"></span><span class="legend-label">done</span>
        </div>
        <div class="legend-item legend-key">
            <span class="legend-node hollow"></span><span class="legend-label">not done</span>
        </div>
    </div>
</div>

@code {
    private bool graphReady;
    private string selectedDomain = "all";
    private string selectedLayout = "force";
    private string? selectedNodeId;

    private List<Topic>? allTopics;
    private List<Domain> domains = new();
    private HashSet<string> completedTopics = new();

    private DotNetObjectReference<KnowledgeGraphPage>? selfRef;
    private List<TopicEdge> edges = new();

    private List<(string otherId, TopicEdge edge)> LinksFor(string id) => edges
        .Where(e => (e.From == id || e.To == id) && !string.IsNullOrEmpty(e.Why))
        .OrderByDescending(e => e.Strength)
        .Take(4)
        .Select(e => (e.From == id ? e.To : e.From, e))
        .ToList();

    // Domain → representative colour, matching DomainsPage
    private static string DomainHue(string id) => id switch
    {
        "math" => "#5B6ABF",
        "philosophy" => "#8E63B5",
        "physics" => "#4A90D9",
        "biology" => "#2ECC71",
        "chemistry" => "#E91E63",
        "geology" => "#8D6E63",
        "materials" => "#607D8B",
        "history" => "#C4813A",
        "linguistics" => "#FF7043",
        "cs" => "#26A69A",
        "misc" => "#5E35B1",
        "economics" => "#16A085",
        "politics" => "#3949AB",
        "media" => "#0277BD",
        "literature" => "#8E2C40",
        _ => "#5B6ABF"
    };

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;

        // Collect all topics and domains
        allTopics = await Content.GetTopicsAsync();
        domains = await Content.GetDomainsAsync();

        // Completed = topics whose progress >= 100
        foreach (var t in allTopics)
        {
            var pct = await Progress.GetTopicProgressAsync(t.Id);
            if (pct >= 100) completedTopics.Add(t.Id);
        }

        // Set initial domain filter to profile's current domain
        selectedDomain = "all";

        selfRef = DotNetObjectReference.Create(this);

        // Load graph JSON
        var graphJson = await FetchGraphJson();
        edges = (await Connections.GetGraphAsync()).Edges;

        // Build colour map from topics
        var colorMap = new Dictionary<string, string>();
        foreach (var t in allTopics)
        {
            colorMap[t.Id] = t.Color;
        }
        var colorMapJson = System.Text.Json.JsonSerializer.Serialize(colorMap);

        var completedArray = completedTopics.ToList();

        await JS.InvokeVoidAsync(
            "TopicGraph.init",
            "topic-graph-canvas",
            graphJson,
            completedArray,
            selfRef
        );

        await JS.InvokeVoidAsync("TopicGraph.setColors", colorMapJson);

        graphReady = true;
        StateHasChanged();
    }

    private async Task<string> FetchGraphJson()
    {
        try
        {
            return await Http.GetStringAsync("data/topic-graph.json");
        }
        catch
        {
            return "{}";
        }
    }

    [JSInvokable]
    public void OnNodeTapped(string nodeId)
    {
        selectedNodeId = nodeId;
        InvokeAsync(StateHasChanged);
    }

    private void NavigateToSelected()
    {
        if (selectedNodeId != null)
            Nav.NavigateTo($"/topic/{selectedNodeId}");
    }

    private async Task OnDomainChanged(ChangeEventArgs e)
    {
        selectedDomain = e.Value?.ToString() ?? "all";
        selectedNodeId = null;
        await JS.InvokeVoidAsync("TopicGraph.filterDomain", selectedDomain);
    }

    private async Task OnLayoutChanged(ChangeEventArgs e)
    {
        selectedLayout = e.Value?.ToString() ?? "force";
        selectedNodeId = null;
        await JS.InvokeVoidAsync("TopicGraph.setLayout", selectedLayout);
    }

    private string GetNodeColor(string id)
    {
        var topic = allTopics?.FirstOrDefault(t => t.Id == id);
        return topic?.Color ?? "#888";
    }

    private string GetNodeName(string id)
    {
        var topic = allTopics?.FirstOrDefault(t => t.Id == id);
        return topic?.Name ?? id;
    }

    private string GetNodeDomain(string id)
    {
        var topic = allTopics?.FirstOrDefault(t => t.Id == id);
        if (topic == null) return "";
        return char.ToUpper(topic.Domain[0]) + topic.Domain[1..];
    }

    public async ValueTask DisposeAsync()
    {
        try { await JS.InvokeVoidAsync("TopicGraph.destroy"); }
        catch { /* JS bridge may already be disposed */ }
        selfRef?.Dispose();
    }
}

<style>
    .tooltip-links { display: flex; flex-direction: column; gap: 6px; margin-top: 8px; max-height: 40vh; overflow-y: auto; }
    .tooltip-link {
        text-align: left; background: var(--bg-surface); border: 1px solid var(--border);
        border-radius: 8px; padding: 6px 8px; cursor: pointer; font-family: inherit; color: var(--text-secondary);
    }
    .tooltip-link-name { display: block; font-weight: 600; font-size: 0.8rem; }
    .tooltip-link small { display: block; font-size: 0.75rem; line-height: 1.35; }

    .graph-page {
        display: flex;
        flex-direction: column;
        height: 100dvh;
        overflow: hidden;
        padding: 0;
    }

    .graph-header {
        display: flex;
        align-items: center;
        gap: 12px;
        padding: 10px 16px;
        background: var(--bg-surface);
        border-bottom: 1px solid var(--border);
        flex-shrink: 0;
        z-index: 10;
    }

    .graph-header h1 {
        flex: 1;
        font-size: 1.1rem;
        font-weight: 700;
        margin: 0;
        display: flex;
        align-items: center;
        gap: 8px;
    }

    .graph-title-icon {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 28px;
        height: 28px;
        border-radius: 50%;
        background: linear-gradient(135deg, var(--primary), var(--primary-light));
        color: white;
    }

    .graph-controls {
        flex-shrink: 0;
        display: flex;
        gap: 6px;
    }

    .domain-filter {
        background: var(--bg-card);
        border: 1px solid var(--border);
        border-radius: var(--radius-sm);
        color: var(--text-primary);
        padding: 6px 10px;
        font-size: 0.8rem;
        cursor: pointer;
        appearance: auto;
    }

    .graph-container {
        flex: 1;
        position: relative;
        overflow: hidden;
        touch-action: none;
    }

    #topic-graph-canvas {
        display: block;
        width: 100%;
        height: 100%;
        touch-action: none;
        cursor: grab;
    }

    #topic-graph-canvas:active {
        cursor: grabbing;
    }

    .graph-loading {
        position: absolute;
        inset: 0;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        gap: 12px;
        background: var(--bg-base);
        color: var(--text-muted);
        font-size: 0.9rem;
        pointer-events: none;
    }

    .spinner {
        width: 32px;
        height: 32px;
        border: 3px solid var(--border);
        border-top-color: var(--primary);
        border-radius: 50%;
        animation: spin 0.8s linear infinite;
    }

    @@keyframes spin { to { transform: rotate(360deg); } }

    /* Node tooltip */
    .node-tooltip {
        position: absolute;
        bottom: 80px;
        left: 50%;
        transform: translateX(-50%);
        display: flex;
        align-items: stretch;
        overflow: hidden;
        padding: 0;
        cursor: pointer;
        min-width: 180px;
        max-width: min(340px, calc(100vw - 32px));
        animation: fadeSlideUp 0.15s ease;
        z-index: 20;
    }

    @@keyframes fadeSlideUp {
        from { opacity: 0; transform: translateX(-50%) translateY(8px); }
        to   { opacity: 1; transform: translateX(-50%) translateY(0); }
    }

    .tooltip-color-bar {
        width: 5px;
        flex-shrink: 0;
    }

    .tooltip-body {
        padding: 10px 14px;
        display: flex;
        flex-direction: column;
        gap: 3px;
    }

    .tooltip-body strong { font-size: 0.9rem; }
    .tooltip-body small { color: var(--text-muted); font-size: 0.75rem; }

    .tooltip-badge {
        font-size: 0.75rem;
        color: var(--primary);
        font-weight: 600;
        display: flex;
        align-items: center;
        gap: 4px;
        margin-top: 2px;
    }

    .tooltip-badge.completed {
        color: var(--success);
    }

    /* Legend */
    .graph-legend {
        display: flex;
        flex-wrap: wrap;
        gap: 8px 14px;
        padding: 8px 16px;
        background: var(--bg-surface);
        border-top: 1px solid var(--border);
        flex-shrink: 0;
    }

    .legend-item {
        display: flex;
        align-items: center;
        gap: 5px;
        font-size: 0.72rem;
        color: var(--text-muted);
        white-space: nowrap;
    }

    .legend-dot {
        width: 10px;
        height: 10px;
        border-radius: 50%;
        flex-shrink: 0;
    }

    .legend-label {
        text-transform: capitalize;
    }

    .legend-line {
        display: inline-block;
        width: 20px;
        height: 2px;
        border-radius: 1px;
    }

    .legend-line.prereq { background: rgba(100,150,255,0.7); }
    .legend-line.related { background: rgba(180,180,180,0.5); border-top: 1px dashed rgba(180,180,180,0.5); height: 0; }

    .legend-node {
        width: 10px;
        height: 10px;
        border-radius: 50%;
        border: 2px solid var(--text-muted);
        flex-shrink: 0;
    }

    .legend-node.filled { background: var(--text-muted); }
    .legend-node.hollow { background: transparent; }

    @@media (min-width: 768px) {
        .graph-header h1 { font-size: 1.3rem; }
        .domain-filter { font-size: 0.85rem; }
    }
</style>
