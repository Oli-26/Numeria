@page "/graph"
@inject IProgressService Progress
@inject IContentRepository Content
@inject NavigationManager Nav
@inject IJSRuntime JS
@inject IConnectionsService Connections
@implements IAsyncDisposable

<div class="graph-page">
    <div class="graph-header">
        <button class="back-btn" aria-label="Back" @onclick='() => Nav.NavigateTo("/")'><Icon Name="arrow-left" Size="18" /></button>
        <h1><span class="graph-title-icon"><Icon Name="graph" Size="16" /></span> Knowledge Graph</h1>
        <div class="gc-layout" role="group" aria-label="Layout">
            <button class="@(layout == "web" ? "on" : "")" aria-pressed="@(layout == "web" ? "true" : "false")" @onclick='() => SetLayout("web")'>Web</button>
            <button class="@(layout == "layers" ? "on" : "")" aria-pressed="@(layout == "layers" ? "true" : "false")" @onclick='() => SetLayout("layers")'>Layers</button>
        </div>
    </div>

    <div class="graph-controls">
        <label class="gc-subject-wrap">
            <span class="gc-dot @(scope == "all" ? "all" : "")" style="--hue: @SubjectHues.For(scope)"></span>
            <select class="gc-subject" value="@scope" @onchange="OnScopeChanged" aria-label="Subject">
                <option value="all">All subjects</option>
                @foreach (var d in domains)
                {
                    <option value="@d.Id">@d.Name</option>
                }
            </select>
            <span class="gc-caret"><Icon Name="chevron-down" Size="14" /></span>
        </label>
        <button class="gc-mine @(mine ? "on" : "")" aria-pressed="@(mine ? "true" : "false")" @onclick="ToggleMine">
            <span class="gc-check"><Icon Name="check" Size="12" /></span> My topics
        </button>
    </div>

    <div class="graph-container">
        <canvas id="topic-graph-canvas"></canvas>

        @if (!graphReady)
        {
            <div class="graph-loading">
                <div class="spinner"></div>
                <p>Building graph…</p>
            </div>
        }
        else
        {
            <div class="graph-stat">@Summary</div>
            <div class="graph-fab">
                <button class="gk-toggle @(showKey ? "on" : "")" aria-expanded="@(showKey ? "true" : "false")" @onclick="() => showKey = !showKey">Key</button>
                <button class="gk-fit" aria-label="Fit to screen" title="Fit to screen" @onclick="Refit"><Icon Name="target" Size="16" /></button>
            </div>
        }

        @if (showKey)
        {
            <div class="graph-key card" @onclick="() => showKey = false">
                <div class="gk-row"><span class="gk-node done"></span>Completed</div>
                <div class="gk-row"><span class="gk-node started" style="--p: 40%"></span>In progress (ring fills as you go)</div>
                <div class="gk-row"><span class="gk-node"></span>Not started</div>
                @if (mine)
                {
                    <div class="gk-row"><span class="gk-node next"></span>Next up: linked to what you've learned</div>
                }
                <div class="gk-row"><span class="gk-edge prereq"></span>Needed for (arrow points onward)</div>
                <div class="gk-row"><span class="gk-edge related"></span>Related</div>
                <div class="gk-row gk-hint">Bigger dots have more connections. Tap a topic to see what it links to.</div>
                @if (scope == "all")
                {
                    <div class="gk-subjects">
                        @foreach (var d in domains)
                        {
                            <span><i style="background: @SubjectHues.For(d.Id)"></i>@d.Name</span>
                        }
                    </div>
                }
            </div>
        }

        @if (graphReady && mine && visible.Count == 0)
        {
            <div class="graph-empty card">
                @if (started.Count + completed.Count > 0 && scope != "all")
                {
                    <strong>Nothing started in @ScopeName yet</strong>
                    <p>Your topics so far are in other subjects.</p>
                    <button class="btn btn-primary btn-sm" @onclick='() => SetScope("all")'>Show all subjects</button>
                }
                else
                {
                    <strong>No topics started yet</strong>
                    <p>Finish a lesson and its topic shows up here, along with the topics it leads to.</p>
                    <button class="btn btn-primary btn-sm" @onclick="ToggleMine">Show the full graph</button>
                }
            </div>
        }

        @if (focusedId != null && nodeById.TryGetValue(focusedId, out var focused))
        {
            var links = LinksFor(focusedId);
            <div class="graph-panel card" @key="focusedId">
                <div class="gp-head">
                    <span class="gp-dot big @StateClass(focusedId)" style="--hue: @SubjectHues.For(focused.Domain); --p: @Pct(focusedId)%"></span>
                    <div class="gp-title">
                        <strong>@focused.Name</strong>
                        <small>@DomainName(focused.Domain) · @StatusText(focusedId)</small>
                    </div>
                    <button class="gp-close" aria-label="Close" @onclick="ClearFocus"><Icon Name="x-mark" Size="18" /></button>
                </div>
                <button class="btn btn-primary btn-sm gp-open" @onclick='() => Nav.NavigateTo($"/topic/{focusedId}")'>
                    @(completed.Contains(focusedId) ? "Review topic" : started.Contains(focusedId) ? "Continue topic" : "Open topic") <Icon Name="arrow-right" Size="14" />
                </button>
                <div class="gp-scroll">
                    @if (links.Count == 0)
                    {
                        <p class="gp-none">No connections recorded yet.</p>
                    }
                    @foreach (var group in new[] { ("Needs", "needs"), ("Leads to", "leads"), ("Related", "related") })
                    {
                        var items = links.Where(l => l.Kind == group.Item2).ToList();
                        if (items.Count == 0) continue;
                        <h3 class="gp-group">@group.Item1 <span>@items.Count</span></h3>
                        @foreach (var link in items)
                        {
                            var other = nodeById[link.OtherId];
                            <button class="gp-entry" @onclick="() => FocusEntry(link.OtherId)">
                                <span class="gp-dot @StateClass(link.OtherId)" style="--hue: @SubjectHues.For(other.Domain); --p: @Pct(link.OtherId)%"></span>
                                <span class="gp-entry-text">
                                    <span class="gp-entry-name">
                                        @other.Name
                                        @if (other.Domain != focused.Domain)
                                        {
                                            <em class="gp-tag">@DomainName(other.Domain)</em>
                                        }
                                    </span>
                                    @if (!string.IsNullOrEmpty(link.Why))
                                    {
                                        <small>@link.Why</small>
                                    }
                                </span>
                                <span class="gp-chev"><Icon Name="chevron-right" Size="14" /></span>
                            </button>
                        }
                    }
                </div>
            </div>
        }
    </div>
</div>

@code {
    private record Link(string OtherId, string Kind, string? Why, double Strength);

    private bool graphReady;
    private string scope = "all";
    private string layout = "web";
    private bool mine;
    private bool showKey;
    private string? focusedId;

    private List<Domain> domains = new();
    private readonly Dictionary<string, TopicGraphNode> nodeById = new();
    private readonly Dictionary<string, List<TopicEdge>> edgesByNode = new();
    private readonly Dictionary<string, (int Done, int Total)> lessons = new();
    private readonly HashSet<string> completed = new();
    private readonly HashSet<string> started = new();
    private HashSet<string> visible = new();
    private HashSet<string> nextUp = new();

    private DotNetObjectReference<KnowledgeGraphPage>? selfRef;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;

        var profile = await Progress.GetProfileAsync();
        domains = await Content.GetDomainsAsync();
        var graph = await Connections.GetGraphAsync();

        foreach (var n in graph.Nodes) nodeById[n.Id] = n;
        foreach (var e in graph.Edges)
        {
            if (!nodeById.ContainsKey(e.From) || !nodeById.ContainsKey(e.To)) continue;
            Bucket(e.From).Add(e);
            Bucket(e.To).Add(e);
        }

        var lessonsDone = profile.LessonsCompleted.ToHashSet();
        var topicsDone = profile.TopicsCompleted.ToHashSet();
        foreach (var id in nodeById.Keys)
        {
            var ids = await Content.GetLessonIdsAsync(id);
            var done = ids.Count(lessonsDone.Contains);
            lessons[id] = (done, ids.Count);
            if (topicsDone.Contains(id) || (ids.Count > 0 && done >= ids.Count)) completed.Add(id);
            else if (done > 0) started.Add(id);
        }

        scope = domains.Any(d => d.Id == profile.CurrentDomain) ? profile.CurrentDomain : "all";
        selfRef = DotNetObjectReference.Create(this);

        var hues = nodeById.Values.Select(n => n.Domain).Distinct().ToDictionary(d => d, SubjectHues.For);
        var progress = nodeById.Keys.Where(id => Pct(id) > 0).ToDictionary(id => id, Pct);
        var names = hues.Keys.ToDictionary(d => d, DomainName);
        var slim = new
        {
            nodes = graph.Nodes.Select(n => new { id = n.Id, name = n.Name, domain = n.Domain }),
            edges = graph.Edges.Select(e => new { from = e.From, to = e.To, type = e.Type, strength = e.Strength })
        };

        await JS.InvokeVoidAsync("TopicGraph.init", "topic-graph-canvas", slim, new { hues, progress, names }, selfRef);
        await ApplyView();

        graphReady = true;
        StateHasChanged();
    }

    private List<TopicEdge> Bucket(string id) =>
        edgesByNode.TryGetValue(id, out var list) ? list : edgesByNode[id] = new List<TopicEdge>();

    private (HashSet<string> Visible, HashSet<string> NextUp) ComputeView(string forScope, bool onlyMine)
    {
        var inScope = nodeById.Values.Where(n => forScope == "all" || n.Domain == forScope).Select(n => n.Id).ToHashSet();
        if (!onlyMine) return (inScope, new HashSet<string>());

        var learned = inScope.Where(id => started.Contains(id) || completed.Contains(id)).ToHashSet();
        var next = new HashSet<string>();
        foreach (var id in learned)
            foreach (var e in Bucket(id))
            {
                var other = e.From == id ? e.To : e.From;
                if (inScope.Contains(other) && !learned.Contains(other)) next.Add(other);
            }
        learned.UnionWith(next);
        return (learned, next);
    }

    private async Task ApplyView()
    {
        (visible, nextUp) = ComputeView(scope, mine);
        focusedId = null;
        await JS.InvokeVoidAsync("TopicGraph.setView", $"{scope}|{(mine ? "mine" : "full")}", visible, nextUp, layout);
    }

    private async Task OnScopeChanged(ChangeEventArgs e) => await SetScope(e.Value?.ToString() ?? "all");

    private async Task SetScope(string value)
    {
        scope = value;
        await ApplyView();
    }

    private async Task ToggleMine()
    {
        mine = !mine;
        await ApplyView();
    }

    private async Task SetLayout(string value)
    {
        if (layout == value) return;
        layout = value;
        await ApplyView();
    }

    private async Task Refit() => await JS.InvokeVoidAsync("TopicGraph.fit");

    private async Task FocusEntry(string id)
    {
        if (!visible.Contains(id) && nodeById.TryGetValue(id, out var node))
        {
            if (scope != "all" && node.Domain != scope) scope = node.Domain;
            if (mine && !ComputeView(scope, true).Visible.Contains(id)) mine = false;
            await ApplyView();
        }
        focusedId = id;
        showKey = false;
        await JS.InvokeVoidAsync("TopicGraph.focus", id);
    }

    private async Task ClearFocus()
    {
        focusedId = null;
        await JS.InvokeVoidAsync("TopicGraph.focus", (string?)null);
    }

    [JSInvokable]
    public void OnNodeFocused(string? nodeId)
    {
        focusedId = nodeId;
        if (nodeId != null) showKey = false;
        InvokeAsync(StateHasChanged);
    }

    private List<Link> LinksFor(string id)
    {
        var byOther = new Dictionary<string, Link>();
        foreach (var e in Bucket(id))
        {
            var other = e.From == id ? e.To : e.From;
            var kind = e.Type != "prereq" ? "related" : e.To == id ? "needs" : "leads";
            // A pair listed as both prerequisite and related shows once, as the prerequisite.
            if (byOther.TryGetValue(other, out var prev) && (prev.Kind != "related" || kind == "related")) continue;
            byOther[other] = new Link(other, kind, e.Why, e.Strength);
        }
        return byOther.Values.OrderByDescending(l => l.Strength).ThenBy(l => nodeById[l.OtherId].Name).ToList();
    }

    private double Pct(string id)
    {
        if (completed.Contains(id)) return 100;
        return lessons.TryGetValue(id, out var l) && l.Total > 0 ? Math.Round(100.0 * l.Done / l.Total) : 0;
    }

    private string StateClass(string id) => completed.Contains(id) ? "done" : started.Contains(id) ? "started" : nextUp.Contains(id) ? "next" : "";

    private string StatusText(string id)
    {
        if (completed.Contains(id)) return "Completed";
        var (done, total) = lessons.TryGetValue(id, out var l) ? l : (0, 0);
        if (done > 0) return $"{done} of {total} lessons";
        return total > 0 ? $"Not started · {total} lessons" : "Not started";
    }

    private string DomainName(string id) => domains.FirstOrDefault(d => d.Id == id)?.Name ?? (id.Length > 0 ? char.ToUpper(id[0]) + id[1..] : id);

    private string ScopeName => scope == "all" ? "All subjects" : DomainName(scope);

    private string Summary
    {
        get
        {
            var shown = visible.Count - nextUp.Count;
            var done = visible.Count(completed.Contains);
            var going = visible.Count(started.Contains);
            if (mine) return visible.Count == 0 ? "" : $"{done} done · {going} in progress · {nextUp.Count} next up";
            return $"{shown} topics · {done} done · {going} in progress";
        }
    }

    public async ValueTask DisposeAsync()
    {
        try { await JS.InvokeVoidAsync("TopicGraph.destroy"); }
        catch { /* JS bridge may already be disposed */ }
        selfRef?.Dispose();
    }
}

<style>
    /* Fixed between the top of the viewport and the bottom nav (sidebar on desktop) so the canvas gets every pixel. */
    .graph-page {
        position: fixed;
        top: 0;
        left: 0;
        right: 0;
        bottom: calc(85px + env(safe-area-inset-bottom));
        display: flex;
        flex-direction: column;
        background: var(--bg-main);
        z-index: 5;
    }

    .graph-header {
        display: flex;
        align-items: center;
        gap: 8px;
        padding: calc(6px + env(safe-area-inset-top)) 10px 2px 4px;
        flex-shrink: 0;
    }

    .graph-header .back-btn {
        display: grid; place-items: center; min-width: 44px; min-height: 44px;
        background: none; border: none; border-radius: var(--radius-sm);
        color: var(--text-secondary); cursor: pointer;
    }
    .graph-header .back-btn:hover { background: var(--bg-surface); }

    .graph-header h1 {
        flex: 1;
        min-width: 0;
        font-size: 1.05rem;
        font-weight: 700;
        margin: 0;
        display: flex;
        align-items: center;
        gap: 8px;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }

    .graph-title-icon {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
        width: 26px;
        height: 26px;
        border-radius: 50%;
        background: var(--primary);
        color: white;
    }

    .gc-layout {
        display: flex;
        flex-shrink: 0;
        padding: 3px;
        border-radius: 999px;
        background: var(--bg-surface);
        border: 1px solid var(--border);
    }

    .gc-layout button {
        border: none;
        background: none;
        font: inherit;
        font-size: 0.78rem;
        font-weight: 600;
        color: var(--text-secondary);
        padding: 5px 11px;
        min-height: 30px;
        border-radius: 999px;
        cursor: pointer;
        -webkit-tap-highlight-color: transparent;
    }

    .gc-layout button.on {
        background: var(--bg-card);
        color: var(--text-primary);
        box-shadow: 0 1px 3px var(--shadow);
    }

    .graph-controls {
        display: flex;
        gap: 8px;
        padding: 6px 12px 10px;
        flex-shrink: 0;
        border-bottom: 1px solid var(--border);
    }

    .gc-subject-wrap {
        position: relative;
        flex: 1;
        min-width: 0;
        display: flex;
        align-items: center;
    }

    .gc-dot {
        position: absolute;
        left: 13px;
        width: 10px;
        height: 10px;
        border-radius: 50%;
        background: var(--hue);
        pointer-events: none;
    }

    .gc-dot.all {
        background: conic-gradient(#5B6ABF, #4A90D9, #2ECC71, #C4813A, #E91E63, #8E63B5, #5B6ABF);
    }

    .gc-subject {
        width: 100%;
        min-width: 0;
        appearance: none;
        -webkit-appearance: none;
        background: var(--bg-card);
        border: 1px solid var(--border);
        border-radius: 999px;
        color: var(--text-primary);
        font: inherit;
        font-size: 0.85rem;
        font-weight: 600;
        padding: 0 32px 0 31px;
        height: 38px;
        cursor: pointer;
        text-overflow: ellipsis;
    }

    .gc-caret {
        position: absolute;
        right: 12px;
        display: flex;
        color: var(--text-muted);
        pointer-events: none;
    }

    .gc-mine {
        flex-shrink: 0;
        display: inline-flex;
        align-items: center;
        gap: 7px;
        height: 38px;
        padding: 0 14px 0 10px;
        border-radius: 999px;
        border: 1px solid var(--border);
        background: var(--bg-card);
        color: var(--text-primary);
        font: inherit;
        font-size: 0.85rem;
        font-weight: 600;
        cursor: pointer;
        -webkit-tap-highlight-color: transparent;
        transition: background 0.2s ease, border-color 0.2s ease, color 0.2s ease;
    }

    .gc-check {
        display: grid;
        place-items: center;
        width: 18px;
        height: 18px;
        border-radius: 50%;
        border: 1.5px solid var(--text-muted);
        color: transparent;
        transition: background 0.2s ease, border-color 0.2s ease, color 0.2s ease;
    }

    .gc-mine.on {
        background: color-mix(in srgb, var(--primary) 14%, var(--bg-card));
        border-color: var(--primary);
    }

    .gc-mine.on .gc-check {
        background: var(--primary);
        border-color: var(--primary);
        color: white;
    }

    .graph-container {
        flex: 1;
        position: relative;
        overflow: hidden;
        touch-action: none;
    }

    #topic-graph-canvas {
        display: block;
        width: 100%;
        height: 100%;
        touch-action: none;
        cursor: grab;
    }

    .graph-loading {
        position: absolute;
        inset: 0;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        gap: 12px;
        background: var(--bg-main);
        color: var(--text-muted);
        font-size: 0.9rem;
        pointer-events: none;
    }

    .spinner {
        width: 32px;
        height: 32px;
        border: 3px solid var(--border);
        border-top-color: var(--primary);
        border-radius: 50%;
        animation: spin 0.8s linear infinite;
    }

    @@keyframes spin { to { transform: rotate(360deg); } }

    .graph-stat {
        position: absolute;
        top: 10px;
        left: 12px;
        font-size: 0.72rem;
        font-weight: 600;
        color: var(--text-muted);
        pointer-events: none;
        text-shadow: 0 0 4px var(--bg-main), 0 0 2px var(--bg-main);
    }

    .graph-fab {
        position: absolute;
        top: 8px;
        right: 10px;
        display: flex;
        gap: 6px;
        z-index: 15;
    }

    .graph-fab button {
        height: 32px;
        min-width: 32px;
        display: grid;
        place-items: center;
        padding: 0 12px;
        border-radius: 999px;
        border: 1px solid var(--border);
        background: color-mix(in srgb, var(--bg-card) 88%, transparent);
        color: var(--text-secondary);
        font: inherit;
        font-size: 0.78rem;
        font-weight: 600;
        cursor: pointer;
        box-shadow: 0 1px 4px var(--shadow);
        -webkit-tap-highlight-color: transparent;
    }

    .graph-fab .gk-fit { padding: 0; width: 32px; }
    .graph-fab .gk-toggle.on { color: var(--text-primary); border-color: var(--text-muted); }

    .graph-key {
        position: absolute;
        top: 46px;
        right: 10px;
        width: min(290px, calc(100% - 20px));
        padding: 12px 14px;
        display: flex;
        flex-direction: column;
        gap: 8px;
        z-index: 16;
        font-size: 0.8rem;
        color: var(--text-secondary);
        animation: graphFade 0.15s ease;
    }

    .gk-row { display: flex; align-items: center; gap: 10px; line-height: 1.3; }
    .gk-hint { font-size: 0.74rem; color: var(--text-muted); padding-top: 2px; }

    .gk-node {
        --hue: var(--primary);
        flex-shrink: 0;
        width: 16px;
        height: 16px;
        border-radius: 50%;
        background: color-mix(in srgb, var(--hue) 38%, var(--bg-main));
        border: 1px solid color-mix(in srgb, var(--hue) 50%, transparent);
    }

    .gk-node.done { background: var(--hue); border-color: var(--hue); box-shadow: 0 0 0 3px color-mix(in srgb, var(--hue) 18%, transparent); }
    .gk-node.next { background: var(--bg-main); border: 1.5px dashed var(--hue); }

    .gk-node.started, .gp-dot.started {
        border: none;
        background:
            radial-gradient(circle, color-mix(in srgb, var(--hue) 14%, var(--bg-card)) 54%, transparent 56%),
            conic-gradient(var(--hue) var(--p), color-mix(in srgb, var(--hue) 25%, var(--bg-card)) 0);
    }

    .gk-edge {
        flex-shrink: 0;
        position: relative;
        width: 16px;
        height: 0;
        border-top: 2px solid var(--text-muted);
    }

    .gk-edge.prereq::after {
        content: "";
        position: absolute;
        right: -2px;
        top: -6px;
        border: 5px solid transparent;
        border-left: 7px solid var(--text-muted);
        border-right: none;
    }

    .gk-edge.related { border-top: 2px dashed var(--text-muted); opacity: 0.8; }

    .gk-subjects {
        display: flex;
        flex-wrap: wrap;
        gap: 4px 10px;
        padding-top: 8px;
        border-top: 1px solid var(--border);
        font-size: 0.72rem;
        color: var(--text-muted);
    }

    .gk-subjects span { display: inline-flex; align-items: center; gap: 5px; white-space: nowrap; }
    .gk-subjects i { width: 8px; height: 8px; border-radius: 50%; }

    .graph-empty {
        position: absolute;
        top: 50%;
        left: 50%;
        transform: translate(-50%, -50%);
        width: min(300px, calc(100% - 40px));
        text-align: center;
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 8px;
        animation: graphFade 0.2s ease;
    }

    .graph-empty strong { font-size: 1rem; }
    .graph-empty p { margin: 0 0 6px; font-size: 0.85rem; color: var(--text-secondary); line-height: 1.45; }

    /* Height cap matches the inset topicGraph.js leaves free when it frames a focused topic. */
    .graph-panel {
        position: absolute;
        left: 8px;
        right: 8px;
        bottom: 8px;
        max-height: min(50%, 400px);
        display: flex;
        flex-direction: column;
        padding: 12px 12px 0;
        z-index: 20;
        animation: panelUp 0.22s var(--ease-spring, ease);
        box-shadow: 0 6px 24px var(--shadow);
    }

    @@keyframes panelUp { from { opacity: 0; transform: translateY(14px); } }
    @@keyframes graphFade { from { opacity: 0; } }

