            new("gk", "Greek", "húdōr", "water", "r", "h- from w-"),
            new("hydro", "English (via Gk.)", "hydro-", "water-", "gk", "combining form"),
        }),
        ["fire"] = new Family("PIE *péh₂wr̥-", "fire (inanimate)", "PIE had two words: *péh₂wr̥- (the substance, gave English 'fire') and *h₁n̥gʷnis (animate, gave Latin 'ignis' > ignite).", new() {
            new("r", "PIE", "*péh₂wr̥-", "fire", null, null, IsRoot: true),
