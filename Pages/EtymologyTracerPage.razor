@page "/etymology"
@inject IProgressService Progress
@inject NavigationManager Nav
@inject IJSRuntime JS

@if (!unlocked)
{
    <div class="page-header">
        <button class="back-btn" aria-label="Back to home" @onclick='() => Nav.NavigateTo("/")'><Icon Name="arrow-left" Size="18" /></button>
        <h1>Etymology Tracer</h1>
    </div>
    <div class="card" style="text-align: center; padding: 40px 24px">
        <Icon Name="lock" Size="40" Stroke="var(--text-muted)" />
        <h2 style="margin-top: 12px">Locked</h2>
        <p style="color: var(--text-secondary)">Purchase "Etymology Tracer" from the Shop to unlock.</p>
        <button class="btn btn-accent" @onclick='() => Nav.NavigateTo("/shop")'>Go to Shop</button>
    </div>
}
else
{
    <div class="page-header">
        <button class="back-btn" aria-label="Back to home" @onclick='() => Nav.NavigateTo("/")'><Icon Name="arrow-left" Size="18" /></button>
        <h1>Etymology Tracer</h1>
    </div>

    <div class="card etym-intro">
        <Icon Name="scroll" Size="22" Stroke="var(--accent)" />
        <p>Trace a modern English word back through history to its earliest reconstructable ancestor. Each branch shows a sound change, borrowing, or sister language.</p>
    </div>

    <div class="card etym-search-card">
        <div class="etym-search-wrap">
            <span class="etym-search-icon"><Icon Name="search" Size="18" Stroke="var(--text-muted)" /></span>
            <input class="etym-search" type="text" placeholder="Search a word (e.g. father, heart, tea)..."
                   @bind="searchText" @bind:event="oninput" />
            @if (!string.IsNullOrEmpty(searchText))
            {
                <button class="etym-clear" @onclick="() => searchText = string.Empty">Clear</button>
            }
        </div>

        @if (!string.IsNullOrWhiteSpace(searchText) && Suggestions().Any())
        {
            <div class="etym-suggestions">
                @foreach (var s in Suggestions())
                {
                    var sx = s;
                    <button class="etym-suggest" @onclick="() => Pick(sx)">@sx</button>
                }
            </div>
        }

        <div class="etym-chips">
            @foreach (var w in Families.Keys.OrderBy(k => k))
            {
                var wx = w;
                <button class="etym-chip @(selectedWord == wx ? "etym-chip-active" : "")" @onclick="() => Pick(wx)">@wx</button>
            }
        </div>
    </div>

    @if (selectedWord != null && Families.TryGetValue(selectedWord, out var family))
    {
        <div class="card etym-detail">
            <div class="etym-detail-header">
                <div>
                    <div class="etym-word">@selectedWord</div>
                    <div class="etym-root">Root: @family.Root</div>
                </div>
                <div class="etym-meaning">@family.Gloss</div>
            </div>

            <div class="etym-tree-wrap">
                @{
                    var layout = Layout(family);
                    var minX = layout.Nodes.Min(n => n.X) - 90;
                    var maxX = layout.Nodes.Max(n => n.X) + 90;
                    var w = maxX - minX;
                    var h = layout.Height;
                }
                <svg class="etym-tree" viewBox="@($"{minX} 0 {w} {h}")" preserveAspectRatio="xMidYMin meet" style="@($"min-width:{Math.Max((int)w, 320)}px;height:{(int)h}px")">
                    @foreach (var e in layout.Edges)
                    {
                        <line x1="@e.X1.ToString(System.Globalization.CultureInfo.InvariantCulture)"
                              y1="@e.Y1.ToString(System.Globalization.CultureInfo.InvariantCulture)"
                              x2="@e.X2.ToString(System.Globalization.CultureInfo.InvariantCulture)"
                              y2="@e.Y2.ToString(System.Globalization.CultureInfo.InvariantCulture)"
                              stroke="var(--border)" stroke-width="1.5" />
                        @if (!string.IsNullOrEmpty(e.Label))
                        {
                            var midX = (e.X1 + e.X2) / 2;
                            var midY = (e.Y1 + e.Y2) / 2;
                            <g>
                                <rect x="@((midX - 60).ToString(System.Globalization.CultureInfo.InvariantCulture))"
                                      y="@((midY - 9).ToString(System.Globalization.CultureInfo.InvariantCulture))"
                                      width="120" height="18" rx="6"
                                      fill="var(--bg-surface)" stroke="var(--border)" stroke-width="0.5" />
                                <text x="@midX.ToString(System.Globalization.CultureInfo.InvariantCulture)"
                                      y="@((midY + 4).ToString(System.Globalization.CultureInfo.InvariantCulture))"
                                      text-anchor="middle" font-size="9" fill="var(--text-secondary)">@Truncate(e.Label, 22)</text>
                            </g>
                        }
                    }
                    @foreach (var n in layout.Nodes)
                    {
                        var fill = n.IsMain ? "var(--primary)" : (n.IsRoot ? "var(--accent)" : "var(--bg-card)");
                        var textColor = n.IsMain || n.IsRoot ? "white" : "var(--text-primary)";
                        var subColor = n.IsMain || n.IsRoot ? "rgba(255,255,255,0.85)" : "var(--text-muted)";
                        <g>
                            <rect x="@((n.X - 75).ToString(System.Globalization.CultureInfo.InvariantCulture))"
                                  y="@((n.Y - 24).ToString(System.Globalization.CultureInfo.InvariantCulture))"
                                  width="150" height="48" rx="8"
                                  fill="@fill" stroke="var(--border)" stroke-width="1" />
                            <text x="@n.X.ToString(System.Globalization.CultureInfo.InvariantCulture)"
                                  y="@((n.Y - 9).ToString(System.Globalization.CultureInfo.InvariantCulture))"
                                  text-anchor="middle" font-size="8" fill="@subColor">@Truncate(n.LangPeriod, 28)</text>
                            <text x="@n.X.ToString(System.Globalization.CultureInfo.InvariantCulture)"
                                  y="@((n.Y + 5).ToString(System.Globalization.CultureInfo.InvariantCulture))"
                                  text-anchor="middle" font-size="13" font-weight="700" fill="@textColor">@Truncate(n.Form, 18)</text>
                            @if (!string.IsNullOrEmpty(n.Meaning))
                            {
                                <g><text x="@n.X.ToString(System.Globalization.CultureInfo.InvariantCulture)"
                                      y="@((n.Y + 17).ToString(System.Globalization.CultureInfo.InvariantCulture))"
                                      text-anchor="middle" font-size="8" font-style="italic" fill="@subColor">"@Truncate(n.Meaning, 24)"</text></g>
                            }
                        </g>
                    }
                </svg>
            </div>

            <div class="etym-legend">
                <span class="legend-item"><span class="legend-dot" style="background:var(--accent)"></span>Proto-root</span>
                <span class="legend-item"><span class="legend-dot" style="background:var(--primary)"></span>Modern English</span>
                <span class="legend-item"><span class="legend-dot" style="background:var(--bg-card);border:1px solid var(--border)"></span>Cognate / ancestor</span>
            </div>

            @if (!string.IsNullOrEmpty(family.Note))
            {
                <div class="etym-note">
                    <Icon Name="book" Size="16" Stroke="var(--accent)" />
                    <span>@family.Note</span>
                </div>
            }
        </div>
    }
    else
    {
        <div class="card etym-empty">
            <Icon Name="brain" Size="32" Stroke="var(--text-muted)" />
            <p>Pick a word above to see its family tree.</p>
        </div>
    }
}

@code {
    private bool unlocked;
    private string searchText = string.Empty;
    private string? selectedWord;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            var profile = await Progress.GetProfileAsync();
            unlocked = profile.ShopPurchases.Contains("unlock-etymology");
            StateHasChanged();
        }
    }

    private void Pick(string w)
    {
        selectedWord = w;
        searchText = string.Empty;
    }

    private IEnumerable<string> Suggestions() =>
        Families.Keys
            .Where(k => k.Contains(searchText.Trim(), StringComparison.OrdinalIgnoreCase))
            .OrderBy(k => k)
            .Take(8);

    private static string Truncate(string s, int max) =>
        string.IsNullOrEmpty(s) ? string.Empty : (s.Length <= max ? s : s.Substring(0, max - 1) + "…");

    // ---- Tree model ----
    private record Node(string Id, string LangPeriod, string Form, string Meaning, string? ParentId, string? EdgeLabel, bool IsMain = false, bool IsRoot = false);
    private record Family(string Root, string Gloss, string? Note, List<Node> Nodes);

    private record PosNode(double X, double Y, string LangPeriod, string Form, string Meaning, bool IsMain, bool IsRoot);
    private record PosEdge(double X1, double Y1, double X2, double Y2, string? Label);
    private record TreeLayout(List<PosNode> Nodes, List<PosEdge> Edges, double Height);

    private TreeLayout Layout(Family family)
    {
        // Compute depth for each node by walking parent chain
        var byId = family.Nodes.ToDictionary(n => n.Id);
        int Depth(Node n) {
            int d = 0;
            var c = n;
            while (c.ParentId != null && byId.ContainsKey(c.ParentId)) { c = byId[c.ParentId]; d++; }
            return d;
        }

        var depths = family.Nodes.ToDictionary(n => n.Id, n => Depth(n));
        var maxDepth = depths.Values.Max();

        // Group nodes by depth, assign x positions evenly
        var byDepth = family.Nodes.GroupBy(n => depths[n.Id]).OrderBy(g => g.Key).ToList();
        var posMap = new Dictionary<string, (double X, double Y)>();
        const double rowH = 100;
        const double colW = 180;

        foreach (var grp in byDepth)
        {
            var list = grp.ToList();
            // Sort so main-line node (IsMain or has descendant chain to a main) is centered
            // Simple: keep input order, center around 0
            int n = list.Count;
            for (int i = 0; i < n; i++)
            {
                double x = (i - (n - 1) / 2.0) * colW;
                double y = 40 + grp.Key * rowH;
                posMap[list[i].Id] = (x, y);
            }
        }

        var posNodes = family.Nodes.Select(n => new PosNode(
            posMap[n.Id].X, posMap[n.Id].Y, n.LangPeriod, n.Form, n.Meaning, n.IsMain, n.IsRoot
        )).ToList();

        var posEdges = new List<PosEdge>();
        foreach (var n in family.Nodes)
        {
            if (n.ParentId != null && posMap.ContainsKey(n.ParentId))
            {
                var p = posMap[n.ParentId];
                var c = posMap[n.Id];
                posEdges.Add(new PosEdge(p.X, p.Y + 24, c.X, c.Y - 24, n.EdgeLabel));
            }
        }

        double height = 80 + maxDepth * rowH + 40;
        return new TreeLayout(posNodes, posEdges, height);
    }

    // ---- Word families ----
    // Each tree: root at depth 0, descendants flow down. Modern English form is marked IsMain.
    private static readonly Dictionary<string, Family> Families = new()
    {
        ["father"] = new Family("PIE *ph₂tér-", "male parent", "Grimm's Law turned PIE *p- into Germanic *f-, giving 'father' rather than Latin 'pater'.", new() {
            new("r", "PIE (~4500 BCE)", "*ph₂tér-", "father", null, null, IsRoot: true),
            new("gmc", "Proto-Germanic", "*fadēr", "father", "r", "Grimm's Law: p > f"),
            new("oe", "Old English (~900)", "fæder", "father", "gmc", "vowel shift"),
            new("en", "Modern English", "father", "father", "oe", "Great Vowel Shift", IsMain: true),
            new("lat", "Latin", "pater", "father", "r", "kept *p-"),
            new("fr", "French", "père", "father", "lat", "Vulgar Latin > OFr"),
            new("skt", "Sanskrit", "pitṛ́", "father", "r", "Indo-Iranian branch"),
        }),
        ["mother"] = new Family("PIE *méh₂tēr-", "female parent", null, new() {
            new("r", "PIE", "*méh₂tēr-", "mother", null, null, IsRoot: true),
            new("gmc", "Proto-Germanic", "*mōdēr", "mother", "r", "vowel shift"),
            new("oe", "Old English", "mōdor", "mother", "gmc", null),
            new("en", "Modern English", "mother", "mother", "oe", "th from d", IsMain: true),
            new("lat", "Latin", "mater", "mother", "r", null),
            new("gk", "Greek", "mḗtēr", "mother", "r", null),
        }),
        ["brother"] = new Family("PIE *bʰréh₂tēr-", "brother", null, new() {
            new("r", "PIE", "*bʰréh₂tēr-", "brother", null, null, IsRoot: true),
            new("gmc", "Proto-Germanic", "*brōþēr", "brother", "r", "Grimm's Law"),
            new("oe", "Old English", "brōþor", "brother", "gmc", null),
            new("en", "Modern English", "brother", "brother", "oe", null, IsMain: true),
            new("lat", "Latin", "frater", "brother", "r", "bʰ > f"),
            new("skt", "Sanskrit", "bhrātṛ", "brother", "r", null),
        }),
        ["sister"] = new Family("PIE *swésōr-", "sister", null, new() {
            new("r", "PIE", "*swésōr-", "sister", null, null, IsRoot: true),
            new("gmc", "Proto-Germanic", "*swestēr", "sister", "r", null),
