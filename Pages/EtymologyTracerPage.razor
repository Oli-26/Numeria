            new("butyric", "English (via Lat.)", "butyric", "buttery (acid)", "lat", "scientific"),
        }),
        ["alcohol"] = new Family("Arabic al-kuḥl", "the kohl (eye powder)", "Arabic al-kuḥl meant powdered antimony eyeliner; Europeans extended it to any fine powder, then to distilled spirits.", new() {
            new("r", "Arabic", "al-kuḥl", "the kohl", null, null, IsRoot: true),
            new("mlat", "Medieval Latin", "alcohol", "fine powder", "r", "borrowed"),
            new("fr", "Middle French", "alcohol", "spirits", "mlat", "sense shift"),
            new("en", "Modern English", "alcohol", "spirits", "fr", "1540s", IsMain: true),
            new("kohl", "English (sister loan)", "kohl", "eye cosmetic", "r", "re-borrowed"),
        }),
