                    <div class="explore-card-content">
                        <div class="explore-icon"><Icon Name="antenna" Size="24" /></div>
                        <div class="explore-text">
                            <strong>Front Page</strong>
                            <small>@(frontPageUnlocked ? "Build a story, see the framing" : "Unlock in Shop")</small>
                        </div>
                    </div>
                    @if (!frontPageUnlocked) { <div class="explore-lock"><Icon Name="lock" Size="14" /></div> }
                </div>
            }

            @if (currentDomain == "literature")
            {
                <div class="explore-card card-clickable @(plotGeometryUnlocked ? "unlocked" : "")" style="--accent-color: #F39C12" @onclick='() => Nav.NavigateTo(plotGeometryUnlocked ? "/plot-geometry" : "/shop/feature")'>
