@page "/"
@inject IProgressService Progress
@inject IGamificationService Gamification
@inject IContentRepository Content
@inject ISessionStateService SessionState
@inject IReviewService ReviewService
@inject INotificationService NotificationSvc
@inject NavigationManager Nav

<div class="dashboard">
    @if (savedSession != null && savedSession.ActiveTopicId != null && savedSession.ActiveLessonId != null)
    {
        <div class="card resume-banner card-clickable" @onclick="ResumeSession">
            <div class="resume-content">
                <strong>Continue where you left off</strong>
                <small>@(savedSession.InQuiz ? "Quiz in progress" : "Lesson in progress")</small>
            </div>
            <span class="resume-arrow">→</span>
        </div>
    }

    @if (profile != null && !cookieViewed)
    {
        <div class="cookie-banner card-clickable" @onclick='() => Nav.NavigateTo("/fortune")'>
            <span class="cookie-banner-icon"><Icon Name="cookie" Size="18" /></span>
            <div class="cookie-banner-text">
                <strong>Today's fortune awaits</strong>
                <small>Tap to reveal your daily math cookie</small>
            </div>
            <span class="cookie-banner-arrow">→</span>
        </div>
    }

    <div class="hero-row">
        <div class="welcome-section">
            <h1>Numeria</h1>
            @if (profile != null && profile.DisplayName != "Mathematician")
            {
                <p class="welcome-greeting">Welcome back, @profile.DisplayName</p>
            }
            @if (profile != null)
            {
                <div class="stats-row">
                    <div class="streak-display">
                        <span class="streak-fire"><Icon Name="fire" Size="16" /></span> @profile.CurrentStreak day@(profile.CurrentStreak != 1 ? "s" : "")
                    </div>
                    <div class="xp-badge">
                        <Icon Name="star-filled" Size="16" Fill="currentColor" /> @profile.TotalXp XP
                    </div>
                    <div class="chip">
                        Lvl @(Gamification.GetLevel(profile.TotalXp))
                    </div>
                </div>

                <div class="xp-progress">
                    @{
                        var level = Gamification.GetLevel(profile.TotalXp);
                        var xpInLevel = Gamification.GetXpProgressInLevel(profile.TotalXp);
                        var xpNeeded = Gamification.GetXpForNextLevel(level);
                        var pct = xpNeeded > 0 ? (double)xpInLevel / xpNeeded * 100 : 0;
                    }
                    <div class="progress-bar-container">
                        <div class="progress-bar-fill accent animate-in" style="width: @pct.ToString("F0")%"></div>
                    </div>
                    <small>@xpInLevel / @xpNeeded XP to Level @(level + 1)</small>
                </div>
            }

            <div class="tools-row">
                <div class="tool-chip card-clickable" @onclick='() => Nav.NavigateTo("/formulas")'>
                    <Icon Name="book" Size="16" /> Formula Codex
                </div>
                <div class="tool-chip card-clickable" @onclick='() => Nav.NavigateTo("/graph")'>
                    <Icon Name="graph" Size="16" /> Knowledge Graph
                </div>
                @if (profile != null && cookieViewed)
                {
                    <div class="tool-chip card-clickable" @onclick='() => Nav.NavigateTo("/fortune")'>
                        <Icon Name="clock" Size="16" /> Past Cookies
                    </div>
                }
            </div>
        </div>

        <div class="action-row">
        @if (!dailyDone)
        {
            <div class="action-card action-daily card-clickable" @onclick='() => Nav.NavigateTo("/daily")'>
                <div class="action-card-icon"><Icon Name="star-filled" Size="22" Fill="currentColor" /></div>
                <div class="action-card-text">
                    <strong>Daily Challenge</strong>
                    <small>1.5x XP bonus</small>
                </div>
            </div>
        }
        else
        {
            <div class="action-card action-done">
                <div class="action-card-icon"><Icon Name="checkmark-circle" Size="22" /></div>
                <div class="action-card-text">
                    <strong>Daily Done!</strong>
                    <small>Come back tomorrow</small>
                </div>
            </div>
        }

        <div class="action-card action-quiz card-clickable" @onclick="StartQuickQuiz">
            <div class="action-card-icon"><Icon Name="zap" Size="22" /></div>
            <div class="action-card-text">
                <strong>Quick Quiz</strong>
                <small>Test yourself</small>
            </div>
        </div>

        @if (reviewDueCount > 0)
        {
            <div class="action-card action-review card-clickable" @onclick='() => Nav.NavigateTo("/review")'>
                <div class="action-card-icon"><Icon Name="brain" Size="22" /></div>
                <div class="action-card-text">
                    <strong>Review</strong>
                    <small>@reviewDueCount due</small>
                </div>
            </div>
        }
        </div>
    </div>

    @if (topics != null && suggestedTopics.Count > 0)
    {
        <div class="section">
            <div class="section-header">
                <h2>Suggested for You</h2>
            </div>
            <div class="topics-grid stagger-in">
                @foreach (var topic in suggestedTopics)
                {
                    <div class="card card-clickable topic-tile suggested-topic" style="border-color: @topic.Color" @onclick="() => NavigateToTopic(topic.Id)">
                        <div class="suggested-label" style="color: @topic.Color"><Icon Name="star-filled" Size="12" Fill="currentColor" /> Start here</div>
                        <div class="topic-tile-icon" style="background: @(topic.Color)22; color: @topic.Color">
                            @((MarkupString)GetTopicSvg(topic.Id))
                        </div>
                        <strong>@topic.Name</strong>
                        <small>@topic.LessonCount lessons</small>
                    </div>
                }
            </div>
        </div>
    }

    <div class="section">
        <div class="section-header">
            <h2>Topics</h2>
        </div>

        @if (topics != null)
        {
            <div class="topics-grid stagger-in">
                @foreach (var topic in topics)
                {
                    var pct = topicProgress.GetValueOrDefault(topic.Id);
                    var done = pct >= 100;
                    <div class="card card-clickable topic-tile" @onclick="() => NavigateToTopic(topic.Id)">
                        <div class="topic-tile-accent" style="background: linear-gradient(135deg, @(topic.Color)18, transparent)"></div>
                        <div class="topic-tile-icon" style="background: @(topic.Color)22; color: @topic.Color">
                            @if (done)
                            {
                                <Icon Name="check" Size="22" />
                            }
                            else
                            {
                                @((MarkupString)GetTopicSvg(topic.Id))
                            }
                        </div>
                        <strong>@topic.Name</strong>
                        <small class="topic-tile-meta">@topic.LessonCount lessons · @topic.Difficulty</small>
                        <p class="topic-tile-desc">@topic.Description</p>
                        @if (pct > 0 && !done)
                        {
                            <div class="topic-tile-progress">
                                <div class="progress-bar-container">
                                    <div class="progress-bar-fill animate-in" style="width: @pct.ToString("F0")%; background: @topic.Color"></div>
                                </div>
                            </div>
                        }
                    </div>
                }
            </div>
        }
        else
        {
            <div class="skeleton-dashboard">
                <div class="skeleton-topics">
                    @for (int i = 0; i < 4; i++)
                    {
                        <div class="skeleton skeleton-topic">
                            <div class="skeleton skeleton-circle" style="width:40px;height:40px;flex-shrink:0"></div>
                            <div style="flex:1">
                                <div class="skeleton skeleton-text medium"></div>
                                <div class="skeleton skeleton-text long"></div>
                                <div class="skeleton skeleton-text short" style="margin-bottom:0"></div>
                            </div>
                        </div>
                    }
                </div>
            </div>
        }
    </div>

    <div class="section">
        <div class="synthesis-entry card card-clickable" @onclick='() => Nav.NavigateTo("/synthesis")'>
            <div class="synthesis-entry-bg"></div>
            <div class="synthesis-entry-icon">
                <Icon Name="zap" Size="24" />
            </div>
            <div class="synthesis-entry-text">
                <strong>Synthesis Quizzes</strong>
                <small>Cross-domain challenges · 1.5× XP</small>
            </div>
            <span class="synthesis-entry-arrow">→</span>
        </div>
    </div>

    <div class="section">
        <div class="section-header">
            <h2>Explore</h2>
        </div>
        <div class="explore-grid">
            <div class="explore-card card-clickable @(playgroundUnlocked ? "unlocked" : "")" style="--accent-color: #9B59B6" @onclick="() => GoPlayground()">
                <div class="explore-card-bg"></div>
                <div class="explore-card-content">
                    <div class="explore-icon"><Icon Name="target" Size="24" /></div>
                    <div class="explore-text">
                        <strong>What If?</strong>
                        <small>@(playgroundUnlocked ? "Break the rules of math" : "Unlock in Shop")</small>
                    </div>
                </div>
                @if (!playgroundUnlocked)
                {
                    <div class="explore-lock"><Icon Name="lock" Size="14" /></div>
                }
            </div>
            <div class="explore-card card-clickable @(hofUnlocked ? "unlocked" : "")" style="--accent-color: var(--accent)" @onclick="() => GoHallOfFame()">
                <div class="explore-card-bg"></div>
                <div class="explore-card-content">
                    <div class="explore-icon"><Icon Name="award" Size="24" /></div>
                    <div class="explore-text">
                        <strong>Hall of Fame</strong>
                        <small>@(hofUnlocked ? "Top Trumps + Timeline" : "Unlock in Shop")</small>
                    </div>
                </div>
                @if (!hofUnlocked)
                {
                    <div class="explore-lock"><Icon Name="lock" Size="14" /></div>
                }
            </div>
            <div class="explore-card card-clickable @(compendiumUnlocked ? "unlocked" : "")" style="--accent-color: #4A90D9" @onclick="() => GoCompendium()">
                <div class="explore-card-bg"></div>
                <div class="explore-card-content">
                    <div class="explore-icon"><Icon Name="book" Size="24" /></div>
                    <div class="explore-text">
                        <strong>Constants</strong>
                        <small>@(compendiumUnlocked ? "Numbers that define reality" : "Unlock in Shop")</small>
                    </div>
                </div>
                @if (!compendiumUnlocked)
                {
                    <div class="explore-lock"><Icon Name="lock" Size="14" /></div>
                }
            </div>
            <div class="explore-card card-clickable @(proofsUnlocked ? "unlocked" : "")" style="--accent-color: var(--primary)" @onclick='() => Nav.NavigateTo(proofsUnlocked ? "/proofs" : "/shop/feature")'>
                <div class="explore-card-bg"></div>
                <div class="explore-card-content">
                    <div class="explore-icon"><Icon Name="puzzle" Size="24" /></div>
                    <div class="explore-text">
                        <strong>Proof Builder</strong>
                        <small>@(proofsUnlocked ? "Build proofs from blocks" : "Unlock in Shop")</small>
                    </div>
                </div>
                @if (!proofsUnlocked)
                {
                    <div class="explore-lock"><Icon Name="lock" Size="14" /></div>
                }
            </div>
            <div class="explore-card card-clickable @(mistakesUnlocked ? "unlocked" : "")" style="--accent-color: var(--error)" @onclick='() => Nav.NavigateTo(mistakesUnlocked ? "/mistakes" : "/shop/feature")'>
                <div class="explore-card-bg"></div>
                <div class="explore-card-content">
                    <div class="explore-icon"><Icon Name="search" Size="24" /></div>
                    <div class="explore-text">
                        <strong>Mistake Museum</strong>
                        <small>@(mistakesUnlocked ? "Spot the flaw" : "Unlock in Shop")</small>
                    </div>
                </div>
                @if (!mistakesUnlocked)
                {
                    <div class="explore-lock"><Icon Name="lock" Size="14" /></div>
                }
            </div>
        </div>
    </div>
</div>

@code {
    private UserProfile? profile;
    private List<Topic>? topics;
    private List<Topic> suggestedTopics = new();
    private Dictionary<string, double> topicProgress = new();
    private SessionState? savedSession;
    private int reviewDueCount;
    private bool dailyDone;
    private bool proofsUnlocked;
    private bool mistakesUnlocked;
    private bool playgroundUnlocked;
    private bool compendiumUnlocked;
    private bool hofUnlocked;
    private bool cookieViewed;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await Progress.UpdateStreakAsync();
            await Progress.StartSessionAsync();
            profile = await Progress.GetProfileAsync();
            if (profile.TotalXp == 0 && profile.DisplayName == "Mathematician")
            {
                Nav.NavigateTo("/welcome");
                return;
            }
            // Refresh notification schedules silently on every app start.
            _ = NotificationSvc.RefreshSchedulesAsync();

            topics = await Content.GetTopicsByDomainAsync(profile.CurrentDomain);
            savedSession = await SessionState.LoadSessionStateAsync();
            reviewDueCount = await ReviewService.GetDueCountAsync();
            var today = DateTime.Now.ToString("yyyy-MM-dd");
            dailyDone = profile.DailyChallengeDate == today && profile.DailyChallengeCompleted;
            proofsUnlocked = profile.ShopPurchases.Contains("unlock-proofs");
            mistakesUnlocked = profile.ShopPurchases.Contains("unlock-mistakes");
            playgroundUnlocked = profile.ShopPurchases.Contains("unlock-playground");
            compendiumUnlocked = profile.ShopPurchases.Contains("unlock-compendium");
            hofUnlocked = profile.ShopPurchases.Contains("unlock-halloffame");
            cookieViewed = profile.ViewedCookieDates.Contains(DateTime.Now.ToString("yyyy-MM-dd"));

            foreach (var topic in topics)
            {
                topicProgress[topic.Id] = await Progress.GetTopicProgressAsync(topic.Id);
            }

            // Show suggestions for topics the user picked in onboarding but hasn't started
            if (profile.SuggestedTopicIds.Count > 0)
            {
                suggestedTopics = topics
                    .Where(t => profile.SuggestedTopicIds.Contains(t.Id) && topicProgress.GetValueOrDefault(t.Id) == 0)
                    .ToList();
            }

            StateHasChanged();
        }
    }

    private void GoHallOfFame()
    {
        Nav.NavigateTo(hofUnlocked ? "/hall-of-fame" : "/shop/feature");
    }

    private void GoCompendium()
    {
        Nav.NavigateTo(compendiumUnlocked ? "/compendium" : "/shop/feature");
    }

    private void GoPlayground()
    {
        Nav.NavigateTo(playgroundUnlocked ? "/playground" : "/shop/feature");
    }

    private void ResumeSession()
    {
        if (savedSession?.ActiveTopicId != null && savedSession.ActiveLessonId != null)
        {
            Nav.NavigateTo($"/topic/{savedSession.ActiveTopicId}/lesson/{savedSession.ActiveLessonId}");
        }
    }

    private static string Svg(string inner) => $"<svg viewBox='0 0 32 32' fill='none' xmlns='http://www.w3.org/2000/svg' style='width:60%;height:60%'>{inner}</svg>";

    private string GetTopicSvg(string topicId) => topicId switch
    {
        "calculus" => Svg("<path d='M13 4c-3 0-4 3-4 6v12c0 3-1 6-4 6' stroke='currentColor' stroke-width='2.5' stroke-linecap='round'/><line x1='8' y1='14' x2='20' y2='14' stroke='currentColor' stroke-width='2'/><line x1='8' y1='18' x2='20' y2='18' stroke='currentColor' stroke-width='2'/><path d='M18 8c2 4 6 8 10 10' stroke='currentColor' stroke-width='1.5' opacity='.4' stroke-linecap='round'/>"),
        "linear-algebra" => Svg("<path d='M8 6H6v20h2M24 6h2v20h-2' stroke='currentColor' stroke-width='2' stroke-linecap='round'/><circle cx='12' cy='12' r='2' fill='currentColor'/><circle cx='20' cy='12' r='2' fill='currentColor' opacity='.5'/><circle cx='12' cy='20' r='2' fill='currentColor' opacity='.5'/><circle cx='20' cy='20' r='2' fill='currentColor'/>"),
        "topology" => Svg("<ellipse cx='16' cy='16' rx='12' ry='7' stroke='currentColor' stroke-width='2'/><ellipse cx='16' cy='16' rx='4' ry='7' stroke='currentColor' stroke-width='1.5' opacity='.5'/>"),
        "number-theory" => Svg("<text x='3' y='14' font-size='11' font-weight='700' font-family='Georgia,serif' fill='currentColor'>2</text><text x='14' y='12' font-size='9' font-weight='700' font-family='Georgia,serif' fill='currentColor' opacity='.7'>3</text><text x='23' y='16' font-size='10' font-weight='700' font-family='Georgia,serif' fill='currentColor' opacity='.5'>5</text><text x='6' y='26' font-size='9' font-weight='700' font-family='Georgia,serif' fill='currentColor' opacity='.6'>7</text><text x='17' y='27' font-size='8' font-weight='700' font-family='Georgia,serif' fill='currentColor' opacity='.4'>11</text>"),
        "probability" => Svg("<rect x='5' y='5' width='22' height='22' rx='4' stroke='currentColor' stroke-width='2'/><circle cx='11' cy='11' r='2' fill='currentColor'/><circle cx='21' cy='11' r='2' fill='currentColor'/><circle cx='16' cy='16' r='2' fill='currentColor' opacity='.6'/><circle cx='11' cy='21' r='2' fill='currentColor'/><circle cx='21' cy='21' r='2' fill='currentColor'/>"),
        "group-theory" => Svg("<polygon points='16,4 27,10 27,22 16,28 5,22 5,10' stroke='currentColor' stroke-width='2' fill='none'/><polygon points='16,9 22,12.5 22,19.5 16,23 10,19.5 10,12.5' stroke='currentColor' stroke-width='1' fill='none' opacity='.35' stroke-dasharray='3,2'/><circle cx='16' cy='16' r='2' fill='currentColor' opacity='.5'/>"),
        "graph-theory" => Svg("<line x1='8' y1='8' x2='24' y2='8' stroke='currentColor' stroke-width='1.5' opacity='.5'/><line x1='8' y1='8' x2='16' y2='24' stroke='currentColor' stroke-width='1.5' opacity='.5'/><line x1='24' y1='8' x2='16' y2='24' stroke='currentColor' stroke-width='1.5' opacity='.5'/><circle cx='8' cy='8' r='3' fill='currentColor'/><circle cx='24' cy='8' r='3' fill='currentColor'/><circle cx='16' cy='24' r='3' fill='currentColor'/>"),
        "differential-geometry" => Svg("<path d='M4 24C8 8 14 8 16 16S24 24 28 8' stroke='currentColor' stroke-width='2' fill='none' stroke-linecap='round'/><line x1='13' y1='18' x2='21' y2='10' stroke='currentColor' stroke-width='1.5' opacity='.5'/><circle cx='16' cy='15' r='2' fill='currentColor' opacity='.7'/>"),
        "set-theory" => Svg("<circle cx='12' cy='16' r='9' stroke='currentColor' stroke-width='2' fill='none' opacity='.7'/><circle cx='20' cy='16' r='9' stroke='currentColor' stroke-width='2' fill='none' opacity='.7'/>"),
        "fractals" => Svg("<polygon points='16,3 30,28 2,28' stroke='currentColor' stroke-width='2' fill='none'/><polygon points='9,28 16,15.5 23,28' stroke='currentColor' stroke-width='1.5' fill='none' opacity='.5'/><polygon points='5.5,28 9,21.5 12.5,28' stroke='currentColor' stroke-width='1' fill='none' opacity='.3'/><polygon points='19.5,28 23,21.5 26.5,28' stroke='currentColor' stroke-width='1' fill='none' opacity='.3'/>"),
        "fourier-analysis" => Svg("<path d='M2 16Q6 6 10 16T18 16T26 16T30 16' stroke='currentColor' stroke-width='2.5' fill='none' stroke-linecap='round'/><path d='M2 16Q10 10 16 16T30 16' stroke='currentColor' stroke-width='1' fill='none' opacity='.3' stroke-dasharray='3,2'/>"),
        "complex-analysis" => Svg("<line x1='4' y1='16' x2='28' y2='16' stroke='currentColor' stroke-width='1' opacity='.3'/><line x1='16' y1='4' x2='16' y2='28' stroke='currentColor' stroke-width='1' opacity='.3'/><circle cx='16' cy='16' r='8' stroke='currentColor' stroke-width='2' fill='none'/><circle cx='22' cy='11' r='2' fill='currentColor' opacity='.8'/>"),
        "computation" => Svg("<rect x='2' y='11' width='8' height='10' rx='1' stroke='currentColor' stroke-width='1.5' opacity='.4'/><rect x='10' y='11' width='8' height='10' rx='1' stroke='currentColor' stroke-width='2'/><rect x='18' y='11' width='8' height='10' rx='1' stroke='currentColor' stroke-width='1.5' opacity='.4'/><text x='12' y='19.5' font-size='7' font-weight='700' font-family='monospace' fill='currentColor'>01</text><polygon points='14,6 12,9 16,9' fill='currentColor'/>"),
        "philosophy-of-math" => Svg("<text x='8' y='22' font-size='20' font-family='Georgia,serif' font-style='italic' fill='currentColor' opacity='.8'>φ</text><text x='22' y='10' font-size='8' font-family='Georgia,serif' fill='currentColor' opacity='.3'>?</text><text x='22' y='24' font-size='8' font-family='Georgia,serif' fill='currentColor' opacity='.25'>∴</text>"),
        "combinatorics" => Svg("<circle cx='16' cy='6' r='3' fill='currentColor' opacity='.5'/><circle cx='10' cy='14' r='3' fill='currentColor' opacity='.6'/><circle cx='22' cy='14' r='3' fill='currentColor' opacity='.6'/><circle cx='6' cy='22' r='3' fill='currentColor' opacity='.4'/><circle cx='16' cy='22' r='3' fill='currentColor' opacity='.7'/><circle cx='26' cy='22' r='3' fill='currentColor' opacity='.4'/>"),
        "differential-equations" => Svg("<path d='M4 26C8 26 10 20 14 14S20 6 28 4' stroke='currentColor' stroke-width='2.5' fill='none' stroke-linecap='round'/><line x1='6' y1='10' x2='10' y2='8' stroke='currentColor' stroke-width='1.5' opacity='.3' stroke-linecap='round'/><line x1='12' y1='24' x2='16' y2='22' stroke='currentColor' stroke-width='1.5' opacity='.3' stroke-linecap='round'/><line x1='22' y1='20' x2='26' y2='16' stroke='currentColor' stroke-width='1.5' opacity='.3' stroke-linecap='round'/>"),
        "philosophy-logic" => Svg("<text x='5' y='22' font-size='18' font-family='Georgia,serif' fill='currentColor' opacity='.85'>∴</text><text x='18' y='14' font-size='10' font-family='Georgia,serif' fill='currentColor' opacity='.4'>→</text><text x='18' y='26' font-size='10' font-family='Georgia,serif' fill='currentColor' opacity='.4'>∧</text>"),
        "philosophy-epistemology" => Svg("<circle cx='16' cy='16' r='10' stroke='currentColor' stroke-width='2' fill='none'/><text x='11' y='22' font-size='14' font-family='Georgia,serif' font-weight='700' fill='currentColor'>?</text>"),
        "philosophy-ethics" => Svg("<line x1='16' y1='5' x2='16' y2='27' stroke='currentColor' stroke-width='2' stroke-linecap='round'/><line x1='6' y1='10' x2='26' y2='10' stroke='currentColor' stroke-width='2' stroke-linecap='round'/><circle cx='6' cy='18' r='4' stroke='currentColor' stroke-width='1.5' fill='none'/><circle cx='26' cy='18' r='4' stroke='currentColor' stroke-width='1.5' fill='none'/>"),
        "philosophy-metaphysics" => Svg("<path d='M6 16C6 11 9 8 13 8S20 11 20 16S23 24 27 24' stroke='currentColor' stroke-width='2' fill='none' stroke-linecap='round'/><path d='M6 16C6 21 9 24 13 24S20 21 20 16S23 8 27 8' stroke='currentColor' stroke-width='2' fill='none' stroke-linecap='round' opacity='.5'/>"),
        "philosophy-mind" => Svg("<path d='M10 8C7 8 5 11 5 14C5 16 6 18 8 19C8 22 11 25 15 25C18 25 20 23 21 21C24 21 27 18 27 14C27 10 24 7 20 7C18 7 16 8 15 10C13 8 11 8 10 8Z' stroke='currentColor' stroke-width='2' fill='none'/><path d='M12 14L16 14M14 11L14 17' stroke='currentColor' stroke-width='1.2' opacity='.5'/>"),
        "philosophy-aesthetics" => Svg("<polygon points='16,4 19,13 28,13 21,18 24,27 16,22 8,27 11,18 4,13 13,13' stroke='currentColor' stroke-width='1.5' fill='currentColor' fill-opacity='.15'/>"),
        "physics-mechanics" => Svg("<circle cx='10' cy='22' r='4' fill='currentColor'/><line x1='10' y1='22' x2='26' y2='6' stroke='currentColor' stroke-width='2' stroke-linecap='round'/><polygon points='26,6 22,8 24,12' fill='currentColor'/>"),
