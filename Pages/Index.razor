@page "/"
@inject IProgressService Progress
@inject IGamificationService Gamification
@inject IContentRepository Content
@inject ISessionStateService SessionState
@inject IReviewService ReviewService
@inject INotificationService NotificationSvc
@inject NavigationManager Nav

<div class="dashboard">
    @if (savedSession != null && savedSession.ActiveTopicId != null && savedSession.ActiveLessonId != null)
    {
        <div class="card resume-banner card-clickable" @onclick="ResumeSession">
            <div class="resume-content">
                <strong>Continue where you left off</strong>
                <small>@(savedSession.InQuiz ? "Quiz in progress" : "Lesson in progress")</small>
            </div>
            <span class="resume-arrow">→</span>
        </div>
    }

    @if (profile != null && !cookieViewed)
    {
        <div class="cookie-banner card-clickable" @onclick='() => Nav.NavigateTo("/fortune")'>
            <span class="cookie-banner-icon"><Icon Name="cookie" Size="18" /></span>
            <div class="cookie-banner-text">
                <strong>Today's fortune awaits</strong>
                <small>Tap to reveal your daily math cookie</small>
            </div>
            <span class="cookie-banner-arrow">→</span>
        </div>
    }

    <div class="hero-row">
        <div class="welcome-section">
            <h1>Phine</h1>
            @if (profile != null && profile.DisplayName != "Mathematician")
            {
                <p class="welcome-greeting">Welcome back, @profile.DisplayName</p>
            }
            @if (profile != null)
            {
                <div class="stats-row">
                    <div class="streak-display">
                        <span class="streak-fire"><Icon Name="fire" Size="16" /></span> @profile.CurrentStreak day@(profile.CurrentStreak != 1 ? "s" : "")
                    </div>
                    <div class="xp-badge">
                        <Icon Name="star-filled" Size="16" Fill="currentColor" /> @profile.TotalXp XP
                    </div>
                    <div class="chip">
                        Lvl @(Gamification.GetLevel(profile.TotalXp))
                    </div>
                </div>

                <div class="xp-progress">
                    @{
                        var level = Gamification.GetLevel(profile.TotalXp);
                        var xpInLevel = Gamification.GetXpProgressInLevel(profile.TotalXp);
                        var xpNeeded = Gamification.GetXpForNextLevel(level);
                        var pct = xpNeeded > 0 ? (double)xpInLevel / xpNeeded * 100 : 0;
                    }
                    <div class="progress-bar-container">
                        <div class="progress-bar-fill accent animate-in" style="width: @pct.ToString("F0")%"></div>
                    </div>
                    <small>@xpInLevel / @xpNeeded XP to Level @(level + 1)</small>
                </div>
            }

            <div class="tools-row">
                <div class="tool-chip card-clickable" @onclick='() => Nav.NavigateTo("/formulas")'>
                    <Icon Name="book" Size="16" /> Formula Codex
                </div>
                <div class="tool-chip card-clickable" @onclick='() => Nav.NavigateTo("/graph")'>
                    <Icon Name="graph" Size="16" /> Knowledge Graph
                </div>
                @if (profile != null && cookieViewed)
                {
                    <div class="tool-chip card-clickable" @onclick='() => Nav.NavigateTo("/fortune")'>
                        <Icon Name="clock" Size="16" /> Past Cookies
                    </div>
                }
            </div>
        </div>

        <div class="action-row">
        @if (!dailyDone)
        {
            <div class="action-card action-daily card-clickable" @onclick='() => Nav.NavigateTo("/daily")'>
                <div class="action-card-icon"><Icon Name="star-filled" Size="22" Fill="currentColor" /></div>
                <div class="action-card-text">
                    <strong>Daily Challenge</strong>
                    <small>1.5x XP bonus</small>
                </div>
            </div>
        }
        else
        {
            <div class="action-card action-done">
                <div class="action-card-icon"><Icon Name="checkmark-circle" Size="22" /></div>
                <div class="action-card-text">
                    <strong>Daily Done!</strong>
                    <small>Come back tomorrow</small>
                </div>
            </div>
        }

        <div class="action-card action-quiz card-clickable" @onclick="StartQuickQuiz">
            <div class="action-card-icon"><Icon Name="zap" Size="22" /></div>
            <div class="action-card-text">
                <strong>Quick Quiz</strong>
                <small>Test yourself</small>
            </div>
        </div>

        @if (reviewDueCount > 0)
        {
            <div class="action-card action-review card-clickable" @onclick='() => Nav.NavigateTo("/review")'>
                <div class="action-card-icon"><Icon Name="brain" Size="22" /></div>
                <div class="action-card-text">
                    <strong>Review</strong>
                    <small>@reviewDueCount due</small>
                </div>
            </div>
        }
        </div>
    </div>

    @if (topics != null && suggestedTopics.Count > 0)
    {
        <div class="section">
            <div class="section-header">
                <h2>Suggested for You</h2>
            </div>
            <div class="topics-grid stagger-in">
                @foreach (var topic in suggestedTopics)
                {
                    <div class="card card-clickable topic-tile suggested-topic" style="border-color: @topic.Color" @onclick="() => NavigateToTopic(topic.Id)">
                        <div class="suggested-label" style="color: @topic.Color"><Icon Name="star-filled" Size="12" Fill="currentColor" /> Start here</div>
                        <div class="topic-tile-icon" style="background: @(topic.Color)22; color: @topic.Color">
                            @((MarkupString)GetTopicSvg(topic.Id))
                        </div>
                        <strong>@topic.Name</strong>
                        <small>@topic.LessonCount lessons</small>
                    </div>
                }
            </div>
        </div>
    }

    <div class="section">
        <div class="section-header">
            <h2>Topics</h2>
        </div>

        @if (topics != null)
        {
            @foreach (var group in GroupTopicsByLevel(topics))
            {
                <div class="topic-level-group">
                    <div class="topic-level-header">
                        <span class="topic-level-dot level-@group.Key.ToLower()"></span>
                        <h3>@group.Key</h3>
                        <small>@group.Value.Count topic@(group.Value.Count == 1 ? "" : "s")</small>
                    </div>
                    <div class="topics-grid stagger-in">
                        @foreach (var topic in group.Value)
                        {
                            var pct = topicProgress.GetValueOrDefault(topic.Id);
                            var done = pct >= 100;
                            <div class="card card-clickable topic-tile" @onclick="() => NavigateToTopic(topic.Id)">
                                <div class="topic-tile-accent" style="background: linear-gradient(135deg, @(topic.Color)18, transparent)"></div>
                                <div class="topic-tile-icon" style="background: @(topic.Color)22; color: @topic.Color">
                                    @if (done)
                                    {
                                        <Icon Name="check" Size="22" />
                                    }
                                    else
                                    {
                                        @((MarkupString)GetTopicSvg(topic.Id))
                                    }
                                </div>
                                <strong>@topic.Name</strong>
                                <small class="topic-tile-meta">@topic.LessonCount lessons · @topic.Difficulty</small>
                                <p class="topic-tile-desc">@topic.Description</p>
                                @if (pct > 0 && !done)
                                {
                                    <div class="topic-tile-progress">
                                        <div class="progress-bar-container">
                                            <div class="progress-bar-fill animate-in" style="width: @pct.ToString("F0")%; background: @topic.Color"></div>
                                        </div>
                                    </div>
                                }
                            </div>
                        }
                    </div>
                </div>
            }
        }
        else
        {
            <div class="skeleton-dashboard">
                <div class="skeleton-topics">
                    @for (int i = 0; i < 4; i++)
                    {
                        <div class="skeleton skeleton-topic">
                            <div class="skeleton skeleton-circle" style="width:40px;height:40px;flex-shrink:0"></div>
                            <div style="flex:1">
                                <div class="skeleton skeleton-text medium"></div>
                                <div class="skeleton skeleton-text long"></div>
                                <div class="skeleton skeleton-text short" style="margin-bottom:0"></div>
                            </div>
                        </div>
                    }
                </div>
            </div>
        }
    </div>

    <div class="section">
        <div class="synthesis-entry card card-clickable" @onclick='() => Nav.NavigateTo("/synthesis")'>
            <div class="synthesis-entry-bg"></div>
            <div class="synthesis-entry-icon">
                <Icon Name="zap" Size="24" />
            </div>
            <div class="synthesis-entry-text">
                <strong>Synthesis Quizzes</strong>
                <small>Cross-domain challenges · 1.5× XP</small>
            </div>
            <span class="synthesis-entry-arrow">→</span>
        </div>
    </div>

