@page "/"
@inject IProgressService Progress
@inject IContentRepository Content
@inject ISessionStateService SessionState
@inject INotificationService NotificationSvc
@inject NavigationManager Nav
@inject IJSRuntime JS

<div class="dashboard">
    <WebInstallBanner />
    @if (streakUp && profile != null)
    {
        <div class="streak-pop" role="status">
            <span class="flame"><Icon Name="fire" Size="20" /></span>
            <strong>@profile.CurrentStreak day streak</strong>
        </div>
    }
    @if (savedSession != null && savedSession.ActiveTopicId != null && savedSession.ActiveLessonId != null)
    {
        <div class="card resume-banner card-clickable" @onclick="ResumeSession">
            <div class="resume-content">
                <strong>Continue where you left off</strong>
                <small>@(savedSession.InQuiz ? "Quiz in progress" : "Lesson in progress")</small>
            </div>
            <span class="row-arrow">→</span>
        </div>
    }

    <div class="section">
        <div class="section-header subject-header">
            <h2>@DomainName(currentDomain)</h2>
            <a class="section-link" href="/domains" @onclick:preventDefault @onclick='() => Nav.NavigateTo("/domains")'>Change subject</a>
        </div>

        @if (topics != null)
        {
            @foreach (var group in GroupTopicsByLevel(topics))
            {
                <div class="topic-level-group">
                    <div class="topic-level-header">
                        <span class="topic-level-dot level-@group.Key.ToLower()"></span>
                        <h3>@group.Key</h3>
                        <small>@group.Value.Count topic@(group.Value.Count == 1 ? "" : "s")</small>
                    </div>
                    <div class="topics-grid stagger-in">
                        @foreach (var topic in group.Value)
                        {
                            var pct = topicProgress.GetValueOrDefault(topic.Id);
                            var done = pct >= 100;
                            <div class="card card-clickable topic-tile" @onclick="() => NavigateToTopic(topic.Id)">
                                @if (suggestedTopics.Any(s => s.Id == topic.Id))
                                {
                                    <div class="suggested-label" style="color: @topic.Color">Start here</div>
                                }
                                <div class="topic-tile-icon" style="color: @topic.Color">
                                    @if (done)
                                    {
                                        <Icon Name="check" Size="22" />
                                    }
                                    else
                                    {
                                        @((MarkupString)TopicArt.For(topic.Id))
                                    }
                                </div>
                                <strong>@topic.Name</strong>
                                <small class="topic-tile-meta">@topic.LessonCount lessons</small>
                                <p class="topic-tile-desc">@topic.Description</p>
                                @if (pct > 0 && !done)
                                {
                                    <div class="topic-tile-progress">
                                        <div class="progress-bar-container">
                                            <div class="progress-bar-fill animate-in" style="width: @pct.ToString("F0")%; background: @topic.Color"></div>
                                        </div>
                                    </div>
                                }
                            </div>
                        }
                    </div>
                </div>
            }
        }
        else
        {
            <div class="skeleton-dashboard">
                <div class="skeleton-topics">
                    @for (int i = 0; i < 4; i++)
                    {
                        <div class="skeleton skeleton-topic">
                            <div class="skeleton skeleton-circle" style="width:40px;height:40px;flex-shrink:0"></div>
                            <div style="flex:1">
                                <div class="skeleton skeleton-text medium"></div>
                                <div class="skeleton skeleton-text long"></div>
                                <div class="skeleton skeleton-text short" style="margin-bottom:0"></div>
                            </div>
                        </div>
                    }
                </div>
            </div>
        }
        <a class="feedback-link" href="@FeedbackLinks.TopicRequest(DomainName(currentDomain))"><Icon Name="message" Size="13" /> Missing a topic in @DomainName(currentDomain)? Request one</a>
    </div>

    @{
        var labs = LabsForDomain().ToList();
        var openLabs = labs.Where(l => l.Unlocked).Select(l => l.Lab).ToList();
        var lockedLabs = labs.Where(l => !l.Unlocked).Select(l => l.Lab).ToList();
    }
    @if (labs.Count > 0)
    {
        <div class="section">
            <h2 class="home-section-title">Labs</h2>
            @if (openLabs.Count > 0)
            {
                <div class="lab-grid">
                    @foreach (var lab in openLabs)
                    {
                        var route = lab.Route;
                        <div class="lab-card card-clickable" @onclick="() => Nav.NavigateTo(route)">
                            <span class="lab-icon" style="color: @lab.Color"><Icon Name="@lab.Icon" Size="22" /></span>
                            <div class="lab-text">
                                <strong>@lab.Name</strong>
                                <small>@lab.Blurb</small>
                            </div>
                            <span class="row-arrow">→</span>
                        </div>
                    }
                </div>
            }
            @if (lockedLabs.Count > 0)
            {
                <div class="labs-locked card-clickable" @onclick='() => Nav.NavigateTo("/shop/feature")'>
                    <Icon Name="lock" Size="16" />
                    <span class="labs-locked-text"><strong>More in the Shop</strong><small>@string.Join(", ", lockedLabs.Select(l => l.Name))</small></span>
                    <span class="row-arrow">→</span>
                </div>
            }
        </div>
    }

    <div class="section">
        <h2 class="home-section-title">Tools</h2>
        <div class="tool-grid">
            @foreach (var tool in Tools)
            {
                var route = tool.Route;
                <a class="tool-link" href="@route" @onclick:preventDefault @onclick="() => Nav.NavigateTo(route)">
                    <Icon Name="@tool.Icon" Size="18" />
                    <span>@tool.Label</span>
                    @if (route == "/fortune" && profile != null && !cookieViewed)
                    {
                        <span class="tool-new" title="Today's cookie is waiting"></span>
                    }
                </a>
            }
        </div>
    </div>
</div>

@code {
    private UserProfile? profile;
    private List<Topic>? topics;
    private List<Topic> suggestedTopics = new();
    private Dictionary<string, double> topicProgress = new();
    private SessionState? savedSession;
    private string currentDomain = "math";

    private static readonly (string Label, string Icon, string Route)[] Tools =
    {
        ("Formula Codex", "book", "/formulas"),
        ("Knowledge Graph", "graph", "/graph"),
        ("Guided Paths", "compass-rose", "/paths"),
        ("Big Questions", "lightbulb", "/big-questions"),
        ("Notebook", "pencil", "/notebook"),
        ("Fortune Cookie", "cookie", "/fortune"),
    };

    // Hands-on pages for each subject. Domain "*" shows everywhere; a "*" in UnlockId stands for the
    // current subject. UnlockId null means free.
    private sealed record Lab(string Domain, string Name, string Blurb, string Icon, string Color, string Route, string? UnlockId = null);

    private static readonly Lab[] Labs =
    {
        new("*", "Hall of Fame", "Great minds on a timeline", "award", "var(--accent)", "/hall-of-fame", "unlock-halloffame-*"),
        new("math", "What If?", "Break the rules of math", "target", "var(--primary)", "/playground", "unlock-playground"),
        new("math", "Constants", "Numbers that define reality", "book", "var(--accent)", "/compendium", "unlock-compendium"),
        new("math", "Proof Builder", "Build proofs from blocks", "puzzle", "var(--primary)", "/proofs", "unlock-proofs"),
        new("math", "Mistake Museum", "Spot the flaw", "search", "var(--accent)", "/mistakes", "unlock-mistakes"),
        new("physics", "Particle Sandbox", "Smash particles, see decays", "rocket", "var(--primary)", "/particle-sandbox"),
        new("physics", "Cosmic Scale", "Planck length to universe", "target", "var(--accent)", "/cosmic-scale"),
        new("biology", "Evolution Sim", "Selection, drift and mutation", "trending-up", "var(--primary)", "/evolution-sim"),
        new("biology", "Cell Tour", "Tap organelles or take the quiz", "search", "var(--accent)", "/cell-tour"),
        new("chemistry", "Reaction Bench", "Combine reagents, see results", "fire", "var(--primary)", "/reaction-bench"),
        new("chemistry", "Molecule Builder", "Drag atoms, build molecules", "puzzle", "var(--accent)", "/molecule-builder"),
        new("geology", "Deep Time", "4.5 Gyr scrollable timeline", "clock", "var(--primary)", "/deep-time"),
        new("geology", "Rock ID", "Identify samples", "search", "var(--accent)", "/rock-id"),
        new("history", "Era Map", "Empires across time", "calendar", "var(--primary)", "/era-map"),
        new("history", "Trade Routes", "Silk Road, Spice Route, more", "trending-up", "var(--accent)", "/trade-routes"),
        new("linguistics", "Etymology", "Trace words to PIE roots", "scroll", "var(--primary)", "/etymology"),
        new("linguistics", "Sound Shift", "Run Grimm's Law on a word", "speech", "var(--accent)", "/sound-shift"),
        new("philosophy", "Trolley Lab", "Branching ethical dilemmas", "puzzle", "var(--primary)", "/trolley-lab"),
        new("materials", "Phase Diagram", "Drag T/P, change states", "flask", "var(--primary)", "/phase-diagram"),
        new("cs", "Algorithm Race", "Sorts head-to-head", "code", "var(--primary)", "/algorithm-race"),
        new("misc", "Cipher Decoder", "Layered cipher puzzles", "eye", "var(--primary)", "/cipher-decoder"),
        new("politics", "Power Map", "Voter sim and electoral systems", "balance-scale", "var(--primary)", "/power-map"),
        new("economics", "Market Sim", "Supply, demand, taxes, deadweight", "coin", "var(--primary)", "/market-sim"),
        new("media", "Front Page", "Build a story, see the framing", "antenna", "var(--primary)", "/front-page"),
        new("literature", "Plot Geometry", "Freytag pyramids of famous works", "quill", "var(--primary)", "/plot-geometry"),
    };

    // Hall of Fame has no figure list for these subjects yet.
    private static readonly HashSet<string> NoHallOfFame = new() { "religion", "psychology" };

    private IEnumerable<(Lab Lab, bool Unlocked)> LabsForDomain() =>
        Labs.Where(l => (l.Domain == "*" && !NoHallOfFame.Contains(currentDomain)) || l.Domain == currentDomain)
            .Select(l => (l, l.UnlockId == null || profile?.ShopPurchases.Contains(l.UnlockId.Replace("*", currentDomain)) == true));
    private bool cookieViewed;
    private bool streakUp;
    private List<Domain> allDomains = new();

    private string DomainName(string id) => allDomains.FirstOrDefault(d => d.Id == id)?.Name ?? id;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            var streakBefore = (await Progress.GetProfileAsync()).CurrentStreak;
            await Progress.UpdateStreakAsync();
            await Progress.StartSessionAsync();
            profile = await Progress.GetProfileAsync();
            // Day one is not news; from day two the first open of the day gets a moment.
            streakUp = profile.CurrentStreak > streakBefore && profile.CurrentStreak >= 2;
            if (profile.TotalXp == 0 && profile.DisplayName == "Mathematician")
            {
                Nav.NavigateTo("/welcome");
                return;
            }
            // Refresh notification schedules silently on every app start.
            _ = NotificationSvc.RefreshSchedulesAsync();

            topics = await Content.GetTopicsByDomainAsync(profile.CurrentDomain);
            allDomains = await Content.GetDomainsAsync();
            savedSession = await SessionState.LoadSessionStateAsync();
            currentDomain = string.IsNullOrEmpty(profile.CurrentDomain) ? "math" : profile.CurrentDomain;
            cookieViewed = profile.ViewedCookieDates.Contains(DateTime.Now.ToString("yyyy-MM-dd"));

            // Paint the subject first; topic progress fills in after.
            StateHasChanged();
            if (streakUp)
            {
                await JS.TryInvokeVoidAsync("Sounds.playStreak");
                await JS.TryInvokeVoidAsync("Haptics.light");
            }

            foreach (var topic in topics)
            {
                topicProgress[topic.Id] = await Progress.GetTopicProgressAsync(topic.Id);
            }

            // Show suggestions for topics the user picked in onboarding but hasn't started
            if (profile.SuggestedTopicIds.Count > 0)
            {
                suggestedTopics = topics
                    .Where(t => profile.SuggestedTopicIds.Contains(t.Id) && topicProgress.GetValueOrDefault(t.Id) == 0)
                    .ToList();
            }

            StateHasChanged();
        }
    }




    private void ResumeSession()
    {
        if (savedSession?.ActiveTopicId != null && savedSession.ActiveLessonId != null)
        {
            Nav.NavigateTo($"/topic/{savedSession.ActiveTopicId}/lesson/{savedSession.ActiveLessonId}");
        }
    }

    private void NavigateToTopic(string topicId)
    {
        Nav.NavigateTo($"/topic/{topicId}");
    }

    private static readonly string[] LevelOrder = { "Beginner", "Intermediate", "Advanced", "Graduate" };

    private static List<KeyValuePair<string, List<Topic>>> GroupTopicsByLevel(List<Topic> topics)
    {
        var groups = topics
            .GroupBy(t => GetStartLevel(t.Difficulty))
            .OrderBy(g => Array.IndexOf(LevelOrder, g.Key) is var i && i < 0 ? int.MaxValue : i)
            .Select(g => new KeyValuePair<string, List<Topic>>(g.Key, g.ToList()))
            .ToList();
        return groups;
    }

    private static string GetStartLevel(string difficulty)
    {
        if (string.IsNullOrWhiteSpace(difficulty)) return "Other";
        var first = difficulty.Split('→', '-')[0].Trim();
        return LevelOrder.Contains(first) ? first : (string.IsNullOrEmpty(first) ? "Other" : first);
    }
}

<style>
    .dashboard {
        padding-top: 8px;
    }

    .topics-grid {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 8px;
    }

    .topic-level-group {
        margin-bottom: 18px;
    }

    .topic-level-group:last-child {
        margin-bottom: 0;
    }

    .topic-level-header {
        display: flex;
        align-items: center;
        gap: 8px;
        margin: 0 0 10px;
        padding: 0 2px;
    }

    .topic-level-header h3 {
        margin: 0;
        font-size: 0.95rem;
        font-weight: 600;
        color: var(--text-primary);
    }

    .topic-level-header small {
        color: var(--text-muted);
        font-size: 0.75rem;
        margin-left: auto;
    }

    .topic-level-dot {
        width: 8px;
        height: 8px;
        border-radius: 50%;
        flex-shrink: 0;
        background: var(--text-muted);
    }

    .topic-level-dot.level-beginner { background: var(--success); }
    .topic-level-dot.level-intermediate { background: var(--accent); }
    .topic-level-dot.level-advanced { background: var(--primary); }
    .topic-level-dot.level-graduate { background: var(--primary-dark); }

    .topic-tile {
        display: flex;
        flex-direction: column;
        align-items: center;
        text-align: center;
        padding: 16px 8px;
        gap: 6px;
        position: relative;
        overflow: hidden;
    }

    .topic-tile strong { font-size: 0.85rem; position: relative; }
    .topic-tile-meta { color: var(--text-muted); font-size: 0.75rem; position: relative; }
    .topic-tile-desc { display: none; }

    .topic-tile-icon {
        width: 32px;
        height: 32px;
        border-radius: 14px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.4rem;
        font-weight: bold;
        margin-bottom: 2px;
        position: relative;
    }

    .topic-tile-progress {
        width: 100%;
        margin-top: 2px;
        position: relative;
    }

    .suggested-label {
        font-size: 0.72rem;
        font-weight: 700;
    }

    .resume-banner {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 14px 18px;
        margin-bottom: 16px;
        background: var(--bg-card);
    }

    .resume-content {
        display: flex;
        flex-direction: column;
        gap: 2px;
    }

    .resume-content small {
        color: var(--text-muted);
        font-size: 0.8rem;
    }

    /* Tablet */
    @@media (min-width: 768px) {
        .topics-grid {
            grid-template-columns: repeat(auto-fill, minmax(160px, 1fr));
            gap: 12px;
        }

        .topic-tile {
            padding: 20px 14px;
            gap: 8px;
        }

        .topic-tile-icon {
            width: 38px;
            height: 38px;
            font-size: 1.7rem;
            border-radius: 16px;
        }

        .topic-tile strong { font-size: 0.95rem; }
    }


    /* Desktop */
    @@media (min-width: 1024px) {
        .topics-grid {
            grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
            gap: 16px;
        }

        .topic-tile {
            padding: 24px 16px;
            gap: 8px;
        }

        .topic-tile-icon {
            width: 44px;
            height: 44px;
            font-size: 1.9rem;
            border-radius: 18px;
        }

        .topic-tile strong { font-size: 1rem; }
        .topic-tile-meta { font-size: 0.8rem; }

        .topic-tile-desc {
            display: block;
            font-size: 0.8rem;
            color: var(--text-muted);
            line-height: 1.4;
            margin: 0;
            position: relative;
        }
    }



    .home-section-title { font-size: 1.05rem; margin: 0 0 10px; }

    .row-arrow { color: var(--text-muted); font-size: 1.1rem; flex-shrink: 0; }

    .tool-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 8px; }
    .tool-link {
        position: relative; display: flex; align-items: center; gap: 10px; padding: 11px 12px;
        border-radius: 10px; background: var(--bg-card); border: 1px solid var(--border);
        color: var(--text-secondary); font-size: 0.88rem; font-weight: 600; text-decoration: none;
        -webkit-tap-highlight-color: transparent;
    }
    .tool-link:active { background: var(--bg-surface); }
    .tool-link span:first-of-type { flex: 1; }
    .tool-new { position: absolute; top: 7px; right: 7px; width: 7px; height: 7px; border-radius: 50%; background: var(--primary); }

    .subject-header h2 { margin: 0; }

    /* Keeps the top rows clear of NavBar's fixed level ring (48px + 12px inset), which desktop hides. */
    @@media (max-width: 1023px) {
        .subject-header { padding-right: 60px; }
        .dashboard > .web-banner { margin-right: 60px; }
    }
    .section-link { color: var(--primary); font-size: 0.88rem; font-weight: 600; text-decoration: none; }

    .lab-grid { display: grid; grid-template-columns: 1fr; gap: 8px; margin-bottom: 8px; }
    .lab-card {
        display: flex; align-items: center; gap: 12px; padding: 12px 14px;
        border-radius: var(--radius-md); background: var(--bg-card); border: 1px solid var(--border);
    }
    .lab-icon { display: flex; flex-shrink: 0; }
    .lab-text { flex: 1; display: flex; flex-direction: column; gap: 1px; min-width: 0; }
    .lab-text strong { font-size: 0.92rem; }
    .lab-text small { color: var(--text-muted); font-size: 0.78rem; }
    .labs-locked {
        display: flex; align-items: center; gap: 10px; padding: 10px 14px; margin-bottom: 8px;
        border-radius: var(--radius-md); border: 1px dashed var(--border);
        color: var(--text-muted); font-size: 0.82rem;
    }
    .labs-locked-text { flex: 1; display: flex; flex-direction: column; gap: 1px; }
    .labs-locked strong { color: var(--text-secondary); font-weight: 600; }

    @@media (min-width: 768px) {
        .tool-grid { grid-template-columns: repeat(3, 1fr); }
        .lab-grid { grid-template-columns: repeat(2, 1fr); }
    }
</style>
