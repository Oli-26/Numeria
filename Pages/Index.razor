@page "/"
@inject IProgressService Progress
@inject IGamificationService Gamification
@inject IContentRepository Content
@inject ISessionStateService SessionState
@inject IReviewService ReviewService
@inject NavigationManager Nav

<div class="dashboard">
    @if (savedSession != null && savedSession.ActiveTopicId != null && savedSession.ActiveLessonId != null)
    {
        <div class="card resume-banner card-clickable" @onclick="ResumeSession">
            <div class="resume-content">
                <strong>Continue where you left off</strong>
                <small>@(savedSession.InQuiz ? "Quiz in progress" : "Lesson in progress")</small>
            </div>
            <span class="resume-arrow">→</span>
        </div>
    }

    @if (profile != null && !cookieViewed)
    {
        <div class="cookie-banner card-clickable" @onclick='() => Nav.NavigateTo("/fortune")'>
            <span class="cookie-banner-icon"><Icon Name="cookie" Size="18" /></span>
            <div class="cookie-banner-text">
                <strong>Today's fortune awaits</strong>
                <small>Tap to reveal your daily math cookie</small>
            </div>
            <span class="cookie-banner-arrow">→</span>
        </div>
    }

    <div class="welcome-section">
        <h1>Numeria</h1>
        @if (profile != null && profile.DisplayName != "Mathematician")
        {
            <p class="welcome-greeting">Welcome back, @profile.DisplayName</p>
        }
        @if (profile != null)
        {
            <div class="stats-row">
                <div class="streak-display">
                    <span class="streak-fire"><Icon Name="fire" Size="16" /></span> @profile.CurrentStreak day@(profile.CurrentStreak != 1 ? "s" : "")
                </div>
                <div class="xp-badge">
                    <Icon Name="star-filled" Size="16" Fill="currentColor" /> @profile.TotalXp XP
                </div>
                <div class="chip">
                    Lvl @(Gamification.GetLevel(profile.TotalXp))
                </div>
            </div>

            <div class="xp-progress">
                @{
                    var level = Gamification.GetLevel(profile.TotalXp);
                    var xpInLevel = Gamification.GetXpProgressInLevel(profile.TotalXp);
                    var xpNeeded = Gamification.GetXpForNextLevel(level);
                    var pct = xpNeeded > 0 ? (double)xpInLevel / xpNeeded * 100 : 0;
                }
                <div class="progress-bar-container">
                    <div class="progress-bar-fill accent animate-in" style="width: @pct.ToString("F0")%"></div>
                </div>
                <small>@xpInLevel / @xpNeeded XP to Level @(level + 1)</small>
            </div>
        }
    </div>

    <div class="tools-row">
        <div class="tool-chip card-clickable" @onclick='() => Nav.NavigateTo("/formulas")'>
            <Icon Name="book" Size="16" /> Formula Codex
        </div>
        @if (profile != null && cookieViewed)
        {
            <div class="tool-chip card-clickable" @onclick='() => Nav.NavigateTo("/fortune")'>
                <Icon Name="clock" Size="16" /> Past Cookies
            </div>
        }
    </div>

    <div class="section action-buttons">
        @if (!dailyDone)
        {
            <button class="btn btn-accent btn-lg action-btn" @onclick='() => Nav.NavigateTo("/daily")'>
                <Icon Name="star-filled" Size="18" Fill="currentColor" /> Daily Challenge
                <small>1.5x XP</small>
            </button>
        }
        else
        {
            <div class="btn btn-outline btn-lg action-btn daily-done-btn" style="cursor: default; opacity: 0.6">
                <Icon Name="checkmark-circle" Size="18" /> Daily Done!
            </div>
        }

        @if (reviewDueCount > 0)
        {
            <button class="btn btn-primary btn-lg action-btn" @onclick='() => Nav.NavigateTo("/review")'>
                <Icon Name="brain" Size="18" /> Review (@reviewDueCount due)
            </button>
        }

        <button class="btn btn-outline btn-lg action-btn" @onclick="StartQuickQuiz">
            <Icon Name="zap" Size="18" /> Quick Quiz
        </button>
    </div>

    @if (topics != null && suggestedTopics.Count > 0)
    {
        <div class="section">
            <div class="section-header">
                <h2>Suggested for You</h2>
            </div>
            <div class="topics-grid stagger-in">
                @foreach (var topic in suggestedTopics)
                {
                    <div class="card card-clickable topic-tile suggested-topic" style="border-color: @topic.Color" @onclick="() => NavigateToTopic(topic.Id)">
                        <div class="suggested-label" style="color: @topic.Color"><Icon Name="star-filled" Size="12" Fill="currentColor" /> Start here</div>
                        <div class="topic-tile-icon" style="background: @(topic.Color)1a; color: @topic.Color">
                            <span>@GetTopicIcon(topic.Id)</span>
                        </div>
                        <strong>@topic.Name</strong>
                        <small>@topic.LessonCount lessons</small>
                    </div>
                }
            </div>
        </div>
    }

    <div class="section">
        <div class="section-header">
            <h2>Topics</h2>
        </div>

        @if (topics != null)
        {
            <div class="topics-grid stagger-in">
                @foreach (var topic in topics)
                {
                    var pct = topicProgress.GetValueOrDefault(topic.Id);
                    var done = pct >= 100;
                    <div class="card card-clickable topic-tile" @onclick="() => NavigateToTopic(topic.Id)">
                        <div class="topic-tile-icon" style="background: @(topic.Color)1a; color: @topic.Color">
                            @if (done)
                            {
                                <Icon Name="check" Size="22" />
                            }
                            else
                            {
                                <span>@GetTopicIcon(topic.Id)</span>
                            }
                        </div>
                        <strong>@topic.Name</strong>
                        <small>@topic.LessonCount lessons</small>
                        @if (pct > 0 && !done)
                        {
                            <div class="topic-tile-progress">
                                <div class="progress-bar-container">
                                    <div class="progress-bar-fill animate-in" style="width: @pct.ToString("F0")%; background: @topic.Color"></div>
                                </div>
                            </div>
                        }
                    </div>
                }
            </div>
        }
        else
        {
            <div class="skeleton-dashboard">
                <div class="skeleton-topics">
                    @for (int i = 0; i < 4; i++)
                    {
                        <div class="skeleton skeleton-topic">
                            <div class="skeleton skeleton-circle" style="width:40px;height:40px;flex-shrink:0"></div>
                            <div style="flex:1">
                                <div class="skeleton skeleton-text medium"></div>
                                <div class="skeleton skeleton-text long"></div>
                                <div class="skeleton skeleton-text short" style="margin-bottom:0"></div>
                            </div>
                        </div>
                    }
                </div>
            </div>
        }
    </div>

    <div class="section">
        <div class="section-header">
            <h2>Explore</h2>
        </div>
        <div class="explore-grid">
            <div class="explore-card card-clickable @(playgroundUnlocked ? "unlocked" : "")" style="--accent-color: #9B59B6" @onclick="() => GoPlayground()">
                <div class="explore-card-bg"></div>
                <div class="explore-card-content">
                    <div class="explore-icon"><Icon Name="target" Size="24" /></div>
                    <div class="explore-text">
                        <strong>What If?</strong>
                        <small>@(playgroundUnlocked ? "Break the rules of math" : "Unlock in Shop")</small>
                    </div>
                </div>
                @if (!playgroundUnlocked)
                {
                    <div class="explore-lock"><Icon Name="lock" Size="14" /></div>
                }
            </div>
            <div class="explore-card card-clickable @(hofUnlocked ? "unlocked" : "")" style="--accent-color: var(--accent)" @onclick="() => GoHallOfFame()">
                <div class="explore-card-bg"></div>
                <div class="explore-card-content">
                    <div class="explore-icon"><Icon Name="award" Size="24" /></div>
                    <div class="explore-text">
                        <strong>Hall of Fame</strong>
                        <small>@(hofUnlocked ? "Top Trumps + Timeline" : "Unlock in Shop")</small>
                    </div>
                </div>
                @if (!hofUnlocked)
                {
                    <div class="explore-lock"><Icon Name="lock" Size="14" /></div>
                }
            </div>
            <div class="explore-card card-clickable @(compendiumUnlocked ? "unlocked" : "")" style="--accent-color: #4A90D9" @onclick="() => GoCompendium()">
                <div class="explore-card-bg"></div>
                <div class="explore-card-content">
                    <div class="explore-icon"><Icon Name="book" Size="24" /></div>
                    <div class="explore-text">
                        <strong>Constants</strong>
                        <small>@(compendiumUnlocked ? "Numbers that define reality" : "Unlock in Shop")</small>
                    </div>
                </div>
                @if (!compendiumUnlocked)
                {
                    <div class="explore-lock"><Icon Name="lock" Size="14" /></div>
                }
            </div>
            <div class="explore-card card-clickable @(proofsUnlocked ? "unlocked" : "")" style="--accent-color: var(--primary)" @onclick='() => Nav.NavigateTo("/proofs")'>
                <div class="explore-card-bg"></div>
                <div class="explore-card-content">
                    <div class="explore-icon"><Icon Name="puzzle" Size="24" /></div>
                    <div class="explore-text">
                        <strong>Proof Builder</strong>
                        <small>@(proofsUnlocked ? "Build proofs from blocks" : "Unlock in Shop")</small>
                    </div>
                </div>
                @if (!proofsUnlocked)
                {
                    <div class="explore-lock"><Icon Name="lock" Size="14" /></div>
                }
            </div>
            <div class="explore-card card-clickable @(mistakesUnlocked ? "unlocked" : "")" style="--accent-color: var(--error)" @onclick='() => Nav.NavigateTo("/mistakes")'>
                <div class="explore-card-bg"></div>
                <div class="explore-card-content">
                    <div class="explore-icon"><Icon Name="search" Size="24" /></div>
                    <div class="explore-text">
                        <strong>Mistake Museum</strong>
                        <small>@(mistakesUnlocked ? "Spot the flaw" : "Unlock in Shop")</small>
                    </div>
                </div>
                @if (!mistakesUnlocked)
                {
                    <div class="explore-lock"><Icon Name="lock" Size="14" /></div>
                }
            </div>
        </div>
    </div>
</div>

@code {
    private UserProfile? profile;
    private List<Topic>? topics;
    private List<Topic> suggestedTopics = new();
    private Dictionary<string, double> topicProgress = new();
    private SessionState? savedSession;
    private int reviewDueCount;
    private bool dailyDone;
    private bool proofsUnlocked;
    private bool mistakesUnlocked;
    private bool playgroundUnlocked;
    private bool compendiumUnlocked;
    private bool hofUnlocked;
    private bool cookieViewed;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await Progress.UpdateStreakAsync();
            await Progress.StartSessionAsync();
            profile = await Progress.GetProfileAsync();
            if (profile.TotalXp == 0 && profile.DisplayName == "Mathematician")
            {
                Nav.NavigateTo("/welcome");
                return;
            }
            topics = await Content.GetTopicsAsync();
            savedSession = await SessionState.LoadSessionStateAsync();
            reviewDueCount = await ReviewService.GetDueCountAsync();
            var today = DateTime.Now.ToString("yyyy-MM-dd");
            dailyDone = profile.DailyChallengeDate == today && profile.DailyChallengeCompleted;
            proofsUnlocked = profile.ShopPurchases.Contains("unlock-proofs");
            mistakesUnlocked = profile.ShopPurchases.Contains("unlock-mistakes");
            playgroundUnlocked = profile.ShopPurchases.Contains("unlock-playground");
            compendiumUnlocked = profile.ShopPurchases.Contains("unlock-compendium");
            hofUnlocked = profile.ShopPurchases.Contains("unlock-halloffame");
            cookieViewed = profile.ViewedCookieDates.Contains(DateTime.Now.ToString("yyyy-MM-dd"));

            foreach (var topic in topics)
            {
                topicProgress[topic.Id] = await Progress.GetTopicProgressAsync(topic.Id);
            }

            // Show suggestions for topics the user picked in onboarding but hasn't started
            if (profile.SuggestedTopicIds.Count > 0)
            {
                suggestedTopics = topics
                    .Where(t => profile.SuggestedTopicIds.Contains(t.Id) && topicProgress.GetValueOrDefault(t.Id) == 0)
                    .ToList();
            }

            StateHasChanged();
        }
    }

    private void GoHallOfFame()
    {
        Nav.NavigateTo(hofUnlocked ? "/hall-of-fame" : "/shop/feature");
    }

    private void GoCompendium()
    {
        Nav.NavigateTo(compendiumUnlocked ? "/compendium" : "/shop/feature");
    }

    private void GoPlayground()
    {
        Nav.NavigateTo(playgroundUnlocked ? "/playground" : "/shop/feature");
    }

    private void ResumeSession()
    {
        if (savedSession?.ActiveTopicId != null && savedSession.ActiveLessonId != null)
        {
            Nav.NavigateTo($"/topic/{savedSession.ActiveTopicId}/lesson/{savedSession.ActiveLessonId}");
        }
    }

    private string GetTopicIcon(string topicId) => topicId switch
    {
        "calculus" => "∫",
        "linear-algebra" => "⟨⟩",
        "topology" => "∾",
        "number-theory" => "ℙ",
        "probability" => "⚄",
        "group-theory" => "⬡",
        "graph-theory" => "○—○",
        "differential-geometry" => "κ",
        "set-theory" => "∀∃",
        "fractals" => "✳",
        "fourier-analysis" => "∿",
        "complex-analysis" => "ℂ",
        "computation" => "⊢",
        "philosophy-of-math" => "φ",
        "combinatorics" => "nCr",
        "differential-equations" => "dy",
        _ => "∑"
    };

    private void NavigateToTopic(string topicId)
    {
        Nav.NavigateTo($"/topic/{topicId}");
    }

    private void StartQuickQuiz()
    {
        Nav.NavigateTo("/quiz/mixed/all");
    }
}

<style>
    .dashboard {
        padding-top: 8px;
    }

    .welcome-section {
        text-align: center;
        margin-bottom: 24px;
    }

    .welcome-section h1 {
        font-family: 'Cinzel', 'Cambria Math', 'STIX Two Math', Georgia, serif;
        font-size: 2.4rem;
        font-weight: 700;
        letter-spacing: 0.12em;
        background: linear-gradient(90deg, var(--primary), var(--primary-light), #ff8ec6, var(--primary));
        background-size: 200% auto;
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        background-clip: text;
        margin-bottom: 12px;
        animation: titleShimmer 3s linear infinite;
    }

    @@keyframes titleShimmer {
        to { background-position: 200% center; }
    }

    .stats-row {
        display: flex;
        justify-content: center;
        gap: 12px;
        margin-bottom: 12px;
        flex-wrap: wrap;
    }

    .xp-progress {
        max-width: 300px;
        margin: 0 auto;
    }

    .xp-progress small {
        color: var(--text-muted);
        font-size: 0.8rem;
    }

    .topics-grid {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 8px;
    }

    .topic-tile {
        display: flex;
        flex-direction: column;
        align-items: center;
        text-align: center;
        padding: 16px 8px;
        gap: 6px;
    }

    .topic-tile strong { font-size: 0.85rem; }
    .topic-tile small { color: var(--text-muted); font-size: 0.75rem; }

    .topic-tile-icon {
        width: 48px;
        height: 48px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.4rem;
        font-weight: bold;
        margin-bottom: 2px;
    }

    .topic-tile-progress {
        width: 100%;
        margin-top: 2px;
    }

    .suggested-topic {
        border-width: 2px;
        border-style: solid;
        position: relative;
    }

    .suggested-label {
        font-size: 0.7rem;
        font-weight: 700;
        display: flex;
        align-items: center;
        gap: 4px;
    }

    .welcome-greeting {
        color: var(--text-muted);
        font-size: 0.9rem;
        margin: 0 0 8px;
    }

    .action-buttons {
        display: flex;
        flex-direction: column;
        gap: 10px;
    }

    .action-btn {
        width: 100%;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
    }

    .action-btn small {
        background: rgba(255,255,255,0.2);
        padding: 1px 8px;
        border-radius: 10px;
        font-size: 0.75rem;
    }


    .daily-done-btn {
        border-color: var(--success) !important;
        color: var(--success) !important;
    }

    .resume-banner {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 14px 18px;
        margin-bottom: 16px;
        background: var(--bg-card);
    }

    .resume-content {
        display: flex;
        flex-direction: column;
        gap: 2px;
    }

    .resume-content small {
        color: var(--text-muted);
        font-size: 0.8rem;
    }

    .resume-arrow {
        font-size: 1.3rem;
        color: var(--accent);
    }

    .explore-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
        gap: 10px;
    }

    .explore-card {
        position: relative;
        border-radius: var(--radius-md);
        padding: 16px;
        overflow: hidden;
        background: var(--bg-card);
        border: 1px solid var(--border);
        opacity: 0.5;
        transition: opacity 0.2s ease, transform 0.2s ease;
    }

    .explore-card.unlocked {
        opacity: 1;
    }

    .explore-card-bg {
        position: absolute;
        inset: 0;
        background: linear-gradient(135deg, transparent 50%, color-mix(in srgb, var(--accent-color) 8%, transparent));
        pointer-events: none;
    }

    .explore-card-content {
        position: relative;
        display: flex;
        align-items: center;
        gap: 12px;
    }

    .explore-icon {
        width: 44px;
        height: 44px;
        border-radius: 10px;
        background: color-mix(in srgb, var(--accent-color) 12%, transparent);
        color: var(--accent-color);
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
    }

    .explore-text {
        display: flex;
        flex-direction: column;
        gap: 2px;
    }

    .explore-text strong { font-size: 0.9rem; }
    .explore-text small { color: var(--text-muted); font-size: 0.75rem; }

    .explore-lock {
        position: absolute;
        top: 8px;
        right: 8px;
        color: var(--text-muted);
        opacity: 0.6;
    }

    /* Tool chips */
    .tools-row {
        display: flex; gap: 8px; margin-bottom: 16px; flex-wrap: wrap;
    }
    .tool-chip {
        display: inline-flex; align-items: center; gap: 6px;
        padding: 8px 14px; border-radius: 20px;
        background: var(--bg-card); border: 1px solid var(--border);
        font-size: 0.8rem; font-weight: 600; color: var(--text-secondary);
        cursor: pointer; transition: all 0.2s ease;
        -webkit-tap-highlight-color: transparent;
    }
    .tool-chip:active { transform: scale(0.95); background: var(--bg-surface); }

    /* Fortune cookie banner */
    .cookie-banner {
        display: flex; align-items: center; gap: 12px;
        padding: 12px 16px; margin-bottom: 16px;
        background: linear-gradient(135deg, rgba(45,43,107,0.08), rgba(180,140,255,0.08));
        border: 1px solid rgba(180,140,255,0.2);
        border-radius: var(--radius-md);
        cursor: pointer; -webkit-tap-highlight-color: transparent;
    }
    .cookie-banner:active { transform: scale(0.98); }

    .cookie-banner-icon {
        font-size: 1.8rem;
        animation: cookieBannerBob 2s ease-in-out infinite;
    }

    .cookie-banner-text { flex: 1; }
    .cookie-banner-text strong { display: block; font-size: 0.9rem; }
    .cookie-banner-text small { color: var(--text-muted); font-size: 0.8rem; }
    .cookie-banner-arrow { color: var(--primary); font-size: 1.1rem; }

    @@keyframes cookieBannerBob {
        0%, 100% { transform: rotate(-5deg); }
        50% { transform: rotate(5deg); }
    }

    /* Tablet */
    @@media (min-width: 768px) {
        .topics-grid {
            grid-template-columns: repeat(auto-fill, minmax(130px, 1fr));
            gap: 12px;
        }

        .action-buttons {
            flex-direction: row;
        }

        .action-btn {
            width: auto;
            flex: 1;
        }

        .topic-tile-icon {
            width: 56px;
            height: 56px;
            font-size: 1.6rem;
        }

        .welcome-section {
            text-align: left;
        }

        .xp-progress {
            margin: 0;
        }

        .stats-row {
            justify-content: flex-start;
        }
    }

    /* Desktop */
    @@media (min-width: 1024px) {
        .topic-tile {
            padding: 20px 12px;
        }

        .topic-tile strong { font-size: 0.9rem; }
        .topic-tile small { font-size: 0.8rem; }
    }
</style>
