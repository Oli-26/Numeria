    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await Progress.UpdateStreakAsync();
            await Progress.StartSessionAsync();
            profile = await Progress.GetProfileAsync();
            if (profile.TotalXp == 0 && profile.DisplayName == "Mathematician")
            {
                Nav.NavigateTo("/welcome");
                return;
            }
            // Refresh notification schedules silently on every app start.
            _ = NotificationSvc.RefreshSchedulesAsync();

            topics = await Content.GetTopicsByDomainAsync(profile.CurrentDomain);
            savedSession = await SessionState.LoadSessionStateAsync();
            reviewDueCount = await ReviewService.GetDueCountAsync();
            var today = DateTime.Now.ToString("yyyy-MM-dd");
            dailyDone = profile.DailyChallengeDate == today && profile.DailyChallengeCompleted;
            proofsUnlocked = profile.ShopPurchases.Contains("unlock-proofs");
            mistakesUnlocked = profile.ShopPurchases.Contains("unlock-mistakes");
            playgroundUnlocked = profile.ShopPurchases.Contains("unlock-playground");
            compendiumUnlocked = profile.ShopPurchases.Contains("unlock-compendium");
            hofUnlocked = profile.ShopPurchases.Contains($"unlock-halloffame-{profile.CurrentDomain}");
            particleSandboxUnlocked = profile.ShopPurchases.Contains("unlock-particle-sandbox");
            cosmicScaleUnlocked = profile.ShopPurchases.Contains("unlock-cosmic-scale");
            evolutionSimUnlocked = profile.ShopPurchases.Contains("unlock-evolution-sim");
            cellTourUnlocked = profile.ShopPurchases.Contains("unlock-cell-tour");
            reactionBenchUnlocked = profile.ShopPurchases.Contains("unlock-reaction-bench");
            moleculeBuilderUnlocked = profile.ShopPurchases.Contains("unlock-molecule-builder");
            deepTimeUnlocked = profile.ShopPurchases.Contains("unlock-deep-time");
            rockIdUnlocked = profile.ShopPurchases.Contains("unlock-rock-id");
            eraMapUnlocked = profile.ShopPurchases.Contains("unlock-era-map");
            tradeRoutesUnlocked = profile.ShopPurchases.Contains("unlock-trade-routes");
            etymologyUnlocked = profile.ShopPurchases.Contains("unlock-etymology");
            trolleyLabUnlocked = profile.ShopPurchases.Contains("unlock-trolley-lab");
            soundShiftUnlocked = profile.ShopPurchases.Contains("unlock-sound-shift");
            phaseDiagramUnlocked = profile.ShopPurchases.Contains("unlock-phase-diagram");
            algorithmRaceUnlocked = profile.ShopPurchases.Contains("unlock-algorithm-race");
            cipherDecoderUnlocked = profile.ShopPurchases.Contains("unlock-cipher-decoder");
            powerMapUnlocked = profile.ShopPurchases.Contains("unlock-power-map");
            marketSimUnlocked = profile.ShopPurchases.Contains("unlock-market-sim");
            frontPageUnlocked = profile.ShopPurchases.Contains("unlock-front-page");
            plotGeometryUnlocked = profile.ShopPurchases.Contains("unlock-plot-geometry");
            currentDomain = string.IsNullOrEmpty(profile.CurrentDomain) ? "math" : profile.CurrentDomain;
            cookieViewed = profile.ViewedCookieDates.Contains(DateTime.Now.ToString("yyyy-MM-dd"));

            foreach (var topic in topics)
            {
                topicProgress[topic.Id] = await Progress.GetTopicProgressAsync(topic.Id);
            }

            // Show suggestions for topics the user picked in onboarding but hasn't started
            if (profile.SuggestedTopicIds.Count > 0)
            {
                suggestedTopics = topics
                    .Where(t => profile.SuggestedTopicIds.Contains(t.Id) && topicProgress.GetValueOrDefault(t.Id) == 0)
                    .ToList();
            }

            StateHasChanged();
        }
    }

    private void GoHallOfFame()
    {
        Nav.NavigateTo(hofUnlocked ? "/hall-of-fame" : "/shop/feature");
    }

    private void GoCompendium()
    {
        Nav.NavigateTo(compendiumUnlocked ? "/compendium" : "/shop/feature");
    }

    private void GoPlayground()
    {
        Nav.NavigateTo(playgroundUnlocked ? "/playground" : "/shop/feature");
    }

    private void ResumeSession()
    {
        if (savedSession?.ActiveTopicId != null && savedSession.ActiveLessonId != null)
        {
            Nav.NavigateTo($"/topic/{savedSession.ActiveTopicId}/lesson/{savedSession.ActiveLessonId}");
        }
    }

