    private void NavigateToTopic(string topicId)
    {
        Nav.NavigateTo($"/topic/{topicId}");
    }

    private static readonly string[] LevelOrder = { "Beginner", "Intermediate", "Advanced", "Graduate" };

    private static List<KeyValuePair<string, List<Topic>>> GroupTopicsByLevel(List<Topic> topics)
    {
        var groups = topics
            .GroupBy(t => GetStartLevel(t.Difficulty))
            .OrderBy(g => Array.IndexOf(LevelOrder, g.Key) is var i && i < 0 ? int.MaxValue : i)
            .Select(g => new KeyValuePair<string, List<Topic>>(g.Key, g.ToList()))
            .ToList();
        return groups;
    }

    private static string GetStartLevel(string difficulty)
    {
        if (string.IsNullOrWhiteSpace(difficulty)) return "Other";
        var first = difficulty.Split('→', '-')[0].Trim();
        return LevelOrder.Contains(first) ? first : (string.IsNullOrEmpty(first) ? "Other" : first);
    }

    private void StartQuickQuiz()
    {
        Nav.NavigateTo("/quiz/mixed/all");
    }
}

<style>
    .dashboard {
        padding-top: 8px;
    }

    .hero-row {
        margin-bottom: 24px;
    }

    .welcome-section {
        text-align: center;
        margin-bottom: 16px;
    }

    .welcome-section h1 {
        font-family: 'Cinzel', 'Cambria Math', 'STIX Two Math', Georgia, serif;
        font-size: 2.4rem;
        font-weight: 700;
        letter-spacing: 0.12em;
        background: linear-gradient(90deg, var(--primary), var(--accent-light), var(--primary-light), var(--primary));
        background-size: 200% auto;
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        background-clip: text;
        margin-bottom: 12px;
        animation: titleShimmer 3s linear infinite;
    }

    @@keyframes titleShimmer {
        to { background-position: 200% center; }
    }

    .stats-row {
        display: flex;
        justify-content: center;
        gap: 12px;
        margin-bottom: 12px;
        flex-wrap: wrap;
    }

    .xp-progress {
        max-width: 300px;
        margin: 0 auto;
    }

    .xp-progress small {
        color: var(--text-muted);
        font-size: 0.8rem;
    }

    .topics-grid {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 8px;
    }

    .topic-level-group {
        margin-bottom: 18px;
    }

    .topic-level-group:last-child {
        margin-bottom: 0;
    }

    .topic-level-header {
        display: flex;
        align-items: center;
        gap: 8px;
        margin: 0 0 10px;
        padding: 0 2px;
    }

    .topic-level-header h3 {
        margin: 0;
        font-size: 0.95rem;
        font-weight: 600;
        color: var(--text-primary);
    }

    .topic-level-header small {
        color: var(--text-muted);
        font-size: 0.75rem;
        margin-left: auto;
    }

    .topic-level-dot {
        width: 8px;
        height: 8px;
        border-radius: 50%;
        flex-shrink: 0;
        background: var(--text-muted);
    }

    .topic-level-dot.level-beginner { background: #2ECC71; }
    .topic-level-dot.level-intermediate { background: #F1C40F; }
    .topic-level-dot.level-advanced { background: #E67E22; }
    .topic-level-dot.level-graduate { background: #E91E63; }

    .topic-tile {
        display: flex;
        flex-direction: column;
        align-items: center;
        text-align: center;
        padding: 16px 8px;
        gap: 6px;
        position: relative;
        overflow: hidden;
    }

    .topic-tile-accent {
        position: absolute;
        inset: 0;
        pointer-events: none;
    }

    .topic-tile strong { font-size: 0.85rem; position: relative; }
    .topic-tile-meta { color: var(--text-muted); font-size: 0.75rem; position: relative; }
    .topic-tile-desc { display: none; }

    .topic-tile-icon {
        width: 48px;
        height: 48px;
        border-radius: 14px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.4rem;
        font-weight: bold;
        margin-bottom: 2px;
        position: relative;
    }

    .topic-tile-progress {
        width: 100%;
        margin-top: 2px;
        position: relative;
    }

    .suggested-topic {
        border-width: 2px;
        border-style: solid;
        position: relative;
    }

    .suggested-label {
        font-size: 0.7rem;
        font-weight: 700;
        display: flex;
        align-items: center;
        gap: 4px;
    }

    .welcome-greeting {
        color: var(--text-muted);
        font-size: 0.9rem;
        margin: 0 0 8px;
    }

    .action-row {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 10px;
    }

    .action-card {
        display: flex;
        align-items: center;
        gap: 12px;
        padding: 14px 16px;
        border-radius: var(--radius-md);
        cursor: pointer;
        transition: transform 0.15s ease, opacity 0.15s ease;
        -webkit-tap-highlight-color: transparent;
    }

    .action-card:active { transform: scale(0.97); }

    .action-card-icon {
        width: 40px;
        height: 40px;
        border-radius: 10px;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
    }

    .action-card-text { display: flex; flex-direction: column; gap: 1px; }
    .action-card-text strong { font-size: 0.9rem; }
    .action-card-text small { font-size: 0.75rem; opacity: 0.7; }

    .action-daily {
        background: var(--bg-card);
        border: 1px solid var(--border);
        color: var(--text-primary);
    }
    .action-daily .action-card-icon { background: var(--bg-surface); color: var(--accent); }

    .action-quiz {
        background: var(--bg-card);
        border: 1px solid var(--border);
        color: var(--text-primary);
    }
    .action-quiz .action-card-icon { background: var(--bg-surface); color: var(--primary); }

    .action-review {
        background: var(--bg-card);
        border: 1px solid var(--border);
        color: var(--text-primary);
        grid-column: 1 / -1;
    }
    .action-review .action-card-icon { background: var(--bg-surface); color: var(--success); }

    .action-done {
        background: var(--bg-surface);
        border: 1px solid var(--border);
        color: var(--text-muted);
        cursor: default;
        opacity: 0.5;
    }
    .action-done .action-card-icon { background: var(--bg-card); }

    .resume-banner {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 14px 18px;
        margin-bottom: 16px;
        background: var(--bg-card);
    }

    .resume-content {
        display: flex;
        flex-direction: column;
        gap: 2px;
    }

    .resume-content small {
        color: var(--text-muted);
        font-size: 0.8rem;
    }

    .resume-arrow {
        font-size: 1.3rem;
        color: var(--accent);
    }

    .explore-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
        gap: 10px;
    }

    .explore-card {
        position: relative;
        border-radius: var(--radius-md);
        padding: 16px;
        overflow: hidden;
        background: var(--bg-card);
        border: 1px solid var(--border);
        opacity: 0.5;
        transition: opacity 0.2s ease, transform 0.2s ease;
    }

    .explore-card.unlocked {
        opacity: 1;
    }

    .explore-card-bg {
        position: absolute;
        inset: 0;
        background: linear-gradient(135deg, transparent 50%, color-mix(in srgb, var(--accent-color) 8%, transparent));
        pointer-events: none;
    }

    .explore-card-content {
        position: relative;
        display: flex;
        align-items: center;
        gap: 12px;
    }

    .explore-icon {
        width: 44px;
        height: 44px;
        border-radius: 10px;
        background: color-mix(in srgb, var(--accent-color) 12%, transparent);
        color: var(--accent-color);
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
    }

    .explore-text {
        display: flex;
        flex-direction: column;
        gap: 2px;
    }

    .explore-text strong { font-size: 0.9rem; }
    .explore-text small { color: var(--text-muted); font-size: 0.75rem; }

    .explore-lock {
        position: absolute;
        top: 8px;
        right: 8px;
        color: var(--text-muted);
        opacity: 0.6;
    }

    /* Tool chips */
    .tools-row {
        display: flex; gap: 8px; margin-bottom: 16px; flex-wrap: wrap;
    }
    .tool-chip {
        display: inline-flex; align-items: center; gap: 6px;
        padding: 8px 14px; border-radius: 20px;
        background: var(--bg-card); border: 1px solid var(--border);
        font-size: 0.8rem; font-weight: 600; color: var(--text-secondary);
        cursor: pointer; transition: all 0.2s ease;
        -webkit-tap-highlight-color: transparent;
    }
    .tool-chip:active { transform: scale(0.95); background: var(--bg-surface); }

    /* Fortune cookie banner */
    .cookie-banner {
        display: flex; align-items: center; gap: 12px;
        padding: 12px 16px; margin-bottom: 16px;
        background: linear-gradient(135deg, rgba(45,43,107,0.08), rgba(180,140,255,0.08));
        border: 1px solid rgba(180,140,255,0.2);
        border-radius: var(--radius-md);
        cursor: pointer; -webkit-tap-highlight-color: transparent;
    }
    .cookie-banner:active { transform: scale(0.98); }

    .cookie-banner-icon {
        font-size: 1.8rem;
    }

    .cookie-banner-text { flex: 1; }
    .cookie-banner-text strong { display: block; font-size: 0.9rem; }
    .cookie-banner-text small { color: var(--text-muted); font-size: 0.8rem; }
    .cookie-banner-arrow { color: var(--primary); font-size: 1.1rem; }

    /* Tablet */
    @@media (min-width: 768px) {
        .topics-grid {
            grid-template-columns: repeat(auto-fill, minmax(160px, 1fr));
            gap: 12px;
