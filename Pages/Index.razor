                    <div class="explore-card-content">
                        <div class="explore-icon"><Icon Name="coin" Size="24" /></div>
                        <div class="explore-text">
                            <strong>Market Sim</strong>
                            <small>@(marketSimUnlocked ? "Supply, demand, taxes, deadweight" : "Unlock in Shop")</small>
                        </div>
                    </div>
                    @if (!marketSimUnlocked) { <div class="explore-lock"><Icon Name="lock" Size="14" /></div> }
                </div>
            }

            @if (currentDomain == "media")
            {
                <div class="explore-card card-clickable @(frontPageUnlocked ? "unlocked" : "")" style="--accent-color: #E91E63" @onclick='() => Nav.NavigateTo(frontPageUnlocked ? "/front-page" : "/shop/feature")'>
