@page "/rock-id"
@inject IProgressService Progress
@inject NavigationManager Nav
@inject IJSRuntime JS

@if (!unlocked)
{
    <div class="page-header">
        <button class="back-btn" aria-label="Back to home" @onclick='() => Nav.NavigateTo("/")'><Icon Name="arrow-left" Size="18" /></button>
        <h1>Rock ID</h1>
    </div>
    <div class="card" style="text-align: center; padding: 40px 24px">
        <Icon Name="lock" Size="40" Stroke="var(--text-muted)" />
        <h2 style="margin-top: 12px">Locked</h2>
        <p style="color: var(--text-secondary)">Purchase "Rock ID" from the Shop to unlock.</p>
        <button class="btn btn-accent" @onclick='() => Nav.NavigateTo("/shop")'>Go to Shop</button>
    </div>
}
else
{
<div class="page-header">
    <button class="back-btn" aria-label="Back to home" @onclick='() => Nav.NavigateTo("/")'><Icon Name="arrow-left" Size="18" /></button>
    <h1>Rock ID</h1>
</div>

<div class="rock-tabs">
    <button class="rock-tab @(viewMode == "quiz" ? "active" : "")" @onclick='() => SwitchMode("quiz")'>
        <Icon Name="brain" Size="16" /> Quiz
    </button>
    <button class="rock-tab @(viewMode == "library" ? "active" : "")" @onclick='() => SwitchMode("library")'>
        <Icon Name="book" Size="16" /> Reference Library
    </button>
</div>

@if (viewMode == "quiz")
{
    <div class="rock-score-bar">
        <div class="score-block">
            <Icon Name="target" Size="16" Stroke="var(--accent)" />
            <span class="score-text">Score: <strong>@correctCount</strong> / <strong>@totalCount</strong></span>
            @if (totalCount > 0)
            {
                <span class="score-pct">(@((correctCount * 100 / totalCount))%)</span>
            }
        </div>
        <button class="btn-mini" @onclick="ResetSession" title="Reset session">Reset</button>
    </div>

    @if (currentRock != null)
    {
        <div class="card rock-sample-card">
            <div class="sample-svg-wrap">
                @((MarkupString)currentRock.Svg)
            </div>
            <div class="sample-props">
                <h3>Sample Properties</h3>
                <div class="prop-grid">
                    <div class="prop"><span class="prop-key">Hardness</span><span class="prop-val">@currentRock.Hardness Mohs</span></div>
                    <div class="prop"><span class="prop-key">Grain</span><span class="prop-val">@currentRock.GrainSize</span></div>
                    <div class="prop"><span class="prop-key">Color</span><span class="prop-val">@currentRock.Color</span></div>
                    <div class="prop"><span class="prop-key">Formation</span><span class="prop-val">@currentRock.Formation</span></div>
                    <div class="prop prop-wide"><span class="prop-key">Key Minerals</span><span class="prop-val">@currentRock.Minerals</span></div>
                </div>
            </div>
        </div>

        @if (stage == "class")
        {
            <div class="card question-card">
                <div class="q-label">Step 1 of 2</div>
                <h3 class="q-text">What class of rock is this?</h3>
                <div class="class-buttons">
                    <button class="class-btn cb-igneous" @onclick='() => GuessClass("igneous")'>Igneous</button>
                    <button class="class-btn cb-sedimentary" @onclick='() => GuessClass("sedimentary")'>Sedimentary</button>
                    <button class="class-btn cb-metamorphic" @onclick='() => GuessClass("metamorphic")'>Metamorphic</button>
                </div>
            </div>
        }
        else if (stage == "specific")
        {
            <div class="card question-card">
                <div class="q-label">
                    Step 2 of 2 -
                    @if (classCorrect)
                    {
                        <span class="q-feedback ok"><Icon Name="check" Size="14" Stroke="var(--success)" /> Class correct!</span>
                    }
                    else
                    {
                        <span class="q-feedback err"><Icon Name="x-mark" Size="14" Stroke="var(--error)" /> Class was @currentRock.Class</span>
                    }
                </div>
                <h3 class="q-text">Which rock is it?</h3>
                <div class="specific-buttons">
                    @foreach (var opt in specificOptions)
                    {
                        var name = opt;
                        <button class="specific-btn" @onclick="() => GuessSpecific(name)">@name</button>
                    }
                </div>
            </div>
        }
        else if (stage == "reveal")
        {
            <div class="card reveal-card @(specificCorrect ? "reveal-ok" : "reveal-err")">
                <div class="reveal-header">
                    @if (specificCorrect)
                    {
                        <Icon Name="check" Size="22" Stroke="var(--success)" />
                        <span class="reveal-title ok">Correct!</span>
                    }
                    else
                    {
                        <Icon Name="x-mark" Size="22" Stroke="var(--error)" />
                        <span class="reveal-title err">Not quite</span>
                    }
                </div>
                <div class="reveal-name">@currentRock.Name</div>
                <div class="reveal-class class-tag class-@currentRock.Class">@currentRock.Class</div>
                <p class="reveal-desc">@currentRock.Description</p>
                <button class="btn btn-primary next-btn" @onclick="NextSample">
                    <Icon Name="dice" Size="16" /> Next Sample
                </button>
            </div>
        }
    }
}
else
{
    <div class="library-intro">
        <Icon Name="search" Size="16" Stroke="var(--text-muted)" />
        <span>Browse all @rocks.Count rock samples</span>
    </div>
    <div class="library-grid">
        @foreach (var r in rocks)
        {
            <div class="card lib-card">
                <div class="lib-svg">@((MarkupString)r.Svg)</div>
                <div class="lib-name">@r.Name</div>
                <div class="lib-class class-tag class-@r.Class">@r.Class</div>
                <div class="lib-props">
                    <div><span>Hardness:</span> @r.Hardness</div>
                    <div><span>Grain:</span> @r.GrainSize</div>
                    <div><span>Color:</span> @r.Color</div>
                    <div><span>Formation:</span> @r.Formation</div>
                    <div><span>Minerals:</span> @r.Minerals</div>
                </div>
            </div>
        }
    </div>
}
}

@code {
    private bool unlocked;
    private string viewMode = "quiz";
    private string stage = "class"; // class -> specific -> reveal
    private Rock? currentRock;
    private List<string> specificOptions = new();
    private bool classCorrect;
    private bool specificCorrect;
    private int correctCount;
    private int totalCount;
    private bool classGuessed;
    private bool specificGuessed;
    private readonly Random rng = new();

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            var profile = await Progress.GetProfileAsync();
            unlocked = profile.ShopPurchases.Contains("unlock-rock-id");
            if (unlocked && currentRock == null)
            {
                NextSample();
            }
            StateHasChanged();
        }
    }

    private void SwitchMode(string mode)
    {
        viewMode = mode;
        if (mode == "quiz" && currentRock == null)
        {
            NextSample();
        }
    }

    private void ResetSession()
    {
        correctCount = 0;
        totalCount = 0;
        NextSample();
    }

    private void NextSample()
    {
        currentRock = rocks[rng.Next(rocks.Count)];
        stage = "class";
        classCorrect = false;
        specificCorrect = false;
        classGuessed = false;
        specificGuessed = false;
        BuildSpecificOptions();
    }

    private void BuildSpecificOptions()
    {
        if (currentRock == null) return;
        var sameClass = rocks.Where(r => r.Class == currentRock.Class && r.Name != currentRock.Name)
                             .OrderBy(_ => rng.Next()).Take(3).Select(r => r.Name).ToList();
        sameClass.Add(currentRock.Name);
        specificOptions = sameClass.OrderBy(_ => rng.Next()).ToList();
    }

    private void GuessClass(string guess)
    {
        if (currentRock == null || classGuessed) return;
        classGuessed = true;
        classCorrect = guess == currentRock.Class;
        stage = "specific";
    }

    private void GuessSpecific(string name)
    {
        if (currentRock == null || specificGuessed) return;
        specificGuessed = true;
        specificCorrect = name == currentRock.Name;
        totalCount++;
        if (specificCorrect && classCorrect) correctCount++;
        stage = "reveal";
    }

    public record Rock(
        string Name,
        string Class,
        int Hardness,
        string GrainSize,
        string Color,
        string Formation,
        string Minerals,
        string Description,
        string Svg
    );

