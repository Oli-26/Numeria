@page "/rock-id"
@inject NavigationManager Nav
@inject IJSRuntime JS

<div class="page-header">
    <button class="back-btn" aria-label="Back to home" @onclick='() => Nav.NavigateTo("/")'><Icon Name="arrow-left" Size="18" /></button>
    <h1>Rock ID</h1>
</div>

<div class="rock-tabs">
    <button class="rock-tab @(viewMode == "quiz" ? "active" : "")" @onclick='() => SwitchMode("quiz")'>
        <Icon Name="brain" Size="16" /> Quiz
    </button>
    <button class="rock-tab @(viewMode == "library" ? "active" : "")" @onclick='() => SwitchMode("library")'>
        <Icon Name="book" Size="16" /> Reference Library
    </button>
</div>

@if (viewMode == "quiz")
{
    <div class="rock-score-bar">
        <div class="score-block">
            <Icon Name="target" Size="16" Stroke="var(--accent)" />
            <span class="score-text">Score: <strong>@correctCount</strong> / <strong>@totalCount</strong></span>
            @if (totalCount > 0)
            {
                <span class="score-pct">(@((correctCount * 100 / totalCount))%)</span>
            }
        </div>
        <button class="btn-mini" @onclick="ResetSession" title="Reset session">Reset</button>
    </div>

    @if (currentRock != null)
    {
        <div class="card rock-sample-card">
            <div class="sample-svg-wrap" @key="sampleSerial">
                <div class="rk-stage">
                    @((MarkupString)Specimen(currentRock, "q"))
                    <div class="rk-fx" id="rk-fx"></div>
                </div>
            </div>
            <div class="rk-tests">
                <button class="rk-test" disabled="@(steelBusy || steelResult != null)" @onclick="ScratchTest"><Icon Name="pickaxe" Size="16" /> Scratch with steel</button>
                <button class="rk-test" disabled="@(acidBusy || acidResult != null)" @onclick="AcidTest"><Icon Name="flask" Size="16" /> Drop of acid</button>
            </div>
            <div class="sample-props">
                <h3>Sample Properties</h3>
                <div class="prop-grid">
                    <div class="prop"><span class="prop-key">Hardness</span><span class="prop-val">@currentRock.Hardness Mohs</span></div>
                    <div class="prop"><span class="prop-key">Grain</span><span class="prop-val">@currentRock.GrainSize</span></div>
                    <div class="prop"><span class="prop-key">Color</span><span class="prop-val">@currentRock.Color</span></div>
                    @if (steelResult != null)
                    {
                        <div class="prop prop-wide rk-result"><span class="prop-key">Steel test</span><span class="prop-val">@steelResult</span></div>
                    }
                    @if (acidResult != null)
                    {
                        <div class="prop prop-wide rk-result"><span class="prop-key">Acid test</span><span class="prop-val">@acidResult</span></div>
                    }
                </div>
            </div>
        </div>

        @if (stage == "class")
        {
            <div class="card question-card">
                <div class="q-label">Step 1 of 2</div>
                <h3 class="q-text">What class of rock is this?</h3>
                <div class="class-buttons">
                    <button class="class-btn cb-igneous" @onclick='() => GuessClass("igneous")'>Igneous</button>
                    <button class="class-btn cb-sedimentary" @onclick='() => GuessClass("sedimentary")'>Sedimentary</button>
                    <button class="class-btn cb-metamorphic" @onclick='() => GuessClass("metamorphic")'>Metamorphic</button>
                </div>
            </div>
        }
        else if (stage == "specific")
        {
            <div class="card question-card">
                <div class="q-label">
                    Step 2 of 2 -
                    @if (classCorrect)
                    {
                        <span class="q-feedback ok"><Icon Name="check" Size="14" Stroke="var(--success)" /> Class correct!</span>
                    }
                    else
                    {
                        <span class="q-feedback err"><Icon Name="x-mark" Size="14" Stroke="var(--error)" /> Class was @currentRock.Class</span>
                    }
                </div>
                <h3 class="q-text">Which rock is it?</h3>
                <div class="specific-buttons">
                    @foreach (var opt in specificOptions)
                    {
                        var name = opt;
                        <button class="specific-btn" @onclick="() => GuessSpecific(name)">@name</button>
                    }
                </div>
            </div>
        }
        else if (stage == "reveal")
        {
            <div class="card reveal-card @(specificCorrect && classCorrect ? "reveal-ok" : "reveal-err")">
                <div class="reveal-header">
                    @if (specificCorrect && classCorrect)
                    {
                        <Icon Name="check" Size="22" Stroke="var(--success)" />
                        <span class="reveal-title ok">Correct!</span>
                    }
                    else if (specificCorrect)
                    {
                        <Icon Name="x-mark" Size="22" Stroke="var(--error)" />
                        <span class="reveal-title err">Right rock, wrong class</span>
                    }
                    else
                    {
                        <Icon Name="x-mark" Size="22" Stroke="var(--error)" />
                        <span class="reveal-title err">Not quite</span>
                    }
                </div>
                <div class="reveal-name">@currentRock.Name</div>
                <div class="reveal-class class-tag class-@currentRock.Class">@currentRock.Class</div>
                @if (specificCorrect && !classCorrect)
                {
                    <p class="reveal-note">Both steps must be right to score a point.</p>
                }
                <div class="reveal-facts">
                    <div><span>Formation:</span> @currentRock.Formation</div>
                    <div><span>Key minerals:</span> @currentRock.Minerals</div>
                </div>
                <p class="reveal-desc">@currentRock.Description</p>
                <button class="btn btn-primary next-btn" @onclick="NextSample">
                    <Icon Name="dice" Size="16" /> Next Sample
                </button>
            </div>
        }
    }
}
else
{
    <div class="library-intro">
        <Icon Name="search" Size="16" Stroke="var(--text-muted)" />
        <span>Browse all @rocks.Count rock samples</span>
    </div>
    <div class="library-grid">
        @foreach (var r in rocks)
        {
            <div class="card lib-card">
                <div class="lib-svg">@((MarkupString)Specimen(r, "l"))</div>
                <div class="lib-name">@r.Name</div>
                <div class="lib-class class-tag class-@r.Class">@r.Class</div>
                <div class="lib-props">
                    <div><span>Hardness:</span> @r.Hardness</div>
                    <div><span>Grain:</span> @r.GrainSize</div>
                    <div><span>Color:</span> @r.Color</div>
                    <div><span>Formation:</span> @r.Formation</div>
                    <div><span>Minerals:</span> @r.Minerals</div>
                </div>
            </div>
        }
    </div>
}

@code {
    private string viewMode = "quiz";
    private string stage = "class"; // class -> specific -> reveal
    private Rock? currentRock;
    private List<string> specificOptions = new();
    private bool classCorrect;
    private bool specificCorrect;
    private int correctCount;
    private int totalCount;
    private bool classGuessed;
    private bool specificGuessed;
    private readonly Random rng = new();
    private string? steelResult;
    private string? acidResult;
    private bool steelBusy;
    private bool acidBusy;
    private int sampleSerial;
    private string? appliedSample;

    // ?sample=Limestone opens the quiz on that rock.
    [SupplyParameterFromQuery(Name = "sample")] public string? Sample { get; set; }

    protected override void OnInitialized() => NextSample();

    protected override void OnParametersSet()
    {
        if (Sample == appliedSample) return;
        appliedSample = Sample;
        var pick = rocks.FirstOrDefault(r => r.Name.Equals(Sample, StringComparison.OrdinalIgnoreCase));
        if (pick != null) { viewMode = "quiz"; ShowSample(pick); }
    }

    private void SwitchMode(string mode)
    {
        viewMode = mode;
        if (mode == "quiz" && currentRock == null)
        {
            NextSample();
        }
    }

    private void ResetSession()
    {
        correctCount = 0;
        totalCount = 0;
        NextSample();
    }

    private void NextSample()
    {
        Rock next;
        do { next = rocks[rng.Next(rocks.Count)]; }
        while (rocks.Count > 1 && next == currentRock);
        ShowSample(next);
    }

    private void ShowSample(Rock next)
    {
        currentRock = next;
        sampleSerial++;
        steelResult = null;
        acidResult = null;
        steelBusy = acidBusy = false;
        stage = "class";
        classCorrect = false;
        specificCorrect = false;
        classGuessed = false;
        specificGuessed = false;
        BuildSpecificOptions();
    }

    private void BuildSpecificOptions()
    {
        if (currentRock == null) return;
        var sameClass = rocks.Where(r => r.Class == currentRock.Class && r.Name != currentRock.Name)
                             .OrderBy(_ => rng.Next()).Take(3).Select(r => r.Name).ToList();
        sameClass.Add(currentRock.Name);
        specificOptions = sameClass.OrderBy(_ => rng.Next()).ToList();
    }

    private void GuessClass(string guess)
    {
        if (currentRock == null || classGuessed) return;
        classGuessed = true;
        classCorrect = guess == currentRock.Class;
        stage = "specific";
    }

    private void GuessSpecific(string name)
    {
        if (currentRock == null || specificGuessed) return;
        specificGuessed = true;
        specificCorrect = name == currentRock.Name;
        totalCount++;
        if (specificCorrect && classCorrect) correctCount++;
        stage = "reveal";
    }

    public record Rock(
        string Name,
        string Class,
        int Hardness,
        string GrainSize,
        string Color,
        string Formation,
        string Minerals,
        string Description,
        Look Look
    );

    // How a hand specimen is drawn: base color, fabric (which texture), and grain colors as "color:weight".
    public sealed class Look
    {
        public Look(string baseColor, string fabric, params string[] grains)
        {
            Base = baseColor; Fabric = fabric;
            Grains = grains.Select(g => g.Split(':')).Select(p => (p[0], p.Length > 1 ? int.Parse(p[1]) : 1)).ToArray();
        }
        public string Base { get; }
        public string Fabric { get; }
        public (string Color, int Weight)[] Grains { get; }
    }

    private static readonly Dictionary<string, string> specimenCache = new();

    private static string N(double v) => v.ToString("0.#", System.Globalization.CultureInfo.InvariantCulture);

    private static string ClipId(Rock r, string mode) => "rk-clip-" + mode + r.Name.ToLowerInvariant();

    // FNV-1a, so each rock draws the same specimen every run (string.GetHashCode is randomized per process).
    private static int StableSeed(string s)
    {
        unchecked
        {
            uint h = 2166136261;
            foreach (var c in s) { h ^= c; h *= 16777619; }
            return (int)(h & 0x7fffffff);
        }
    }

    private static string Shade(string hex, double k)
    {
        int Ch(int i) => Convert.ToInt32(hex.Substring(1 + i * 2, 2), 16);
        int Adj(int c) => (int)Math.Clamp(k < 0 ? c * (1 + k) : c + (255 - c) * k, 0, 255);
        return $"#{Adj(Ch(0)):x2}{Adj(Ch(1)):x2}{Adj(Ch(2)):x2}";
    }

    // Grain radius range and count, from the sample's grain size.
    private static (double Min, double Max, int Count) GrainScale(string g) =>
        g.StartsWith("very coarse") ? (0.7, 1.2, 260)
        : g.StartsWith("very fine") ? (0.35, 0.6, 260)
        : g.StartsWith("coarse") ? (2.6, 5.2, 480)
        : g.StartsWith("medium") ? (1.3, 2.3, 420)
        : g.StartsWith("fine to") ? (0.8, 1.6, 380)
        : g.StartsWith("fine") ? (0.55, 1.0, 420)
        : (0, 0, 0);

    private static string Specimen(Rock r, string mode)
    {
        var id = ClipId(r, mode);
        if (specimenCache.TryGetValue(id, out var hit)) return hit;
        var rng = new Random(StableSeed(r.Name));
        var look = r.Look;
        var flat = look.Fabric is "laminae" or "cleavage" ? 0.8 : 1.0;
        var pts = Enumerable.Range(0, 13).Select(i =>
        {
            var a = (i + rng.NextDouble() * 0.5 - 0.25) / 13 * Math.PI * 2;
            var k = 0.84 + rng.NextDouble() * 0.16;
            return (X: 100 + Math.Cos(a) * 86 * k, Y: 64 + Math.Sin(a) * 50 * flat * k);
        }).ToList();
        var outline = "M" + string.Join(" L", pts.Select(p => N(p.X) + "," + N(p.Y))) + "Z";
        var glassy = look.Fabric is "glassy" or "coal";
        var sb = new System.Text.StringBuilder();
        sb.Append("<svg class='rk-specimen' viewBox='0 0 200 140' xmlns='http://www.w3.org/2000/svg'>");
        sb.Append($"<defs><clipPath id='{id}'><path d='{outline}'/></clipPath>");
        sb.Append($"<radialGradient id='{id}-sh' cx='34%' cy='24%' r='82%'><stop offset='0' stop-color='#fff' stop-opacity='{(glassy ? ".3" : ".2")}'/>");
        sb.Append("<stop offset='.45' stop-color='#fff' stop-opacity='0'/><stop offset='1' stop-color='#000' stop-opacity='.42'/></radialGradient></defs>");
        sb.Append("<ellipse cx='100' cy='126' rx='80' ry='6' fill='rgba(0,0,0,.2)'/>");
        sb.Append($"<path d='{outline}' transform='translate(0 7)' fill='{Shade(look.Base, -0.4)}'/>");
        sb.Append($"<g clip-path='url(#{id})'><rect width='200' height='140' fill='{look.Base}'/>");
        DrawFabric(sb, rng, r);
        sb.Append($"<rect width='200' height='140' fill='url(#{id}-sh)'/></g>");
        sb.Append($"<path d='{outline}' fill='none' stroke='rgba(0,0,0,.35)' stroke-width='.8' stroke-linejoin='round'/></svg>");
        return specimenCache[id] = sb.ToString();
    }

    private static string Pick(Random rng, (string Color, int Weight)[] g)
    {
        var n = rng.Next(g.Sum(x => x.Weight));
        foreach (var x in g) { if (n < x.Weight) return x.Color; n -= x.Weight; }
        return g[0].Color;
    }

    private static (double X, double Y) Spot(Random rng) => (8 + rng.NextDouble() * 184, 10 + rng.NextDouble() * 112);

    // Circles, polygons and ellipses are merged into one path per color, so a specimen stays a handful of elements.
    private static void Dots(System.Text.StringBuilder sb, Random rng, (string Color, int Weight)[] g, int n, double r0, double r1, double op = 1)
    {
        var paths = g.ToDictionary(x => x.Color, _ => new System.Text.StringBuilder());
        for (var i = 0; i < n; i++)
        {
            var (x, y) = Spot(rng); var r = r0 + rng.NextDouble() * (r1 - r0);
            paths[Pick(rng, g)].Append($"M{N(x - r)},{N(y)}a{N(r)},{N(r)} 0 1 0 {N(2 * r)},0a{N(r)},{N(r)} 0 1 0 {N(-2 * r)},0");
        }
        foreach (var (c, d) in paths) if (d.Length > 0) sb.Append($"<path d='{d}' fill='{c}' opacity='{N(op)}'/>");
    }

    private static void Polys(System.Text.StringBuilder sb, Random rng, (string Color, int Weight)[] g, int n, double r0, double r1, double op = 1, double elong = 1.4)
    {
        var paths = g.ToDictionary(x => x.Color, _ => new System.Text.StringBuilder());
        for (var i = 0; i < n; i++)
        {
            var (x, y) = Spot(rng); var r = r0 + rng.NextDouble() * (r1 - r0);
            var rot = rng.NextDouble() * Math.PI; var e = 1 + rng.NextDouble() * (elong - 1); var m = 5 + rng.Next(2);
            var d = paths[Pick(rng, g)];
            for (var k = 0; k < m; k++)
            {
                var a = (k + rng.NextDouble() * 0.4) / m * Math.PI * 2; var rr = r * (0.7 + rng.NextDouble() * 0.4);
                var px = Math.Cos(a) * rr * e; var py = Math.Sin(a) * rr / e;
                d.Append(k == 0 ? "M" : "L").Append(N(x + px * Math.Cos(rot) - py * Math.Sin(rot))).Append(',').Append(N(y + px * Math.Sin(rot) + py * Math.Cos(rot)));
            }
            d.Append('Z');
        }
        foreach (var (c, d) in paths) if (d.Length > 0) sb.Append($"<path d='{d}' fill='{c}' opacity='{N(op)}'/>");
    }

    private static void Ellipses(System.Text.StringBuilder sb, Random rng, (string Color, int Weight)[] g, int n, double r0, double r1, double squash, double tilt, double jitter, double op = 1)
    {
        var paths = g.ToDictionary(x => x.Color, _ => new System.Text.StringBuilder());
        for (var i = 0; i < n; i++)
        {
            var (x, y) = Spot(rng); var rx = r0 + rng.NextDouble() * (r1 - r0); var ry = rx * (squash + rng.NextDouble() * 0.2);
            var t = tilt + (rng.NextDouble() - 0.5) * jitter; var dx = rx * Math.Cos(t); var dy = rx * Math.Sin(t); var deg = t * 180 / Math.PI;
            paths[Pick(rng, g)].Append($"M{N(x - dx)},{N(y - dy)}A{N(rx)},{N(ry)} {N(deg)} 1 0 {N(x + dx)},{N(y + dy)}A{N(rx)},{N(ry)} {N(deg)} 1 0 {N(x - dx)},{N(y - dy)}Z");
        }
        foreach (var (c, d) in paths) if (d.Length > 0) sb.Append($"<path d='{d}' fill='{c}' opacity='{N(op)}'/>");
    }

    private static string Wave(Random rng, double y0, double amp, double tilt, double freq)
    {
        var ph = rng.NextDouble() * 6.3; var ph2 = rng.NextDouble() * 6.3;
        var d = new System.Text.StringBuilder();
        for (var x = -10; x <= 210; x += 8)
        {
            var y = y0 + tilt * (x - 100) + amp * Math.Sin(x * freq + ph) + amp * 0.4 * Math.Sin(x * freq * 2.3 + ph2);
            d.Append(x == -10 ? "M" : "L").Append(N(x)).Append(',').Append(N(y));
        }
        return d.ToString();
    }

    private static void Lines(System.Text.StringBuilder sb, Random rng, (string Color, int Weight)[] g, double from, double to, double step, double amp, double tilt, double freq, double w0, double w1, double op)
    {
        for (var y = from; y <= to; y += step * (0.7 + rng.NextDouble() * 0.6))
            sb.Append($"<path d='{Wave(rng, y, amp, tilt, freq)}' fill='none' stroke='{Pick(rng, g)}' stroke-width='{N(w0 + rng.NextDouble() * (w1 - w0))}' opacity='{N(op)}' stroke-linejoin='round'/>");
    }

    private static void Sheen(System.Text.StringBuilder sb, double op) =>
        sb.Append($"<ellipse cx='72' cy='38' rx='36' ry='11' transform='rotate(-14 72 38)' fill='#fff' opacity='{N(op)}'/><ellipse cx='64' cy='34' rx='15' ry='3.4' transform='rotate(-14 64 34)' fill='#fff' opacity='{N(op * 1.8)}'/>");

    private static void DrawFabric(System.Text.StringBuilder sb, Random rng, Rock r)
    {
        var look = r.Look; var g = look.Grains; var (r0, r1, n) = GrainScale(r.GrainSize);
        var dark = new[] { (Shade(look.Base, -0.18), 1) }; var light = new[] { (Shade(look.Base, 0.18), 1) };
        switch (look.Fabric)
        {
            case "crystals":
                Dots(sb, rng, g, 160, 0.5, 1.1, 0.8);
                Polys(sb, rng, g, n, r0, r1);
                break;
            case "fine":
                Dots(sb, rng, g, n, r0, r1, 0.9);
                break;
            case "glassy":
                for (var k = 0; k < 3; k++)
                {
                    var (x, y) = Spot(rng); var a = rng.NextDouble() * 6.3;
                    for (var rr = 8.0; rr < 40; rr += 6 + rng.NextDouble() * 3)
                        sb.Append($"<path d='M{N(x + Math.Cos(a) * rr)},{N(y + Math.Sin(a) * rr)}A{N(rr)},{N(rr)} 0 0 1 {N(x + Math.Cos(a + 1.7) * rr)},{N(y + Math.Sin(a + 1.7) * rr)}' fill='none' stroke='#fff' stroke-width='1' opacity='.09'/>");
                }
                Sheen(sb, 0.16);
                break;
            case "vesicular":
                Dots(sb, rng, g, 200, 0.4, 0.8, 0.8);
                Ellipses(sb, rng, light, 150, 1.2, 4.4, 0.42, -0.2, 0.3, 0.8);
                Ellipses(sb, rng, new[] { (Shade(look.Base, -0.32), 1) }, 150, 1.0, 4.0, 0.4, -0.2, 0.3);
                break;
            case "flow":
                Lines(sb, rng, g.Take(2).ToArray(), 8, 130, 9, 3, -0.08, 0.035, 2, 6, 0.55);
                Dots(sb, rng, g.Take(2).ToArray(), n, r0, r1, 0.7);
                Polys(sb, rng, g.Skip(2).ToArray(), 22, 0.9, 1.8);
                break;
            case "fragments":
                Dots(sb, rng, g, 300, 0.4, 0.8, 0.7);
                Polys(sb, rng, g, 30, 2, 7, 1, 1.2);
                break;
            case "fossils":
                Dots(sb, rng, g, n, r0, r1, 0.8);
                Lines(sb, rng, dark, 34, 110, 26, 1.2, 0.02, 0.03, 0.5, 0.9, 0.7);
                for (var i = 0; i < 14; i++)
                {
                    var (x, y) = Spot(rng); var rr = 2 + rng.NextDouble() * 3; var a = rng.NextDouble() * 6.3;
                    sb.Append($"<path d='M{N(x - Math.Cos(a) * rr)},{N(y - Math.Sin(a) * rr)}A{N(rr)},{N(rr * 0.8)} {N(a * 57.3)} 0 1 {N(x + Math.Cos(a) * rr)},{N(y + Math.Sin(a) * rr)}' fill='none' stroke='#a99d80' stroke-width='1.1' stroke-linecap='round'/>");
                }
                for (var i = 0; i < 6; i++)
                {
                    var (x, y) = Spot(rng); var rr = 1.5 + rng.NextDouble();
                    sb.Append($"<circle cx='{N(x)}' cy='{N(y)}' r='{N(rr)}' fill='#c9bea4' stroke='#a99d80' stroke-width='.5'/><circle cx='{N(x)}' cy='{N(y)}' r='.45' fill='#8f846a'/>");
                }
                break;
            case "beds":
                Dots(sb, rng, g, n, r0, r1, 0.85);
                foreach (var yb in new[] { 46.0, 92.0 }) sb.Append($"<path d='{Wave(rng, yb, 1, 0.01, 0.02)}' fill='none' stroke='{Shade(look.Base, -0.22)}' stroke-width='1'/>");
                foreach (var (top, bot) in new[] { (12.0, 46.0), (46.0, 92.0), (92.0, 126.0) })
                    for (var x = -20.0; x < 200; x += 9 + rng.NextDouble() * 5)
                        sb.Append($"<path d='M{N(x)},{N(top)}Q{N(x + 22)},{N(top + 4)} {N(x + 34)},{N(bot)}' fill='none' stroke='{Shade(look.Base, -0.14)}' stroke-width='.6' opacity='.8'/>");
                break;
            case "laminae":
                Lines(sb, rng, g, 8, 130, 3.4, 0.4, -0.04, 0.02, 0.6, 1.5, 0.9);
                break;
            case "pebbles":
                Dots(sb, rng, g, n, r0, r1, 0.6);
                for (var i = 0; i < 28; i++)
                {
                    var (x, y) = Spot(rng); var rx = 5 + rng.NextDouble() * 9; var ry = rx * (0.65 + rng.NextDouble() * 0.25); var a = rng.NextDouble() * 180;
                    sb.Append($"<g transform='translate({N(x)} {N(y)}) rotate({N(a)})'><ellipse rx='{N(rx)}' ry='{N(ry)}' fill='{Pick(rng, g)}' stroke='rgba(0,0,0,.28)' stroke-width='.6'/>");
                    sb.Append($"<ellipse cx='{N(-rx * 0.25)}' cy='{N(-ry * 0.3)}' rx='{N(rx * 0.45)}' ry='{N(ry * 0.3)}' fill='#fff' opacity='.16'/></g>");
                }
                break;
            case "coal":
                for (var y = 6.0; y < 134; y += 3 + rng.NextDouble() * 6)
                    sb.Append($"<rect x='0' y='{N(y)}' width='200' height='{N(1.5 + rng.NextDouble() * 3)}' fill='{(rng.Next(2) == 0 ? "#262628" : "#0c0c0c")}' transform='rotate(-3 100 70)'/>");
                for (var i = 0; i < 10; i++)
                {
                    var x = 14 + rng.NextDouble() * 172;
                    sb.Append($"<path d='M{N(x)},8L{N(x + rng.NextDouble() * 6 - 3)},132' stroke='#000' stroke-width='.7' opacity='.7'/>");
                }
                Sheen(sb, 0.09);
                break;
            case "massive":
                Dots(sb, rng, g, 18, 8, 20, 0.35);
                Dots(sb, rng, g, 220, 0.3, 0.6, 0.8);
                break;
            case "cleavage":
                Lines(sb, rng, g, -10, 150, 3.2, 0.3, -0.2, 0.02, 0.5, 1.0, 0.85);
                Sheen(sb, 0.05);
                break;
            case "schistose":
                Lines(sb, rng, g.Take(2).ToArray(), 4, 136, 4.2, 2.4, -0.06, 0.05, 0.8, 1.6, 0.8);
                for (var i = 0; i < 60; i++)
                {
                    var (x, y) = Spot(rng); var l = 1.5 + rng.NextDouble() * 2.5;
                    sb.Append($"<path d='M{N(x)},{N(y)}l{N(l)},{N(-l * 0.06)}' stroke='#fff' stroke-width='.7' opacity='{N(0.4 + rng.NextDouble() * 0.5)}'/>");
                }
                Polys(sb, rng, g.Skip(2).ToArray(), 7, 1.6, 2.8, 1, 1.05);
                break;
            case "gneissic":
                var y0 = 4 + rng.NextDouble() * 6;
                for (var i = 0; y0 < 140; i++)
                {
                    var w = i % 2 == 0 ? 8 + rng.NextDouble() * 7 : 4 + rng.NextDouble() * 5;
                    sb.Append($"<path d='{Wave(rng, y0, 4.5, -0.1, 0.03)}' fill='none' stroke='{(i % 2 == 0 ? g[0].Color : g[1].Color)}' stroke-width='{N(w)}' stroke-linejoin='round'/>");
                    y0 += w * 0.5 + 2 + rng.NextDouble() * 3;
                }
                Polys(sb, rng, g, 140, 1.2, 2.6, 0.55);
                break;
            case "veins":
                Polys(sb, rng, g.Take(1).ToArray(), 160, 2, 3.5, 0.5, 1.1);
                Lines(sb, rng, g.Skip(1).ToArray(), 10, 120, 30, 6, 0.45, 0.04, 0.6, 1.6, 0.6);
                break;
            case "sugary":
                Polys(sb, rng, g, 220, 1.5, 2.8, 0.6, 1.1);
                if (r.Minerals.Contains("quartz", StringComparison.OrdinalIgnoreCase)) Sheen(sb, 0.07);
                else Lines(sb, rng, dark, 30, 110, 30, 1, 0.02, 0.03, 0.5, 0.8, 0.6);
                break;
        }
    }

    // Field tests. Steel is about 5.5 on the Mohs scale; calcite fizzes in cold dilute HCl, dolomite only weakly.
    private const double SteelHardness = 5.5;

    private static string AcidKind(Rock r)
    {
        var m = r.Minerals.ToLowerInvariant();
        return m.Contains("calcite") || m.Contains("aragonite") ? "strong" : m.Contains("dolomite") ? "weak" : "none";
    }

    private static string SteelText(Rock r) =>
        r.Hardness >= SteelHardness ? "Too hard to scratch: harder than steel"
        : r.Hardness >= 5 ? "Scratches, only just: about as hard as steel"
        : "Scratches: softer than steel";

    private static string AcidText(string kind) => kind switch
    {
        "strong" => "Fizzes in dilute acid",
        "weak" => "Weak fizz, stronger on the powder",
        _ => "No reaction",
    };

    private async Task ScratchTest()
    {
        if (currentRock == null || steelBusy || steelResult != null) return;
        var rock = currentRock; steelBusy = true;
        await JS.TryInvokeVoidAsync("RockLab.scratch", ClipId(rock, "q"), rock.Hardness);
        if (rock != currentRock) return;
        steelBusy = false; steelResult = SteelText(rock);
    }

    private async Task AcidTest()
    {
        if (currentRock == null || acidBusy || acidResult != null) return;
        var rock = currentRock; var kind = AcidKind(rock); acidBusy = true;
        await JS.TryInvokeVoidAsync("RockLab.acid", ClipId(rock, "q"), kind);
        if (rock != currentRock) return;
        acidBusy = false; acidResult = AcidText(kind);
    }

