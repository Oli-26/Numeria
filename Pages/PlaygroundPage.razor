            $"C = π × d = {piValue * 2 * r:F0}", 170, 246, "rgba(220,228,255,0.7)", 11, "center");
    }

    private async Task DrawGravity()
    {
        var v0 = 20.0;
        var g = gravityValue;
        var yMax = v0 * v0 / (2 * g);
        var tMax = 2 * v0 / g;
        var refHeight = 200.0;
        var refYMax = v0 * v0 / (2 * 1.0);
        var scaleY = refHeight / Math.Max(refYMax * 0.12, 1);
        var groundY = 240.0;

        await JS.InvokeVoidAsync("MathCanvas.drawCanvasBackground", "playground-canvas",
            new object[] {
                new object[] { 0.0, "rgba(8,15,40,0.85)" },
                new object[] { 0.6, "rgba(30,40,80,0.6)" },
                new object[] { 1.0, "rgba(60,80,120,0.35)" }
            });
        await JS.InvokeVoidAsync("MathCanvas.drawStarfield", "playground-canvas", 60, (int)(g * 13));

        await JS.InvokeVoidAsync("MathCanvas.drawGradientFill", "playground-canvas",
            new[] { new[] { 0.0, groundY }, new[] { 340.0, groundY }, new[] { 340.0, 260.0 }, new[] { 0.0, 260.0 } },
            0, groundY, 0, 260,
            new object[] {
                new object[] { 0.0, "rgba(80,60,40,0.85)" },
                new object[] { 1.0, "rgba(40,28,18,0.95)" }
            });
        await JS.InvokeVoidAsync("MathCanvas.drawGlowPath", "playground-canvas",
            new[] { new[] { 0.0, groundY }, new[] { 340.0, groundY } }, "rgba(180,140,100,0.6)", 1.2, 4, 0.2);

        var refs = new[] { (1.6, "Moon", "rgba(180,200,220,0.45)"), (9.8, "Earth", "rgba(140,180,220,0.4)"), (24.8, "Jupiter", "rgba(220,180,140,0.4)") };
        foreach (var (refG, name, color) in refs)
        {
            if (Math.Abs(refG - g) < 0.5) continue;
            var refPeak = v0 * v0 / (2 * refG);
            var h = Math.Min(refPeak * scaleY, refHeight);
            var arc = new double[20][];
            for (int i = 0; i < 20; i++)
            {
                var t = (double)i / 19;
                arc[i] = new[] { 40 + t * 260, groundY - h * 4 * t * (1 - t) };
            }
            await JS.InvokeVoidAsync("MathCanvas.drawDashedPath", "playground-canvas", arc, color, 1.2, 4, 3);
            await JS.InvokeVoidAsync("MathCanvas.drawText", "playground-canvas",
                name, 170, groundY - h + 2, color, 9, "center");
        }

        var curPeak = Math.Min(yMax * scaleY, refHeight);
        var pts = new double[60][];
        for (int i = 0; i < 60; i++)
        {
            var t = (double)i / 59;
            pts[i] = new[] { 40 + t * 260, groundY - curPeak * 4 * t * (1 - t) };
        }
        await JS.InvokeVoidAsync("MathCanvas.drawGlowPath", "playground-canvas", pts, "#7FFFA8", 2.5, 8, 0.3);

        var trailCount = 20;
        for (int i = 0; i < trailCount; i++)
        {
            var t = (double)i / (trailCount - 1);
            var f = i * 1.0 / (trailCount - 1);
            var alpha = 0.15 + f * 0.6;
            var rad = 1.5 + f * 2.5;
            await JS.InvokeVoidAsync("MathCanvas.drawCircleFill", "playground-canvas",
                40 + t * 260, groundY - curPeak * 4 * t * (1 - t),
                rad, $"rgba(127,255,168,{alpha:F2})", null, 0);
        }

        await JS.InvokeVoidAsync("MathCanvas.drawGlowPoint", "playground-canvas",
            170, groundY - curPeak, 7, "#FF7766", "rgba(255,140,120,0.85)", 18);

        await JS.InvokeVoidAsync("MathCanvas.drawDashedPath", "playground-canvas",
            new[] { new[] { 15.0, groundY }, new[] { 15.0, groundY - curPeak } }, "rgba(127,255,168,0.55)", 1, 3, 3);
        await JS.InvokeVoidAsync("MathCanvas.drawText", "playground-canvas",
            $"{yMax:F1}m", 15, groundY - curPeak / 2, "#A8FFC8", 10, "center");

        var planetName = g < 2 ? "Moon-like" : g < 5 ? "Mars-like" : g < 12 ? "Earth-like" : g < 20 ? "Heavy" : "Crushing";
        await JS.InvokeVoidAsync("MathCanvas.drawText", "playground-canvas",
            $"g = {g:F1} m/s² ({planetName})  |  Peak: {yMax:F1}m  |  Time: {tMax:F1}s", 170, 18, "#A8FFC8", 11, "center");
    }

    private async Task DrawDivZero()
    {
        var cx = 170.0; var cy = 130.0;
        var curY = 1.0 / divZeroX;

        var yRange = Math.Max(curY * 1.5, 5);
        var xRange = Math.Max(divZeroX * 3, 0.5);
        var scaleX = 140.0 / xRange;
        var scaleY = 110.0 / yRange;

        await JS.InvokeVoidAsync("MathCanvas.drawCanvasBackground", "playground-canvas",
            new object[] { new object[] { 0.0, "rgba(35,5,15,0.6)" }, new object[] { 1.0, "rgba(15,5,35,0.5)" } });

        await JS.InvokeVoidAsync("MathCanvas.drawFunction", "playground-canvas",
            new[] { new[] { 20.0, cy }, new[] { 320.0, cy } }, "rgba(220,200,255,0.25)", 1);
        await JS.InvokeVoidAsync("MathCanvas.drawFunction", "playground-canvas",
            new[] { new[] { cx, 10.0 }, new[] { cx, 250.0 } }, "rgba(220,200,255,0.25)", 1);

        for (int i = 1; i <= 4; i++)
        {
            var labelVal = yRange * i / 4;
            var labelY = cy - (labelVal / yRange) * 110;
            if (labelY > 15)
                await JS.InvokeVoidAsync("MathCanvas.drawText", "playground-canvas",
                    labelVal >= 1000 ? $"{labelVal:E0}" : $"{labelVal:F0}", cx - 8, labelY + 3, "rgba(220,200,255,0.4)", 8, "right");
        }

        var pos = new List<double[]>();
        var step = xRange / 200;
        for (double x = step; x <= xRange * 2; x += step)
        {
            var y = 1.0 / x;
            var py = cy - y * scaleY;
            if (py > 10 && py < 250) pos.Add(new[] { cx + x * scaleX, py });
        }
        if (pos.Count > 1)
            await JS.InvokeVoidAsync("MathCanvas.drawGlowPath", "playground-canvas", pos.ToArray(), "#7FA8FF", 2.2, 8, 0.25);

        var neg = new List<double[]>();
        for (double x = -xRange * 2; x <= -step; x += step)
        {
            var y = 1.0 / x;
            var py = cy - y * scaleY;
            if (py > 10 && py < 250) neg.Add(new[] { cx + x * scaleX, py });
        }
        if (neg.Count > 1)
            await JS.InvokeVoidAsync("MathCanvas.drawGlowPath", "playground-canvas", neg.ToArray(), "#FF7090", 2.2, 8, 0.25);

        await JS.InvokeVoidAsync("MathCanvas.drawDashedPath", "playground-canvas",
            new[] { new[] { cx, 10.0 }, new[] { cx, 250.0 } }, "rgba(255,120,140,0.4)", 1.2, 4, 4);

        var ptX = cx + divZeroX * scaleX;
        var ptY = cy - Math.Min(curY, yRange) * scaleY;
        ptY = Math.Max(ptY, 15);
        await JS.InvokeVoidAsync("MathCanvas.drawDashedPath", "playground-canvas",
            new[] { new[] { ptX, cy }, new[] { ptX, ptY } }, "rgba(255,200,80,0.55)", 1.2, 3, 3);
        await JS.InvokeVoidAsync("MathCanvas.drawDashedPath", "playground-canvas",
            new[] { new[] { cx, ptY }, new[] { ptX, ptY } }, "rgba(255,200,80,0.55)", 1.2, 3, 3);

        var pulse = 1 + Math.Sin(DateTime.UtcNow.Millisecond / 1000.0 * Math.PI * 2) * 0.3;
        await JS.InvokeVoidAsync("MathCanvas.drawGlowPoint", "playground-canvas",
            ptX, ptY, 5, "#FFD050", "rgba(255,200,80,0.9)", 16 * pulse);

        var xStr = divZeroX < 0.001 ? divZeroX.ToString("E2") : divZeroX.ToString("F4");
        var yStr = curY > 1e6 ? curY.ToString("E2") : curY.ToString("N0");
        await JS.InvokeVoidAsync("MathCanvas.drawText", "playground-canvas",
            $"1 / {xStr} = {yStr}", 170, 16, "#FFD080", 13, "center");
        await JS.InvokeVoidAsync("MathCanvas.drawText", "playground-canvas",
            "Infinity isn't a number — it's a direction", 170, 252, "rgba(220,200,255,0.65)", 9, "center");
    }

    private async Task DrawDimension()
    {
        var maxDim = Math.Max(dimensionCount, 10);
        var barW = 300.0 / maxDim;
        double maxV = 0;
        var volumes = new double[maxDim];
        for (int n = 1; n <= maxDim; n++)
        {
            var halfN = n / 2.0;
            volumes[n - 1] = Math.Pow(Math.PI, halfN) / Gamma(halfN + 1);
            if (volumes[n - 1] > maxV) maxV = volumes[n - 1];
        }
        // Peak dimension label
        var peakDim = Array.IndexOf(volumes, maxV) + 1;

        for (int n = 1; n <= maxDim; n++)
        {
            var h = Math.Max(volumes[n - 1] / maxV * 175, 1);
            var x = 20 + (n - 1) * barW;
            var isSelected = n == dimensionCount;
            var isPeak = n == peakDim;
            var color = isSelected ? "#9B59B6" : isPeak ? "rgba(155,89,182,0.5)" : "rgba(155,89,182,0.2)";
            var border = isSelected ? "#7D3C98" : "rgba(155,89,182,0.25)";
            await JS.InvokeVoidAsync("MathCanvas.drawRect", "playground-canvas",
                x + 2, 225 - h, barW - 4, h, color, border);
            // Only label every dimension if room, or selected/peak
            if (barW > 20 || isSelected || isPeak || n == 1 || n == maxDim)
                await JS.InvokeVoidAsync("MathCanvas.drawText", "playground-canvas",
                    $"{n}", x + barW / 2, 242, isSelected ? "#9B59B6" : "#888", 9, "center");
        }

        // Volume value on top of selected bar
        var selVol = volumes[dimensionCount - 1];
        var selX = 20 + (dimensionCount - 1) * barW + barW / 2;
        var selH = Math.Max(selVol / maxV * 175, 1);
        await JS.InvokeVoidAsync("MathCanvas.drawText", "playground-canvas",
            selVol < 0.001 ? selVol.ToString("E1") : selVol.ToString("F3"),
            selX, 225 - selH - 6, "#9B59B6", 9, "center");

        // Percentage of bounding cube
        var cubeFraction = selVol / Math.Pow(2, dimensionCount) * 100;
        await JS.InvokeVoidAsync("MathCanvas.drawText", "playground-canvas",
            $"{dimensionCount}D: V = {(selVol < 0.001 ? selVol.ToString("E2") : selVol.ToString("F4"))}  ({cubeFraction:F1}% of bounding cube)",
            170, 16, "#9B59B6", 11, "center");
    }

    private static double Gamma(double z)
    {
        if (z < 0.5) return Math.PI / (Math.Sin(Math.PI * z) * Gamma(1 - z));
        z -= 1;
        double[] g = { 0.99999999999980993, 676.5203681218851, -1259.1392167224028, 771.32342877765313, -176.61502916214059, 12.507343278686905, -0.13857109526572012, 9.9843695780195716e-6, 1.5056327351493116e-7 };
        double x = g[0];
        for (int i = 1; i < 9; i++) x += g[i] / (z + i);
        double t = z + 7.5;
        return Math.Sqrt(2 * Math.PI) * Math.Pow(t, z + 0.5) * Math.Exp(-t) * x;
    }

    private async Task DrawBase()
    {
        // Show numbers 0-20 in current base
        var y = 35.0;
        for (int n = 0; n <= 20; n++)
        {
            var col = n % 3;
            var row = n / 3;
            var x = 30 + col * 110.0;
            var yPos = y + row * 28;
            var rep = ConvertToBase(n, numberBase);
            var color = n < numberBase ? "#2ECC71" : "#4A5FE0";
            await JS.InvokeVoidAsync("MathCanvas.drawText", "playground-canvas",
                $"{n}₁₀ = {rep}", x, yPos, color, 12, "left");
        }
        await JS.InvokeVoidAsync("MathCanvas.drawText", "playground-canvas",
            $"Base {numberBase}: digits 0-{(numberBase > 10 ? (char)('A' + numberBase - 11) : (char)('0' + numberBase - 1))}",
            170, 16, "#F1C40F", 13, "center");
    }

    private static string ConvertToBase(int n, int b)
    {
        if (n == 0) return "0";
        var digits = "0123456789ABCDEF";
        var result = "";
        while (n > 0) { result = digits[n % b] + result; n /= b; }
        return result;
    }

    private async Task DrawEuclid()
    {
        var cx = 170.0; var cy = 135.0;
        var k = curvatureValue;
        await JS.InvokeVoidAsync("MathCanvas.drawCanvasBackground", "playground-canvas",
            new object[] { new object[] { 0.0, "rgba(8,28,30,0.6)" }, new object[] { 1.0, "rgba(20,55,55,0.2)" } });
        await JS.InvokeVoidAsync("MathCanvas.drawRadialGlow", "playground-canvas",
            cx, cy, 0, 160, "rgba(26,188,156,0.22)", 1);

        var rGrid = 110.0;
        var rows = 9; var cols = 17;
        var nodes = new double[rows, cols, 2];
        for (int r = 0; r < rows; r++)
        {
            for (int c = 0; c < cols; c++)
            {
                var u = -1.0 + 2.0 * c / (cols - 1);
                var v = -1.0 + 2.0 * r / (rows - 1);
                double x, y, depth;
                if (Math.Abs(k) < 0.05)
                {
                    x = u * rGrid * 1.3;
                    y = v * rGrid * 0.6;
                    depth = 0.5;
                }
                else if (k > 0)
                {
                    var theta = u * Math.PI * 0.45 * (0.4 + k * 0.6);
                    var phi = v * Math.PI * 0.4 * (0.4 + k * 0.6);
                    var sx = Math.Cos(phi) * Math.Sin(theta);
                    var sy = Math.Sin(phi);
                    var sz = Math.Cos(phi) * Math.Cos(theta);
                    x = sx * rGrid * 1.2;
                    y = sy * rGrid * 0.65 - (1 - sz) * 12;
                    depth = (sz + 1) / 2;
                }
                else
                {
                    var kk = Math.Abs(k);
                    var stretch = 1 + kk * (u * u + v * v) * 0.6;
                    x = u * rGrid * 1.3 / stretch;
                    y = v * rGrid * 0.6 / stretch + (u * u + v * v) * 12 * kk;
                    depth = 1 - (u * u + v * v) * 0.4;
                }
                nodes[r, c, 0] = cx + x;
                nodes[r, c, 1] = cy + y;
            }
        }

        for (int r = 0; r < rows; r++)
        {
            var pts = new double[cols][];
            for (int c = 0; c < cols; c++) pts[c] = new[] { nodes[r, c, 0], nodes[r, c, 1] };
            var t = (double)r / (rows - 1);
            var alpha = 0.4 + Math.Abs(t - 0.5) * 0.5;
            var hue = 165 + (r % 2) * 8;
            await JS.InvokeVoidAsync("MathCanvas.drawGlowPath", "playground-canvas",
                pts, $"hsla({hue}, 70%, 65%, {alpha:F2})", 1.6, 4, 0.18);
        }
        for (int c = 0; c < cols; c++)
        {
            var pts = new double[rows][];
            for (int r = 0; r < rows; r++) pts[r] = new[] { nodes[r, c, 0], nodes[r, c, 1] };
            var alpha = 0.25 + (c % 2 == 0 ? 0.15 : 0);
            await JS.InvokeVoidAsync("MathCanvas.drawFunction", "playground-canvas",
                pts, $"rgba(140,220,200,{alpha:F2})", 1);
        }

        var midRow = rows / 2;
        var hl1 = midRow - 2; var hl2 = midRow + 2;
        var pl1 = new double[cols][]; var pl2 = new double[cols][];
        for (int c = 0; c < cols; c++)
        {
            pl1[c] = new[] { nodes[hl1, c, 0], nodes[hl1, c, 1] };
            pl2[c] = new[] { nodes[hl2, c, 0], nodes[hl2, c, 1] };
        }
        await JS.InvokeVoidAsync("MathCanvas.drawGlowPath", "playground-canvas", pl1, "#FFD27D", 2.2, 6, 0.35);
        await JS.InvokeVoidAsync("MathCanvas.drawGlowPath", "playground-canvas", pl2, "#FFD27D", 2.2, 6, 0.35);

        string title;
        if (Math.Abs(k) < 0.05) title = "Euclidean: parallel lines never meet";
        else if (k > 0) title = $"Spherical (K={k:F2}): geodesics converge!";
        else title = $"Hyperbolic (K={k:F2}): geodesics spread apart!";
        await JS.InvokeVoidAsync("MathCanvas.drawText", "playground-canvas",
            title, 170, 20, "#A8FFE0", 11, "center");
    }

    private async Task DrawExpo()
    {
        var r = growthRate;
        var steps = 30;
        var values = new double[steps];
        values[0] = 1;
        for (int i = 1; i < steps; i++) values[i] = values[i - 1] * r;

        var groundY = 235.0;
        var topY = 25.0;
        var chartH = groundY - topY;
        var visibleMax = Math.Max(values[(int)(steps * 0.65)], 2);

        await JS.InvokeVoidAsync("MathCanvas.drawCanvasBackground", "playground-canvas",
            new object[] { new object[] { 0.0, "rgba(40,20,8,0.6)" }, new object[] { 1.0, "rgba(70,40,15,0.2)" } });

        for (int i = 1; i <= 5; i++)
        {
            var y = groundY - chartH * i / 5;
            await JS.InvokeVoidAsync("MathCanvas.drawDashedPath", "playground-canvas",
                new[] { new[] { 30.0, y }, new[] { 310.0, y } }, "rgba(255,180,120,0.15)", 1, 3, 3);
        }

        var linPts = new double[steps][];
        for (int i = 0; i < steps; i++)
        {
            var x = 30 + i * 280.0 / (steps - 1);
            var linVal = 1 + (r - 1) * i;
            var y = groundY - (linVal / visibleMax) * chartH;
            linPts[i] = new[] { x, Math.Max(y, topY - 5) };
        }
        await JS.InvokeVoidAsync("MathCanvas.drawDashedPath", "playground-canvas", linPts, "rgba(200,200,220,0.4)", 1.2, 4, 4);
        await JS.InvokeVoidAsync("MathCanvas.drawText", "playground-canvas",
            "linear", 310, linPts[steps - 1][1] - 4, "rgba(200,200,220,0.55)", 8, "right");

        var pts = new double[steps][];
        var wentOffScreen = false;
        for (int i = 0; i < steps; i++)
        {
            var x = 30 + i * 280.0 / (steps - 1);
            var y = groundY - (values[i] / visibleMax) * chartH;
            if (y < topY - 5) { y = topY - 5; wentOffScreen = true; }
            pts[i] = new[] { x, y };
        }

        var fillPoly = new List<double[]>();
        foreach (var p in pts) fillPoly.Add(p);
        fillPoly.Add(new[] { pts[steps - 1][0], groundY });
        fillPoly.Add(new[] { pts[0][0], groundY });
        await JS.InvokeVoidAsync("MathCanvas.drawGradientFill", "playground-canvas",
            fillPoly.ToArray(), 0, topY, 0, groundY,
            new object[] {
                new object[] { 0.0, "rgba(255,180,80,0.6)" },
                new object[] { 0.6, "rgba(230,126,34,0.32)" },
                new object[] { 1.0, "rgba(180,80,20,0.05)" }
            });

        await JS.InvokeVoidAsync("MathCanvas.drawGlowPath", "playground-canvas", pts, "#FFB060", 2.5, 10, 0.3);

        await JS.InvokeVoidAsync("MathCanvas.drawGlowPath", "playground-canvas",
            new[] { new[] { 30.0, groundY }, new[] { 310.0, groundY } }, "rgba(255,200,160,0.5)", 1.2, 3, 0.2);

        await JS.InvokeVoidAsync("MathCanvas.drawGlowPoint", "playground-canvas", 30, pts[0][1], 5, "#FFD080", "rgba(255,200,140,0.9)", 14);

        if (wentOffScreen)
        {
            await JS.InvokeVoidAsync("MathCanvas.drawText", "playground-canvas",
                "OFF THE CHART!", 260, topY + 12, "rgba(255,120,90,0.85)", 10, "center");
        }

        var finalStr = values[steps - 1] > 1e15 ? values[steps - 1].ToString("E1") : values[steps - 1].ToString("N0");
        await JS.InvokeVoidAsync("MathCanvas.drawText", "playground-canvas",
            $"{r:F2}x per step. After 30: {finalStr}", 170, 14, "#FFD0A0", 11, "center");
    }

