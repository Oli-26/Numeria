@page "/playground"
@implements IAsyncDisposable
@inject IJSRuntime JS
@inject IProgressService Progress
@inject NavigationManager Nav

@if (!unlocked)
{
    <div class="page-header">
        <button class="back-btn" aria-label="Back to home" @onclick='() => Nav.NavigateTo("/")'><Icon Name="arrow-left" Size="18" /></button>
        <h1>What If? Playground</h1>
    </div>
    <div class="card" style="text-align: center; padding: 40px 24px">
        <Icon Name="lock" Size="40" Stroke="var(--text-muted)" />
        <h2 style="margin-top: 12px">Locked</h2>
        <p style="color: var(--text-secondary)">Purchase the "What If? Playground" from the Shop to unlock.</p>
        <button class="btn btn-accent" @onclick='() => Nav.NavigateTo("/shop")'>Go to Shop</button>
    </div>
}
else
{

<div class="page-header">
    <button class="back-btn" aria-label="Back to home" @onclick='() => Nav.NavigateTo("/")'><Icon Name="arrow-left" Size="18" /></button>
    <h1>What If? Playground</h1>
</div>

<p class="playground-subtitle">Break the rules. Twist the constants. See what happens.</p>

<div class="experiment-list">
    @foreach (var exp in experiments)
    {
        var e = exp;
        <div class="card card-clickable experiment-card" @onclick="() => OpenExperiment(e.Id)">
            <div class="exp-icon" style="background: @e.Color">@e.Symbol</div>
            <div class="exp-info">
                <strong>@e.Title</strong>
                <small>@e.Subtitle</small>
            </div>
            <Icon Name="arrow-left" Size="16" Style="transform: rotate(180deg); color: var(--text-muted)" />
        </div>
    }
</div>

@if (activeExperiment != null)
{
    <div class="experiment-overlay" @onclick="CloseExperiment">
        <div class="experiment-panel" @onclick:stopPropagation>
            <div class="exp-panel-header">
                <h2>@activeExperiment.Title</h2>
                <button class="close-btn" @onclick="CloseExperiment"><Icon Name="x-mark" Size="20" /></button>
            </div>
            <p class="exp-description">@activeExperiment.Description</p>

            <div class="canvas-container">
                <canvas id="playground-canvas"></canvas>
            </div>

            <div class="exp-controls">
                @if (activeExperiment.Id == "pi")
                {
                    <label>Pi = @piValue.ToString("F2")</label>
                    <input type="range" min="200" max="500" value="@piSlider" @oninput="OnPiChange" />
                    <small>Real pi = 3.14. Try 4.0 (squares!) or 2.0 (squished circles)</small>
                }
                else if (activeExperiment.Id == "gravity")
                {
                    <label>Gravity = @gravityValue.ToString("F1") m/s²</label>
                    <input type="range" min="1" max="200" value="@gravitySlider" @oninput="OnGravityChange" />
                    <div class="preset-row">
                        <button class="btn btn-sm btn-outline" @onclick="() => SetGravity(16)">Moon</button>
                        <button class="btn btn-sm btn-outline" @onclick="() => SetGravity(98)">Earth</button>
                        <button class="btn btn-sm btn-outline" @onclick="() => SetGravity(248)">Jupiter</button>
                    </div>
                    <small>Height: @((200.0 / gravityValue).ToString("F1"))m | Hang time: @((2 * 20.0 / gravityValue).ToString("F1"))s</small>
                }
                else if (activeExperiment.Id == "divzero")
                {
                    <label>x = @divZeroX.ToString("F6") | 1/x = @((1.0/divZeroX).ToString("N0"))</label>
                    <input type="range" min="0" max="1000" value="@divZeroSlider" @oninput="OnDivZeroChange" />
                    <small>Slide right to approach zero. At x=0.001, 1/x = 1,000. At x=0.0001, 1/x = 10,000...</small>
                }
                else if (activeExperiment.Id == "dimension")
                {
                    <label>Dimensions: @dimensionCount</label>
                    <input type="range" min="1" max="20" value="@dimensionCount" @oninput="OnDimensionChange" />
                    <small>Unit sphere volume peaks at 5D then shrinks toward zero!</small>
                    <button class="btn btn-sm btn-outline" style="margin-top: 8px; width: 100%" @onclick="() => showDimExplain = !showDimExplain">
                        @(showDimExplain ? "Hide explanation" : "Why does it shrink?")
                    </button>
                    @if (showDimExplain)
                    {
                        <div class="explain-box">
                            <p><strong>The curse of dimensionality.</strong> In high dimensions, most of the volume of a cube is concentrated in its corners, far from the center. The sphere (the set of points within distance 1 of the center) captures less and less of the cube's volume.</p>
                            <p>Think of it this way: in 2D, a circle covers about 78% of its bounding square. In 3D, a sphere covers 52% of its bounding cube. By 10D, the "sphere" covers just 0.25% of the cube. The corners dominate.</p>
                            <p>The formula is V_n = pi^(n/2) / Gamma(n/2 + 1). The gamma function in the denominator grows factorially, eventually overwhelming the pi^(n/2) in the numerator.</p>
                        </div>
                    }
                }
                else if (activeExperiment.Id == "base")
                {
                    <label>Number base: @numberBase</label>
                    <input type="range" min="2" max="16" value="@numberBase" @oninput="OnBaseChange" />
                    <small>Binary (2), Octal (8), Decimal (10), Hex (16)</small>
                }
                else if (activeExperiment.Id == "euclid")
                {
                    <label>Curvature: @curvatureValue.ToString("F2")</label>
                    <input type="range" min="0" max="200" value="@curvatureSlider" @oninput="OnCurvatureChange" />
                    <small>0 = flat (Euclid), positive = sphere, negative = hyperbolic</small>
                }
                else if (activeExperiment.Id == "expo")
                {
                    <label>Growth rate: @growthRate.ToString("F2")x per step</label>
                    <input type="range" min="100" max="300" value="@growthSlider" @oninput="OnGrowthChange" />
                    <div class="expo-comparison">
                        @{ var final = Math.Pow(growthRate, 30); }
                        <small>After 30 steps: <strong>@(final > 1e15 ? final.ToString("E1") : final.ToString("N0"))</strong></small>
                        <small>@GetExpoComparison(final)</small>
                    </div>
                }
                else if (activeExperiment.Id == "imaginary")
                {
                    <label>Angle: @imagAngle°</label>
                    <input type="range" min="0" max="360" value="@imagAngle" @oninput="OnImagChange" />
                    <small>Multiplying by i = rotating 90°. Powers of i cycle: i, -1, -i, 1, ...</small>
                }
                else if (activeExperiment.Id == "infinity")
                {
                    <label>Step @infinityStep of 7</label>
                    <div class="step-buttons">
                        <button class="btn btn-sm btn-outline" disabled="@(infinityStep <= 0)" @onclick="() => InfinityNav(-1)">
                            <Icon Name="arrow-left" Size="14" /> Back
                        </button>
                        <button class="btn btn-sm btn-primary" disabled="@(infinityStep >= 7)" @onclick="() => InfinityNav(1)">
                            Next <Icon Name="arrow-left" Size="14" Style="transform:rotate(180deg)" />
                        </button>
                    </div>
                    <small>@GetInfinityCaption()</small>
                }
                else if (activeExperiment.Id == "fracdim")
                {
                    <label>Fractal dimension: @fracDimValue.ToString("F2")</label>
                    <input type="range" min="0" max="250" value="@fracDimSlider" @oninput="OnFracDimChange" />
                    <div class="fracdim-examples">
                        <small>@GetFracDimLabel()</small>
                    </div>
                    <button class="btn btn-sm btn-outline" style="margin-top: 8px; width: 100%" @onclick="() => showFracExplain = !showFracExplain">
                        @(showFracExplain ? "Hide explanation" : "How does fractal dimension work?")
                    </button>
                    @if (showFracExplain)
                    {
                        <div class="explain-box">
                            <p><strong>Box-counting dimension:</strong> Cover the shape with boxes of side length r. Count how many boxes N(r) touch the shape. As r shrinks: N(r) ~ r^(-D). D is the fractal dimension.</p>
                            <p>A line: halve the box size, need 2x more boxes. D = log(2)/log(2) = 1. A filled square: halve box size, need 4x more. D = log(4)/log(2) = 2.</p>
                            <p>The Koch curve: each iteration replaces 1 segment with 4 segments, each 1/3 the length. D = log(4)/log(3) = 1.26. It's more than a line but less than a plane!</p>
                        </div>
                    }
                }
                else if (activeExperiment.Id == "contagion")
                {
                    <label>Rule: @GetCaRuleName()</label>
                    <div class="preset-row">
                        <button class="btn btn-sm @(caRule==0?"btn-primary":"btn-outline")" @onclick="() => SetCaRule(0)">Mod</button>
                        <button class="btn btn-sm @(caRule==1?"btn-primary":"btn-outline")" @onclick="() => SetCaRule(1)">Prime</button>
                        <button class="btn btn-sm @(caRule==2?"btn-primary":"btn-outline")" @onclick="() => SetCaRule(2)">Collatz</button>
                        <button class="btn btn-sm @(caRule==3?"btn-primary":"btn-outline")" @onclick="() => SetCaRule(3)">Fib</button>
                        <button class="btn btn-sm @(caRule==4?"btn-primary":"btn-outline")" @onclick="() => SetCaRule(4)">Life</button>
                        <button class="btn btn-sm @(caRule==5?"btn-primary":"btn-outline")" @onclick="() => SetCaRule(5)">Wave</button>
                        <button class="btn btn-sm @(caRule==6?"btn-primary":"btn-outline")" @onclick="() => SetCaRule(6)">XOR</button>
                    </div>
                    <div class="step-buttons">
                        <button class="btn btn-sm btn-outline" @onclick="ResetCa">Reset</button>
                        <button class="btn btn-sm btn-primary" @onclick="StepCa">Step</button>
                        @if (caRunning)
                        {
                            <button class="btn btn-sm" style="background:var(--error);color:white" @onclick="StopCa">Stop</button>
                        }
                        else
                        {
                            <button class="btn btn-sm btn-accent" @onclick="AutoRunCa">Run</button>
                        }
                    </div>
                    <div class="ca-settings">
                        <label>Grid: @caGridSize x @caGridSize</label>
                        <input type="range" min="11" max="61" step="2" value="@caGridSize" @oninput="OnCaGridSizeChange" />
                        <label>Speed: @caSpeed steps/sec</label>
                        <input type="range" min="1" max="10" value="@caSpeed" @oninput="OnCaSpeedChange" />
                        <div class="ca-toggle-row">
                            <span>8-neighbor mode</span>
                            <button class="toggle-btn @(ca8Neighbor ? "on" : "")" @onclick="ToggleCa8">
                                <span class="toggle-knob"></span>
                            </button>
                        </div>
                    </div>
                    <small>Gen @caGeneration | @GetCaRuleDescription()</small>
                }
                else if (activeExperiment.Id == "terraform")
                {
                    <label>Terrain: @GetTerrainName()</label>
                    <div class="preset-row" style="flex-wrap: wrap">
                        <button class="btn btn-sm @(terrainFunc==0?"btn-primary":"btn-outline")" @onclick="() => SetTerrain(0)">Hills</button>
                        <button class="btn btn-sm @(terrainFunc==1?"btn-primary":"btn-outline")" @onclick="() => SetTerrain(1)">Ripple</button>
                        <button class="btn btn-sm @(terrainFunc==2?"btn-primary":"btn-outline")" @onclick="() => SetTerrain(2)">Peaks</button>
                        <button class="btn btn-sm @(terrainFunc==3?"btn-primary":"btn-outline")" @onclick="() => SetTerrain(3)">Canyon</button>
                        <button class="btn btn-sm @(terrainFunc==4?"btn-primary":"btn-outline")" @onclick="() => SetTerrain(4)">Alien</button>
                        <button class="btn btn-sm @(terrainFunc==5?"btn-primary":"btn-outline")" @onclick="() => SetTerrain(5)">Volcano</button>
                        <button class="btn btn-sm @(terrainFunc==6?"btn-primary":"btn-outline")" @onclick="() => SetTerrain(6)">Dunes</button>
                        <button class="btn btn-sm @(terrainFunc==7?"btn-primary":"btn-outline")" @onclick="() => SetTerrain(7)">Fractal</button>
                    </div>
                    <label>Height: @terrainAmplitude.ToString("F1")x</label>
                    <input type="range" min="10" max="150" value="@terrainAmp" @oninput="OnTerrainAmpChange" />
                    <label>Rotation: @terrainRotation°</label>
                    <input type="range" min="0" max="90" value="@terrainRotation" @oninput="OnTerrainRotChange" />
                    <label>Detail: @terrainDensity</label>
                    <input type="range" min="12" max="40" value="@terrainDensity" @oninput="OnTerrainDensityChange" />
                }
                else if (activeExperiment.Id == "axioms")
                {
                    <label>Toggle axioms and see the consequences:</label>
                    <div class="axiom-toggles">
                        <div class="axiom-row">
                            <span>Axiom of Choice</span>
                            <button class="toggle-btn @(axiomChoice ? "on" : "")" @onclick="() => ToggleAxiom(0)"><span class="toggle-knob"></span></button>
                        </div>
                        <div class="axiom-row">
                            <span>Law of Excluded Middle</span>
                            <button class="toggle-btn @(axiomExcludedMiddle ? "on" : "")" @onclick="() => ToggleAxiom(1)"><span class="toggle-knob"></span></button>
                        </div>
                        <div class="axiom-row">
                            <span>Axiom of Infinity</span>
                            <button class="toggle-btn @(axiomInfinity ? "on" : "")" @onclick="() => ToggleAxiom(2)"><span class="toggle-knob"></span></button>
                        </div>
                    </div>
                }
                else if (activeExperiment.Id == "rules")
                {
                    <label>Toggle arithmetic rules:</label>
                    <div class="axiom-toggles">
                        <div class="axiom-row">
                            <span>a + b = b + a</span>
                            <button class="toggle-btn @(ruleCommAdd ? "on" : "")" @onclick="() => ToggleRule(0)"><span class="toggle-knob"></span></button>
                        </div>
                        <div class="axiom-row">
                            <span>a x b = b x a</span>
                            <button class="toggle-btn @(ruleCommMul ? "on" : "")" @onclick="() => ToggleRule(1)"><span class="toggle-knob"></span></button>
                        </div>
                        <div class="axiom-row">
                            <span>(a+b)+c = a+(b+c)</span>
                            <button class="toggle-btn @(ruleAssoc ? "on" : "")" @onclick="() => ToggleRule(2)"><span class="toggle-knob"></span></button>
                        </div>
                        <div class="axiom-row">
                            <span>Zero exists (a+0=a)</span>
                            <button class="toggle-btn @(ruleZeroExists ? "on" : "")" @onclick="() => ToggleRule(3)"><span class="toggle-knob"></span></button>
                        </div>
                        <div class="axiom-row">
                            <span>a(b+c) = ab+ac</span>
                            <button class="toggle-btn @(ruleDistrib ? "on" : "")" @onclick="() => ToggleRule(4)"><span class="toggle-knob"></span></button>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
}
} @* end else unlocked *@

@code {
    private bool unlocked;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            var profile = await Progress.GetProfileAsync();
            unlocked = profile.ShopPurchases.Contains("unlock-playground");
            StateHasChanged();
        }
    }

    private record Experiment(string Id, string Title, string Subtitle, string Description, string Symbol, string Color);

    private List<Experiment> experiments = new()
    {
        new("pi", "What If Pi Was Different?", "Reshape circles by changing pi", "Pi defines the ratio of circumference to diameter. But what if it was 4? Or 2? Watch how circles morph into squares, ellipses, and alien shapes.", "π", "rgba(74, 95, 224, 0.15)"),
        new("gravity", "What If Gravity Changed?", "Launch a ball on different planets", "Throw a ball upward and watch its trajectory change as you dial gravity from Moon-strength to Jupiter-strength to absurd extremes.", "g", "rgba(46, 204, 113, 0.15)"),
        new("divzero", "What If You Divide By Zero?", "Approach the forbidden operation", "We're told you can't divide by zero. But what happens as you get closer and closer? Watch 1/x as x approaches zero from both sides.", "1/0", "rgba(231, 76, 60, 0.15)"),
        new("dimension", "What If Space Had More Dimensions?", "Sphere volume in N dimensions", "A unit sphere in 2D has area π. In 3D, volume 4π/3. In higher dimensions? The volume peaks at dimension 5, then shrinks toward zero. Infinity is weird.", "Nᴰ", "rgba(155, 89, 182, 0.15)"),
        new("base", "What If We Didn't Count In Base 10?", "See numbers in any base", "Humans have 10 fingers, so we use base 10. Computers use base 2. What does counting look like in base 3? Base 7? Base 16?", "0₁₆", "rgba(241, 196, 15, 0.15)"),
        new("euclid", "What If Parallel Lines Could Meet?", "Bend the geometry of space", "In Euclidean geometry, parallel lines never meet. But on a sphere they do! Dial the curvature from flat to spherical to hyperbolic.", "∦", "rgba(26, 188, 156, 0.15)"),
        new("expo", "What If Growth Never Stopped?", "Exponential growth visualized", "Start with 1. Multiply by a small number each step. Watch how absurdly fast it grows — and why exponentials dominate everything.", "eˣ", "rgba(230, 126, 34, 0.15)"),
        new("imaginary", "What If √-1 Existed?", "Visualize complex multiplication", "We invented i = √-1. Multiplying by i rotates a point 90° in the complex plane. Watch numbers spiral through the four quadrants.", "i", "rgba(22, 160, 133, 0.15)"),
        new("infinity", "What If Infinity Came in Sizes?", "Some infinities are bigger than others", "There are as many even numbers as natural numbers (both infinite!). But Cantor proved there are MORE real numbers than natural numbers. Watch the diagonal argument unfold step by step.", "ℵ", "rgba(52, 152, 219, 0.15)"),
        new("fracdim", "What If Dimensions Could Be Fractional?", "Shapes between 1D and 2D", "A line is 1D. A plane is 2D. But what about a coastline? A crumpled ball of paper? Fractal dimension measures how 'space-filling' a shape is. Explore objects with dimension 0.63, 1.26, 1.58...", "D?", "rgba(192, 57, 43, 0.15)"),
        new("contagion", "What If Numbers Were Contagious?", "Cellular automata meets number theory", "Seed a grid with a number. It spreads to neighbors following a rule you choose. Some rules create chaos, some create stunning symmetry, some die out. Tweak the rule and watch math come alive.", "CA", "rgba(211, 84, 0, 0.15)"),
        new("terraform", "Terraform with Math", "Shape worlds using functions", "Start with flat terrain. Stack mathematical functions to sculpt mountains, valleys, and alien landscapes. Your world is defined by f(x,y). Rotate and explore.", "f()", "rgba(39, 174, 96, 0.15)"),
        new("axioms", "Vote on Axioms", "Choose your mathematical universe", "Should the Axiom of Choice be true? What about Excluded Middle? Vote on foundational axioms and see what theorems survive -- and what paradoxes appear.", "?!", "rgba(142, 68, 173, 0.15)"),
        new("rules", "What If Math Had Different Rules?", "Break arithmetic and see what survives", "What if multiplication was commutative but addition wasn't? What if there was no zero? Toggle fundamental rules on and off, and watch algebra reshape itself.", "a+b", "rgba(44, 62, 80, 0.15)")
    };

    private Experiment? activeExperiment;
    private bool canvasReady;

    // Pi experiment
    private int piSlider = 314;
    private double piValue => piSlider / 100.0;

    // Gravity experiment
    private int gravitySlider = 98;
    private double gravityValue => gravitySlider / 10.0;

    // Divide by zero -- exponential slider: 0 = x=1.0, 1000 = x=0.000001
    private int divZeroSlider = 500;
    private double divZeroX => Math.Pow(10, -(divZeroSlider / 166.7)); // 0→1.0, 500→0.001, 1000→0.000001

    // Dimensions
    private int dimensionCount = 3;
    private bool showDimExplain;

    // Number base
    private int numberBase = 10;

    // Curvature
    private int curvatureSlider = 0;
    private double curvatureValue => (curvatureSlider - 100) / 100.0;

    // Exponential growth
    private int growthSlider = 150;
    private double growthRate => growthSlider / 100.0;

    // Imaginary
    private int imagAngle = 90;

    // Infinity sizes
    private int infinityStep = 0;

    // Fractal dimension
    private bool showFracExplain;
    private int fracDimSlider = 150;
    private double fracDimValue => fracDimSlider / 100.0;

    // Contagion automata
    private int caRule = 0;
    private int caGridSize = 31;
    private int[,] caGrid = new int[31, 31];
    private int caGeneration;
    private bool caRunning;
    private bool ca8Neighbor;
    private int caSpeed = 2; // steps per second

    // Terraform
    private int terrainFunc = 0;
    private int terrainAmp = 50;
    private double terrainAmplitude => terrainAmp / 50.0;
    private int terrainRotation = 30;
    private int terrainDensity = 28;

    // Axiom voting
    private bool axiomChoice = true;
    private bool axiomExcludedMiddle = true;
    private bool axiomInfinity = true;
    // Different rules
    private bool ruleCommAdd = true;
    private bool ruleCommMul = true;
    private bool ruleAssoc = true;
    private bool ruleZeroExists = true;
    private bool ruleDistrib = true;

    private async Task OpenExperiment(string id)
    {
        activeExperiment = experiments.First(e => e.Id == id);
        canvasReady = false;
        StateHasChanged();
        await Task.Delay(50); // let DOM render
        await JS.InvokeVoidAsync("MathCanvas.init", "playground-canvas", 340, 260);
        canvasReady = true;
        if (id == "contagion") { caRunning = false; ResetCaGrid(); }
        await DrawExperiment();
    }

    private void CloseExperiment()
    {
        activeExperiment = null;
    }

    private async Task DrawExperiment()
    {
        if (!canvasReady || activeExperiment == null) return;
        await JS.InvokeVoidAsync("MathCanvas.clear", "playground-canvas");

        switch (activeExperiment.Id)
        {
            case "pi": await DrawPi(); break;
            case "gravity": await DrawGravity(); break;
            case "divzero": await DrawDivZero(); break;
            case "dimension": await DrawDimension(); break;
            case "base": await DrawBase(); break;
            case "euclid": await DrawEuclid(); break;
            case "expo": await DrawExpo(); break;
            case "imaginary": await DrawImaginary(); break;
            case "infinity": await DrawInfinity(); break;
            case "fracdim": await DrawFracDim(); break;
            case "contagion": await DrawContagion(); break;
            case "terraform": await DrawTerraform(); break;
            case "axioms": await DrawAxioms(); break;
            case "rules": await DrawRules(); break;
        }
    }

    // --- Drawing methods ---
    private async Task DrawPi()
    {
        var cx = 170.0; var cy = 130.0; var r = 80.0;
        await JS.InvokeVoidAsync("MathCanvas.drawCanvasBackground", "playground-canvas",
            new object[] { new object[] { 0.0, "rgba(20,24,60,0.05)" }, new object[] { 1.0, "rgba(74,95,224,0.12)" } });

        await JS.InvokeVoidAsync("MathCanvas.drawRadialGlow", "playground-canvas",
            cx, cy, 0, r * 1.6, "rgba(74,95,224,0.35)", 0.9);

        var ghost = new double[49][];
        for (int i = 0; i <= 48; i++)
        {
            var a = 2 * Math.PI * i / 48;
            ghost[i] = new[] { cx + r * Math.Cos(a), cy + r * Math.Sin(a) };
        }
        await JS.InvokeVoidAsync("MathCanvas.drawDashedPath", "playground-canvas", ghost, "rgba(180,200,255,0.45)", 1.2, 5, 4);

        var points = new double[97][];
        var n = piValue / Math.PI * 2;
        for (int i = 0; i <= 96; i++)
        {
            var angle = 2 * Math.PI * i / 96;
            var cosA = Math.Cos(angle);
            var sinA = Math.Sin(angle);
            var rr = r / Math.Pow(Math.Pow(Math.Abs(cosA), n) + Math.Pow(Math.Abs(sinA), n), 1.0 / n);
            points[i] = new[] { cx + rr * cosA, cy + rr * sinA };
        }

        await JS.InvokeVoidAsync("MathCanvas.drawGradientFill", "playground-canvas",
            points, cx, cy - r, cx, cy + r,
            new object[] {
                new object[] { 0.0, "rgba(120,140,255,0.55)" },
                new object[] { 0.5, "rgba(74,95,224,0.32)" },
                new object[] { 1.0, "rgba(40,55,140,0.18)" }
            });

        await JS.InvokeVoidAsync("MathCanvas.drawGlowPath", "playground-canvas", points, "#A8B8FF", 2.5, 10, 0.22);

        var traceFrac = ((DateTime.UtcNow.Millisecond / 1000.0) + piValue * 0.1) % 1.0;
        var traceLen = (int)(points.Length * 0.18);
        var traceStart = (int)(points.Length * traceFrac);
        var trace = new List<double[]>();
        for (int i = 0; i < traceLen; i++) trace.Add(points[(traceStart + i) % points.Length]);
        await JS.InvokeVoidAsync("MathCanvas.drawGlowPath", "playground-canvas", trace.ToArray(), "#FFFFFF", 2.0, 8, 0.4);

        var diaPts = new[] { new[] { cx - r, cy }, new[] { cx + r, cy } };
        await JS.InvokeVoidAsync("MathCanvas.drawDashedPath", "playground-canvas", diaPts, "rgba(255,255,255,0.35)", 1.2, 4, 3);
