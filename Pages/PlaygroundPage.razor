            await JS.InvokeVoidAsync("MathCanvas.drawText", "playground-canvas", "A line: dimension 1", cx, cy + 30, "rgba(255,210,190,0.75)", 11, "center");
        }
        else if (d < 1.45)
        {
            await DrawKochSnowflake(cx, cy, 90, 4);
            await JS.InvokeVoidAsync("MathCanvas.drawText", "playground-canvas",
                "Koch snowflake: D = log4/log3 \u2248 1.26", cx, 30, "rgba(255,210,190,0.8)", 10, "center");
        }
        else if (d < 1.75)
        {
            // Sierpinski-like (D≈1.58)
