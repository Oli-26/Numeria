    private async Task DrawFracDim()
    {
        var d = fracDimValue;
        var cx = 170.0; var cy = 120.0;
        await JS.InvokeVoidAsync("MathCanvas.drawCanvasBackground", "playground-canvas",
            new object[] { new object[] { 0.0, "rgba(40,10,8,0.5)" }, new object[] { 1.0, "rgba(80,20,15,0.15)" } });
