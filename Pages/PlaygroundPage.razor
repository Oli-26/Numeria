        var curX = 30 + d / 2.5 * 280;
        await JS.InvokeVoidAsync("MathCanvas.drawGlowPoint", "playground-canvas",
            curX, lineY, 5, "#FF8060", "rgba(255,140,100,0.85)", 16);

        if (d < 0.3)
        {
            await JS.InvokeVoidAsync("MathCanvas.drawGlowPoint", "playground-canvas", cx, cy, 5, "#FF7050", "rgba(255,150,100,0.9)", 22);
            await JS.InvokeVoidAsync("MathCanvas.drawText", "playground-canvas", "A point: dimension 0", cx, cy + 36, "rgba(255,210,190,0.75)", 11, "center");
        }
        else if (d < 0.8)
        {
