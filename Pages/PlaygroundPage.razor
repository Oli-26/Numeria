    private static bool IsPrimeSmall(int n)
    {
        if (n < 2) return false;
        for (int i = 2; i * i <= n; i++) if (n % i == 0) return false;
        return true;
    }

    // --- Terraform ---
    private async Task DrawTerraform()
    {
        var gridN = terrainDensity;
        var amp = terrainAmplitude;
        var rotRad = terrainRotation * Math.PI / 180;
        var cosR = Math.Cos(rotRad);
        var sinR = Math.Sin(rotRad);

        await JS.InvokeVoidAsync("MathCanvas.drawCanvasBackground", "playground-canvas",
            new object[] {
                new object[] { 0.0, "rgba(80,120,180,0.5)" },
                new object[] { 0.55, "rgba(180,140,100,0.25)" },
                new object[] { 1.0, "rgba(40,30,20,0.5)" }
            });

        var heights = new double[gridN + 1, gridN + 1];
        double minH = double.MaxValue, maxH = double.MinValue;
        for (int gy = 0; gy <= gridN; gy++)
        {
            for (int gx = 0; gx <= gridN; gx++)
            {
                var fx = (double)gx / gridN * 6 - 3;
                var fy = (double)gy / gridN * 6 - 3;
                var h = GetTerrainHeight(fx, fy) * amp;
                heights[gx, gy] = h;
                if (h < minH) minH = h;
                if (h > maxH) maxH = h;
            }
        }
        var hRange = Math.Max(maxH - minH, 0.01);

        for (int gy = gridN - 1; gy >= 0; gy--)
        {
            for (int gx = 0; gx < gridN; gx++)
            {
                var h00 = heights[gx, gy];
                var h10 = heights[gx + 1, gy];
                var h01 = heights[gx, gy + 1];
                var h11 = heights[gx + 1, gy + 1];
                var avgH = (h00 + h10 + h01 + h11) / 4;
                var norm = (avgH - minH) / hRange;

                var slopeX = (h10 + h11) / 2 - (h00 + h01) / 2;
                var slopeY = (h01 + h11) / 2 - (h00 + h10) / 2;
                var nrm = Math.Sqrt(slopeX * slopeX + slopeY * slopeY + 1);
                var nx = -slopeX / nrm;
                var ny = -slopeY / nrm;
                var nz = 1 / nrm;
                var lx = -0.4; var ly = -0.6; var lz = 0.7;
                var dot = Math.Max(0.25, nx * lx + ny * ly + nz * lz);

                int hue, sat, light;
                if (norm < 0.2) { hue = 210; sat = 65; light = 32; }
                else if (norm < 0.4) { hue = 140; sat = 55; light = 35; }
                else if (norm < 0.6) { hue = 90; sat = 50; light = 42; }
                else if (norm < 0.8) { hue = 30; sat = 55; light = 45; }
                else { hue = 30; sat = 12; light = 82; }
                var litLight = (int)(light * dot * 1.4);
                if (litLight > 90) litLight = 90;
                if (litLight < 8) litLight = 8;

                var quad = new double[4][];
                quad[0] = IsoProject(gx, gy, h00, gridN, cosR, sinR);
                quad[1] = IsoProject(gx + 1, gy, h10, gridN, cosR, sinR);
                quad[2] = IsoProject(gx + 1, gy + 1, h11, gridN, cosR, sinR);
                quad[3] = IsoProject(gx, gy + 1, h01, gridN, cosR, sinR);

                await JS.InvokeVoidAsync("MathCanvas.drawShape", "playground-canvas",
                    quad, $"hsl({hue}, {sat}%, {litLight}%)",
                    $"hsla({hue}, {sat}%, {Math.Max(litLight - 12, 5)}%, 0.55)", 0.4);
            }
        }

        await JS.InvokeVoidAsync("MathCanvas.drawText", "playground-canvas",
            $"f(x,y) = {GetTerrainFormula()}", 170, 16, "#A8FFD8", 10, "center");
    }

    private static double[] IsoProject(int gx, int gy, double h, int gridN, double cosR, double sinR)
    {
        var fx = (double)gx / gridN - 0.5;
        var fy = (double)gy / gridN - 0.5;
        // Rotate
        var rx = fx * cosR - fy * sinR;
        var ry = fx * sinR + fy * cosR;
        // Isometric
        var sx = 170 + rx * 280;
        var sy = 145 + ry * 160 - h * 30;
        return new[] { sx, sy };
    }

    private double GetTerrainHeight(double x, double y)
    {
        return terrainFunc switch
        {
            0 => Math.Sin(x) * Math.Cos(y),
            1 => Math.Sin(Math.Sqrt(x * x + y * y) * 3) / Math.Max(Math.Sqrt(x * x + y * y), 0.3),
            2 => Math.Exp(-(x * x + y * y) / 2) + 0.5 * Math.Exp(-((x - 1.5) * (x - 1.5) + (y - 1) * (y - 1))),
            3 => -Math.Abs(Math.Sin(x * 2)) * Math.Cos(y * 0.5),
            4 => Math.Sin(x * y) * Math.Cos(x - y) + 0.3 * Math.Sin(3 * x) * Math.Sin(3 * y),
            5 => Math.Exp(-(x * x + y * y) / 1.5) * 2 - 0.5 * Math.Exp(-(x * x + y * y) / 0.3), // volcano
            6 => Math.Sin(x * 1.5 + y * 0.5) * 0.5 + Math.Sin(x * 0.3 + y * 1.8) * 0.3 + Math.Sin(x * 2.1 - y * 0.7) * 0.2, // dunes
            7 => FractalNoise(x, y), // fractal
            _ => 0
        };
    }

    private static double FractalNoise(double x, double y)
    {
        double val = 0; double amp = 1; double freq = 1;
        for (int i = 0; i < 5; i++)
        {
            val += Math.Sin(x * freq + i * 1.7) * Math.Cos(y * freq + i * 2.3) * amp;
            freq *= 2; amp *= 0.5;
        }
        return val;
    }

