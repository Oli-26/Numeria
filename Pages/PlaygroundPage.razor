            await JS.InvokeVoidAsync("MathCanvas.drawText", "playground-canvas",
                $"D = {d:F2}: beyond a plane, into volume", cx, 205, "rgba(255,210,190,0.85)", 10, "center");
        }

        await JS.InvokeVoidAsync("MathCanvas.drawText", "playground-canvas",
            $"Dimension = {d:F2}", cx, 16, "#FFB090", 13, "center");
    }

    private async Task DrawCantorSet(double left, double right, double y1, double y2, int depth, int level)
    {
        if (depth == 0 || right - left < 2)
        {
            var alpha = 0.55 + level * 0.08;
            var hue = 10 + level * 6;
            await JS.InvokeVoidAsync("MathCanvas.drawRoundRect", "playground-canvas",
                left, y1, right - left, y2 - y1, 1.5,
                $"hsla({hue}, 80%, 60%, {Math.Min(alpha, 0.95):F2})", null, 0);
            return;
        }
        var third = (right - left) / 3;
        await DrawCantorSet(left, left + third, y1, y2, depth - 1, level + 1);
        await DrawCantorSet(right - third, right, y1, y2, depth - 1, level + 1);
    }

    private async Task DrawKochLine(double x1, double y1, double x2, double y2, int depth, int level, int maxLevel)
    {
        if (depth == 0)
        {
            var t = maxLevel == 0 ? 0 : (double)level / maxLevel;
            var hue = 20 - t * 15;
            var sat = 80 + t * 10;
            var light = 70 - t * 20;
            await JS.InvokeVoidAsync("MathCanvas.drawGlowPath", "playground-canvas",
                new[] { new[] { x1, y1 }, new[] { x2, y2 } },
                $"hsl({hue:F0}, {sat:F0}%, {light:F0}%)", 1.4, 3, 0.25);
            return;
        }
        var dx = x2 - x1; var dy = y2 - y1;
        var ax = x1 + dx / 3; var ay = y1 + dy / 3;
        var bx = x1 + 2 * dx / 3; var by = y1 + 2 * dy / 3;
        var px = (x1 + x2) / 2 - dy * Math.Sqrt(3) / 6;
        var py = (y1 + y2) / 2 + dx * Math.Sqrt(3) / 6;
        await DrawKochLine(x1, y1, ax, ay, depth - 1, level + 1, maxLevel);
        await DrawKochLine(ax, ay, px, py, depth - 1, level + 1, maxLevel);
        await DrawKochLine(px, py, bx, by, depth - 1, level + 1, maxLevel);
        await DrawKochLine(bx, by, x2, y2, depth - 1, level + 1, maxLevel);
    }

    private async Task DrawKochSnowflake(double cx, double cy, double size, int depth)
    {
        var h = size * Math.Sqrt(3) / 2;
        var p1 = new[] { cx, cy - h * 2 / 3 };
        var p2 = new[] { cx + size / 2, cy + h / 3 };
        var p3 = new[] { cx - size / 2, cy + h / 3 };
        await DrawKochLine(p1[0], p1[1], p2[0], p2[1], depth, 0, depth);
        await DrawKochLine(p2[0], p2[1], p3[0], p3[1], depth, 0, depth);
        await DrawKochLine(p3[0], p3[1], p1[0], p1[1], depth, 0, depth);
    }

    private async Task DrawSierpinskiSmall(double cx, double cy, double size, int depth, int level)
    {
        if (depth == 0)
        {
            var h = size * Math.Sqrt(3) / 2;
            var hue = 5 + level * 8;
            var alpha = 0.45 + level * 0.05;
            await JS.InvokeVoidAsync("MathCanvas.drawShape", "playground-canvas",
                new[] { new[] { cx, cy }, new[] { cx - size / 2, cy + h }, new[] { cx + size / 2, cy + h } },
                $"hsla({hue}, 80%, 60%, {Math.Min(alpha, 0.95):F2})",
                $"hsla({hue}, 85%, 75%, 0.85)", 1);
            return;
        }
        var half = size / 2;
        var hh = half * Math.Sqrt(3) / 2;
        await DrawSierpinskiSmall(cx, cy, half, depth - 1, level + 1);
        await DrawSierpinskiSmall(cx - half / 2, cy + hh, half, depth - 1, level + 1);
        await DrawSierpinskiSmall(cx + half / 2, cy + hh, half, depth - 1, level + 1);
    }

    private string GetFracDimLabel()
    {
        var d = fracDimValue;
        if (d < 0.3) return "D = 0: a point. No length, no area. Just... there.";
        if (d < 0.8) return "D \u2248 0.63: Cantor set. More than a point, less than a line. Infinitely many pieces, zero total length.";
        if (d < 1.15) return "D = 1: a line. Has length but no area.";
        if (d < 1.45) return "D \u2248 1.26: Koch curve. Infinite length crammed into finite space. A line trying to become a plane.";
        if (d < 1.75) return "D \u2248 1.58: Sierpinski triangle. More than a curve but less than a surface.";
        if (d < 1.95) return "D \u2248 1.9: almost a plane. Like a coastline -- the more you zoom in, the more detail appears.";
        if (d < 2.05) return "D = 2: a filled region. Has area.";
        return "D > 2: beyond flat. A space-filling sponge, crumpled 3D structure.";
    }

    // --- Contagion automata ---
    private async Task DrawContagion()
    {
        var sz = caGridSize;
        var canvasW = 310.0;
        var canvasH = 230.0;
        var cellW = Math.Min(canvasW / sz, canvasH / sz);
        var ox = (340 - sz * cellW) / 2;
        var oy = 28.0;

        await JS.InvokeVoidAsync("MathCanvas.drawCanvasBackground", "playground-canvas",
            new object[] { new object[] { 0.0, "rgba(20,12,30,0.7)" }, new object[] { 1.0, "rgba(40,20,50,0.4)" } });

        await JS.InvokeVoidAsync("MathCanvas.drawRoundRect", "playground-canvas",
            ox - 4, oy - 4, sz * cellW + 8, sz * cellW + 8, 6,
            "rgba(0,0,0,0.35)", "rgba(255,180,100,0.35)", 1.2);

        var rad = Math.Max(cellW * 0.18, 1);
        for (int y = 0; y < sz; y++)
        {
            for (int x = 0; x < sz; x++)
            {
                var val = caGrid[x, y];
                if (val == 0)
                {
                    await JS.InvokeVoidAsync("MathCanvas.drawRoundRect", "playground-canvas",
                        ox + x * cellW + 0.5, oy + y * cellW + 0.5, cellW - 1, cellW - 1, rad,
                        "rgba(255,255,255,0.025)", null, 0);
                }
                else
                {
                    var color = GetCaColor(val);
                    await JS.InvokeVoidAsync("MathCanvas.drawRoundRect", "playground-canvas",
                        ox + x * cellW + 0.5, oy + y * cellW + 0.5, cellW - 1, cellW - 1, rad,
                        color, null, 0);
                    if (cellW >= 6)
                    {
                        await JS.InvokeVoidAsync("MathCanvas.drawRoundRect", "playground-canvas",
                            ox + x * cellW + cellW * 0.18, oy + y * cellW + cellW * 0.15,
                            cellW * 0.45, cellW * 0.3, rad * 0.6,
                            "rgba(255,255,255,0.22)", null, 0);
                    }
                }
            }
        }
        var alive = 0;
        for (int y = 0; y < sz; y++)
            for (int x = 0; x < sz; x++)
                if (caGrid[x, y] > 0) alive++;

        await JS.InvokeVoidAsync("MathCanvas.drawText", "playground-canvas",
            $"Gen {caGeneration} | {alive} alive | {GetCaRuleName()}", 170, 16, "#FFB070", 10, "center");
    }

    private string GetCaColor(int val)
    {
        if (caRule == 4) return val > 0 ? "#F39C12" : "rgba(0,0,0,0.04)"; // Life: binary
        var hue = (val * 37) % 360;
        return $"hsl({hue}, 75%, 50%)";
    }

    private string GetCaRuleName() => caRule switch
    {
        0 => "Modular", 1 => "Prime Spread", 2 => "Collatz", 3 => "Fibonacci",
        4 => "Game of Life", 5 => "Wave", 6 => "XOR", _ => "?"
    };

    private string GetCaRuleDescription() => caRule switch
    {
        0 => "Sum of neighbors mod 10. Kaleidoscopic patterns.",
        1 => "Spread only when sum is prime. Selective growth.",
        2 => "Collatz rule (even: n/2, odd: 3n+1) + spread.",
        3 => "Sum of neighbors mod 10, Fibonacci-like cascades.",
        4 => "Conway's Game of Life. Birth=3, Survive=2-3.",
        5 => "Wave propagation. Values ripple outward and fade.",
        6 => "XOR of all neighbors. Creates fractal-like patterns.",
        _ => ""
    };

    private async Task SetCaRule(int rule)
    {
        caRunning = false;
        caRule = rule;
        ResetCaGrid();
        await DrawExperiment();
    }

    private void ResetCaGrid()
    {
        var sz = caGridSize;
        caGrid = new int[sz, sz];
        var mid = sz / 2;
        if (caRule == 4) // Game of Life: glider + block
        {
            caGrid[mid, mid] = 1; caGrid[mid + 1, mid] = 1; caGrid[mid - 1, mid] = 1;
            caGrid[mid - 1, mid - 1] = 1; caGrid[mid, mid - 2] = 1; // glider
            caGrid[mid + 3, mid + 3] = 1; caGrid[mid + 4, mid + 3] = 1;
            caGrid[mid + 3, mid + 4] = 1; caGrid[mid + 4, mid + 4] = 1; // block
        }
        else
        {
            caGrid[mid, mid] = 1;
        }
        caGeneration = 0;
    }

    private async Task ResetCa()
    {
        caRunning = false;
        ResetCaGrid();
        await DrawExperiment();
    }

    private async Task StepCa()
    {
        var sz = caGridSize;
        var next = new int[sz, sz];
        var rng = new Random(caGeneration * 7 + caRule);

        int[] dx4 = { -1, 0, 1, 0 }; int[] dy4 = { 0, -1, 0, 1 };
        int[] dx8 = { -1, 0, 1, -1, 1, -1, 0, 1 }; int[] dy8 = { -1, -1, -1, 0, 0, 1, 1, 1 };
        var dxArr = (ca8Neighbor || caRule == 4) ? dx8 : dx4;
        var dyArr = (ca8Neighbor || caRule == 4) ? dy8 : dy4;
        var neighbors = dxArr.Length;

        for (int y = 0; y < sz; y++)
        {
            for (int x = 0; x < sz; x++)
            {
                int sum = 0; int count = 0;
                for (int d = 0; d < neighbors; d++)
                {
                    var nx = (x + dxArr[d] + sz) % sz; // wrap around
                    var ny = (y + dyArr[d] + sz) % sz;
                    sum += caGrid[nx, ny];
                    if (caGrid[nx, ny] > 0) count++;
                }

                switch (caRule)
                {
                    case 0: // Modular
                        next[x, y] = (caGrid[x, y] + sum) % 10;
                        break;
                    case 1: // Prime spread
                        var s = caGrid[x, y] + sum;
                        next[x, y] = IsPrimeSmall(s) ? s % 10 : (caGrid[x, y] > 0 ? caGrid[x, y] : 0);
                        break;
                    case 2: // Collatz
                        var v = caGrid[x, y];
                        if (v > 0) next[x, y] = v % 2 == 0 ? Math.Max(v / 2, 1) : (3 * v + 1) % 20;
                        else if (count > 0) next[x, y] = sum / Math.Max(count, 1) % 10;
                        break;
                    case 3: // Fibonacci
                        if (count >= 2) next[x, y] = sum % 10;
                        else if (caGrid[x, y] > 0) next[x, y] = caGrid[x, y];
                        else if (count == 1) next[x, y] = (sum + rng.Next(1, 4)) % 10;
                        break;
                    case 4: // Game of Life
                        var alive = count;
                        if (caGrid[x, y] > 0)
                            next[x, y] = (alive == 2 || alive == 3) ? 1 : 0;
                        else
                            next[x, y] = alive == 3 ? 1 : 0;
                        break;
                    case 5: // Wave
                        if (caGrid[x, y] > 0)
                            next[x, y] = Math.Max(caGrid[x, y] - 1, 0); // fade
                        else if (count > 0 && sum > 3)
                            next[x, y] = 9; // propagate
                        break;
                    case 6: // XOR
                        next[x, y] = sum % 2 == 1 ? ((caGrid[x, y] + 1) % 10) : 0;
                        break;
                }
                if (next[x, y] < 0) next[x, y] = 0;
            }
        }
        caGrid = next;
        caGeneration++;
        await DrawExperiment();
    }

    private async Task AutoRunCa()
    {
        caRunning = true;
        StateHasChanged();
        while (caRunning)
        {
            await StepCa();
            await Task.Delay(1000 / Math.Max(caSpeed, 1));
        }
    }

