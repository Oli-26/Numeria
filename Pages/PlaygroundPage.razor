        await JS.InvokeVoidAsync("MathCanvas.drawText", "playground-canvas", "i", cx + 6, cy - r - 8, "rgba(200,255,235,0.7)", 11, "left");
        await JS.InvokeVoidAsync("MathCanvas.drawText", "playground-canvas", "-1", cx - r - 14, cy + 4, "rgba(200,255,235,0.7)", 11, "right");
        await JS.InvokeVoidAsync("MathCanvas.drawText", "playground-canvas", "-i", cx + 6, cy + r + 14, "rgba(200,255,235,0.7)", 11, "left");

        var rad = imagAngle * Math.PI / 180;
        var trailSteps = 18;
        var trailSpan = Math.Min(imagAngle, 60) * Math.PI / 180;
        for (int i = 0; i < trailSteps; i++)
        {
            var f = (double)i / (trailSteps - 1);
            var ta = rad - trailSpan * (1 - f);
            var tx = cx + r * Math.Cos(ta);
            var ty = cy - r * Math.Sin(ta);
            var hue = ((ta * 180 / Math.PI) % 360 + 360) % 360;
            var rad6 = 1.5 + f * 4;
            var alpha = 0.08 + f * 0.5;
            await JS.InvokeVoidAsync("MathCanvas.drawCircleFill", "playground-canvas",
                tx, ty, rad6, $"hsla({hue:F0}, 75%, 65%, {alpha:F2})", null, 0);
        }

        var px = cx + r * Math.Cos(rad);
        var py = cy - r * Math.Sin(rad);
        var pHue = ((imagAngle % 360) + 360) % 360;
        await JS.InvokeVoidAsync("MathCanvas.drawGlowPath", "playground-canvas",
            new[] { new[] { cx, cy }, new[] { px, py } }, $"hsl({pHue}, 80%, 65%)", 2.0, 8, 0.3);

        var arc = new List<double[]>();
        var arcSteps = Math.Max(1, imagAngle / 3);
        for (int i = 0; i <= arcSteps; i++)
        {
            var a = rad * i / arcSteps;
            arc.Add(new[] { cx + 28 * Math.Cos(a), cy - 28 * Math.Sin(a) });
        }
        if (arc.Count > 1)
            await JS.InvokeVoidAsync("MathCanvas.drawGlowPath", "playground-canvas", arc.ToArray(), "#FFD27D", 1.5, 5, 0.3);

        await JS.InvokeVoidAsync("MathCanvas.drawGlowPoint", "playground-canvas", px, py, 5.5, $"hsl({pHue}, 85%, 70%)", $"hsla({pHue}, 90%, 70%, 0.9)", 18);

        var re = Math.Cos(rad);
        var im = Math.Sin(rad);
        var label = $"e^(i·{imagAngle}°) = {re:F2} + {im:F2}i";
        await JS.InvokeVoidAsync("MathCanvas.drawText", "playground-canvas", label, 170, 18, "#A8FFE0", 12, "center");
    }

