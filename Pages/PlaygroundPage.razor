    private static string GetExpoComparison(double val)
    {
        if (val < 10) return "About the size of a handful of marbles";
        if (val < 1000) return "Roughly a building's weight in grams";
        if (val < 1e6) return "Around a city's population";
        if (val < 1e9) return "Close to Earth's population";
        if (val < 1e12) return "National debt territory (dollars)";
        if (val < 1e15) return "More than all the sand grains on a beach";
        if (val < 1e20) return "Approaching the number of grains of sand on Earth";
        if (val < 1e25) return "More than all stars in the observable universe";
        if (val < 1e50) return "More than atoms in the Earth";
        if (val < 1e80) return "Approaching atoms in the observable universe (~10\u2078\u2070)";
        return "Beyond comprehension. The universe doesn't have enough atoms.";
    }

