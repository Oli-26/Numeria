    // --- Axiom voting ---
    private async Task DrawAxioms()
    {
        var cx = 170.0; var y = 30.0;

        await JS.InvokeVoidAsync("MathCanvas.drawText", "playground-canvas",
            "Your Mathematical Universe", cx, y, "#8E44AD", 14, "center");
        y += 30;

        // Show consequences based on active axioms
        var consequences = new List<(string text, string color, bool alive)>();

        consequences.Add(("Every vector space has a basis", axiomChoice ? "#2ECC71" : "#E74C3C", axiomChoice));
        consequences.Add(("Banach-Tarski: duplicate a sphere!", axiomChoice ? "#E74C3C" : "#2ECC71", axiomChoice));
        consequences.Add(("Non-measurable sets exist", axiomChoice ? "#F39C12" : "#2ECC71", axiomChoice));

        consequences.Add(("P or not-P is always true", axiomExcludedMiddle ? "#2ECC71" : "#E74C3C", axiomExcludedMiddle));
        consequences.Add(("Proof by contradiction works", axiomExcludedMiddle ? "#2ECC71" : "#E74C3C", axiomExcludedMiddle));
        consequences.Add(("Constructive math only", !axiomExcludedMiddle ? "#2ECC71" : "#888", !axiomExcludedMiddle));

        consequences.Add(("Natural numbers exist", axiomInfinity ? "#2ECC71" : "#E74C3C", axiomInfinity));
        consequences.Add(("Calculus works", axiomInfinity ? "#2ECC71" : "#E74C3C", axiomInfinity));
        consequences.Add(("Only finite math allowed", !axiomInfinity ? "#F39C12" : "#888", !axiomInfinity));

        foreach (var (text, color, alive) in consequences)
        {
            var icon = alive ? "+" : "-";
            var alpha = alive ? "1" : "0.4";
            await JS.InvokeVoidAsync("MathCanvas.drawText", "playground-canvas",
                $"{icon} {text}", 30, y, color, 11, "left");
            y += 20;
        }

        // Summary
        y += 10;
        var world = GetAxiomWorld();
        await JS.InvokeVoidAsync("MathCanvas.drawText", "playground-canvas",
            world, cx, y, "#8E44AD", 10, "center");
    }

    private string GetAxiomWorld()
    {
        if (axiomChoice && axiomExcludedMiddle && axiomInfinity) return "Standard ZFC: the default universe of most mathematicians";
        if (!axiomChoice && axiomExcludedMiddle && axiomInfinity) return "ZF without Choice: no Banach-Tarski, but also no guaranteed bases";
        if (axiomChoice && !axiomExcludedMiddle && axiomInfinity) return "Constructive + Choice: unusual combo. Proves everything constructively but with selection";
        if (!axiomChoice && !axiomExcludedMiddle && axiomInfinity) return "Constructive math: only proofs that construct objects. Brouwer's world";
        if (!axiomInfinity) return "Finitist math: no infinity, no calculus, no real numbers. Only what you can count";
        return "A custom mathematical universe. Explore the consequences!";
    }

    private async Task ToggleAxiom(int idx)
    {
        if (idx == 0) axiomChoice = !axiomChoice;
        else if (idx == 1) axiomExcludedMiddle = !axiomExcludedMiddle;
        else axiomInfinity = !axiomInfinity;
        await DrawExperiment();
    }

    // --- Different rules ---
    private async Task DrawRules()
    {
        var cx = 170.0; var y = 25.0;

        await JS.InvokeVoidAsync("MathCanvas.drawText", "playground-canvas",
            "Arithmetic with your rules:", cx, y, "#2C3E50", 13, "center");
        y += 28;

        // Show what equations look like under the current rules
        var examples = new List<(string eq, string result, bool valid)>();

        if (ruleCommAdd)
        {
            examples.Add(("3 + 5 = 5 + 3 = 8", "Swapping addition order is fine", true));
        }
        else
        {
            examples.Add(("3 + 5 = 8, but 5 + 3 = ???", "Order matters! Like matrix multiplication", false));
        }

        if (ruleCommMul)
        {
            examples.Add(("4 x 7 = 7 x 4 = 28", "Multiplication commutes", true));
        }
        else
        {
            examples.Add(("4 x 7 = 28, but 7 x 4 = ???", "This is how matrices and quaternions work!", false));
        }

        if (ruleZeroExists)
        {
            examples.Add(("5 + 0 = 5", "Zero is the additive identity", true));
        }
        else
        {
            examples.Add(("There is no zero!", "You can never \"have nothing.\" Weird but consistent", false));
        }

        if (ruleAssoc)
        {
            examples.Add(("(2+3)+4 = 2+(3+4) = 9", "Grouping doesn't matter", true));
        }
        else
        {
            examples.Add(("(2+3)+4 vs 2+(3+4)", "Parentheses MATTER. Like octonions!", false));
        }

        if (ruleDistrib)
        {
            examples.Add(("2(3+4) = 2x3 + 2x4 = 14", "Distribution works", true));
        }
        else
        {
            examples.Add(("2(3+4) = 14, but 2x3+2x4 = ???", "Multiplication and addition don't interact", false));
        }

        foreach (var (eq, result, valid) in examples)
        {
            await JS.InvokeVoidAsync("MathCanvas.drawText", "playground-canvas",
                eq, cx, y, valid ? "#2ECC71" : "#E74C3C", 11, "center");
            y += 16;
            await JS.InvokeVoidAsync("MathCanvas.drawText", "playground-canvas",
                result, cx, y, "#888", 9, "center");
            y += 22;
        }

        // What algebraic structure do we have?
        y += 5;
        var structure = GetAlgebraStructure();
        await JS.InvokeVoidAsync("MathCanvas.drawText", "playground-canvas",
            $"You have: {structure}", cx, y, "#2C3E50", 11, "center");
    }

    private string GetAlgebraStructure()
    {
        if (ruleCommAdd && ruleCommMul && ruleAssoc && ruleZeroExists && ruleDistrib) return "a commutative ring (normal arithmetic!)";
        if (!ruleCommMul && ruleCommAdd && ruleAssoc && ruleZeroExists && ruleDistrib) return "a non-commutative ring (like matrices or quaternions)";
        if (!ruleAssoc && ruleCommAdd && ruleCommMul && ruleZeroExists) return "a non-associative algebra (like octonions)";
        if (!ruleZeroExists) return "a semigroup (no identity element, just raw operation)";
        if (!ruleDistrib) return "two unrelated operations (addition and multiplication don't talk)";
        if (!ruleCommAdd) return "a very exotic structure (non-commutative addition is extremely rare)";
        return "a custom algebraic structure";
    }

    private async Task ToggleRule(int idx)
    {
        if (idx == 0) ruleCommAdd = !ruleCommAdd;
        else if (idx == 1) ruleCommMul = !ruleCommMul;
        else if (idx == 2) ruleAssoc = !ruleAssoc;
        else if (idx == 3) ruleZeroExists = !ruleZeroExists;
        else ruleDistrib = !ruleDistrib;
        await DrawExperiment();
    }

