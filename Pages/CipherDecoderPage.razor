@page "/cipher-decoder"
@inject NavigationManager Nav
@inject IJSRuntime JS

@{
    var p = puzzles[index];
}

<div class="page-header">
    <button class="back-btn" aria-label="Back to home" @onclick='() => Nav.NavigateTo("/")'><Icon Name="arrow-left" Size="18" /></button>
    <h1>Cipher Decoder</h1>
</div>

<div class="card cd-intro">
    <Icon Name="eye" Size="22" Stroke="var(--accent)" />
    <p>Six puzzles, from Caesar to a layered cipher. Crack each one and type the plaintext; case and spaces do not matter. The last one stacks two ciphers.</p>
</div>

<div class="card cd-puzzle">
    <div class="cd-meta">
        <span class="cd-tag">@p.Type</span>
        <span class="cd-progress">@(index + 1) / @puzzles.Count</span>
    </div>
    @if (p.Kind == CipherKind.Pigpen)
    {
        <div class="cd-cipher cd-glyphs" role="img" aria-label="Pigpen cipher glyphs" @key="index" @ref="cipherEl">
            @foreach (var g in p.Glyphs)
            {
                if (g is { } glyph) { <span class="cd-glyph">@((MarkupString)Ciphers.PigpenSvg(glyph, 30))</span> }
                else { <span class="cd-gap"></span> }
            }
        </div>
        <details class="cd-key">
            <summary>Pigpen key</summary>
            <div class="cd-key-grid">
                @for (var c = 'A'; c <= 'Z'; c++)
                {
                    <span class="cd-key-cell">@((MarkupString)Ciphers.PigpenSvg(Ciphers.PigpenFor(c), 22))<small>@c</small></span>
                }
            </div>
        </details>
    }
    else
    {
        <div class="cd-cipher" @key="index" @ref="cipherEl">@p.Ciphertext</div>
    }
    <div class="cd-hint">@((MarkupString)p.Hint)</div>

    <input class="cd-input @(feedback == "wrong" ? "cd-wrong" : "")" placeholder="Plaintext..." @ref="inputEl"
           @bind="answer" @bind:event="oninput" @onkeyup="OnKey"/>

    <div class="cd-actions">
        <button class="btn btn-primary" @onclick="Check">Submit</button>
        <button class="btn btn-outline" @onclick="ShowReveal">Reveal</button>
        @if (revealed)
        {
            <small class="cd-reveal">Answer: <strong>@p.Plaintext</strong></small>
        }
    </div>

    @if (feedback == "right")
    {
        <div class="cd-correct">
            <strong>Solved.</strong> @p.Lore
        </div>
    }
    else if (feedback == "wrong")
    {
        <div class="cd-wrong-msg">Not quite. Look again.</div>
    }
</div>

<div class="cd-nav">
    <button class="btn btn-outline" disabled="@(index == 0)" @onclick="() => Move(-1)">Prev</button>
    <button class="btn btn-outline" disabled="@(index == puzzles.Count - 1)" @onclick="() => Move(1)">Next</button>
</div>

@code {
    private int index;
    private string answer = "";
    private string? feedback;
    private bool revealed;
    private bool decoded;
    private string? pendingFx;
    private ElementReference cipherEl, inputEl;

    private void OnKey(KeyboardEventArgs e) { if (e.Key == "Enter") Check(); }

    private void Check()
    {
        var right = puzzles[index].Accepts(answer);
        feedback = right ? "right" : "wrong";
        pendingFx = !right ? "wrong" : decoded ? "again" : "decode";
        decoded |= right;
    }

    private void ShowReveal()
    {
        revealed = true;
        if (!decoded) { decoded = true; pendingFx = "decode"; }
    }

    private async Task Move(int delta)
    {
        index = Math.Clamp(index + delta, 0, puzzles.Count - 1);
        answer = ""; feedback = null; revealed = false; decoded = false;
        await JS.TryInvokeVoidAsync("CipherDecoder.cancel");
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (pendingFx is not { } fx) return;
        pendingFx = null;
        var p = puzzles[index];
        if (fx == "wrong") await JS.TryInvokeVoidAsync("CipherDecoder.wrong", inputEl);
        else if (fx == "again") await JS.TryInvokeVoidAsync("CipherDecoder.solvedAgain");
        else if (p.Kind == CipherKind.Pigpen) await JS.TryInvokeVoidAsync("CipherDecoder.flip", cipherEl, p.Plaintext);
        else
        {
            // A layered puzzle stops on its middle layer (Atbash undone, Caesar still on) before the plaintext.
            var layers = p.Kind == CipherKind.Layered
                ? new[] { p.Ciphertext, Ciphers.Atbash(p.Ciphertext), p.Plaintext }
                : new[] { p.Ciphertext, p.Plaintext };
            await JS.TryInvokeVoidAsync("CipherDecoder.decode", cipherEl, layers);
        }
    }

    private static readonly IReadOnlyList<CipherPuzzle> puzzles = CipherPuzzles.All;
}

<style>
    .cd-intro { display: flex; align-items: flex-start; gap: 12px; padding: 14px; }
    .cd-intro p { margin: 0; font-size: 0.9rem; color: var(--text-secondary); line-height: 1.5; }

    .cd-puzzle { padding: 16px; }
    .cd-meta { display: flex; justify-content: space-between; align-items: center; margin-bottom: 10px; }
    .cd-tag { padding: 3px 10px; background: color-mix(in srgb, var(--primary) 10%, transparent); color: var(--primary); border-radius: 10px; font-size: 0.75rem; font-weight: 700; }
    .cd-progress { font-size: 0.75rem; color: var(--text-muted); }

    .cd-cipher { font-family: 'Roboto Mono', monospace; font-size: 1.2rem; letter-spacing: 0.1em; padding: 14px; background: var(--bg-surface); border: 1px dashed var(--border); border-radius: var(--radius-sm); text-align: center; color: var(--text-primary); margin-bottom: 10px; }
    .cd-hint { font-size: 0.82rem; color: var(--text-secondary); line-height: 1.55; margin-bottom: 12px; }

    .cd-input { width: 100%; padding: 10px 12px; background: var(--bg-surface); border: 1px solid var(--border); border-radius: var(--radius-sm); font-family: 'Roboto Mono', monospace; font-size: 0.95rem; color: var(--text-primary); margin-bottom: 8px; text-transform: uppercase; }
    .cd-input.cd-wrong { border-color: var(--error); }
    .cd-input.cd-flash { animation: cd-flash 0.6s ease-out; }
    @@keyframes cd-flash { 0%, 30% { border-color: var(--error); box-shadow: 0 0 0 3px color-mix(in srgb, var(--error) 30%, transparent); } 100% { box-shadow: 0 0 0 3px transparent; } }

    .cd-w { white-space: nowrap; }
    .cd-l { display: inline-block; min-width: 1ch; }
    .cd-l.cd-mid { color: var(--text-secondary); }
    .cd-l.cd-plain { color: var(--accent); font-weight: 700; }
    .cd-rolled .cd-glyph { width: 30px; height: 30px; line-height: 30px; justify-content: center; align-items: center; }

    .cd-actions { display: flex; gap: 6px; align-items: center; flex-wrap: wrap; }
    .cd-reveal { color: var(--text-muted); font-size: 0.78rem; margin-left: 4px; }
    .cd-reveal strong { color: var(--accent); font-family: 'Roboto Mono', monospace; }

    .cd-correct { margin-top: 10px; padding: 10px 12px; background: color-mix(in srgb, var(--success) 10%, transparent); border-radius: var(--radius-sm); font-size: 0.85rem; color: var(--text-secondary); line-height: 1.5; }
    .cd-correct strong { color: var(--success); }
    .cd-wrong-msg { margin-top: 10px; padding: 8px 12px; background: color-mix(in srgb, var(--error) 8%, transparent); border-radius: var(--radius-sm); font-size: 0.8rem; color: var(--error); }

    .cd-glyphs { display: flex; flex-wrap: wrap; justify-content: center; gap: 4px; letter-spacing: 0; }
    .cd-glyph { display: inline-flex; line-height: 0; }
    .cd-gap { width: 16px; }
    .cd-key { margin-bottom: 12px; font-size: 0.8rem; color: var(--text-secondary); }
    .cd-key summary { cursor: pointer; font-weight: 600; }
    .cd-key-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(44px, 1fr)); gap: 6px; margin-top: 8px; }
    .cd-key-cell { display: flex; flex-direction: column; align-items: center; color: var(--text-primary); }
    .cd-key-cell small { font-family: 'Roboto Mono', monospace; color: var(--text-muted); }

    .cd-nav { display: flex; gap: 8px; margin-top: 10px; }
    .cd-nav button { flex: 1; }
</style>
