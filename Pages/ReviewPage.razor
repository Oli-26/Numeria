@page "/review"
@inject IReviewService ReviewService
@inject IContentRepository Content
@inject IProgressService Progress
@inject IGamificationService Gamification
@inject IJSRuntime JS
@inject NavigationManager Nav

<div class="page-header">
    <button class="back-btn" aria-label="Back to home" @onclick='() => Nav.NavigateTo("/")'><Icon Name="arrow-left" Size="18" /></button>
    <h1>Review</h1>
</div>

@if (state == ReviewState.Loading)
{
    <div class="skeleton-list">
        <div class="skeleton skeleton-card" style="height: 140px; margin-bottom: 12px;"></div>
        <div class="skeleton skeleton-card" style="height: 56px; margin-bottom: 8px;"></div>
        <div class="skeleton skeleton-card" style="height: 56px;"></div>
    </div>
}
else if (state == ReviewState.Empty)
{
    <div class="empty-state card">
        <div class="empty-icon"><Icon Name="checkmark-circle" Size="40" /></div>
        <h2>All caught up!</h2>
        <p>No cards due for review. Keep learning and questions will appear here based on how well you remember them.</p>
        <button class="btn btn-primary" @onclick='() => Nav.NavigateTo("/")'>Back to Home</button>
    </div>
}
else if (state == ReviewState.Active)
{
    <div class="review-container">
        <div class="review-header">
            <span class="review-count">@(currentIndex + 1) / @dueCards.Count</span>
            <span class="chip">Spaced Repetition</span>
        </div>

        @if (currentQuestion != null)
        {
            <div class="card review-card question-enter" @key="currentIndex">
                <p class="question-prompt">@currentQuestion.Prompt</p>

                @if (currentQuestion.MathExpression != null)
                {
                    <div class="math-display" id="review-math"></div>
                }

                @if (currentQuestion.Type == QuestionType.FindTheError && currentQuestion.Steps != null)
                {
                    <div class="review-steps">
                        @for (int i = 0; i < currentQuestion.Steps.Count; i++)
                        {
                            var stepNum = i + 1;
                            var isError = revealed && currentQuestion.CorrectAnswer == stepNum.ToString();
                            <div class="review-step @(isError ? "error-found" : "")">
                                <span class="rstep-num">@stepNum</span>
                                <span>@currentQuestion.Steps[i]</span>
                            </div>
                        }
                    </div>
                }
                else if (currentQuestion.Type == QuestionType.ProofOrdering && currentQuestion.Steps != null)
                {
                    <div class="review-steps">
                        @for (int i = 0; i < currentQuestion.Steps.Count; i++)
                        {
                            <div class="review-step">
                                <span class="rstep-num">@(i + 1)</span>
                                <span>@(revealed ? currentQuestion.Steps[i] : "???")</span>
                            </div>
                        }
                    </div>
                }
                else if (currentQuestion.Type == QuestionType.ConceptMatch && currentQuestion.Pairs != null)
                {
                    <div class="review-pairs">
                        @foreach (var pair in currentQuestion.Pairs)
                        {
                            <div class="review-pair">
                                <span class="pair-left">@pair.Left</span>
                                <span class="pair-arrow">↔</span>
                                <span class="pair-right @(revealed ? "revealed" : "hidden")">@(revealed ? pair.Right : "???")</span>
                            </div>
                        }
                    </div>
                }
                else if ((currentQuestion.Type == QuestionType.MultipleChoice || currentQuestion.Type == QuestionType.VisualIdentify) && currentQuestion.Options != null)
                {
                    <div class="review-options">
                        @foreach (var opt in currentQuestion.Options)
                        {
                            var isCorrect = revealed && opt == currentQuestion.CorrectAnswer;
                            <div class="review-option @(isCorrect ? "correct" : "")">@opt</div>
                        }
                    </div>
                }

                @if (!revealed)
                {
                    <button class="btn btn-primary" style="width: 100%; margin-top: 16px" @onclick="Reveal">
                        Show Answer
                    </button>
                }
                else
                {
                    @if (HasScalarAnswer(currentQuestion))
                    {
                        <div class="review-answer">
                            <strong>@currentQuestion.CorrectAnswer</strong>
                            @if (currentQuestion.Explanation != null)
                            {
                                <p>@currentQuestion.Explanation</p>
                            }
                        </div>
                    }
                    else if (currentQuestion.Explanation != null)
                    {
                        <div class="review-answer">
                            <p style="margin: 0">@currentQuestion.Explanation</p>
                        </div>
                    }

                    <p class="review-rate-prompt">How well did you remember?</p>
                    <div class="review-buttons">
                        <button class="btn review-btn forgot" @onclick="() => Rate(false)">
                            Forgot
                            <small>Review soon</small>
                        </button>
                        <button class="btn review-btn remembered" @onclick="() => Rate(true)">
                            Remembered
                            <small>Review later</small>
                        </button>
                    </div>
                }
            </div>
        }
    </div>
}
else if (state == ReviewState.Complete)
{
    <div class="card review-complete count-up">
        <div class="complete-icon"><Icon Name="star-filled" Size="32" Fill="currentColor" /></div>
        <h2>Review Complete!</h2>
        <div class="review-stats-row stagger-in">
            <div class="review-stat">
                <span class="review-stat-val correct-color">@rememberedCount</span>
                <small>Remembered</small>
            </div>
            <div class="review-stat">
                <span class="review-stat-val error-color">@forgotCount</span>
                <small>Forgot</small>
            </div>
            <div class="review-stat">
                <span class="review-stat-val">+@xpEarned</span>
                <small>XP</small>
            </div>
        </div>
        <button class="btn btn-primary btn-lg" style="width: 100%; margin-top: 16px" @onclick='() => Nav.NavigateTo("/")'>
            Done
        </button>
    </div>
}

@code {
    private enum ReviewState { Loading, Empty, Active, Complete }
    private ReviewState state = ReviewState.Loading;

    private List<ReviewCard> dueCards = new();
    private int currentIndex;
    private Question? currentQuestion;
    private bool revealed;
    private int rememberedCount;
    private int forgotCount;
    private int xpEarned;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            dueCards = await ReviewService.GetDueCardsAsync(15);
            if (dueCards.Count == 0)
            {
                state = ReviewState.Empty;
            }
            else
            {
                state = ReviewState.Active;
                await LoadCurrentQuestion();
            }
            StateHasChanged();
        }

        if (state == ReviewState.Active && currentQuestion?.MathExpression != null)
        {
            await JS.InvokeVoidAsync("renderMath", "review-math", currentQuestion.MathExpression, true);
        }
    }

    private async Task LoadCurrentQuestion()
    {
        if (currentIndex >= dueCards.Count) return;
        var card = dueCards[currentIndex];
        var questions = await Content.GetQuestionsAsync(card.TopicId);
        currentQuestion = null;
        if (card.ConceptId != null)
        {
            // Concept cards test the idea, not a memorised question: prefer a sibling question.
            var siblings = questions.Where(q => q.ConceptId == card.ConceptId).ToList();
            var fresh = siblings.Where(q => q.Id != card.QuestionId).ToList();
            currentQuestion = fresh.Count > 0 ? fresh[Random.Shared.Next(fresh.Count)] : siblings.FirstOrDefault();
        }
        currentQuestion ??= questions.FirstOrDefault(q => q.Id == card.QuestionId);
        revealed = false;

        // Skip missing questions
        if (currentQuestion == null)
        {
            currentIndex++;
            if (currentIndex < dueCards.Count)
                await LoadCurrentQuestion();
            else
                state = ReviewState.Complete;
        }
    }

    private async Task Reveal()
    {
        revealed = true;
        await JS.TryInvokeVoidAsync("Sounds.playReveal");
        await JS.TryInvokeVoidAsync("Haptics.light");
    }

    private static bool HasScalarAnswer(Question q) =>
        q.Type != QuestionType.FindTheError
        && q.Type != QuestionType.ConceptMatch
        && q.Type != QuestionType.ProofOrdering
        && !string.IsNullOrEmpty(q.CorrectAnswer);

    private async Task Rate(bool remembered)
    {
        var card = dueCards[currentIndex];
        if (currentQuestion != null) card.QuestionId = currentQuestion.Id;
        await ReviewService.UpdateCardAsync(card.QuestionId, remembered, card.ConceptId);

        if (remembered)
        {
            rememberedCount++;
            var earned = 10;
            xpEarned += earned;
            await Gamification.AwardXpAsync(earned);
            await JS.TryInvokeVoidAsync("Sounds.playCorrect");
            await JS.TryInvokeVoidAsync("Haptics.success");
        }
        else
        {
            forgotCount++;
            await JS.TryInvokeVoidAsync("Sounds.playWrong");
            await JS.TryInvokeVoidAsync("Haptics.warning");
        }

        currentIndex++;
        if (currentIndex >= dueCards.Count)
        {
            state = ReviewState.Complete;
            await JS.TryInvokeVoidAsync("Sounds.playComplete");
            await JS.TryInvokeVoidAsync("Haptics.medium");
        }
        else
        {
            await LoadCurrentQuestion();
        }
    }
}

<style>
    .review-container { max-width: 600px; margin: 0 auto; }
    .review-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 12px; }
    .review-count { color: var(--text-muted); font-size: 0.9rem; }

    .review-card { padding: 24px; }
    .question-prompt { font-size: 1.1rem; font-weight: 600; line-height: 1.5; margin-bottom: 8px; }

    .review-answer {
        margin-top: 16px; padding: 14px; background: var(--bg-surface);
        border-radius: var(--radius-sm); border-color: var(--primary);
        animation: revealSlide 0.25s ease;
    }

    @@keyframes revealSlide {
        from { opacity: 0; transform: translateY(12px); max-height: 0; }
        to { opacity: 1; transform: translateY(0); max-height: 200px; }
    }
    .review-answer strong { font-size: 1.1rem; color: var(--primary); }
    .review-answer p { margin: 8px 0 0; color: var(--text-secondary); font-size: 0.9rem; line-height: 1.5; }

    .review-rate-prompt { text-align: center; color: var(--text-muted); font-size: 0.85rem; margin: 16px 0 8px; }

    .review-buttons { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; }
    .review-btn {
        display: flex; flex-direction: column; align-items: center; gap: 2px;
        padding: 14px; border-radius: var(--radius-sm); font-weight: 600;
        border: none; cursor: pointer; transition: all 0.15s ease;
        -webkit-tap-highlight-color: transparent;
        min-height: 56px;
    }
    .review-btn:active { transform: scale(0.97); }
    .review-btn small { font-weight: 400; font-size: 0.75rem; opacity: 0.8; }
    .review-btn.forgot { background: rgba(239, 83, 80, 0.12); color: var(--error); }
    .review-btn.remembered { background: rgba(76, 175, 80, 0.12); color: var(--success); }

    .empty-state { text-align: center; padding: 40px 24px; }
    .empty-icon { color: var(--success); margin-bottom: 12px; }
    .empty-state h2 { margin-bottom: 8px; }
    .empty-state p { color: var(--text-secondary); margin: 8px 0 20px; line-height: 1.6; max-width: 320px; display: block; margin-left: auto; margin-right: auto; }

    .review-complete { text-align: center; padding: 32px 24px; }
    .complete-icon { font-size: 3rem; margin-bottom: 8px; }
    .review-stats-row { display: flex; justify-content: center; gap: 24px; margin: 16px 0; }
    .review-stat { display: flex; flex-direction: column; align-items: center; }
    .review-stat-val { font-size: 1.5rem; font-weight: 700; }
    .correct-color { color: var(--success); }
    .error-color { color: var(--error); }
    .review-stat small { color: var(--text-muted); font-size: 0.8rem; }

    .review-steps { display: flex; flex-direction: column; gap: 6px; margin-top: 12px; }
    .review-step {
        display: flex; align-items: flex-start; gap: 10px; padding: 10px 12px;
        background: var(--bg-card); border: 2px solid var(--border);
        border-radius: var(--radius-sm); font-size: 0.9rem; color: var(--text-primary);
    }
    .review-step.error-found { border-color: var(--error); background: rgba(239, 83, 80, 0.12); }
    .rstep-num {
        width: 24px; height: 24px; border-radius: 50%; background: var(--bg-surface);
        color: var(--text-muted); display: flex; align-items: center; justify-content: center;
        font-size: 0.8rem; font-weight: 700; flex-shrink: 0;
    }
    .review-step.error-found .rstep-num { background: var(--error); color: white; }

    .review-pairs { display: flex; flex-direction: column; gap: 6px; margin-top: 12px; }
    .review-pair {
        display: grid; grid-template-columns: 1fr auto 1fr; align-items: center; gap: 8px;
        padding: 8px 10px; background: var(--bg-card); border: 2px solid var(--border);
        border-radius: var(--radius-sm); font-size: 0.9rem;
    }
    .pair-left, .pair-right { padding: 6px 8px; text-align: center; }
    .pair-arrow { color: var(--text-muted); }
    .pair-right.hidden { color: var(--text-muted); font-style: italic; }
    .pair-right.revealed { color: var(--primary); font-weight: 600; }

    .review-options { display: flex; flex-direction: column; gap: 6px; margin-top: 12px; }
    .review-option {
        padding: 10px 12px; background: var(--bg-card); border: 2px solid var(--border);
        border-radius: var(--radius-sm); font-size: 0.9rem; color: var(--text-primary);
    }
    .review-option.correct { border-color: var(--success); background: rgba(76, 175, 80, 0.12); color: var(--success); font-weight: 600; }
</style>
