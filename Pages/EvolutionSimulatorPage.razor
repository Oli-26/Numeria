@page "/evolution-sim"
@using System.Globalization
@inject NavigationManager Nav
@implements IDisposable

<div class="page-header">
    <button class="back-btn" aria-label="Back to home" @onclick='() => Nav.NavigateTo("/")'><Icon Name="arrow-left" Size="18" /></button>
    <h1>Evolution Simulator</h1>
</div>

<p class="evo-intro">Each generation, selection decides who survives, chance decides which survivors leave the most offspring, and mutation adds small random changes. Pick a preset or set the pressures yourself.</p>

<div class="evo-presets">
    @foreach (var p in Presets)
    {
        var preset = p;
        <button class="preset-btn @(presetKey == preset.Key ? "on" : "")" aria-pressed="@Pressed(presetKey == preset.Key)" @onclick="() => ApplyPreset(preset.Key)">
            <Icon Name="@preset.Icon" Size="16" />
            <span>@preset.Label</span>
        </button>
    }
</div>

@if (CurrentPreset is { } cp)
{
    <div class="card evo-note">
        <div class="evo-note-title">@cp.Title</div>
        <p>@cp.Note</p>
    </div>
}

<div class="card evo-card">
    <div class="evo-meta">
        <div class="evo-meta-row">
            <span class="meta-label">Gen</span>
            <strong>@model.Generation</strong>
        </div>
        <div class="evo-meta-row">
            <span class="meta-label">Survived</span>
            <strong>@(model.LastSurvivors?.ToString() ?? "-")/@(model.LastSurvivors is null ? model.Population.Count : model.LastCount)</strong>
        </div>
        @for (int t = 0; t < EvolutionModel.TraitCount; t++)
        {
            var trait = (EvoTrait)t;
            <div class="evo-meta-row">
                <span class="meta-label">@TraitNames[t]</span>
                <strong>@(model.Extinct ? "-" : model.Mean(trait).ToString("F2"))</strong>
            </div>
        }
    </div>

    <div class="evo-canvas-wrap">
        <svg viewBox="0 0 300 300" class="evo-canvas" xmlns="http://www.w3.org/2000/svg" role="img"
             aria-label="@($"{model.Population.Count} individuals on bark of lightness {model.Background:F2}")">
            <rect x="0" y="0" width="300" height="300" fill="@BarkColor(model.Background)" />
            @foreach (var c in model.Casualties)
            {
                <circle cx="@F(c.X)" cy="@F(c.Y)" r="@F(Radius(c))" fill="none"
                        stroke="var(--error)" stroke-width="1" opacity="0.55" />
            }
            @foreach (var c in model.Population)
            {
                <circle cx="@F(c.X)" cy="@F(c.Y)" r="@F(Radius(c))" fill="@BodyColor(c[EvoTrait.Lightness])"
                        stroke="rgba(128,128,128,0.45)" stroke-width="0.6" />
            }
            @if (model.Extinct)
            {
                <g><text x="150" y="150" text-anchor="middle" fill="var(--error)" font-size="16" font-weight="700">Extinct</text></g>
            }
        </svg>
    </div>
    <p class="field-legend">Dots are the living generation, shaded by lightness and sized by size. Red rings mark those that died in the last round of selection; offspring appear near their parent.</p>

    <div class="bark-row">
        <label>
            <span>Bark lightness: <strong>@model.Background.ToString("F2")</strong></span>
            <input type="range" min="0" max="1" step="0.05" @bind="model.Background" @bind:event="oninput" />
            <div class="bark-bar"></div>
        </label>
        <div class="bark-quick">
            <button class="btn btn-outline btn-sm" @onclick="() => model.Background = 0.15">Sooty bark</button>
            <button class="btn btn-outline btn-sm" @onclick="() => model.Background = 0.85">Clean bark</button>
        </div>
    </div>
</div>

<div class="evo-buttons">
    <button class="btn btn-primary" @onclick="StepOnce" disabled="@(running || !CanStep)">
        <Icon Name="skip-forward" Size="16" /> <span>Step</span>
    </button>
    <button class="btn btn-accent" @onclick="ToggleRun" disabled="@(!running && !CanStep)">
        @if (running)
        {
            <svg width="16" height="16" viewBox="0 0 16 16" aria-hidden="true"><rect x="3" y="2" width="3.5" height="12" rx="1" fill="currentColor" /><rect x="9.5" y="2" width="3.5" height="12" rx="1" fill="currentColor" /></svg>
            <span>Pause</span>
        }
        else
        {
            <Icon Name="play" Size="16" /> <span>Run</span>
        }
    </button>
    <button class="btn btn-outline" @onclick="NewReplicate">
        <Icon Name="stack" Size="16" /> <span>New replicate</span>
    </button>
    <button class="btn btn-outline" @onclick="ResetAll">
        <Icon Name="rotate" Size="16" /> <span>Reset</span>
    </button>
</div>

@if (lastEvent != null)
{
    <div class="evo-event">@lastEvent</div>
}

<div class="card evo-card">
    <div class="chart-head">
        <span class="histo-title">Mean @TraitNames[(int)chartTrait].ToLowerInvariant() by generation</span>
        <div class="seg" role="group" aria-label="Trait to chart">
            @for (int t = 0; t < EvolutionModel.TraitCount; t++)
            {
                var trait = (EvoTrait)t;
                <button class="@(chartTrait == trait ? "on" : "")" aria-pressed="@Pressed(chartTrait == trait)" @onclick="() => chartTrait = trait">@TraitNames[t]</button>
            }
        </div>
    </div>
    @{
        int ct = (int)chartTrait;
        int maxGen = ChartMaxGen;
        string targetPath = TargetPath(model.History, ct, maxGen);
    }
    <svg viewBox="0 0 320 134" class="evo-chart" xmlns="http://www.w3.org/2000/svg" role="img"
         aria-label="@ChartLabel">
        @foreach (var v in new[] { 0.0, 0.5, 1.0 })
        {
            <g>
                <line x1="@F(CL)" x2="@F(CR)" y1="@F(Cy(v))" y2="@F(Cy(v))" stroke="var(--border)" stroke-width="0.6" />
                <text x="@F(CL - 4)" y="@F(Cy(v) + 3)" text-anchor="end" font-size="8" fill="var(--text-muted)">@v.ToString("0.#", CultureInfo.InvariantCulture)</text>
            </g>
        }
        @foreach (var g in new[] { 0, maxGen / 2, maxGen })
        {
            <g><text x="@F(Cx(g, maxGen))" y="128" text-anchor="middle" font-size="8" fill="var(--text-muted)">@g</text></g>
        }
        @foreach (var run in pastRuns)
        {
            <polyline points="@Points(run, ct, maxGen)" fill="none" stroke="var(--text-muted)" stroke-width="1.5"
                      stroke-linejoin="round" opacity="0.5"><title>Earlier replicate</title></polyline>
        }
        @if (targetPath.Length > 0)
        {
            <path d="@targetPath" fill="none" stroke="var(--accent)" stroke-width="1.5" stroke-dasharray="4 3"><title>Target</title></path>
        }
        <polyline points="@Points(model.History, ct, maxGen)" fill="none" stroke="var(--primary)" stroke-width="2"
                  stroke-linejoin="round" stroke-linecap="round"><title>This run</title></polyline>
    </svg>
    <div class="chart-legend">
        <span><svg width="18" height="6" aria-hidden="true"><line x1="0" y1="3" x2="18" y2="3" stroke="var(--primary)" stroke-width="2" /></svg>This run</span>
        @if (pastRuns.Count > 0)
        {
            <span><svg width="18" height="6" aria-hidden="true"><line x1="0" y1="3" x2="18" y2="3" stroke="var(--text-muted)" stroke-width="1.5" opacity="0.6" /></svg>Earlier replicates (@pastRuns.Count)</span>
        }
        @if (targetPath.Length > 0)
        {
            <span><svg width="18" height="6" aria-hidden="true"><line x1="0" y1="3" x2="18" y2="3" stroke="var(--accent)" stroke-width="1.5" stroke-dasharray="4 3" /></svg>Target</span>
        }
        <span class="chart-scale">0 = @Low[ct], 1 = @High[ct]</span>
    </div>

    <div class="histo-wrap">
        @for (int t = 0; t < EvolutionModel.TraitCount; t++)
        {
            var trait = (EvoTrait)t;
            var bins = Bins(trait);
            var binMax = Math.Max(1, bins.Max());
            <div class="histo-block">
                <div class="histo-title">@TraitNames[t]</div>
                <svg viewBox="0 0 100 56" class="histo-svg" xmlns="http://www.w3.org/2000/svg" role="img"
                     aria-label="@($"{TraitNames[t]} distribution")">
                    @for (int i = 0; i < Bins10; i++)
                    {
                        var h = bins[i] * 40.0 / binMax;
                        <rect x="@F(i * 10 + 0.5)" y="@F(44 - h)" width="9" height="@F(h)" rx="1"
                              fill="@BarFill(trait, i)" stroke="var(--border)" stroke-width="@(trait == EvoTrait.Lightness ? "0.5" : "0")" />
                    }
                    <line x1="0" y1="44" x2="100" y2="44" stroke="var(--border)" stroke-width="1" />
                    @if (model.IsSelected(trait))
                    {
                        var tx = model.TargetOf(trait) * 100;
                        <line x1="@F(tx)" x2="@F(tx)" y1="2" y2="44" stroke="var(--accent)" stroke-width="1" stroke-dasharray="2 2" />
                    }
                    <text x="0" y="54" font-size="8" fill="var(--text-muted)">@Low[t]</text>
                    <text x="100" y="54" font-size="8" text-anchor="end" fill="var(--text-muted)">@High[t]</text>
                </svg>
            </div>
        }
    </div>
</div>

<div class="card evo-controls">
    <h3 class="ctrl-title"><Icon Name="target" Size="16" /> Selection pressures</h3>

    @for (int t = 0; t < EvolutionModel.TraitCount; t++)
    {
        var trait = (EvoTrait)t;
        var sel = model.Selection[t];
        <div class="trait-block">
            <div class="trait-head">
                <span class="trait-name">@TraitNames[t]</span>
                <div class="seg" role="group" aria-label="@($"{TraitNames[t]} selection")">
                    <button class="@(sel.Selected ? "" : "on")" aria-pressed="@Pressed(!sel.Selected)" @onclick="() => sel.Selected = false">Neutral</button>
                    <button class="@(sel.Selected ? "on" : "")" aria-pressed="@Pressed(sel.Selected)" @onclick="() => sel.Selected = true">Selected</button>
                </div>
            </div>
            <p class="trait-hint">@TraitHints[t]</p>
            @if (sel.Selected)
            {
                if (trait == EvoTrait.Lightness)
                {
                    <p class="trait-hint">Target: match the bark (@model.Background.ToString("F2")).</p>
                }
                else
                {
                    <div class="ctrl-row">
                        <label>
                            <span>Favoured @TraitNames[t].ToLowerInvariant(): <strong>@sel.Target.ToString("F2")</strong></span>
                            <input type="range" min="0" max="1" step="0.05" @bind="sel.Target" @bind:event="oninput" />
                        </label>
                    </div>
                }
                <div class="ctrl-row">
                    <label>
                        <span>Strength s: <strong>@sel.Strength.ToString("F2")</strong></span>
                        <input type="range" min="0" max="@F(EvolutionModel.MaxStrength)" step="0.05" @bind="sel.Strength" @bind:event="oninput" />
                    </label>
                </div>
            }
        </div>
    }
</div>

<div class="card evo-controls">
    <h3 class="ctrl-title"><Icon Name="dice" Size="16" /> Population and mutation</h3>
    <div class="ctrl-row">
        <label>
            <span>Population size N: <strong>@model.PopulationSize</strong></span>
            <input type="range" min="@EvolutionModel.MinPopulation" max="@EvolutionModel.MaxPopulation" step="10" @bind="PopN" @bind:event="oninput" />
        </label>
        <p class="trait-hint">Mid-run changes apply from the next generation.</p>
    </div>
    <div class="ctrl-row">
        <label>
            <span>Mutation size: <strong>@model.MutationSd.ToString("F3")</strong></span>
            <input type="range" min="0" max="0.1" step="0.005" @bind="model.MutationSd" @bind:event="oninput" />
        </label>
        <p class="trait-hint">Typical random change per offspring, per trait, as likely up as down.</p>
    </div>
</div>

<div class="card evo-controls evo-how">
    <h3 class="ctrl-title"><Icon Name="help" Size="16" /> How the model works</h3>
    <ol>
        <li><strong>Selection.</strong> Each individual survives with probability @EvolutionModel.BaseSurvival.ToString("0.##", CultureInfo.InvariantCulture) × (1 − s × mismatch) for every selected trait, where mismatch is its distance from the target (0 to 1). Neutral traits never affect survival, and nor does a selected trait with s = 0.</li>
        <li><strong>Reproduction.</strong> N offspring are made, each copying one survivor picked at random, with replacement. Some survivors leave several offspring and some leave none: that luck is genetic drift, and it is strongest when N is small.</li>
        <li><strong>Mutation.</strong> Each offspring's traits shift by a small random amount, as likely up as down. Mutation supplies variation without a direction; selection supplies the direction.</li>
    </ol>
    <p class="trait-hint">Simplified: every trait is fully inherited, each offspring has one parent, and traits do not trade off against each other.</p>
</div>

@code {
    private sealed record Preset(string Key, string Label, string Icon, string Title, string Note);

    private static readonly Preset[] Presets =
    {
        new("moth", "Peppered moth", "moon", "Peppered moth (Biston betularia)",
            "In industrial Britain, air pollution killed the pale lichens on trees and soot blackened the bark. Birds hunting by sight found pale moths more easily on dark trunks, and the black carbonaria form rose from rare to common near cities during the 1800s. Run it and watch mean lightness fall. Then tap Clean bark, as happened after clean-air laws cut smoke from the 1950s, and watch the pale form return. Kettlewell's release-recapture experiments in the 1950s pointed to bird predation, and Michael Majerus's large field study in the 2000s confirmed it. In the real moth a single gene switches between pale and black forms; here lightness varies smoothly."),
        new("finch", "Finch beaks", "leaf", "Medium ground finch on Daphne Major (Geospiza fortis)",
            "In the 1977 drought on this Galápagos island, plants set few seeds. The small, soft seeds were eaten first, leaving mostly large, hard ones such as caltrop (Tribulus) that only birds with big, deep beaks could crack. Most of the finches died, and the survivors had larger beaks on average. Beak size is strongly inherited, so the next generation's beaks were measurably deeper, as Peter and Rosemary Grant's team recorded. Here size stands for beak depth. Step once to see one round of selection; keep going and the drought never ends, unlike on the real island. Years later, after very wet seasons left plenty of small seeds, selection swung back toward smaller beaks: drag Favoured size down to try it."),
        new("drift", "Genetic drift", "dice", "Genetic drift",
            "Every trait is neutral, so who survives is pure luck, and the population is small (N = 20). Each offspring copies a random survivor, so some lineages leave many young and others none, and the trait means wander with no direction. Press Run, then New replicate a few times: identical settings, different random histories, and the lines spread apart. Watch the histograms too: variation drains away as lineages die out, and only mutation slowly restores it. Raise N to 300 and each generation's random change is far smaller, so the lines spread more slowly."),
        new("escape", "Predator escape", "zap", "Predator escape",
            "Predators catch slow prey more often than fast ones, so faster individuals are more likely to survive and breed, and because speed is inherited the mean climbs generation after generation. Selection can only act on variation that exists: set Mutation size to 0 and the climb stalls once variation runs out. Real prey also pay for speed, in energy and other costs, which this model leaves out, so here speed rises until mutation and the top of the range hold it back."),
    };

    private static readonly string[] TraitNames = { "Lightness", "Size", "Speed" };
    private static readonly string[] Low = { "dark", "small", "slow" };
    private static readonly string[] High = { "pale", "large", "fast" };
    private static readonly string[] TraitHints =
    {
        "Birds hunting by sight catch individuals that contrast with the bark.",
        "Food sets the best size: hard seeds favour big, deep beaks.",
        "Predators catch the slowest prey first.",
    };

    private const int MaxGenerations = 200;
    private const int MaxReplicates = 6;
    private const int Bins10 = 10;
    private const double CL = 26, CR = 314, CT = 6, CB = 116;

    private readonly EvolutionModel model = new();
    private readonly List<List<GenStats>> pastRuns = new();
    private EvoTrait chartTrait = EvoTrait.Lightness;
    private string? presetKey;
    private string? lastEvent;
    private bool running;
    private int runToken;

    private Preset? CurrentPreset => Presets.FirstOrDefault(p => p.Key == presetKey);
    private bool CanStep => !model.Extinct && model.Generation < MaxGenerations;

    private int PopN
    {
        get => model.PopulationSize;
        set
        {
            model.PopulationSize = value;
            if (model.Generation == 0) model.Reset(model.Seed);
        }
    }

    protected override void OnInitialized() => ApplyPreset("moth");

    public void Dispose()
    {
        running = false;
        runToken++;
    }

    private static int NewSeed() => Random.Shared.Next();

    private void ApplyPreset(string key)
    {
        StopRunning();
        foreach (var sel in model.Selection)
        {
            sel.Selected = false;
            sel.Target = 1.0;
            sel.Strength = 0.6;
        }
        Array.Fill(model.StartMean, 0.5);
        model.StartSd = 0.15;
        model.PopulationSize = 150;
        model.MutationSd = 0.02;
        model.Background = 0.5;

        switch (key)
        {
            case "moth":
                model.Background = 0.15;
                model.MutationSd = 0.03;
                model.StartMean[(int)EvoTrait.Lightness] = 0.8;
                Select(EvoTrait.Lightness, 0, 0.7);
                chartTrait = EvoTrait.Lightness;
                break;
            case "finch":
                model.StartMean[(int)EvoTrait.Size] = 0.4;
                Select(EvoTrait.Size, 1.0, 0.6);
                chartTrait = EvoTrait.Size;
                break;
            case "drift":
                model.PopulationSize = 20;
                model.MutationSd = 0.01;
                model.StartSd = 0.2;
                chartTrait = EvoTrait.Lightness;
                break;
            case "escape":
                model.StartMean[(int)EvoTrait.Speed] = 0.35;
                Select(EvoTrait.Speed, 1.0, 0.6);
                chartTrait = EvoTrait.Speed;
                break;
        }

        presetKey = key;
        pastRuns.Clear();
        model.Reset(NewSeed());
        lastEvent = null;
    }

    private void Select(EvoTrait t, double target, double strength)
    {
        var sel = model.Selection[(int)t];
        sel.Selected = true;
        sel.Target = target;
        sel.Strength = strength;
    }

    private void StepOnce()
    {
        if (!CanStep) return;
        model.Step();
        if (model.Extinct)
        {
            lastEvent = $"Generation {model.Generation}: none of {model.LastCount} survived, so the population is extinct. Selection was harsher than a population this size could absorb. Press Reset.";
            return;
        }
        lastEvent = $"Generation {model.Generation}: {model.LastSurvivors} of {model.LastCount} survived and left {model.Population.Count} offspring.";
        if (model.Generation >= MaxGenerations)
            lastEvent += $" That is the {MaxGenerations}-generation limit: press New replicate or Reset.";
    }

    private async Task ToggleRun()
    {
        if (running)
        {
            StopRunning();
            return;
        }
        var token = ++runToken;
        running = true;
        while (running && token == runToken && CanStep)
        {
            StepOnce();
            StateHasChanged();
            await Task.Delay(140);
        }
        if (token == runToken) running = false;
    }

    private void StopRunning()
    {
        running = false;
        runToken++;
    }

    private void NewReplicate()
    {
        if (model.History.Count > 1)
        {
            pastRuns.Add(model.History);
            if (pastRuns.Count > MaxReplicates) pastRuns.RemoveAt(0);
        }
        model.Reset(NewSeed());
        lastEvent = $"Replicate {pastRuns.Count + 1}: same settings, new random seed. Earlier runs stay on the chart as grey lines.";
    }

    private void ResetAll()
    {
        StopRunning();
        pastRuns.Clear();
        model.Reset(NewSeed());
        lastEvent = null;
    }

    private int[] Bins(EvoTrait t)
    {
        var bins = new int[Bins10];
        foreach (var o in model.Population)
            bins[Math.Min(Bins10 - 1, (int)(o[t] * Bins10))]++;
        return bins;
    }

    private int ChartMaxGen
    {
        get
        {
            int longest = pastRuns.Select(r => r.Count - 1).Append(model.History.Count - 1).Max();
            return Math.Max(20, (longest + 9) / 10 * 10);
        }
    }

    private static double Cx(int g, int maxGen) => CL + (CR - CL) * g / (double)maxGen;
    private static double Cy(double v) => CB - (CB - CT) * v;

    private static string Points(List<GenStats> history, int t, int maxGen) =>
        string.Join(" ", history.Select((s, g) => $"{F(Cx(g, maxGen))},{F(Cy(s.Mean[t]))}"));

    private static string TargetPath(List<GenStats> history, int t, int maxGen)
    {
        var sb = new System.Text.StringBuilder();
        bool pen = false;
        for (int g = 0; g < history.Count; g++)
        {
            if (history[g].Target[t] is double v)
            {
                sb.Append(pen ? " L" : " M").Append(F(Cx(g, maxGen))).Append(' ').Append(F(Cy(v)));
                pen = true;
            }
            else pen = false;
        }
        return sb.ToString().TrimStart();
    }

    private string ChartLabel => model.Extinct
        ? $"Mean {TraitNames[(int)chartTrait]} over {model.Generation} generations; the population went extinct"
        : $"Mean {TraitNames[(int)chartTrait]} over {model.Generation} generations, now {model.Mean(chartTrait):F2}";

    private static string BarFill(EvoTrait t, int bin) => t switch
    {
        EvoTrait.Lightness => BodyColor((bin + 0.5) / Bins10),
        EvoTrait.Size => "var(--primary)",
        _ => "var(--accent)",
    };

    private static double Radius(Organism o) => 2.5 + 5.5 * o[EvoTrait.Size];

    private static string BarkColor(double lightness) => $"hsl(30, 12%, {F(10 + 78 * lightness)}%)";
    private static string BodyColor(double lightness) => $"hsl(35, 8%, {F(10 + 78 * lightness)}%)";

    private static string Pressed(bool on) => on ? "true" : "false";

    private static string F(double v) => v.ToString("0.#", CultureInfo.InvariantCulture);
}

<style>
    .evo-intro {
        color: var(--text-secondary);
        font-size: 0.88rem;
        margin: 0 0 12px;
        line-height: 1.5;
    }

    .evo-presets {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 6px;
        margin-bottom: 12px;
    }
    .preset-btn {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 4px;
        padding: 10px 4px;
        background: var(--bg-card);
        border: 1px solid var(--border);
        border-radius: var(--radius-sm);
        color: var(--text-primary);
        font-size: 0.72rem;
        font-weight: 600;
        cursor: pointer;
        transition: all 0.15s ease;
        -webkit-tap-highlight-color: transparent;
    }
    .preset-btn:active { transform: scale(0.97); }
    .preset-btn:hover, .preset-btn.on { border-color: var(--primary); color: var(--primary); }
    .preset-btn span { line-height: 1.2; text-align: center; }

    .evo-note {
        padding: 12px 14px;
        margin-bottom: 14px;
        border-left: 3px solid var(--primary);
    }
    .evo-note-title {
        font-weight: 700;
        font-size: 0.9rem;
        color: var(--text-primary);
        margin-bottom: 4px;
    }
    .evo-note p {
        margin: 0;
        font-size: 0.82rem;
        line-height: 1.5;
        color: var(--text-secondary);
    }

    .evo-card {
        padding: 14px;
        margin-bottom: 14px;
    }

    .evo-meta {
        display: grid;
        grid-template-columns: repeat(5, 1fr);
        gap: 6px;
        margin-bottom: 12px;
    }
    .evo-meta-row {
        display: flex;
        flex-direction: column;
        align-items: center;
        background: var(--bg-surface);
        border-radius: var(--radius-sm);
        padding: 6px 2px;
        min-width: 0;
    }
    .meta-label {
        font-size: 0.62rem;
        color: var(--text-muted);
        text-transform: uppercase;
        letter-spacing: 0.3px;
