@page "/cards"
@inject IProgressService Progress
@inject IContentRepository Content
@inject IJSRuntime JS
@inject NavigationManager Nav

<div class="page-header">
    <button class="back-btn" aria-label="Back to profile" @onclick='() => Nav.NavigateTo("/profile")'><Icon Name="arrow-left" Size="18" /></button>
    <h1>Hall of Cards</h1>
</div>

<p class="cards-subtitle">Complete all lessons in a topic to earn its card.</p>

@if (profile != null && topics != null)
{
    <div class="cards-count">
        <strong>@profile.CompletionCards.Count</strong> / @topics.Count collected
    </div>

    <div class="cards-grid">
        @foreach (var topic in topics)
        {
            var card = profile.CompletionCards.FirstOrDefault(c => c.TopicId == topic.Id);
            var earned = card != null;

            <div class="completion-card @(earned ? "earned" : "locked")" @onclick="() => { if (earned) FlipCard(topic.Id); }">
                @if (earned && flippedCard == topic.Id)
                {
                    <div class="card-back">
                        <h3>@topic.Name</h3>
                        <p class="card-desc">@topic.Description</p>
                        <div class="card-date">Earned @card!.EarnedDate</div>
                        <div class="card-badge">MASTERED</div>
                    </div>
                }
                else
                {
                    <div class="card-front">
                        @if (HasCustomArt(topic.Id))
                        {
                            <div class="card-art">
                                @((MarkupString)GetCardSvg(topic.Id, topic.Color, earned))
                            </div>
                        }
                        else
                        {
                            <div class="card-art card-art-generic" style="background: linear-gradient(135deg, @(earned ? topic.Color : "#888"), @(earned ? topic.Color : "#888")99); opacity: @(earned ? "1" : "0.25"); color: #fff;">
                                <TopicIcon TopicId="@topic.Id" Size="64" />
                            </div>
                        }
                        <div class="card-title">@topic.Name</div>
                        @if (!earned)
                        {
                            <div class="card-lock"><Icon Name="lock" Size="18" /></div>
                        }
                    </div>
                }
            </div>
        }
    </div>
}
else
{
    <div class="loading">Loading...</div>
}

