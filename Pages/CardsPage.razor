<style>
    .cards-subtitle {
        color: var(--text-muted); font-size: 0.9rem; margin-bottom: 16px; text-align: center;
    }

    .cards-count {
        text-align: center; margin-bottom: 20px;
        font-size: 0.9rem; color: var(--text-secondary);
    }
    .cards-count strong { font-size: 1.3rem; color: var(--primary); }

    .cards-grid {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: 14px;
    }

    .completion-card {
        border-radius: var(--radius-md);
        overflow: hidden;
        box-shadow: 0 4px 16px var(--shadow);
        border: 2px solid var(--border);
        aspect-ratio: 4/3;
        position: relative;
        transition: transform 0.3s ease, box-shadow 0.3s ease;
        cursor: default;
    }

    .completion-card:active { transform: scale(0.97); }

    .completion-card.earned {
        cursor: pointer;
        border-color: transparent;
        box-shadow: 0 4px 20px rgba(0,0,0,0.12);
    }

    .completion-card.earned:hover {
        transform: translateY(-3px);
        box-shadow: 0 8px 28px rgba(0,0,0,0.18);
    }

    .completion-card.locked {
        opacity: 0.55;
    }

    /* Front */
    .card-front {
        width: 100%; height: 100%; position: relative;
        animation: cardIn 0.4s ease;
    }

    .card-art { width: 100%; height: 100%; }
    .card-art svg { width: 100%; height: 100%; display: block; }

    .card-art-generic {
        display: flex; align-items: center; justify-content: center;
    }
    .card-art-generic .topic-icon { filter: drop-shadow(0 2px 4px rgba(0,0,0,0.25)); }

    .card-title {
