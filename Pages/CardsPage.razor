@page "/cards"
@inject IProgressService Progress
@inject IContentRepository Content
@inject NavigationManager Nav

<div class="page-header">
    <button class="back-btn" aria-label="Back to profile" @onclick='() => Nav.NavigateTo("/profile")'><Icon Name="arrow-left" Size="18" /></button>
    <h1>Hall of Cards</h1>
</div>

@if (profile == null || topics == null)
{
    <div class="loading">Loading...</div>
}
else
{
    <div class="card cards-summary">
        <div><strong>@earned.Count</strong> of @topics.Count topics mastered</div>
        <div class="cards-bar"><i style="width: @(topics.Count > 0 ? earned.Count * 100 / topics.Count : 0)%"></i></div>
        <div class="cards-tiers">
            @foreach (var t in Tiers)
            {
                <span class="tier-chip tier-@t"><i></i>@earned.Count(e => TopicArt.Tier(e.Topic.Difficulty) == t) @t</span>
            }
        </div>
    </div>

    @if (earned.Count == 0)
    {
        <div class="card cards-empty">
            <p>No cards yet. Finish every lesson in a topic to earn its card.</p>
            <StartLessonButton />
        </div>
    }
    else
    {
        <p class="cards-hint">Finish every lesson in a topic to earn its card. Tap a card to turn it over.</p>
        var shown = 0;
        @foreach (var group in earned.GroupBy(e => e.Topic.Domain).OrderByDescending(g => g.Count()).ThenBy(g => DomainName(g.Key)))
        {
            <h3 class="cards-group">@DomainName(group.Key) <small>@group.Count()</small></h3>
            <div class="cards-grid">
                @foreach (var e in group)
                {
                    var item = e;
                    <div class="tcard-slot card-flip" role="button" tabindex="0" aria-label="@item.Topic.Name card"
                         style="animation-delay: @(Math.Min(shown++, 12) * 40)ms" @onclick="() => Flip(item.Topic.Id)">
                        <TopicCard Topic="item.Topic" DomainName="@DomainName(item.Topic.Domain)" EarnedDate="@item.Card.EarnedDate" Flipped="flipped == item.Topic.Id">
                            <BackActions>
                                <button type="button" class="btn btn-sm btn-outline" @onclick:stopPropagation="true" @onclick='() => Nav.NavigateTo($"/topic/{item.Topic.Id}")'>Open topic</button>
                            </BackActions>
                        </TopicCard>
                    </div>
                }
            </div>
        }
    }
}

@code {
    private static readonly string[] Tiers = { "bronze", "silver", "gold", "prismatic" };

    private UserProfile? profile;
    private List<Topic>? topics;
    private List<Domain> domains = new();
    private List<(Topic Topic, CompletionCard Card)> earned = new();
    private string? flipped;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        profile = await Progress.GetProfileAsync();
        topics = await Content.GetTopicsAsync();
        domains = await Content.GetDomainsAsync();
        var byId = topics.ToDictionary(t => t.Id);
        // Newest first within each subject; cards for topics that no longer exist are skipped.
        earned = profile.CompletionCards
            .Where(c => byId.ContainsKey(c.TopicId))
            .DistinctBy(c => c.TopicId)
            .OrderByDescending(c => c.EarnedDate)
            .Select(c => (byId[c.TopicId], c))
            .ToList();
        StateHasChanged();
    }

    private string DomainName(string id) => domains.FirstOrDefault(d => d.Id == id)?.Name ?? id;

    private void Flip(string topicId) => flipped = flipped == topicId ? null : topicId;
}

<style>
    .cards-summary { padding: 14px 16px; margin-bottom: 14px; font-size: .9rem; color: var(--text-secondary); }
    .cards-summary strong { font-size: 1.25rem; color: var(--primary); }
    .cards-bar { height: 6px; border-radius: 4px; background: var(--bg-surface); overflow: hidden; margin: 8px 0 10px; }
    .cards-bar i { display: block; height: 100%; border-radius: 4px; background: linear-gradient(90deg, var(--primary), var(--accent)); }
    .cards-tiers { display: flex; flex-wrap: wrap; gap: 6px 14px; font-size: .74rem; text-transform: capitalize; color: var(--text-muted); }
    .tier-chip { display: inline-flex; align-items: center; gap: 5px; }
    .tier-chip i { width: 10px; height: 14px; border-radius: 3px; }
    .tier-chip.tier-bronze i { background: linear-gradient(145deg, #DDAE82, #9A6338); }
    .tier-chip.tier-silver i { background: linear-gradient(145deg, #F1EDE6, #8F8778); }
    .tier-chip.tier-gold i { background: linear-gradient(145deg, #F4D893, #A57726); }
    .tier-chip.tier-prismatic i { background: linear-gradient(135deg, #E8B4CB, #B7C6EF, #B4E5D1, #F2E2A3); }
    .cards-hint { margin: 0 0 6px; font-size: .8rem; color: var(--text-muted); }
    .cards-group { margin: 16px 0 8px; font-size: .78rem; letter-spacing: .1em; text-transform: uppercase; color: var(--text-secondary); }
    .cards-group small { margin-left: 4px; color: var(--text-muted); font-weight: 600; }
    .cards-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(150px, 1fr)); gap: 12px; }
    .tcard-slot { cursor: pointer; -webkit-tap-highlight-color: transparent; }
    .tcard-slot:active .tcard { transform: scale(.97); }
    .tcard-slot .tcard { transition: transform .15s; }
    .cards-empty { text-align: center; padding: 28px 20px; }
    .cards-empty p { margin: 0 0 14px; color: var(--text-secondary); }
</style>
