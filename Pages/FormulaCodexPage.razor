@page "/formulas"
@inject IProgressService Progress
@inject IContentRepository Content
@inject IJSRuntime JS
@inject NavigationManager Nav
@inject HttpClient Http

<div class="page-header">
    <button class="back-btn" aria-label="Back to home" @onclick='() => Nav.NavigateTo("/")'><Icon Name="arrow-left" Size="18" /></button>
    <h1>Formula Codex</h1>
</div>

@if (formulas != null && profile != null)
{
    <div class="codex-search">
        <input type="text" class="codex-search-input" placeholder="Search formulas..."
               @bind="searchQuery" @bind:event="oninput" />
    </div>

    <div class="codex-stats">
        <small>@unlockedCount / @formulas.Count formulas unlocked</small>
        <div class="progress-bar-container" style="height: 6px; flex: 1; max-width: 120px">
            <div class="progress-bar-fill animate-in" style="width: @(formulas.Count > 0 ? (unlockedCount * 100 / formulas.Count) : 0)%"></div>
        </div>
    </div>

    <!-- Topic filter -->
    <div class="codex-filters">
        <button class="codex-filter @(activeFilter == null ? "active" : "")" @onclick="() => activeFilter = null">All</button>
        @foreach (var cat in categories)
        {
            <button class="codex-filter @(activeFilter == cat ? "active" : "")" @onclick="() => activeFilter = cat">@cat</button>
        }
    </div>

    <div class="codex-list">
        @foreach (var group in FilteredFormulas().GroupBy(f => f.Category).OrderBy(g => g.Key))
        {
            <div class="codex-category-header">@group.Key</div>
            <div class="codex-group stagger-in">
                @foreach (var formula in group)
                {
                    var isUnlocked = IsUnlocked(formula);
                    <div class="card codex-card @(isUnlocked ? "" : "codex-locked")" @key="formula.Id">
                        <div class="codex-card-header">
                            <strong>@formula.Name</strong>
                            @if (!isUnlocked)
                            {
                                <Icon Name="lock" Size="14" />
                            }
                        </div>
                        @if (isUnlocked)
                        {
                            <div class="math-display codex-math" id="codex-@formula.Id"></div>
                            <small class="codex-desc">@formula.Description</small>
                        }
                        else
                        {
                            <div class="codex-hidden">Complete more lessons to unlock</div>
                        }
                    </div>
                }
            </div>
        }

        @if (!FilteredFormulas().Any())
        {
            <div class="codex-empty">No formulas match your search.</div>
        }
    </div>
}
else
{
    <div>
        <div class="skeleton" style="height:44px;border-radius:var(--radius-sm);margin-bottom:12px"></div>
        @for (int i = 0; i < 6; i++)
        {
            <div class="skeleton skeleton-card" style="height:70px;margin-bottom:8px"></div>
        }
    </div>
}

@code {
    private List<Formula>? formulas;
    private UserProfile? profile;
    private string searchQuery = "";
    private string? activeFilter;
    private List<string> categories = new();
    private int unlockedCount;

    private class Formula
    {
        public string Id { get; set; } = "";
        public string Name { get; set; } = "";
        public string TopicId { get; set; } = "";
        public string LessonId { get; set; } = "";
        public string Category { get; set; } = "";
        public string Expression { get; set; } = "";
        public string Description { get; set; } = "";
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            formulas = await Http.GetFromJsonAsync<List<Formula>>("data/formula-codex.json") ?? new();
            profile = await Progress.GetProfileAsync();
            categories = formulas.Select(f => f.Category).Distinct().OrderBy(c => c).ToList();
            unlockedCount = formulas.Count(f => IsUnlocked(f));
            StateHasChanged();
        }

        // Render KaTeX for visible unlocked formulas
        if (formulas != null && profile != null)
        {
            foreach (var f in FilteredFormulas().Where(IsUnlocked))
            {
                try { await JS.InvokeVoidAsync("renderMath", $"codex-{f.Id}", f.Expression, true); } catch { }
            }
        }
    }

    private bool IsUnlocked(Formula f)
    {
        if (profile == null) return false;
        // Dev mode unlocks all
        if (profile.ShopPurchases.Contains("__dev_mode__")) return true;
        return profile.LessonsCompleted.Contains(f.LessonId)
            || profile.TopicsCompleted.Contains(f.TopicId);
    }

    private IEnumerable<Formula> FilteredFormulas()
    {
        if (formulas == null) return Enumerable.Empty<Formula>();
        var q = formulas.AsEnumerable();

        if (activeFilter != null)
            q = q.Where(f => f.Category == activeFilter);

        if (!string.IsNullOrWhiteSpace(searchQuery))
        {
            var search = searchQuery.Trim().ToLower();
            q = q.Where(f => f.Name.ToLower().Contains(search)
                || f.Description.ToLower().Contains(search)
                || f.Category.ToLower().Contains(search));
        }

        return q;
    }
}

<style>
    .codex-search { margin-bottom: 12px; }

    .codex-search-input {
        width: 100%; padding: 12px 16px; border: 2px solid var(--border);
        border-radius: var(--radius-md); font-size: 0.95rem; font-family: var(--font-main);
        background: var(--bg-card); color: var(--text-primary); outline: none;
        transition: border-color 0.2s ease; box-sizing: border-box;
    }
    .codex-search-input:focus { border-color: var(--primary); }

    .codex-stats {
        display: flex; align-items: center; gap: 10px; margin-bottom: 12px;
    }
    .codex-stats small { color: var(--text-muted); font-size: 0.8rem; white-space: nowrap; }

    /* Filters */
    .codex-filters {
        display: flex; gap: 6px; margin-bottom: 16px;
        overflow-x: auto; padding-bottom: 4px;
        -webkit-overflow-scrolling: touch;
    }
    .codex-filters::-webkit-scrollbar { display: none; }

    .codex-filter {
        padding: 6px 12px; border: 1px solid var(--border); border-radius: 20px;
        background: var(--bg-card); color: var(--text-muted); font-size: 0.75rem;
        font-weight: 600; cursor: pointer; white-space: nowrap;
        transition: all 0.2s ease; -webkit-tap-highlight-color: transparent;
    }
    .codex-filter:active { transform: scale(0.95); }
    .codex-filter.active {
        background: var(--primary); color: white; border-color: var(--primary);
    }

    /* List */
    .codex-list { display: flex; flex-direction: column; gap: 4px; }

    .codex-category-header {
        font-size: 0.8rem; font-weight: 700; color: var(--primary);
        text-transform: uppercase; letter-spacing: 0.5px;
        padding: 12px 0 6px; border-bottom: 1px solid var(--border); margin-bottom: 4px;
    }

    .codex-group { display: flex; flex-direction: column; gap: 6px; margin-bottom: 8px; }

    .codex-card { padding: 12px 14px; }
    .codex-card:hover { transform: none; }

    .codex-card-header {
        display: flex; justify-content: space-between; align-items: center;
        margin-bottom: 4px;
    }
    .codex-card-header strong { font-size: 0.9rem; }

    .codex-math {
        background: transparent; padding: 6px 0; margin: 4px 0;
        font-size: 1rem; text-align: left;
    }

    .codex-desc {
        color: var(--text-muted); font-size: 0.8rem;
    }

    .codex-locked { opacity: 0.45; }
    .codex-hidden {
        font-size: 0.8rem; color: var(--text-muted); font-style: italic;
        padding: 8px 0;
    }

    .codex-empty {
        text-align: center; padding: 40px; color: var(--text-muted);
    }
</style>
