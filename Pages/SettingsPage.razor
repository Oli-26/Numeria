@page "/settings"
@inject IProgressService Progress
@inject IThemeService ThemeService
@inject IJSRuntime JS

<h1>Settings</h1>

<div class="settings-list">
    <div class="card settings-item">
        <h3>Theme</h3>
        <p>Change your current theme from the <a href="/shop">Shop</a>.</p>
        <p>Current: <strong>@activeTheme</strong></p>
    </div>

    <div class="card settings-item">
        <h3>Reset Progress</h3>
        <p>This will erase all your XP, achievements, and purchases. This cannot be undone.</p>
        @if (!confirmReset)
        {
            <button class="btn btn-outline" style="color: var(--error); border-color: var(--error)" @onclick="() => confirmReset = true">
                Reset All Progress
            </button>
        }
        else
        {
            <div class="confirm-reset">
                <p style="color: var(--error); font-weight: 600">Are you sure?</p>
                <div style="display: flex; gap: 10px">
                    <button class="btn btn-sm btn-outline" @onclick="() => confirmReset = false">Cancel</button>
                    <button class="btn btn-sm" style="background: var(--error); color: white" @onclick="DoReset">Yes, Reset Everything</button>
                </div>
            </div>
        }
    </div>

    <div class="card settings-item">
        <h3>About</h3>
        <p>MathVoyager v1.0</p>
        <p style="color: var(--text-muted)">A visual math learning app. Built with Blazor WebAssembly.</p>
    </div>
</div>

@code {
    private string activeTheme = "default";
    private bool confirmReset;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            activeTheme = await ThemeService.GetActiveThemeAsync();
            StateHasChanged();
        }
    }

    private async Task DoReset()
    {
        await Progress.ResetProgressAsync();
        await ThemeService.ApplyThemeAsync("default");
        confirmReset = false;
        activeTheme = "default";
        await JS.InvokeVoidAsync("showToast", "Progress reset.", "");
    }
}

<style>
    .settings-list {
        display: flex;
        flex-direction: column;
        gap: 12px;
    }

    .settings-item {
        padding: 16px;
    }

    .settings-item:hover { transform: none; }

    .settings-item h3 {
        margin-bottom: 6px;
    }

    .settings-item p {
        color: var(--text-secondary);
        font-size: 0.9rem;
        margin-bottom: 8px;
    }
</style>
