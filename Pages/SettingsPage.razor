@page "/settings"
@inject IProgressService Progress
@inject IThemeService ThemeService
@inject IContentRepository Content
@inject IJSRuntime JS
@inject NavigationManager Nav
@inject INotificationService NotificationSvc
@inject ITtsService TtsService

<div class="page-header">
    <button class="back-btn" aria-label="Back to home" @onclick='() => Nav.NavigateTo("/")'><Icon Name="arrow-left" Size="18" /></button>
    <h1>Settings</h1>
</div>

<div class="settings-list">
    @if (domains.Count >= 2)
    {
        <div class="card settings-item">
            <div class="settings-row">
                <div class="settings-icon"><Icon Name="book" Size="24" /></div>
                <div class="settings-info">
                    <h3>Domain</h3>
                    <p>What you're learning</p>
                </div>
            </div>
            <div class="domain-picker">
                @foreach (var d in domains)
                {
                    <button class="domain-btn @(currentDomain == d.Id ? "active" : "")" @onclick="() => SetDomain(d.Id)">
                        <strong>@d.Name</strong>
                        <small>@d.Description</small>
                    </button>
                }
            </div>
        </div>
    }

    <div class="card settings-item">
        <div class="settings-row">
            <div class="settings-icon"><Icon Name="palette" Size="24" /></div>
            <div class="settings-info">
                <h3>Theme</h3>
                <p>Current: <strong>@FormatThemeName(activeTheme)</strong></p>
            </div>
            <button class="btn btn-sm btn-outline" @onclick='() => Nav.NavigateTo("/shop")'>Browse</button>
        </div>
        @if (activeTheme != "default")
        {
            <button class="btn btn-sm btn-outline reset-theme-btn" @onclick="ResetTheme">
                Reset to Default
            </button>
        }
    </div>

    <div class="card settings-item">
        <div class="settings-row">
            <div class="settings-icon"><Icon Name="zap" Size="24" /></div>
            <div class="settings-info">
                <h3>Sound Effects</h3>
                <p>@(soundEnabled ? "On" : "Off")</p>
            </div>
            <button class="toggle-btn @(soundEnabled ? "on" : "")" aria-label="@(soundEnabled ? "Disable sound effects" : "Enable sound effects")" @onclick="ToggleSound">
                <span class="toggle-knob"></span>
            </button>
        </div>
    </div>

    <div class="card settings-item">
        <div class="settings-row">
            <div class="settings-icon"><Icon Name="pencil" Size="24" /></div>
            <div class="settings-info">
                <h3>Display Name</h3>
                <p>@currentName</p>
            </div>
            <button class="btn btn-sm btn-outline" @onclick="() => editingName = true" style="@(editingName ? "display:none" : "")">Edit</button>
        </div>
        @if (editingName)
        {
            <div class="name-edit">
                <input type="text" class="name-input" @bind="newName" @bind:event="oninput"
                       placeholder="Enter new name..." maxlength="30" @onkeydown="HandleNameKeydown" />
                <div class="name-edit-buttons">
                    <button class="btn btn-sm btn-outline" @onclick="CancelNameEdit">Cancel</button>
                    <button class="btn btn-sm btn-primary" @onclick="SaveName"
                            disabled="@(string.IsNullOrWhiteSpace(newName) || newName.Trim() == currentName)">Save</button>
                </div>
            </div>
        }
    </div>

    <div class="card settings-item">
        <div class="settings-row">
            <div class="settings-icon"><Icon Name="lightbulb" Size="24" /></div>
            <div class="settings-info">
                <h3>Show Hints by Default</h3>
                <p>Auto-reveal hints when available</p>
            </div>
            <button class="toggle-btn @(showHints ? "on" : "")" aria-label="@(showHints ? "Disable auto-hints" : "Enable auto-hints")" @onclick="ToggleShowHints">
                <span class="toggle-knob"></span>
            </button>
        </div>
    </div>

    <div class="card settings-item">
        <div class="settings-row">
            <div class="settings-icon"><Icon Name="search" Size="24" /></div>
            <div class="settings-info">
                <h3>Font Size</h3>
                <p>@FormatFontSize(fontSize)</p>
            </div>
        </div>
        <div class="font-size-picker">
            <button class="font-btn @(fontSize == "small" ? "active" : "")" @onclick='() => SetFontSize("small")'>
                <span style="font-size: 0.8rem">A</span> Small
            </button>
            <button class="font-btn @(fontSize == "medium" ? "active" : "")" @onclick='() => SetFontSize("medium")'>
                <span style="font-size: 1rem">A</span> Medium
            </button>
            <button class="font-btn @(fontSize == "large" ? "active" : "")" @onclick='() => SetFontSize("large")'>
                <span style="font-size: 1.2rem">A</span> Large
            </button>
        </div>
    </div>

    <div class="card settings-item">
        <div class="settings-row">
            <div class="settings-icon"><Icon Name="clock" Size="24" /></div>
            <div class="settings-info">
                <h3>Notifications</h3>
                <p>@(notificationsEnabled ? "On" : "Off")</p>
            </div>
            <button class="toggle-btn @(notificationsEnabled ? "on" : "")" aria-label="@(notificationsEnabled ? "Disable notifications" : "Enable notifications")" @onclick="ToggleNotifications">
                <span class="toggle-knob"></span>
            </button>
        </div>
        @if (notificationsEnabled)
        {
            <div class="notif-section">
                <div class="settings-row notif-sub-row">
                    <div class="settings-info">
                        <h3>Streak Reminder</h3>
                        <p>Daily nudge at the time below</p>
                    </div>
                    <button class="toggle-btn @(streakReminderEnabled ? "on" : "")" @onclick="ToggleStreakReminder">
                        <span class="toggle-knob"></span>
                    </button>
                </div>
                <div class="settings-row notif-sub-row">
                    <div class="settings-info">
                        <h3>Daily Reminder Time</h3>
                        <p>When to nudge you each day</p>
                    </div>
                    <input type="time" class="time-input" value="@dailyReminderTime"
                           @onchange="OnReminderTimeChanged" />
                </div>
                <div class="settings-row notif-sub-row">
                    <div class="settings-info">
                        <h3>Review Reminder</h3>
                        <p>Alert when review cards are due</p>
                    </div>
                    <button class="toggle-btn @(reviewReminderEnabled ? "on" : "")" @onclick="ToggleReviewReminder">
                        <span class="toggle-knob"></span>
                    </button>
                </div>
            </div>
        }
    </div>

    <!-- ── Audio / TTS ─────────────────────────────────────────────────── -->
    <div class="card settings-item">
        <div class="settings-row">
            <div class="settings-icon">
                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24"
                     fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <polygon points="11 5 6 9 2 9 2 15 6 15 11 19"/>
                    <path d="M15.54 8.46a5 5 0 0 1 0 7.07"/>
                    <path d="M19.07 4.93a10 10 0 0 1 0 14.14"/>
                </svg>
            </div>
            <div class="settings-info">
                <h3>Audio Mode</h3>
                <p>Read lessons aloud while you study</p>
            </div>
            <button class="toggle-btn @(ttsEnabled ? "on" : "")" aria-label="@(ttsEnabled ? "Disable audio mode" : "Enable audio mode")" @onclick="ToggleTts">
                <span class="toggle-knob"></span>
            </button>
        </div>

        @if (ttsEnabled)
        {
            <div class="tts-settings-section">
                <!-- Speed -->
                <div class="settings-row tts-sub-row">
                    <div class="settings-info">
                        <h3>Default Speed</h3>
                        <p>@(ttsRate)x</p>
                    </div>
                </div>
                <div class="tts-speed-picker">
                    @foreach (var sp in new double[] { 0.75, 1.0, 1.25, 1.5 })
                    {
                        var speed = sp;
                        <button class="tts-speed-opt @(ttsRate == speed ? "active" : "")"
                                @onclick="() => SetTtsRateSetting(speed)">
                            @(speed)x
                        </button>
                    }
                </div>

                <!-- Voice picker -->
                @if (ttsVoices.Count > 0)
                {
                    <div class="settings-row tts-sub-row" style="margin-top:12px">
                        <div class="settings-info">
                            <h3>Voice</h3>
                            <p>@(string.IsNullOrEmpty(ttsVoice) ? "System default" : ttsVoice)</p>
                        </div>
                    </div>
                    <select class="tts-voice-select" @onchange="OnVoiceChanged">
                        <option value="">System default</option>
                        @foreach (var v in ttsVoices)
                        {
                            <option value="@v.Name" selected="@(v.Name == ttsVoice)">@v.Name (@v.Lang)</option>
                        }
                    </select>
                }

                <!-- Auto-advance -->
                <div class="settings-row tts-sub-row" style="margin-top:12px">
                    <div class="settings-info">
                        <h3>Auto-advance</h3>
                        <p>Move to next concept when audio ends</p>
                    </div>
                    <button class="toggle-btn @(ttsAutoAdvance ? "on" : "")" @onclick="ToggleTtsAutoAdvance">
                        <span class="toggle-knob"></span>
                    </button>
                </div>
            </div>
        }
    </div>

    <div class="card settings-item">
        <div class="settings-row">
            <div class="settings-icon"><Icon Name="trending-up" Size="24" /></div>
            <div class="settings-info">
                <h3>Export Stats</h3>
                <p>Copy your progress summary</p>
            </div>
            <button class="btn btn-sm btn-outline" @onclick="ExportStats">Copy</button>
        </div>
    </div>

    <div class="card settings-item">
        <div class="settings-row">
            <div class="settings-icon"><Icon Name="gift" Size="24" /></div>
            <div class="settings-info">
                <h3>Backup & Restore</h3>
                <p>Export or import your full progress</p>
            </div>
        </div>
        <div class="backup-buttons">
            <button class="btn btn-sm btn-primary" @onclick="ExportData" style="flex:1">
                Export Data
            </button>
            <button class="btn btn-sm btn-outline" @onclick="ImportData" style="flex:1">
                Import Data
            </button>
        </div>
    </div>

    <div class="card settings-item danger-item">
        <div class="settings-row">
            <div class="settings-icon"><Icon Name="x-mark" Size="24" Stroke="var(--error)" /></div>
            <div class="settings-info">
                <h3>Reset Progress</h3>
                <p>Erase all data. Cannot be undone.</p>
            </div>
            @if (!confirmReset)
            {
                <button class="btn btn-sm btn-danger" @onclick="() => confirmReset = true">Reset</button>
            }
        </div>
        @if (confirmReset)
        {
            <div class="confirm-box">
                <p>Are you sure? All XP, achievements, and purchases will be lost.</p>
                <div class="confirm-buttons">
                    <button class="btn btn-sm btn-outline" @onclick="() => confirmReset = false">Cancel</button>
                    <button class="btn btn-sm btn-danger" @onclick="DoReset">Yes, Reset Everything</button>
                </div>
            </div>
        }
    </div>

    <div class="card settings-item dev-item">
        <div class="settings-row">
            <div class="settings-icon"><Icon Name="zap" Size="24" Stroke="var(--accent)" /></div>
            <div class="settings-info">
                <h3>Dev Mode</h3>
                <p>@(devMode ? "Active — everything unlocked" : "Unlock all features, items, and give max points")</p>
            </div>
            <button class="toggle-btn @(devMode ? "on" : "")" aria-label="@(devMode ? "Disable dev mode" : "Enable dev mode")" @onclick="ToggleDevMode">
                <span class="toggle-knob"></span>
            </button>
        </div>
    </div>

    <div class="card settings-item about-card">
        <div class="about-brand">
            <img src="numeria-icon.svg" alt="Numeria" class="about-icon" />
            <div>
                <h3>Numeria</h3>
                <p>v1.0</p>
            </div>
        </div>
        <p class="about-desc">A visual math learning app. Built with Blazor WebAssembly.</p>
    </div>
</div>

@code {
    private string activeTheme = "default";
    private bool confirmReset;
    private bool soundEnabled = true;
    private string currentName = "";
    private string newName = "";
    private bool editingName;
    private bool devMode;
    private bool showHints;
    private string fontSize = "medium";
    private string currentDomain = "math";
    private List<Domain> domains = new();
    private bool notificationsEnabled;
    private bool streakReminderEnabled = true;
    private bool reviewReminderEnabled = true;
    private string dailyReminderTime = "19:00";

    // TTS
    private bool ttsEnabled = true;
    private double ttsRate = 1.0;
    private string ttsVoice = "";
    private bool ttsAutoAdvance;
    private List<TtsVoice> ttsVoices = new();

    [Inject] private IShopRepository ShopRepo { get; set; } = default!;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            activeTheme = await ThemeService.GetActiveThemeAsync();
            var profile = await Progress.GetProfileAsync();
            currentName = profile.DisplayName;
            newName = currentName;
            devMode = profile.ShopPurchases.Contains("__dev_mode__");
            showHints = profile.ShowHintsByDefault;
            fontSize = profile.FontSize ?? "medium";
            currentDomain = profile.CurrentDomain;
            notificationsEnabled = profile.NotificationsEnabled;
            streakReminderEnabled = profile.StreakReminderEnabled;
            reviewReminderEnabled = profile.ReviewReminderEnabled;
            dailyReminderTime = profile.DailyReminderTime ?? "19:00";
            ttsEnabled = profile.TtsEnabled;
            ttsRate = profile.TtsRate > 0 ? profile.TtsRate : 1.0;
            ttsVoice = profile.TtsVoice ?? "";
            ttsAutoAdvance = profile.TtsAutoAdvance;
            domains = await Content.GetDomainsAsync();
            // Load voices (async — fires after first render is complete)
            try { ttsVoices = await TtsService.GetVoicesAsync(); } catch { }
            try
            {
                var muted = await JS.InvokeAsync<string>("localStorage.getItem", "numeria-sound-muted");
                soundEnabled = muted != "true";
            }
            catch { }
            StateHasChanged();
        }
    }

    private async Task ToggleDevMode()
    {
        devMode = !devMode;
        var profile = await Progress.GetProfileAsync();

        if (devMode)
        {
            // Grant max points
            profile.Points = 99999;

            // Add dev mode marker
            if (!profile.ShopPurchases.Contains("__dev_mode__"))
                profile.ShopPurchases.Add("__dev_mode__");

            // Unlock ALL shop items (current and future-proof: grab everything from shop data)
            var allItems = await ShopRepo.GetShopItemsAsync();
            foreach (var item in allItems)
            {
                if (!profile.ShopPurchases.Contains(item.Id))
                    profile.ShopPurchases.Add(item.Id);
            }

            await Progress.SaveProfileAsync(profile);
            await JS.InvokeVoidAsync("showToast", "Dev mode ON — everything unlocked!", "");
            try { await JS.InvokeVoidAsync("Sounds.playLevelUp"); } catch { }
        }
        else
        {
            profile.ShopPurchases.Remove("__dev_mode__");
            await Progress.SaveProfileAsync(profile);
            await JS.InvokeVoidAsync("showToast", "Dev mode OFF", "");
        }
    }

    private async Task ToggleSound()
    {
        soundEnabled = !soundEnabled;
        try
        {
            await JS.InvokeVoidAsync("localStorage.setItem", "numeria-sound-muted", soundEnabled ? "false" : "true");
            await JS.InvokeVoidAsync("eval", $"window.Sounds._muted = {(soundEnabled ? "false" : "true")}");
            if (soundEnabled)
                try { await JS.InvokeVoidAsync("Sounds.playClick"); } catch { }
        }
        catch { }
    }

    private async Task SaveName()
    {
        if (string.IsNullOrWhiteSpace(newName)) return;
        var profile = await Progress.GetProfileAsync();
        profile.DisplayName = newName.Trim();
        await Progress.SaveProfileAsync(profile);
        currentName = profile.DisplayName;
        editingName = false;
        await JS.InvokeVoidAsync("showToast", "Name updated!", "");
        try { await JS.InvokeVoidAsync("Sounds.playClick"); } catch { }
    }

    private void CancelNameEdit()
    {
        newName = currentName;
        editingName = false;
    }

    private async Task HandleNameKeydown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") await SaveName();
        if (e.Key == "Escape") CancelNameEdit();
    }

    private async Task ExportStats()
    {
        var profile = await Progress.GetProfileAsync();
        var text = $"Numeria Stats\n" +
                   $"Name: {profile.DisplayName}\n" +
                   $"Total XP: {profile.TotalXp}\n" +
                   $"Level: {Gamification.GetLevel(profile.TotalXp)}\n" +
                   $"Streak: {profile.CurrentStreak} days\n" +
                   $"Lessons: {profile.LessonsCompleted.Count}\n" +
                   $"Quizzes: {profile.QuizHistory.Count}\n" +
                   $"Accuracy: {(profile.TotalQuestionsAnswered > 0 ? profile.TotalCorrectAnswers * 100 / profile.TotalQuestionsAnswered : 0)}%\n" +
                   $"Achievements: {profile.AchievementsUnlocked.Count}";
        try
        {
            await JS.InvokeVoidAsync("navigator.clipboard.writeText", text);
            await JS.InvokeVoidAsync("showToast", "Stats copied!", "");
        }
        catch
        {
            await JS.InvokeVoidAsync("showToast", "Could not copy", "");
        }
    }

    [Inject] private IGamificationService Gamification { get; set; } = default!;

    private async Task ResetTheme()
    {
        await ThemeService.ApplyThemeAsync("dark");
        activeTheme = "dark";
        await JS.InvokeVoidAsync("showToast", "Theme reset to default.", "");
        try { await JS.InvokeVoidAsync("Sounds.playClick"); } catch { }
    }

    private async Task DoReset()
    {
        await Progress.ResetProgressAsync();
        await ThemeService.ApplyThemeAsync("dark");
        confirmReset = false;
        activeTheme = "dark";
        await JS.InvokeVoidAsync("showToast", "Progress reset.", "");
    }

    private async Task ToggleShowHints()
    {
        showHints = !showHints;
        var profile = await Progress.GetProfileAsync();
        profile.ShowHintsByDefault = showHints;
        await Progress.SaveProfileAsync(profile);
        await JS.InvokeVoidAsync("showToast", showHints ? "Hints will auto-show" : "Hints hidden by default", "");
        try { await JS.InvokeVoidAsync("Sounds.playClick"); } catch { }
    }

    private async Task SetDomain(string domainId)
    {
        if (currentDomain == domainId) return;
        currentDomain = domainId;
        var profile = await Progress.GetProfileAsync();
        profile.CurrentDomain = domainId;
        await Progress.SaveProfileAsync(profile);
        var name = domains.FirstOrDefault(d => d.Id == domainId)?.Name ?? domainId;
        await JS.InvokeVoidAsync("showToast", $"Switched to {name}", "");
        try { await JS.InvokeVoidAsync("Sounds.playClick"); } catch { }
        Nav.NavigateTo("/", forceLoad: false);
    }

    private async Task SetFontSize(string size)
    {
        fontSize = size;
        var profile = await Progress.GetProfileAsync();
        profile.FontSize = size;
        await Progress.SaveProfileAsync(profile);
        await JS.InvokeVoidAsync("applyFontSize", size);
        try { await JS.InvokeVoidAsync("Sounds.playClick"); } catch { }
    }

    private async Task ExportData()
    {
        try
        {
            var json = await JS.InvokeAsync<string?>("exportProfileData");
            if (json != null)
            {
                var filename = $"numeria-backup-{DateTime.Now:yyyy-MM-dd}.json";
                await JS.InvokeVoidAsync("downloadFile", filename, json);
                await JS.InvokeVoidAsync("showToast", "Backup downloaded!", "");
            }
        }
        catch
        {
            await JS.InvokeVoidAsync("showToast", "Export failed", "");
        }
    }

    private async Task ImportData()
    {
        try
        {
            var json = await JS.InvokeAsync<string>("pickAndReadFile");
            var success = await JS.InvokeAsync<bool>("importProfileData", json);
            if (success)
            {
                await JS.InvokeVoidAsync("showToast", "Data restored! Reloading...", "");
                await Task.Delay(1000);
                await JS.InvokeVoidAsync("location.reload");
            }
            else
            {
                await JS.InvokeVoidAsync("showToast", "Invalid backup file", "");
            }
        }
        catch
        {
            await JS.InvokeVoidAsync("showToast", "Import cancelled", "");
        }
    }

    private async Task ToggleNotifications()
    {
        if (!notificationsEnabled)
        {
            // Request permission before turning on.
            var granted = await NotificationSvc.RequestPermissionAsync();
            if (!granted)
            {
                await JS.InvokeVoidAsync("showToast", "Permission denied — check app settings", "");
                return;
            }
            notificationsEnabled = true;
        }
        else
        {
            notificationsEnabled = false;
            await NotificationSvc.DisableAllAsync();
        }

        var profile = await Progress.GetProfileAsync();
        profile.NotificationsEnabled = notificationsEnabled;
        await Progress.SaveProfileAsync(profile);

        if (notificationsEnabled)
        {
            await NotificationSvc.RefreshSchedulesAsync();
            await JS.InvokeVoidAsync("showToast", "Notifications enabled", "");
        }
        else
        {
            await JS.InvokeVoidAsync("showToast", "Notifications disabled", "");
        }

        try { await JS.InvokeVoidAsync("Sounds.playClick"); } catch { }
    }

    private async Task ToggleStreakReminder()
    {
        streakReminderEnabled = !streakReminderEnabled;
        var profile = await Progress.GetProfileAsync();
        profile.StreakReminderEnabled = streakReminderEnabled;
        await Progress.SaveProfileAsync(profile);
        await NotificationSvc.RefreshSchedulesAsync();
        await JS.InvokeVoidAsync("showToast", streakReminderEnabled ? "Streak reminder on" : "Streak reminder off", "");
        try { await JS.InvokeVoidAsync("Sounds.playClick"); } catch { }
    }

    private async Task ToggleReviewReminder()
    {
        reviewReminderEnabled = !reviewReminderEnabled;
        var profile = await Progress.GetProfileAsync();
        profile.ReviewReminderEnabled = reviewReminderEnabled;
        await Progress.SaveProfileAsync(profile);
        await NotificationSvc.RefreshSchedulesAsync();
        await JS.InvokeVoidAsync("showToast", reviewReminderEnabled ? "Review reminder on" : "Review reminder off", "");
        try { await JS.InvokeVoidAsync("Sounds.playClick"); } catch { }
    }

    private async Task OnReminderTimeChanged(ChangeEventArgs e)
    {
        var val = e.Value?.ToString();
        if (string.IsNullOrWhiteSpace(val)) return;
        dailyReminderTime = val;
        var profile = await Progress.GetProfileAsync();
        profile.DailyReminderTime = dailyReminderTime;
        await Progress.SaveProfileAsync(profile);
        await NotificationSvc.RefreshSchedulesAsync();
        try { await JS.InvokeVoidAsync("Sounds.playClick"); } catch { }
    }

    private async Task ToggleTts()
    {
        ttsEnabled = !ttsEnabled;
        var profile = await Progress.GetProfileAsync();
        profile.TtsEnabled = ttsEnabled;
        await Progress.SaveProfileAsync(profile);
        await JS.InvokeVoidAsync("showToast", ttsEnabled ? "Audio mode on" : "Audio mode off", "");
        try { await JS.InvokeVoidAsync("Sounds.playClick"); } catch { }

        // Load voices when first enabled
        if (ttsEnabled && ttsVoices.Count == 0)
        {
            try { ttsVoices = await TtsService.GetVoicesAsync(); } catch { }
        }
    }

    private async Task SetTtsRateSetting(double rate)
    {
        ttsRate = rate;
        var profile = await Progress.GetProfileAsync();
        profile.TtsRate = rate;
        await Progress.SaveProfileAsync(profile);
        try { await JS.InvokeVoidAsync("Sounds.playClick"); } catch { }
    }

    private async Task OnVoiceChanged(ChangeEventArgs e)
    {
        ttsVoice = e.Value?.ToString() ?? "";
        var profile = await Progress.GetProfileAsync();
        profile.TtsVoice = ttsVoice;
        await Progress.SaveProfileAsync(profile);
    }

    private async Task ToggleTtsAutoAdvance()
    {
        ttsAutoAdvance = !ttsAutoAdvance;
        var profile = await Progress.GetProfileAsync();
        profile.TtsAutoAdvance = ttsAutoAdvance;
        await Progress.SaveProfileAsync(profile);
        await JS.InvokeVoidAsync("showToast", ttsAutoAdvance ? "Auto-advance on" : "Auto-advance off", "");
        try { await JS.InvokeVoidAsync("Sounds.playClick"); } catch { }
    }

    private string FormatFontSize(string size) => size switch
    {
        "small" => "Small",
        "large" => "Large",
        _ => "Medium"
    };

    private string FormatThemeName(string theme) => theme switch
    {
        "default" => "Default",
        "dark" => "Dark Mode",
        "chalkboard" => "Chalkboard",
        "neon" => "Neon Glow",
        "blueprint" => "Blueprint",
        _ => theme
    };
}

<style>
    .settings-list {
        display: flex; flex-direction: column; gap: 10px;
