<style>
    .cosmic-intro {
        text-align: center; color: var(--text-muted); font-size: 0.9rem;
        margin: 0 0 16px;
    }

    .cosmic-stage {
        display: flex; gap: 14px; align-items: stretch; margin-bottom: 18px;
    }

    .cosmic-zoom-controls {
        display: flex; flex-direction: column; align-items: center; gap: 8px;
        padding: 12px 6px; background: var(--bg-surface);
        border-radius: var(--radius-md); position: relative;
        min-width: 56px;
    }

    .zoom-btn {
        background: var(--bg-card); border: 1px solid var(--border);
        color: var(--text-primary); width: 38px; height: 38px;
        border-radius: var(--radius-sm); cursor: pointer;
        display: flex; align-items: center; justify-content: center;
        transition: all 0.15s ease; -webkit-tap-highlight-color: transparent;
    }
    .zoom-btn:hover:not(:disabled) { background: var(--primary); color: white; }
    .zoom-btn:active:not(:disabled) { transform: scale(0.92); }
    .zoom-btn:disabled { opacity: 0.35; cursor: not-allowed; }

    .cosmic-slider {
        -webkit-appearance: slider-vertical;
        appearance: slider-vertical;
        writing-mode: bt-lr;
        width: 32px;
        height: 280px;
        background: transparent;
        cursor: pointer;
    }
    .cosmic-slider::-webkit-slider-thumb {
        -webkit-appearance: none; appearance: none;
        width: 22px; height: 22px; border-radius: 50%;
        background: var(--primary); border: 2px solid var(--bg-card);
        cursor: pointer; box-shadow: 0 2px 6px var(--shadow);
    }
    .cosmic-slider::-moz-range-thumb {
        width: 22px; height: 22px; border-radius: 50%;
        background: var(--primary); border: 2px solid var(--bg-card);
        cursor: pointer; box-shadow: 0 2px 6px var(--shadow);
    }

    .slider-tick-track {
        position: absolute; left: 50%; top: 62px; bottom: 62px;
        transform: translateX(-50%);
        display: flex; flex-direction: column-reverse; justify-content: space-between;
        pointer-events: none; width: 14px; align-items: center;
    }
    .slider-tick {
        width: 6px; height: 1px; background: var(--text-muted); opacity: 0.4;
    }
