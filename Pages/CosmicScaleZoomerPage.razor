                <circle cx='172' cy='124' r='0.6'/><circle cx='15' cy='140' r='0.5'/>
                <circle cx='65' cy='148' r='0.5'/><circle cx='110' cy='150' r='0.6'/>
                <circle cx='155' cy='144' r='0.5'/><circle cx='195' cy='148' r='0.7'/>
            </g>
            <g fill='#FFFFFF'>
                <circle cx='130' cy='34' r='0.8'>
                    <animate attributeName='opacity' values='0.3;1;0.3' dur='3.4s' repeatCount='indefinite'/>
                </circle>
                <circle cx='52' cy='98' r='0.8'>
