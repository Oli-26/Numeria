                <circle cx='10' cy='14' r='0.7'/><circle cx='42' cy='9' r='0.5'/>
                <circle cx='73' cy='22' r='0.6'/><circle cx='117' cy='6' r='0.7'/>
                <circle cx='158' cy='18' r='0.5'/><circle cx='189' cy='12' r='0.6'/>
                <circle cx='25' cy='44' r='0.5'/><circle cx='98' cy='38' r='0.7'/>
                <circle cx='148' cy='52' r='0.5'/><circle cx='180' cy='49' r='0.6'/>
                <circle cx='8' cy='75' r='0.6'/><circle cx='58' cy='82' r='0.5'/>
                <circle cx='192' cy='80' r='0.7'/><circle cx='35' cy='112' r='0.5'/>
