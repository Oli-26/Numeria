@page "/cosmic-scale"
@inject IProgressService Progress
@inject NavigationManager Nav
@inject IJSRuntime JS

@if (!unlocked)
{
    <div class="page-header">
        <button class="back-btn" aria-label="Back to home" @onclick='() => Nav.NavigateTo("/")'><Icon Name="arrow-left" Size="18" /></button>
        <h1>Cosmic Scale Zoomer</h1>
    </div>
    <div class="card" style="text-align: center; padding: 40px 24px">
        <Icon Name="lock" Size="40" Stroke="var(--text-muted)" />
        <h2 style="margin-top: 12px">Locked</h2>
        <p style="color: var(--text-secondary)">Purchase "Cosmic Scale Zoomer" from the Shop to unlock.</p>
        <button class="btn btn-accent" @onclick='() => Nav.NavigateTo("/shop")'>Go to Shop</button>
    </div>
}
else
{

<div class="page-header">
    <button class="back-btn" aria-label="Back to home" @onclick='() => Nav.NavigateTo("/")'><Icon Name="arrow-left" Size="18" /></button>
    <h1>Cosmic Scale Zoomer</h1>
</div>

<p class="cosmic-intro">Slide through 62 orders of magnitude, from the quantum foam to the entire observable universe.</p>


<div class="cosmic-stage">
    <div class="cosmic-zoom-controls">
        <button class="zoom-btn" aria-label="Zoom out" @onclick="ZoomOut" disabled="@(currentIndex == 0)">
            <Icon Name="chevron-up" Size="20" />
        </button>
        <input type="range"
               class="cosmic-slider"
               min="0"
               max="@(scales.Count - 1)"
               step="1"
               value="@currentIndex"
               @oninput="OnSliderInput" />
        <div class="slider-tick-track">
            @for (int i = 0; i < scales.Count; i++)
            {
                <div class="slider-tick @(i == currentIndex ? "tick-active" : "")"></div>
            }
        </div>
        <button class="zoom-btn" aria-label="Zoom in" @onclick="ZoomIn" disabled="@(currentIndex == scales.Count - 1)">
            <Icon Name="chevron-down" Size="20" />
        </button>
        <div class="cosmic-position">
            <Icon Name="target" Size="14" />
            <span>@(currentIndex + 1) / @scales.Count</span>
        </div>
    </div>

    <div class="cosmic-display card @RegimeClass">
        <div class="cosmic-readout-row">
            <div class="cosmic-magnitude">10<sup>@Cur.Exponent</sup> m</div>
            <div class="cosmic-mono-readout">EXP @Cur.Exponent.ToString("+00;-00")</div>
        </div>
        <div class="cosmic-name">@Cur.Name</div>
        <div class="cosmic-readable">@FormatMeters(Cur.Exponent)</div>

        <div class="cosmic-svg-frame" style="background: @Cur.BackgroundTint">
            <div class="cosmic-bg-layer">
                @((MarkupString)BackgroundForRegime(Cur.Exponent))
            </div>
            <div class="cosmic-scene-layer" @key="currentIndex">
                @((MarkupString)Cur.Svg)
            </div>
            <div class="cosmic-frame-chrome">
                <span class="chrome-corner tl"></span>
                <span class="chrome-corner tr"></span>
                <span class="chrome-corner bl"></span>
                <span class="chrome-corner br"></span>
                <span class="you-are-here">YOU ARE HERE</span>
            </div>
        </div>

        <div class="cosmic-log-axis">
            <div class="axis-line"></div>
            @for (int i = 0; i < scales.Count; i++)
            {
                var s = scales[i];
                var pct = (i / (double)(scales.Count - 1)) * 100.0;
                var major = (s.Exponent % 5 == 0);
                <div class="axis-tick @(major ? "axis-tick-major" : "") @(i == currentIndex ? "axis-tick-here" : "")"
                     style="left: @(pct.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture))%"></div>
            }
            <div class="axis-cursor" style="left: @AxisCursorPct%"></div>
            <div class="axis-label-left">10<sup>-35</sup></div>
            <div class="axis-label-right">10<sup>27</sup></div>
        </div>

        <div class="cosmic-description">@Cur.Description</div>

        <div class="cosmic-comparisons">
            @if (Prv != null)
            {
                var diff = Cur.Exponent - Prv.Exponent;
                <div class="comparison-line">
                    <Icon Name="chevron-up" Size="14" />
                    <span>About <strong>10<sup>@diff</sup></strong> times bigger than <em>@Prv.Name</em></span>
                </div>
            }
            @if (Nxt != null)
            {
                var diff = Nxt.Exponent - Cur.Exponent;
                <div class="comparison-line">
                    <Icon Name="chevron-down" Size="14" />
                    <span>About <strong>10<sup>@diff</sup></strong> times smaller than <em>@Nxt.Name</em></span>
                </div>
            }
        </div>
    </div>
</div>

<div class="cosmic-quick-jump">
    <h3><Icon Name="search" Size="16" /> Jump to a realm</h3>
    <div class="jump-grid">
        @foreach (var jump in jumpPoints)
        {
            var idx = jump.Item2;
            <button class="jump-chip @(currentIndex == idx ? "jump-active" : "")" @onclick="() => JumpTo(idx)">
                @jump.Item1
            </button>
        }
    </div>
</div>

}

@code {
    private bool unlocked;
    private int currentIndex = 17;

    private Scale Cur => scales[currentIndex];
    private Scale? Prv => currentIndex > 0 ? scales[currentIndex - 1] : null;
    private Scale? Nxt => currentIndex < scales.Count - 1 ? scales[currentIndex + 1] : null;

    private string AxisCursorPct =>
        ((currentIndex / (double)(scales.Count - 1)) * 100.0)
            .ToString("0.##", System.Globalization.CultureInfo.InvariantCulture);

    private string RegimeClass
    {
        get
        {
            var e = Cur.Exponent;
            if (e <= -16) return "regime-subatomic";
            if (e <= -7) return "regime-molecular";
            if (e <= -2) return "regime-micro";
            if (e <= 4) return "regime-human";
            if (e <= 9) return "regime-planetary";
            if (e <= 15) return "regime-stellar";
            return "regime-cosmic";
        }
    }

    private static string BackgroundForRegime(int e)
    {
        if (e <= -16) return HexGridBg();
        if (e <= -7) return HexGridBg();
        if (e <= 4) return SkyHazeBg();
        if (e <= 9) return SkyHazeBg();
        return StarfieldBg();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            var profile = await Progress.GetProfileAsync();
            unlocked = true;
            StateHasChanged();
        }
    }

    private void OnSliderInput(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out var v))
        {
            currentIndex = Math.Clamp(v, 0, scales.Count - 1);
        }
    }

    private void ZoomIn() { if (currentIndex < scales.Count - 1) currentIndex++; }
    private void ZoomOut() { if (currentIndex > 0) currentIndex--; }
    private void JumpTo(int idx) { currentIndex = Math.Clamp(idx, 0, scales.Count - 1); }

    private static string FormatMeters(int exp)
    {
        if (exp >= -3 && exp <= 3)
        {
            var v = Math.Pow(10, exp);
            return v >= 1 ? $"{v:0.###} m" : $"{v * 1000:0.###} mm";
        }
        if (exp <= -9 && exp >= -12) return $"{Math.Pow(10, exp + 12):0.###} pm";
        if (exp <= -6 && exp >= -8) return $"{Math.Pow(10, exp + 9):0.###} nm";
        if (exp <= -4 && exp >= -5) return $"{Math.Pow(10, exp + 6):0.###} um";
        if (exp >= 4 && exp <= 6) return $"{Math.Pow(10, exp - 3):0.###} km";
        if (exp >= 16 && exp <= 22) return $"{Math.Pow(10, exp - 16) / 9.461:0.###} light years";
        return $"10^{exp} m";
    }

    private record Scale(int Exponent, string Name, string Description, string BackgroundTint, string Svg);

    private List<(string, int)> jumpPoints => new()
    {
        ("Quantum", 0),
        ("Atomic", 5),
        ("Cellular", 11),
        ("Human", 17),
        ("Planetary", 23),
        ("Stellar", 26),
        ("Galactic", 30),
        ("Universe", 33)
    };

    private readonly List<Scale> scales = new()
    {
        new Scale(-35, "Planck Length",
            "The smallest meaningful length in physics. Below this scale, our notion of space-time itself breaks down. Quantum gravity is required to even ask what 'distance' means here.",
            "linear-gradient(135deg, #1a0033 0%, #0a0018 100%)",
            QuantumFoamSvg("#7C4DFF")),

        new Scale(-30, "Quantum Foam",
            "A theoretical region where space-time bubbles in and out of existence due to quantum fluctuations. Virtual particles wink in and out faster than light could cross the bubble.",
            "linear-gradient(135deg, #220055 0%, #0d002a 100%)",
            QuantumFoamSvg("#9966FF")),

        new Scale(-22, "Neutrino Reach",
            "The effective interaction range of a neutrino. About 100 trillion neutrinos pass through your thumbnail every second from the Sun, and almost none of them notice you exist.",
            "linear-gradient(135deg, #001a33 0%, #00081a 100%)",
            NeutrinoSvg()),

        new Scale(-18, "Quark / Electron",
            "The fundamental constituents of matter, with no known internal structure. Quarks are forever trapped inside protons and neutrons by the strong force.",
            "linear-gradient(135deg, #002244 0%, #000a1a 100%)",
            ElectronCloudSvg()),

        new Scale(-15, "Proton",
            "The positively charged heart of every atom. Made of three quarks bound together by gluons. Almost all the mass of ordinary matter lives here.",
            "linear-gradient(135deg, #220033 0%, #0a000f 100%)",
            ProtonSvg()),

        new Scale(-14, "Atomic Nucleus",
            "The dense bundle of protons and neutrons at an atom's centre. If an atom were a football stadium, the nucleus would be a marble at the centre circle.",
            "linear-gradient(135deg, #330044 0%, #110018 100%)",
            NucleusSvg()),

        new Scale(-11, "Hydrogen Atom",
            "The simplest, most abundant atom in the universe. One proton and one electron in a probabilistic cloud. Roughly three out of every four atoms in existence are hydrogen.",
            "linear-gradient(135deg, #003355 0%, #001125 100%)",
            AtomSvg("#4FC3F7")),

        new Scale(-10, "Atom",
            "The classical 'building block' of chemistry. Mostly empty space - electrons buzz in shells around a tiny dense nucleus.",
            "linear-gradient(135deg, #003355 0%, #001125 100%)",
            AtomSvg("#81D4FA")),

        new Scale(-9, "DNA Helix Width",
            "The double helix of deoxyribonucleic acid - the chemical alphabet of life. Just two nanometres wide, but stretches to two metres if uncoiled inside one of your cells.",
            "linear-gradient(135deg, #003322 0%, #00120b 100%)",
            DnaSvg()),

        new Scale(-8, "Virus",
            "Tiny biological packages of genetic material in a protein shell. Not quite alive, not quite dead - they hijack living cells to copy themselves.",
            "linear-gradient(135deg, #332200 0%, #120c00 100%)",
            VirusSvg()),

        new Scale(-7, "Bacterium",
            "Single-celled organisms that outnumber every other life form on Earth. There are more bacteria in your gut than human cells in your body.",
            "linear-gradient(135deg, #223300 0%, #0c1200 100%)",
            BacteriumSvg()),

        new Scale(-5, "Animal Cell",
            "The basic unit of complex life - a tiny self-contained factory with a nucleus, mitochondria, and a few hundred other moving parts. You are made of about 30 trillion of these.",
            "linear-gradient(135deg, #332244 0%, #110d18 100%)",
            CellSvg()),

        new Scale(-4, "Grain of Salt",
            "About a quarter of a millimetre across - small enough to dissolve instantly, large enough to crunch between your teeth. Each grain is a near-perfect cubic crystal.",
            "linear-gradient(135deg, #222244 0%, #0c0c1c 100%)",
            CubeSvg("#E0E0E0")),

        new Scale(-3, "Ant",
            "A few millimetres long but able to lift fifty times its own weight. Ants form colonies that behave like a single super-organism.",
            "linear-gradient(135deg, #4a3318 0%, #1a1108 100%)",
            AntSvg()),

        new Scale(-2, "Coin",
            "A few centimetres across - the comfortable size of human-made tokens for trade. Most coins in history have hovered around this size for ergonomic reasons.",
            "linear-gradient(135deg, #332211 0%, #120a05 100%)",
            CoinSvg()),

        new Scale(-1, "Cat",
            "About a tenth of a metre at the shoulder for a small cat. Domestic cats have changed shape remarkably little in 10,000 years of living with humans.",
            "linear-gradient(135deg, #4a3a20 0%, #1a1408 100%)",
            CatSvg()),

        new Scale(0, "Toddler",
            "One metre tall - a small child. The metre was originally defined as one ten-millionth of the distance from the equator to the North Pole.",
            "linear-gradient(180deg, #67a8d8 0%, #2c5577 100%)",
            FigureSvg(0.6)),

        new Scale(1, "Adult Human",
            "Around 1.7 metres tall on average. You are roughly halfway in scale between an atom and a star, geometrically speaking.",
            "linear-gradient(180deg, #67a8d8 0%, #2c5577 100%)",
            FigureSvg(1.0)),

        new Scale(2, "Blue Whale",
            "Up to 30 metres long and 200 tonnes - the largest animal ever to have lived on Earth. Its tongue alone weighs as much as an elephant.",
            "linear-gradient(180deg, #2e6790 0%, #0a2238 100%)",
            WhaleSvg()),

        new Scale(3, "Eiffel Tower",
            "330 metres tall - taller than any building had ever been when it was finished in 1889. Made of 18,000 wrought iron pieces and 2.5 million rivets.",
            "linear-gradient(180deg, #d8a878 0%, #5e3018 100%)",
            TowerSvg()),

        new Scale(4, "Mount Everest Height",
            "8,849 metres above sea level - the highest point on Earth's surface. It still grows a few millimetres per year as the Indian plate pushes north.",
            "linear-gradient(180deg, #8a9bb5 0%, #2a3a5a 100%)",
            MountainSvg()),

        new Scale(5, "Large City",
            "A hundred kilometres across - the size of a major metropolitan region like Greater London or Tokyo. Visible as a glow from low Earth orbit at night.",
            "linear-gradient(180deg, #1a2855 0%, #050a1a 100%)",
            CitySvg()),

        new Scale(6, "Small Country",
            "A thousand kilometres - roughly the length of Britain or Italy. About the distance light travels in 1/300th of a second.",
            "linear-gradient(180deg, #112844 0%, #050a18 100%)",
            CountrySvg()),

        new Scale(7, "Earth's Diameter",
            "Earth is about 12,742 km across. A jet airliner takes around 17 hours to fly from pole to pole. The crust we live on is just 0.5% of that diameter thick.",
            "radial-gradient(circle at 50% 50%, #001a33 0%, #00050f 100%)",
            EarthSvg()),

        new Scale(8, "Earth-Moon Distance",
            "The Moon orbits an average of 384,400 km away - about 30 Earth-diameters. Light takes 1.3 seconds to make the trip.",
            "radial-gradient(circle at 30% 50%, #001533 0%, #000008 100%)",
            EarthMoonSvg()),

        new Scale(9, "Sun's Diameter",
            "The Sun is 1.39 million km across - 109 times wider than Earth. You could fit about 1.3 million Earths inside it.",
            "radial-gradient(circle at 50% 50%, #4a2a00 0%, #150800 100%)",
            SunSvg()),

        new Scale(11, "Earth-Sun Distance (1 AU)",
            "One Astronomical Unit: 149.6 million kilometres. Light from the Sun takes 8 minutes and 20 seconds to reach you.",
            "radial-gradient(circle at 30% 50%, #221100 0%, #050300 100%)",
            OrbitSvg()),

        new Scale(13, "Outer Solar System",
            "Out past Neptune, around 30 AU from the Sun. The Voyager 1 probe took 35 years to cross this distance and is still our farthest ambassador.",
            "radial-gradient(circle at 50% 50%, #00112e 0%, #000005 100%)",
            SolarSystemSvg()),

        new Scale(15, "Oort Cloud",
            "A vast spherical shell of icy bodies thought to surround the solar system out to about 100,000 AU. The home of long-period comets.",
            "radial-gradient(circle at 50% 50%, #050822 0%, #000003 100%)",
            OortCloudSvg()),

        new Scale(16, "One Light Year",
            "The distance light travels in a year - about 9.46 trillion kilometres. The nearest star, Proxima Centauri, is 4.24 of these away.",
            "radial-gradient(circle at 50% 50%, #000a33 0%, #000002 100%)",
            StarFieldSvg(false)),

        new Scale(18, "Stellar Neighbourhood",
            "The closest few hundred stars to the Sun, spanning about a hundred light years. Most are dim red dwarfs you cannot see without a telescope.",
            "radial-gradient(circle at 50% 50%, #00114a 0%, #000003 100%)",
            StarFieldSvg(true)),

        new Scale(21, "Milky Way Galaxy",
            "Our home galaxy: a barred spiral 100,000 light years across, containing 200-400 billion stars. The Sun orbits the galactic centre once every 230 million years.",
            "radial-gradient(circle at 50% 50%, #1a0033 0%, #050010 100%)",
            GalaxySvg()),

        new Scale(23, "Local Group",
            "A loose cluster of about 80 galaxies including the Milky Way, Andromeda and Triangulum. Andromeda is heading towards us at 110 km/s and will collide in 4.5 billion years.",
            "radial-gradient(circle at 50% 50%, #240044 0%, #08001a 100%)",
            GalaxyClusterSvg()),

        new Scale(25, "Virgo Supercluster",
            "A vast structure of about 100 galaxy groups spanning 110 million light years. It is itself just a lobe of the much larger Laniakea Supercluster.",
            "radial-gradient(circle at 50% 50%, #330055 0%, #0a0018 100%)",
            SuperclusterSvg()),

        new Scale(27, "Observable Universe",
            "About 93 billion light years across - all that we can ever see. Beyond this horizon, light has not had time to reach us since the Big Bang 13.8 billion years ago.",
            "radial-gradient(circle at 50% 50%, #000022 0%, #000000 100%)",
            UniverseSvg())
    };

    private static string HexGridBg() =>
        @"<svg viewBox='0 0 200 160' xmlns='http://www.w3.org/2000/svg' preserveAspectRatio='xMidYMid slice'>
            <defs>
                <pattern id='hexbg' x='0' y='0' width='24' height='21' patternUnits='userSpaceOnUse'>
                    <path d='M12 0 L24 7 L24 14 L12 21 L0 14 L0 7 Z' fill='none' stroke='#ffffff' stroke-width='0.4' opacity='0.12'/>
                </pattern>
            </defs>
            <rect width='200' height='160' fill='url(#hexbg)'/>
        </svg>";

    private static string SkyHazeBg() =>
        @"<svg viewBox='0 0 200 160' xmlns='http://www.w3.org/2000/svg' preserveAspectRatio='xMidYMid slice'>
            <defs>
                <linearGradient id='haze' x1='0' y1='0' x2='0' y2='1'>
                    <stop offset='0%' stop-color='#ffffff' stop-opacity='0.22'/>
                    <stop offset='40%' stop-color='#ffffff' stop-opacity='0.07'/>
                    <stop offset='100%' stop-color='#ffffff' stop-opacity='0'/>
                </linearGradient>
            </defs>
            <rect width='200' height='160' fill='url(#haze)'/>
        </svg>";

    private static string StarfieldBg() =>
        @"<svg viewBox='0 0 200 160' xmlns='http://www.w3.org/2000/svg' preserveAspectRatio='xMidYMid slice'>
