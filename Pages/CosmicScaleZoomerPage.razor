            </g>
        </svg>";

    private static string ElectronCloudSvg() =>
        @"<svg viewBox='0 0 200 160' xmlns='http://www.w3.org/2000/svg'>
            <defs>
                <radialGradient id='ecCloud'>
                    <stop offset='0%' stop-color='#4FC3F7' stop-opacity='0.55'/>
