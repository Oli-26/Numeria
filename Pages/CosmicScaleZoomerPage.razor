    private static string FigureSvg(double scale)
    {
        var h = (int)(70 * scale);
        var headR = (int)(8 * scale);
        var topY = 80 - h / 2;
        var headCY = topY + headR;
        var bodyTop = headCY + headR;
        var bodyBot = bodyTop + (int)(30 * scale);
        var armY = bodyTop + (int)(8 * scale);
        var groundY = bodyBot + (int)(15 * scale) + 4;
        return $@"<svg viewBox='0 0 200 160' xmlns='http://www.w3.org/2000/svg'>
