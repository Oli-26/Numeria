}

@code {
    private bool unlocked;
    private string cellType = "animal";
    private string? selected;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            var profile = await Progress.GetProfileAsync();
            unlocked = true;
            StateHasChanged();
        }
    }

    private void SwitchCell(string ct)
    {
        cellType = ct;
        selected = null;
    }

    private void Select(string id)
    {
        selected = selected == id ? null : id;
    }

    private bool IsActive(string id) => selected == id;

    private record OrganelleInfo(string Name, string ShortLabel, string Function, string FunFact, string[] FoundIn, string Related);

    private static readonly Dictionary<string, OrganelleInfo> organelles = new()
    {
        // Animal
        ["nucleus"] = new("Nucleus", "Cell control centre",
            "Stores the cell's DNA and directs all activity by controlling which genes are expressed. Surrounded by a double membrane with pores.",
            "If you stretched the DNA from one human nucleus end to end, it would be roughly 2 metres long -- packed inside a sphere about 6 micrometres across.",
            new[] { "Animal", "Plant" },
            "Transcription, DNA replication, mRNA export"),

        ["nucleolus"] = new("Nucleolus", "Ribosome factory",
            "A dense region inside the nucleus where ribosomal RNA is transcribed and ribosome subunits are assembled.",
            "It isn't bound by a membrane -- it's just a really crowded neighbourhood inside the nucleus where rRNA work happens.",
            new[] { "Animal", "Plant" },
            "rRNA synthesis, ribosome biogenesis"),

        ["mitochondrion-animal"] = new("Mitochondrion", "Powerhouse of the cell",
            "Generates most of the cell's ATP through aerobic respiration. Has a folded inner membrane (cristae) that increases surface area for energy production.",
            "Mitochondria carry their own circular DNA and were almost certainly free-living bacteria swallowed by an ancestor cell about 1.5 billion years ago.",
            new[] { "Animal", "Plant" },
            "ATP synthesis, citric acid cycle, oxidative phosphorylation"),

        ["ribosome-animal"] = new("Ribosomes", "Protein assemblers",
            "Tiny molecular machines that read messenger RNA and link amino acids together to build proteins.",
            "A single growing cell can contain millions of ribosomes -- each one builds a protein at roughly 20 amino acids per second.",
            new[] { "Animal", "Plant", "Bacteria" },
            "Translation, protein synthesis"),

        ["rough-er"] = new("Rough Endoplasmic Reticulum", "Protein highway",
            "A network of membrane sheets studded with ribosomes. Folds and modifies proteins destined for export or for membranes.",
            "It's called 'rough' purely because the attached ribosomes make it look bumpy under an electron microscope.",
            new[] { "Animal", "Plant" },
            "Protein folding, glycosylation, quality control"),

        ["smooth-er"] = new("Smooth Endoplasmic Reticulum", "Lipid lab",
            "Membrane network without ribosomes. Synthesises lipids and steroids, detoxifies drugs, and stores calcium.",
            "Liver cells are crammed with smooth ER because so much of their job is breaking down toxins like alcohol.",
            new[] { "Animal", "Plant" },
            "Lipid synthesis, detoxification, calcium storage"),

        ["golgi-animal"] = new("Golgi Apparatus", "Packaging and dispatch",
            "Modifies, sorts, and packages proteins and lipids from the ER into vesicles for delivery elsewhere in the cell or for secretion.",
            "Discovered in 1898 by Camillo Golgi using a silver stain. For decades many scientists thought it was a staining artefact.",
            new[] { "Animal", "Plant" },
            "Protein sorting, glycosylation, vesicle transport"),

        ["lysosome"] = new("Lysosome", "Recycling crew",
