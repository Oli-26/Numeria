            new[] { "Animal", "Plant", "Bacteria" },
            "Glycolysis, protein synthesis on free ribosomes, transport"),

        ["plasma-membrane-animal"] = new("Plasma Membrane", "Selective barrier",
            "Phospholipid bilayer studded with proteins. Controls what enters and leaves the cell and lets it sense its surroundings.",
            "It's only about 8 nanometers thick, around 10,000 times thinner than a sheet of paper.",
