@page "/cell-tour"
@inject IProgressService Progress
@inject IJSRuntime JS
@inject NavigationManager Nav

@if (!unlocked)
{
    <div class="page-header">
        <button class="back-btn" aria-label="Back to home" @onclick='() => Nav.NavigateTo("/")'><Icon Name="arrow-left" Size="18" /></button>
        <h1>Cell Tour</h1>
    </div>
    <div class="card" style="text-align: center; padding: 40px 24px">
        <Icon Name="lock" Size="40" Stroke="var(--text-muted)" />
        <h2 style="margin-top: 12px">Locked</h2>
        <p style="color: var(--text-secondary)">Purchase "Cell Tour" from the Shop to unlock.</p>
        <button class="btn btn-accent" @onclick='() => Nav.NavigateTo("/shop")'>Go to Shop</button>
    </div>
}
else
{
    <div class="page-header">
        <button class="back-btn" aria-label="Back to home" @onclick='() => Nav.NavigateTo("/")'><Icon Name="arrow-left" Size="18" /></button>
        <h1>Cell Tour</h1>
    </div>

    <p class="ct-intro"><Icon Name="target" Size="14" Stroke="var(--accent)" /> Tap any organelle to learn its job.</p>

    <div class="ct-tabs">
        <button class="tab @(cellType == "animal" ? "active" : "")" @onclick='() => SwitchCell("animal")'>Animal Cell</button>
        <button class="tab @(cellType == "plant" ? "active" : "")" @onclick='() => SwitchCell("plant")'>Plant Cell</button>
        <button class="tab @(cellType == "bacteria" ? "active" : "")" @onclick='() => SwitchCell("bacteria")'>Bacteria (Prokaryote)</button>
    </div>

    <div class="ct-stage card">
        @if (cellType == "animal")
        {
            <svg viewBox="0 0 400 320" class="ct-svg" preserveAspectRatio="xMidYMid meet" xmlns="http://www.w3.org/2000/svg">
                <defs>
                    <radialGradient id="animalBg" cx="45%" cy="40%" r="70%">
                        <stop offset="0%" stop-color="#FFF4F8" />
                        <stop offset="55%" stop-color="#FBD9E3" />
                        <stop offset="100%" stop-color="#E9A8BD" />
                    </radialGradient>
                    <radialGradient id="nucleusGrad" cx="40%" cy="35%" r="80%">
                        <stop offset="0%" stop-color="#B79CD9" />
                        <stop offset="60%" stop-color="#7B5EA7" />
                        <stop offset="100%" stop-color="#3F2D60" />
                    </radialGradient>
                    <radialGradient id="nucleolusGrad" cx="40%" cy="35%" r="70%">
                        <stop offset="0%" stop-color="#6E4E94" />
                        <stop offset="100%" stop-color="#1F1330" />
                    </radialGradient>
                    <radialGradient id="mitoGrad" cx="40%" cy="40%" r="70%">
                        <stop offset="0%" stop-color="#FFB1A8" />
                        <stop offset="55%" stop-color="#E36B6B" />
                        <stop offset="100%" stop-color="#702020" />
                    </radialGradient>
                    <radialGradient id="lysoGrad" cx="40%" cy="35%" r="70%">
                        <stop offset="0%" stop-color="#FFE69A" />
                        <stop offset="60%" stop-color="#F2C548" />
                        <stop offset="100%" stop-color="#7E5F12" />
                    </radialGradient>
                    <radialGradient id="peroxGrad" cx="40%" cy="35%" r="70%">
                        <stop offset="0%" stop-color="#D7F0AC" />
                        <stop offset="60%" stop-color="#A8D26A" />
                        <stop offset="100%" stop-color="#3D5F18" />
                    </radialGradient>
                    <linearGradient id="erRoughGrad" x1="0%" y1="0%" x2="0%" y2="100%">
                        <stop offset="0%" stop-color="#F4B27D" />
                        <stop offset="100%" stop-color="#C26A2A" />
                    </linearGradient>
                    <linearGradient id="erSmoothGrad" x1="0%" y1="0%" x2="0%" y2="100%">
                        <stop offset="0%" stop-color="#FBD49C" />
                        <stop offset="100%" stop-color="#D89438" />
                    </linearGradient>
                    <linearGradient id="golgiGrad" x1="0%" y1="0%" x2="0%" y2="100%">
                        <stop offset="0%" stop-color="#7DD0E2" />
                        <stop offset="100%" stop-color="#2D7E94" />
                    </linearGradient>
                    <radialGradient id="centroGrad" cx="50%" cy="50%" r="70%">
                        <stop offset="0%" stop-color="#A2B8E6" />
                        <stop offset="100%" stop-color="#314B86" />
                    </radialGradient>
                    <filter id="ctShadow" x="-30%" y="-30%" width="160%" height="160%">
                        <feGaussianBlur in="SourceAlpha" stdDeviation="1.5" />
                        <feOffset dx="0.5" dy="1" result="off" />
                        <feComponentTransfer><feFuncA type="linear" slope="0.45" /></feComponentTransfer>
                        <feMerge><feMergeNode /><feMergeNode in="SourceGraphic" /></feMerge>
                    </filter>
                    <filter id="ctSoft" x="-20%" y="-20%" width="140%" height="140%">
                        <feGaussianBlur stdDeviation="0.6" />
                    </filter>
                    <pattern id="cytoNoise" x="0" y="0" width="40" height="40" patternUnits="userSpaceOnUse">
                        <circle cx="6" cy="9" r="0.7" fill="#C97B95" opacity="0.25" />
                        <circle cx="22" cy="14" r="0.5" fill="#A85A78" opacity="0.22" />
                        <circle cx="34" cy="6" r="0.6" fill="#C97B95" opacity="0.18" />
                        <circle cx="14" cy="28" r="0.6" fill="#A85A78" opacity="0.22" />
                        <circle cx="30" cy="32" r="0.7" fill="#C97B95" opacity="0.25" />
                    </pattern>
                    <clipPath id="animalClip">
                        <path d="M 200 18 C 320 16 388 84 388 160 C 388 250 312 304 200 304 C 92 304 12 248 12 160 C 12 80 84 20 200 18 Z" />
                    </clipPath>
                </defs>

                <g class="ct-organelle @(IsActive("plasma-membrane-animal") ? "ct-active" : "")"
                   @onclick='() => Select("plasma-membrane-animal")'>
                    <path d="M 200 18 C 320 16 388 84 388 160 C 388 250 312 304 200 304 C 92 304 12 248 12 160 C 12 80 84 20 200 18 Z"
                          fill="url(#animalBg)" stroke="#B66987" stroke-width="3" filter="url(#ctShadow)" />
                    <path d="M 200 22 C 318 20 384 86 384 160 C 384 248 310 300 200 300 C 94 300 16 246 16 160 C 16 82 86 24 200 22 Z"
                          fill="none" stroke="#E9B6C5" stroke-width="1" stroke-dasharray="2,2" opacity="0.7" />
                </g>

                <rect x="12" y="18" width="376" height="286" fill="url(#cytoNoise)" clip-path="url(#animalClip)" pointer-events="none" />

                <g class="ct-organelle @(IsActive("cytoskeleton") ? "ct-active" : "")"
                   @onclick='() => Select("cytoskeleton")' clip-path="url(#animalClip)">
                    <path d="M 30 110 Q 150 130 270 100 T 380 220" fill="none" stroke="#9D8DF1" stroke-width="0.9" opacity="0.55" />
                    <path d="M 40 240 Q 160 200 250 250 T 370 130" fill="none" stroke="#9D8DF1" stroke-width="0.9" opacity="0.55" />
                    <path d="M 120 50 Q 200 160 130 280" fill="none" stroke="#B5A6FF" stroke-width="0.8" opacity="0.45" />
                    <path d="M 280 40 Q 240 170 320 290" fill="none" stroke="#B5A6FF" stroke-width="0.8" opacity="0.45" />
                    <path d="M 60 180 Q 200 175 350 180" fill="none" stroke="#9D8DF1" stroke-width="0.7" opacity="0.4" stroke-dasharray="2,3" />
                </g>

                <g class="ct-organelle @(IsActive("nucleus") ? "ct-active" : "")"
                   @onclick='() => Select("nucleus")'>
                    <path d="M 180 92 C 222 90 240 116 238 152 C 240 188 220 212 178 210 C 138 212 120 184 122 150 C 120 116 142 94 180 92 Z"
                          fill="url(#nucleusGrad)" stroke="#3F2D60" stroke-width="2" filter="url(#ctShadow)" />
                    <path d="M 180 96 C 220 94 236 118 234 152 C 236 184 218 208 178 206 C 142 208 124 182 126 150 C 124 118 144 98 180 96 Z"
                          fill="none" stroke="#5A4280" stroke-width="0.8" opacity="0.7" />
                    <circle cx="138" cy="120" r="2" fill="#2A1B45" />
                    <circle cx="222" cy="118" r="2" fill="#2A1B45" />
                    <circle cx="232" cy="170" r="2" fill="#2A1B45" />
                    <circle cx="180" cy="208" r="2" fill="#2A1B45" />
                    <circle cx="126" cy="172" r="2" fill="#2A1B45" />
                    <circle cx="200" cy="96" r="2" fill="#2A1B45" />
                    <circle cx="158" cy="96" r="1.6" fill="#2A1B45" />
                    <circle cx="160" cy="140" r="1.2" fill="#5A4280" opacity="0.6" />
                    <circle cx="200" cy="160" r="1.2" fill="#5A4280" opacity="0.6" />
                    <circle cx="170" cy="180" r="1.2" fill="#5A4280" opacity="0.6" />
                </g>
                <g class="ct-organelle @(IsActive("nucleolus") ? "ct-active" : "")"
                   @onclick='() => Select("nucleolus")'>
                    <circle cx="190" cy="155" r="14" fill="url(#nucleolusGrad)" stroke="#1F1430" stroke-width="1.5" />
                    <circle cx="186" cy="151" r="3" fill="#9678BC" opacity="0.5" />
                </g>

                <g class="ct-organelle @(IsActive("rough-er") ? "ct-active" : "")"
                   @onclick='() => Select("rough-er")'>
