            new[] { "Bacteria" },
            "Adhesion, conjugation, twitching motility"),
    };
}

<style>
    .ct-toolbar {
        display: flex; align-items: center; justify-content: space-between; gap: 8px;
        margin: 0 0 12px;
    }
    .ct-intro {
        display: flex; align-items: center; gap: 6px;
        color: var(--text-secondary); font-size: 0.88rem;
        margin: 0;
    }
    .ct-quiz-btn {
        display: inline-flex; align-items: center; gap: 4px; flex-shrink: 0;
        padding: 5px 10px; border: 1px solid var(--border); border-radius: 14px;
        background: var(--bg-card); color: var(--text-secondary);
        font-size: 0.78rem; font-weight: 600; cursor: pointer;
        -webkit-tap-highlight-color: transparent;
    }
    .ct-quiz-btn.active { background: var(--primary); border-color: var(--primary); color: white; }

    .ct-quiz { padding: 10px 14px; margin-bottom: 14px; }
    .ct-quiz-row { display: flex; align-items: center; gap: 10px; }
    .ct-quiz-prompt { flex: 1; min-width: 0; }
    .ct-quiz-prompt small { display: block; color: var(--text-muted); font-size: 0.72rem; text-transform: uppercase; letter-spacing: 0.5px; }
    .ct-quiz-prompt strong { color: var(--text-primary); font-size: 1rem; }
    .ct-quiz-score { color: var(--text-muted); font-size: 0.75rem; text-align: right; }
    .ct-quiz-skip {
        padding: 5px 10px; border: 1px solid var(--border); border-radius: var(--radius-sm);
        background: var(--bg-surface); color: var(--text-secondary);
        font-size: 0.78rem; font-weight: 600; cursor: pointer;
    }
    .ct-quiz-feedback { margin: 8px 0 0; font-size: 0.85rem; font-weight: 600; }
    .ct-quiz-ok { color: var(--success); }
    .ct-quiz-miss { color: var(--accent); }

    .ct-tabs {
        display: flex; gap: 4px; background: var(--bg-surface); border-radius: var(--radius-md);
        padding: 4px; margin-bottom: 14px;
    }
    .tab {
        flex: 1; padding: 8px 6px; border: none; background: transparent; color: var(--text-muted);
        font-weight: 600; font-size: 0.78rem; border-radius: var(--radius-sm); cursor: pointer;
        transition: all 0.2s ease; -webkit-tap-highlight-color: transparent;
    }
    .tab.active { background: var(--bg-card); color: var(--primary); box-shadow: 0 1px 4px var(--shadow); }

    .ct-stage {
        padding: 10px;
        margin-bottom: 14px;
        background: var(--bg-card);
        border-radius: var(--radius-md);
    }
    .ct-svg {
        width: 100%; height: auto; display: block; max-height: 60vh;
        border-radius: var(--radius-sm);
        background: var(--bg-surface);
    }

    .ct-organelle {
        cursor: pointer;
        transition: filter 0.25s ease, opacity 0.25s ease, transform 0.25s ease;
        transform-box: fill-box;
        transform-origin: center;
        -webkit-tap-highlight-color: transparent;
    }
    .ct-organelle:hover { filter: brightness(1.08); }
    .ct-organelle:focus { outline: none; }
    .ct-organelle:focus-visible { filter: drop-shadow(0 0 2px var(--primary)) drop-shadow(0 0 2px var(--primary)); }
    .ct-organelle.ct-active {
        filter: drop-shadow(0 0 3px var(--accent)) brightness(1.05);
    }
    .ct-organelle.ct-active line:not(.ct-hit),
    .ct-organelle.ct-active path:not(.ct-hit),
    .ct-organelle.ct-active rect:not(.ct-hit),
    .ct-organelle.ct-active circle:not(.ct-hit),
    .ct-organelle.ct-active ellipse:not(.ct-hit) {
        stroke-width: 2.4;
    }

    .ct-panel {
        padding: 14px 16px;
        animation: ctSlideUp 0.25s ease;
    }
    .ct-panel-head {
        display: flex; justify-content: space-between; align-items: flex-start;
        gap: 10px; margin-bottom: 10px;
        padding-bottom: 8px; border-bottom: 1px solid var(--border);
    }
    .ct-panel-head h3 {
        margin: 0; font-size: 1.05rem; color: var(--text-primary);
    }
    .ct-panel-head small {
        color: var(--text-muted); font-size: 0.78rem; font-style: italic;
    }
    .ct-close {
        background: var(--bg-surface); border: 1px solid var(--border);
        border-radius: var(--radius-sm);
        width: 32px; height: 32px;
        display: flex; align-items: center; justify-content: center;
        color: var(--text-secondary); cursor: pointer;
        flex-shrink: 0;
        -webkit-tap-highlight-color: transparent;
    }
    .ct-close:active { transform: scale(0.94); }

    .ct-section { margin-bottom: 10px; }
    .ct-section h4 {
        display: flex; align-items: center; gap: 6px;
        font-size: 0.75rem; color: var(--text-muted);
        text-transform: uppercase; letter-spacing: 0.5px;
        margin: 0 0 4px;
    }
    .ct-section p {
        margin: 0; font-size: 0.86rem; color: var(--text-secondary); line-height: 1.55;
    }
    .ct-related {
        font-style: italic;
        color: var(--text-secondary);
    }

    .ct-chips { display: flex; gap: 6px; flex-wrap: wrap; margin-top: 4px; }
    .ct-chip {
        padding: 3px 10px; border-radius: 12px; font-size: 0.75rem; font-weight: 600;
        border: 1px solid var(--border);
    }
    .ct-chip-on {
        background: color-mix(in srgb, var(--success) 12%, transparent);
        color: var(--success);
        border-color: var(--success);
    }
    .ct-chip-off {
        background: var(--bg-surface);
        color: var(--text-muted);
        opacity: 0.6;
    }

    .ct-hint {
        display: flex; align-items: center; gap: 8px; justify-content: center;
        padding: 14px; color: var(--text-muted); font-size: 0.85rem;
        background: var(--bg-surface);
        border: 1px dashed var(--border);
        border-radius: var(--radius-md);
    }

    @@keyframes ctSlideUp {
        from { opacity: 0; transform: translateY(8px); }
        to   { opacity: 1; transform: translateY(0); }
    }
    @@media (prefers-reduced-motion: reduce) {
        .ct-organelle, .ct-panel { transition: none; animation: none; }
    }
</style>
