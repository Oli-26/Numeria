@if (selected != null && organelles.ContainsKey(selected))
{
    var info = organelles[selected];
    <div class="ct-panel card">
        <div class="ct-panel-head">
            <div>
                <h3>@info.Name</h3>
                <small>@info.ShortLabel</small>
            </div>
            <button class="ct-close" aria-label="Close panel" @onclick="() => selected = null"><Icon Name="x-mark" Size="18" /></button>
        </div>

        <div class="ct-section">
            <h4><Icon Name="brain" Size="14" Stroke="var(--primary)" /> Function</h4>
            <p>@info.Function</p>
        </div>

        <div class="ct-section">
            <h4><Icon Name="search" Size="14" Stroke="var(--accent)" /> Fun Fact</h4>
            <p>@info.FunFact</p>
        </div>

        <div class="ct-section">
            <h4>Found in</h4>
            <div class="ct-chips">
                @foreach (var ct in new[] { "Animal", "Plant", "Bacteria" })
                {
                    var present = info.FoundIn.Contains(ct);
                    <span class="ct-chip @(present ? "ct-chip-on" : "ct-chip-off")">@ct</span>
                }
            </div>
        </div>

        <div class="ct-section">
            <h4>Related processes</h4>
            <p class="ct-related">@info.Related</p>
        </div>
    </div>
}
else
{
    <div class="ct-hint">
        <Icon Name="target" Size="16" Stroke="var(--text-muted)" />
        <span>Select an organelle from the diagram above.</span>
    </div>
}

@code {
    private string cellType = "animal";
    private string? selected;

    private string? quizTarget;
    private int quizScore;
    private int quizMisses;
    private string? quizFeedback;
    private bool quizCorrect;

    private static readonly Dictionary<string, string[]> cellParts = new()
    {
        ["animal"] = new[] { "cytoplasm", "plasma-membrane-animal", "cytoskeleton", "nucleus", "nucleolus", "rough-er", "smooth-er",
            "golgi-animal", "mitochondrion-animal", "lysosome", "peroxisome", "centriole", "ribosome-animal" },
        ["plant"] = new[] { "cell-wall-plant", "cytoplasm", "plasma-membrane-plant", "plasmodesmata", "vacuole", "nucleus-plant",
            "chloroplast", "mitochondrion-plant", "er-plant", "golgi-plant", "ribosome-plant" },
        ["bacteria"] = new[] { "capsule", "cell-wall-bact", "cytoplasm", "plasma-membrane-bact", "nucleoid", "plasmid",
            "ribosome-bact", "pilus", "flagellum" },
    };

    private void SwitchCell(string ct)
    {
        cellType = ct;
        selected = null;
        if (quizTarget != null)
        {
            quizFeedback = null;
            PickQuizTarget();
        }
    }

    private void Select(string id)
    {
        if (quizTarget == null)
        {
            selected = selected == id ? null : id;
            return;
        }

        selected = id;
        quizCorrect = id == quizTarget;
        if (quizCorrect)
        {
            quizScore++;
            quizFeedback = $"Yes, that's the {organelles[id].Name}.";
            PickQuizTarget();
        }
        else
        {
            quizMisses++;
            quizFeedback = $"That's the {organelles[id].Name}. Try again.";
        }
    }

    private void ToggleQuiz()
    {
        selected = null;
        quizFeedback = null;
        quizScore = 0;
        quizMisses = 0;
        if (quizTarget != null)
            quizTarget = null;
        else
            PickQuizTarget();
    }

    private void SkipQuizTarget()
    {
        quizFeedback = null;
        PickQuizTarget();
    }

    private void PickQuizTarget()
    {
        var parts = cellParts[cellType];
        string next;
        do next = parts[Random.Shared.Next(parts.Length)];
        while (next == quizTarget);
        quizTarget = next;
    }

    private Dictionary<string, object> Part(string id) => new()
    {
        ["class"] = IsActive(id) ? "ct-organelle ct-active" : "ct-organelle",
        ["tabindex"] = "0",
        ["role"] = "button",
        ["aria-label"] = organelles[id].Name,
        ["aria-pressed"] = IsActive(id) ? "true" : "false",
        ["onclick"] = EventCallback.Factory.Create<MouseEventArgs>(this, () => Select(id)),
    };

    private bool IsActive(string id) => selected == id;

    private record OrganelleInfo(string Name, string ShortLabel, string Function, string FunFact, string[] FoundIn, string Related);

    private static readonly Dictionary<string, OrganelleInfo> organelles = new()
    {
        // Animal
        ["nucleus"] = new("Nucleus", "Cell control center",
            "Stores the cell's DNA and directs all activity by controlling which genes are expressed. Surrounded by a double membrane with pores.",
            "If you stretched the DNA from one human nucleus end to end, it would be roughly 2 meters long, packed inside a sphere about 6 micrometers across.",
            new[] { "Animal", "Plant" },
            "Transcription, DNA replication, mRNA export"),

        ["nucleolus"] = new("Nucleolus", "Ribosome factory",
            "A dense region inside the nucleus where ribosomal RNA is transcribed and ribosome subunits are assembled.",
            "It isn't bound by a membrane; it's just a really crowded neighborhood inside the nucleus where rRNA work happens.",
            new[] { "Animal", "Plant" },
            "rRNA synthesis, ribosome biogenesis"),

        ["mitochondrion-animal"] = new("Mitochondrion", "Powerhouse of the cell",
            "Generates most of the cell's ATP through aerobic respiration. Has a folded inner membrane (cristae) that increases surface area for energy production.",
            "Mitochondria carry their own circular DNA and were almost certainly free-living bacteria swallowed by an ancestor cell about 1.5 billion years ago.",
            new[] { "Animal", "Plant" },
            "ATP synthesis, citric acid cycle, oxidative phosphorylation"),

        ["ribosome-animal"] = new("Ribosomes", "Protein assemblers",
            "Tiny molecular machines that read messenger RNA and link amino acids together to build proteins.",
            "A single growing cell can contain millions of ribosomes. In human cells each one adds roughly 5 amino acids per second to a growing protein; bacterial ribosomes are faster, at about 20 per second.",
            new[] { "Animal", "Plant", "Bacteria" },
            "Translation, protein synthesis"),

        ["rough-er"] = new("Rough Endoplasmic Reticulum", "Protein highway",
            "A network of membrane sheets studded with ribosomes. Folds and modifies proteins destined for export or for membranes.",
            "It's called 'rough' purely because the attached ribosomes make it look bumpy under an electron microscope.",
            new[] { "Animal", "Plant" },
            "Protein folding, glycosylation, quality control"),

        ["smooth-er"] = new("Smooth Endoplasmic Reticulum", "Lipid lab",
            "Membrane network without ribosomes. Synthesises lipids and steroids, detoxifies drugs, and stores calcium.",
            "Liver cells are crammed with smooth ER because so much of their job is breaking down toxins like alcohol.",
            new[] { "Animal", "Plant" },
            "Lipid synthesis, detoxification, calcium storage"),

        ["golgi-animal"] = new("Golgi Apparatus", "Packaging and dispatch",
            "Modifies, sorts, and packages proteins and lipids from the ER into vesicles for delivery elsewhere in the cell or for secretion.",
