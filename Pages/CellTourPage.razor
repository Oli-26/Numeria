                    <rect x="14" y="19" width="372" height="282" rx="16" fill="none" stroke="#5C3F18" stroke-width="0.8" opacity="0.5" />
                </g>

                <g class="ct-organelle @(IsActive("plasma-membrane-plant") ? "ct-active" : "")"
                   @onclick='() => Select("plasma-membrane-plant")'>
                    <rect x="22" y="27" width="356" height="266" rx="14" fill="url(#plantBg)" stroke="#3F7E3E" stroke-width="2" />
                    <rect x="25" y="30" width="350" height="260" rx="12" fill="none" stroke="#7CC07C" stroke-width="0.8" stroke-dasharray="2,2" opacity="0.7" />
                </g>

                <rect x="22" y="27" width="356" height="266" fill="url(#cytoNoisePlant)" clip-path="url(#plantClip)" pointer-events="none" />

                <g class="ct-organelle @(IsActive("plasmodesmata") ? "ct-active" : "")"
                   @onclick='() => Select("plasmodesmata")'>
                    <rect x="10" y="80" width="20" height="10" fill="#E5C796" stroke="#5A3A1A" stroke-width="0.8" />
                    <line x1="10" y1="85" x2="30" y2="85" stroke="#A98654" stroke-width="0.5" />
                    <rect x="10" y="200" width="20" height="10" fill="#E5C796" stroke="#5A3A1A" stroke-width="0.8" />
                    <line x1="10" y1="205" x2="30" y2="205" stroke="#A98654" stroke-width="0.5" />
                    <rect x="370" y="120" width="20" height="10" fill="#E5C796" stroke="#5A3A1A" stroke-width="0.8" />
