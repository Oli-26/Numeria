                    <rect x="370" y="230" width="20" height="10" fill="#E5C796" stroke="#5A3A1A" stroke-width="0.8" />
                    <line x1="370" y1="235" x2="390" y2="235" stroke="#A98654" stroke-width="0.5" />
                </g>

                <g class="ct-organelle @(IsActive("vacuole") ? "ct-active" : "")"
                   @onclick='() => Select("vacuole")'>
                    <ellipse cx="200" cy="170" rx="140" ry="95" fill="url(#vacuoleGrad)" stroke="#3F6A98" stroke-width="1.8" opacity="0.92" filter="url(#ctShadowP)" />
                    <ellipse cx="200" cy="170" rx="136" ry="91" fill="none" stroke="#7FB6E0" stroke-width="0.8" opacity="0.6" />
                    <ellipse cx="160" cy="135" rx="30" ry="12" fill="#FFFFFF" opacity="0.18" />
                </g>

                <g class="ct-organelle @(IsActive("nucleus-plant") ? "ct-active" : "")"
                   @onclick='() => Select("nucleus-plant")'>
                    <path d="M 78 60 C 100 58 116 72 114 92 C 116 112 100 124 76 122 C 56 124 44 108 46 90 C 44 72 60 60 78 60 Z"
                          fill="url(#nucleusPlantGrad)" stroke="#3F2D60" stroke-width="1.8" filter="url(#ctShadowP)" />
                    <path d="M 78 64 C 98 62 112 74 110 92 C 112 110 98 120 78 118 C 60 120 48 108 50 92 C 48 74 62 64 78 64 Z"
                          fill="none" stroke="#5A4280" stroke-width="0.7" opacity="0.7" />
                    <circle cx="86" cy="93" r="9" fill="#3A2754" />
                    <circle cx="84" cy="91" r="2" fill="#9678BC" opacity="0.6" />
