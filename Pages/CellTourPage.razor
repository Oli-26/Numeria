@page "/cell-tour"
@inject NavigationManager Nav

<div class="page-header">
    <button class="back-btn" aria-label="Back to home" @onclick='() => Nav.NavigateTo("/")'><Icon Name="arrow-left" Size="18" /></button>
    <h1>Cell Tour</h1>
</div>

<div class="ct-toolbar">
    <p class="ct-intro"><Icon Name="target" Size="14" Stroke="var(--accent)" /> Tap any organelle to learn its job.</p>
    <button class="ct-quiz-btn @(quizTarget != null ? "active" : "")" aria-pressed="@(quizTarget != null ? "true" : "false")" @onclick="ToggleQuiz">
        <Icon Name="search" Size="14" /> Find it
    </button>
</div>

<div class="ct-tabs">
    <button class="tab @(cellType == "animal" ? "active" : "")" @onclick='() => SwitchCell("animal")'>Animal Cell</button>
    <button class="tab @(cellType == "plant" ? "active" : "")" @onclick='() => SwitchCell("plant")'>Plant Cell</button>
    <button class="tab @(cellType == "bacteria" ? "active" : "")" @onclick='() => SwitchCell("bacteria")'>Bacteria (Prokaryote)</button>
</div>

@if (quizTarget != null)
{
    <div class="ct-quiz card" aria-live="polite">
        <div class="ct-quiz-row">
            <div class="ct-quiz-prompt">
                <small>Find the</small>
                <strong>@organelles[quizTarget].Name</strong>
            </div>
            <span class="ct-quiz-score">@quizScore found, @quizMisses missed</span>
            <button class="ct-quiz-skip" @onclick="SkipQuizTarget">Skip</button>
        </div>
        @if (quizFeedback != null)
        {
            <p class="ct-quiz-feedback @(quizCorrect ? "ct-quiz-ok" : "ct-quiz-miss")">@quizFeedback</p>
        }
    </div>
}

@* Enter or Space on a focused part fires its click handler. Done inline because Blazor cannot preventDefault (page scroll on Space) for some keys only. *@
