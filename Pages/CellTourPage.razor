            "Transport, signalling, endocytosis"),

        ["centriole"] = new("Centrioles", "Spindle organizer",
            "Paired barrel-shaped structures that organize microtubules and form the mitotic spindle during cell division.",
            "Plant cells get by without centrioles entirely; they organize their spindles in a different way.",
            new[] { "Animal" },
            "Cell division, spindle assembly, cilia formation"),

        ["peroxisome"] = new("Peroxisome", "Detox bubble",
            "Small vesicle containing oxidative enzymes that break down fatty acids and neutralize hydrogen peroxide.",
            "Peroxisomes destroy the very hydrogen peroxide they create, neatly cleaning up after themselves.",
            new[] { "Animal", "Plant" },
            "Beta-oxidation, hydrogen peroxide breakdown"),

        // Plant
        ["nucleus-plant"] = new("Nucleus", "Cell control center",
            "Stores the cell's DNA and directs all activity by controlling which genes are expressed. Surrounded by a double membrane with pores.",
            "Plant nuclei are often pushed to the edge of the cell by the giant central vacuole.",
            new[] { "Animal", "Plant" },
            "Transcription, DNA replication, mRNA export"),

        ["chloroplast"] = new("Chloroplast", "Solar panel of the cell",
            "Captures light energy and uses it to convert carbon dioxide and water into sugar via photosynthesis. Contains the green pigment chlorophyll.",
