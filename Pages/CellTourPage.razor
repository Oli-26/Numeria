            new[] { "Animal" },
            "Autophagy, intracellular digestion, phagocytosis"),

        ["cytoskeleton"] = new("Cytoskeleton", "Internal scaffold",
            "Network of protein filaments (microtubules, actin, intermediate filaments) that gives the cell shape, supports organelle movement, and drives cell division.",
            "Motor proteins literally walk along microtubule tracks, hauling vesicles like microscopic delivery drivers.",
            new[] { "Animal", "Plant" },
            "Cell shape, intracellular transport, mitosis"),

        ["plasma-membrane-animal"] = new("Plasma Membrane", "Selective barrier",
