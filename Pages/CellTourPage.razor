                          fill="url(#erRoughGrad)" stroke="#8C4A18" stroke-width="1" />
                    <g class="ct-rib-twinkle">
                        <circle cx="62" cy="226" r="2" fill="#1A1208" />
                        <circle cx="86" cy="218" r="2" fill="#1A1208" />
                        <circle cx="118" cy="226" r="2" fill="#1A1208" />
                        <circle cx="148" cy="240" r="2" fill="#1A1208" />
                        <circle cx="180" cy="222" r="2" fill="#1A1208" />
                        <circle cx="210" cy="224" r="2" fill="#1A1208" />
                        <circle cx="74" cy="252" r="2" fill="#1A1208" />
                        <circle cx="108" cy="252" r="2" fill="#1A1208" />
                        <circle cx="140" cy="266" r="2" fill="#1A1208" />
                        <circle cx="172" cy="252" r="2" fill="#1A1208" />
                        <circle cx="206" cy="252" r="2" fill="#1A1208" />
                        <circle cx="232" cy="266" r="2" fill="#1A1208" />
                    </g>
                </g>

                <g class="ct-organelle @(IsActive("smooth-er") ? "ct-active" : "")"
                   @onclick='() => Select("smooth-er")'>
                    <path d="M 250 80 C 268 90 248 108 268 120 C 290 132 268 152 286 168 C 300 180 280 200 296 212"
                          fill="none" stroke="url(#erSmoothGrad)" stroke-width="6" stroke-linecap="round" filter="url(#ctShadow)" />
                    <path d="M 268 78 C 286 92 268 110 286 122 C 308 134 290 154 308 168"
                          fill="none" stroke="url(#erSmoothGrad)" stroke-width="5" stroke-linecap="round" />
                    <path d="M 252 84 C 268 92 252 110 270 122" fill="none" stroke="#FFE3B7" stroke-width="1" opacity="0.7" />
                </g>

                <g class="ct-organelle @(IsActive("golgi-animal") ? "ct-active" : "")"
                   @onclick='() => Select("golgi-animal")'>
                    <path d="M 282 214 Q 320 206 354 214 Q 350 220 318 220 Q 286 220 282 214 Z" fill="url(#golgiGrad)" stroke="#1F5E72" stroke-width="0.8" filter="url(#ctShadow)" />
                    <path d="M 286 226 Q 322 218 350 226 Q 346 232 318 232 Q 290 232 286 226 Z" fill="url(#golgiGrad)" stroke="#1F5E72" stroke-width="0.8" />
                    <path d="M 290 238 Q 322 230 346 238 Q 342 244 318 244 Q 294 244 290 238 Z" fill="url(#golgiGrad)" stroke="#1F5E72" stroke-width="0.8" />
                    <path d="M 296 250 Q 322 242 340 250 Q 336 256 318 256 Q 300 256 296 250 Z" fill="url(#golgiGrad)" stroke="#1F5E72" stroke-width="0.8" />
                    <circle cx="358" cy="218" r="3" fill="#7DD0E2" stroke="#1F5E72" stroke-width="0.6" class="ct-vesicle-a" />
                    <circle cx="276" cy="246" r="2.5" fill="#7DD0E2" stroke="#1F5E72" stroke-width="0.6" class="ct-vesicle-b" />
                    <circle cx="346" cy="262" r="2.2" fill="#7DD0E2" stroke="#1F5E72" stroke-width="0.6" class="ct-vesicle-c" />
                </g>

                <g class="ct-organelle ct-mito @(IsActive("mitochondrion-animal") ? "ct-active" : "")"
                   @onclick='() => Select("mitochondrion-animal")'>
                    <path d="M 64 102 C 60 86 84 80 104 82 C 128 84 144 92 138 108 C 142 122 124 120 102 118 C 84 122 62 116 64 102 Z"
                          fill="url(#mitoGrad)" stroke="#5C1818" stroke-width="1.5" filter="url(#ctShadow)" />
                    <path d="M 70 100 Q 78 92 86 100 Q 94 108 102 100 Q 110 92 118 100 Q 126 108 134 100" fill="none" stroke="#5C1818" stroke-width="1.2" opacity="0.85" />
                    <path d="M 72 108 Q 80 116 88 108 Q 96 100 104 108 Q 112 116 120 108 Q 128 100 136 108" fill="none" stroke="#5C1818" stroke-width="1" opacity="0.7" />
                    <path d="M 74 94 Q 80 88 86 94" fill="none" stroke="#5C1818" stroke-width="0.8" opacity="0.5" />
                    <path d="M 100 112 Q 106 118 112 112" fill="none" stroke="#5C1818" stroke-width="0.8" opacity="0.5" />
                </g>

                <g class="ct-organelle @(IsActive("lysosome") ? "ct-active" : "")"
                   @onclick='() => Select("lysosome")'>
                    <circle cx="320" cy="120" r="18" fill="url(#lysoGrad)" stroke="#7E5F12" stroke-width="1.5" filter="url(#ctShadow)" />
                    <circle cx="314" cy="114" r="3" fill="#7E5F12" opacity="0.7" />
                    <circle cx="324" cy="124" r="2.5" fill="#7E5F12" opacity="0.7" />
                    <circle cx="328" cy="113" r="1.6" fill="#7E5F12" opacity="0.5" />
                    <circle cx="312" cy="128" r="1.6" fill="#7E5F12" opacity="0.5" />
                    <circle cx="316" cy="118" r="1.2" fill="#FFF3C4" opacity="0.7" />
                </g>

                <g class="ct-organelle @(IsActive("peroxisome") ? "ct-active" : "")"
                   @onclick='() => Select("peroxisome")'>
                    <circle cx="80" cy="240" r="15" fill="url(#peroxGrad)" stroke="#3D5F18" stroke-width="1.5" filter="url(#ctShadow)" />
                    <circle cx="80" cy="240" r="5" fill="#3D5F18" />
                    <circle cx="78" cy="238" r="1.6" fill="#A8D26A" opacity="0.8" />
                </g>

                <g class="ct-organelle @(IsActive("centriole") ? "ct-active" : "")"
                   @onclick='() => Select("centriole")'>
                    <rect x="240" y="252" width="22" height="10" rx="2" fill="url(#centroGrad)" stroke="#1A2A4D" stroke-width="1" filter="url(#ctShadow)" />
                    <line x1="244" y1="252" x2="244" y2="262" stroke="#1A2A4D" stroke-width="0.6" opacity="0.7" />
                    <line x1="250" y1="252" x2="250" y2="262" stroke="#1A2A4D" stroke-width="0.6" opacity="0.7" />
                    <line x1="256" y1="252" x2="256" y2="262" stroke="#1A2A4D" stroke-width="0.6" opacity="0.7" />
                    <rect x="246" y="262" width="10" height="22" rx="2" fill="url(#centroGrad)" stroke="#1A2A4D" stroke-width="1" />
                    <line x1="246" y1="266" x2="256" y2="266" stroke="#1A2A4D" stroke-width="0.6" opacity="0.7" />
                    <line x1="246" y1="272" x2="256" y2="272" stroke="#1A2A4D" stroke-width="0.6" opacity="0.7" />
                    <line x1="246" y1="278" x2="256" y2="278" stroke="#1A2A4D" stroke-width="0.6" opacity="0.7" />
                </g>

                <g class="ct-organelle ct-rib-twinkle @(IsActive("ribosome-animal") ? "ct-active" : "")"
                   @onclick='() => Select("ribosome-animal")'>
                    <circle cx="158" cy="258" r="2.4" fill="#3F3A52" />
                    <circle cx="162" cy="262" r="2" fill="#5A547A" />
                    <circle cx="170" cy="270" r="2.4" fill="#3F3A52" />
                    <circle cx="174" cy="274" r="2" fill="#5A547A" />
                    <circle cx="200" cy="265" r="2.4" fill="#3F3A52" />
                    <circle cx="204" cy="269" r="2" fill="#5A547A" />
                    <circle cx="220" cy="280" r="2.4" fill="#3F3A52" />
                    <circle cx="224" cy="284" r="2" fill="#5A547A" />
                    <circle cx="140" cy="280" r="2.4" fill="#3F3A52" />
                    <circle cx="144" cy="284" r="2" fill="#5A547A" />
                </g>
            </svg>
        }
        else if (cellType == "plant")
        {
            <svg viewBox="0 0 400 320" class="ct-svg" preserveAspectRatio="xMidYMid meet" xmlns="http://www.w3.org/2000/svg">
                <defs>
                    <radialGradient id="plantBg" cx="50%" cy="40%" r="70%">
                        <stop offset="0%" stop-color="#F1FCEB" />
                        <stop offset="60%" stop-color="#D6F1CC" />
                        <stop offset="100%" stop-color="#A8D89B" />
                    </radialGradient>
                    <linearGradient id="cellWallGrad" x1="0%" y1="0%" x2="0%" y2="100%">
                        <stop offset="0%" stop-color="#B58A52" />
                        <stop offset="100%" stop-color="#6E4D24" />
                    </linearGradient>
                    <radialGradient id="vacuoleGrad" cx="40%" cy="35%" r="80%">
                        <stop offset="0%" stop-color="#D9ECFB" />
                        <stop offset="60%" stop-color="#A4D2F4" />
                        <stop offset="100%" stop-color="#3F6A98" />
                    </radialGradient>
                    <radialGradient id="chloroGrad" cx="40%" cy="35%" r="70%">
                        <stop offset="0%" stop-color="#A2DD8F" />
                        <stop offset="55%" stop-color="#5DA84B" />
                        <stop offset="100%" stop-color="#1F5C18" />
                    </radialGradient>
                    <radialGradient id="nucleusPlantGrad" cx="40%" cy="35%" r="80%">
                        <stop offset="0%" stop-color="#B79CD9" />
                        <stop offset="60%" stop-color="#7B5EA7" />
                        <stop offset="100%" stop-color="#3F2D60" />
                    </radialGradient>
                    <radialGradient id="mitoPlantGrad" cx="40%" cy="40%" r="70%">
                        <stop offset="0%" stop-color="#FFB1A8" />
                        <stop offset="55%" stop-color="#E36B6B" />
                        <stop offset="100%" stop-color="#702020" />
                    </radialGradient>
                    <pattern id="wallTex" x="0" y="0" width="14" height="14" patternUnits="userSpaceOnUse">
                        <path d="M 0 7 L 14 7" stroke="#7A5526" stroke-width="0.6" opacity="0.4" />
                        <path d="M 7 0 L 7 14" stroke="#7A5526" stroke-width="0.4" opacity="0.3" />
                    </pattern>
                    <pattern id="cytoNoisePlant" x="0" y="0" width="40" height="40" patternUnits="userSpaceOnUse">
                        <circle cx="6" cy="9" r="0.7" fill="#5BA15B" opacity="0.22" />
                        <circle cx="22" cy="14" r="0.5" fill="#3F7E3E" opacity="0.2" />
                        <circle cx="34" cy="6" r="0.6" fill="#5BA15B" opacity="0.16" />
                        <circle cx="14" cy="28" r="0.6" fill="#3F7E3E" opacity="0.2" />
                        <circle cx="30" cy="32" r="0.7" fill="#5BA15B" opacity="0.22" />
                    </pattern>
                    <filter id="ctShadowP" x="-30%" y="-30%" width="160%" height="160%">
                        <feGaussianBlur in="SourceAlpha" stdDeviation="1.5" />
                        <feOffset dx="0.5" dy="1" result="off" />
                        <feComponentTransfer><feFuncA type="linear" slope="0.45" /></feComponentTransfer>
                        <feMerge><feMergeNode /><feMergeNode in="SourceGraphic" /></feMerge>
                    </filter>
                    <clipPath id="plantClip">
                        <rect x="22" y="27" width="356" height="266" rx="14" />
                    </clipPath>
                </defs>

                <g class="ct-organelle @(IsActive("cell-wall-plant") ? "ct-active" : "")"
                   @onclick='() => Select("cell-wall-plant")'>
