@page "/phase-diagram"
@implements IAsyncDisposable
@inject NavigationManager Nav
@inject IJSRuntime JS
@using System.Globalization
@using System.Text

<div class="page-header">
    <button class="back-btn" aria-label="Back to home" @onclick='() => Nav.NavigateTo("/")'><Icon Name="arrow-left" Size="18" /></button>
    <h1>Phase Diagram Explorer</h1>
</div>

<div class="card pd-intro">
    <Icon Name="flask" Size="22" Stroke="var(--accent)" />
    <p>Tap or drag on the diagram, or use the sliders. The dot shows which phase is stable at that temperature and pressure; along the lines two phases coexist.</p>
</div>

<div class="card pd-substance-card">
    <label class="pd-label">Substance</label>
    <div class="pd-subs">
        @foreach (var sub in PhaseModel.All)
        {
            var sx = sub;
            <button class="pd-sub @(selected == sx ? "active" : "")" @onclick="() => Select(sx)">@sx.Name</button>
        }
    </div>
</div>

<div class="card pd-diagram-card">
    @{
        var s = selected;
        var p = Math.Pow(10, logP);
        var result = s.Classify(temperature, p);
    }
    <div class="pd-phase-readout" style="background:@PhaseColor(result.Kind)">
        <strong>@PhaseName(result.Kind)</strong>
        <span class="pd-state">@TempText(temperature), @PressureText(p)</span>
        <small>@result.Why</small>
    </div>

    <svg @ref="svgEl" viewBox="0 0 320 242" class="pd-svg" aria-label="@($"Phase diagram of {s.Name}: temperature against pressure on a log scale")"
         @onpointerdown="OnPointerDown" @onpointermove="OnPointerMove" @onpointerup="EndDrag" @onpointercancel="EndDrag">
        <defs>
            <clipPath id="pd-plot-clip"><rect x="@PlotL" y="@PlotT" width="@(PlotR - PlotL)" height="@(PlotB - PlotT)" /></clipPath>
        </defs>
        <rect x="@PlotL" y="@PlotT" width="@(PlotR - PlotL)" height="@(PlotB - PlotT)" fill="var(--bg-surface)" stroke="var(--border)" />

        @for (var d = (int)Math.Ceiling(s.MinLogP); d <= (int)Math.Floor(s.MaxLogP); d++)
        {
            var y = F(YLog(d));
            <g>
                <line x1="@PlotL" x2="@PlotR" y1="@y" y2="@y" stroke="var(--border)" stroke-width="0.5" />
                <text x="@(PlotL - 3)" y="@y" dy="2.5" font-size="7" fill="var(--text-muted)" text-anchor="end">@DecadeLabel(d)</text>
            </g>
        }
        @{ var step = NiceStep(s.MaxT - s.MinT); }
        @for (var t = Math.Ceiling(s.MinT / step) * step; t <= s.MaxT + 1e-9; t += step)
        {
            var x = F(X(t));
            <g>
                <line x1="@x" x2="@x" y1="@PlotB" y2="@(PlotB + 3)" stroke="var(--text-muted)" stroke-width="0.75" />
                <text x="@x" y="@(PlotB + 11)" font-size="7" fill="var(--text-muted)" text-anchor="middle">@t.ToString("0.##", CultureInfo.InvariantCulture)</text>
            </g>
        }
        <text x="@((PlotL + PlotR) / 2)" y="236" font-size="8" fill="var(--text-muted)" text-anchor="middle">Temperature (K)</text>
        <text x="8" y="@((PlotT + PlotB) / 2)" font-size="8" fill="var(--text-muted)" text-anchor="middle" transform="@($"rotate(-90 8 {(PlotT + PlotB) / 2})")">Pressure (log scale)</text>

        <g clip-path="url(#pd-plot-clip)">
            @{ var atmY = F(Y(PhaseSubstance.Atm)); }
            <line x1="@PlotL" x2="@PlotR" y1="@atmY" y2="@atmY" stroke="var(--text-muted)" stroke-width="0.75" stroke-dasharray="4 3" />
            <text x="@(PlotR - 3)" y="@atmY" dy="-2.5" font-size="7" fill="var(--text-muted)" text-anchor="end">1 atm</text>

            @foreach (var c in s.Curves())
            {
                <path d="@PathFor(c)" fill="none" stroke="@CurveColor(c.Kind)" stroke-width="@(c.Kind == CurveKind.CriticalEdge ? "1" : "2")"
                      stroke-dasharray="@(c.Kind == CurveKind.CriticalEdge ? "3 3" : "none")" stroke-linejoin="round" />
            }
        </g>

        @foreach (var lbl in s.Labels)
        {
            var lines = lbl.Text.Split('\n');
            var lx = F(X(lbl.T));
            <g>
                <text x="@lx" y="@F(Y(lbl.P) + 3 - (lines.Length - 1) * 4.5)" font-size="9" font-weight="700" fill="var(--text-secondary)" text-anchor="middle" opacity="0.8">
                    @for (var i = 0; i < lines.Length; i++)
                    {
                        <tspan x="@lx" dy="@(i == 0 ? "0" : "9")">@lines[i]</tspan>
                    }
                </text>
            </g>
        }

        @foreach (var m in s.Markers())
        {
            var mx = X(m.T);
            var my = Y(m.P);
            if (m.Major)
            {
                <g>
                    <circle cx="@F(mx)" cy="@F(my)" r="3.5" fill="@(m.Name.StartsWith("Critical") ? "#8E4FB8" : "#F39C12")" />
                    <text x="@F(m.LabelLeft ? mx - 5 : mx + 5)" y="@F(m.LabelBelow ? my + 10 : my - 4)" font-size="7" fill="var(--text-secondary)" text-anchor="@(m.LabelLeft ? "end" : "start")">@MarkerLabel(m)</text>
                </g>
            }
            else
            {
                <circle cx="@F(mx)" cy="@F(my)" r="2.5" fill="var(--bg-surface)" stroke="var(--text-secondary)" stroke-width="1" />
            }
        }

        <circle cx="@F(X(temperature))" cy="@F(YLog(logP))" r="7" fill="@PhaseColor(result.Kind)" stroke="white" stroke-width="2" pointer-events="none" />
    </svg>

    <div class="pd-sliders">
        <label>Temperature: @TempText(temperature)
            <input type="range" min="@F(s.MinT)" max="@F(s.MaxT)" step="@s.TStep.ToString(CultureInfo.InvariantCulture)" @bind="temperature" @bind:event="oninput" />
        </label>
        <label>Pressure: @PressureText(p)
            <input type="range" min="@F(s.MinLogP)" max="@F(s.MaxLogP)" step="0.01" @bind="logP" @bind:event="oninput" />
        </label>
        <button class="pd-atm" @onclick="() => logP = Math.Log10(PhaseSubstance.Atm)">Set 1 atm</button>
    </div>
</div>

<div class="card pd-facts">
    <h3>@s.Name at a glance</h3>
    <ul>
        @foreach (var m in s.Markers())
        {
            <li><span>@m.Name@(m.Estimate ? " (estimate)" : "")</span><span>@PhaseModel.FormatTemperature(m.T), @PhaseModel.FormatPressure(m.P)</span></li>
        }
    </ul>
    <p>@s.Note</p>
</div>

@code {
    private const double PlotL = 46, PlotR = 312, PlotT = 10, PlotB = 210;

    private PhaseSubstance selected = PhaseModel.Water;
    private double temperature = PhaseModel.Water.DefaultT;
    private double logP = Math.Log10(PhaseModel.Water.DefaultP);

    private ElementReference svgEl;
    private IJSObjectReference? svgModule;
    private double[]? dragMatrix;
    private bool pointerHeld;
    private bool skipRender;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        try { svgModule = await JS.InvokeAsync<IJSObjectReference>("import", "./js/svgPoint.js"); }
        catch (Exception ex) { await JS.LogErrorAsync("phase-diagram:import", ex); }
    }

    protected override bool ShouldRender()
    {
        if (!skipRender) return true;
        skipRender = false;
        return false;
    }

    private void Select(PhaseSubstance s)
    {
        selected = s;
        temperature = s.DefaultT;
        logP = Math.Log10(s.DefaultP);
    }

    private async Task OnPointerDown(PointerEventArgs e)
    {
        if (svgModule is null) return;
        pointerHeld = true;
        double[]? m;
        try { m = await svgModule.InvokeAsync<double[]?>("beginDrag", svgEl, e.PointerId); }
        catch (Exception ex) { await JS.LogErrorAsync("phase-diagram:beginDrag", ex); return; }
        if (m is not { Length: 6 }) return;
        MoveTo(m, e.ClientX, e.ClientY);
        // The pointer may already be up by the time the matrix arrives (a quick tap).
        dragMatrix = pointerHeld ? m : null;
    }

    private void OnPointerMove(PointerEventArgs e)
    {
        if (dragMatrix is null) { skipRender = true; return; }
        MoveTo(dragMatrix, e.ClientX, e.ClientY);
    }

    private void EndDrag()
    {
        pointerHeld = false;
        dragMatrix = null;
    }

    private void MoveTo(double[] m, double clientX, double clientY)
    {
        var x = m[0] * clientX + m[2] * clientY + m[4];
        var y = m[1] * clientX + m[3] * clientY + m[5];
        var fx = Math.Clamp((x - PlotL) / (PlotR - PlotL), 0, 1);
        var fy = Math.Clamp((PlotB - y) / (PlotB - PlotT), 0, 1);
        var s = selected;
        temperature = Math.Clamp(Math.Round((s.MinT + fx * (s.MaxT - s.MinT)) / s.TStep) * s.TStep, s.MinT, s.MaxT);
        logP = Math.Round(s.MinLogP + fy * (s.MaxLogP - s.MinLogP), 2);
    }

    private double X(double t) => PlotL + (t - selected.MinT) / (selected.MaxT - selected.MinT) * (PlotR - PlotL);
    private double YLog(double lp) => PlotB - (lp - selected.MinLogP) / (selected.MaxLogP - selected.MinLogP) * (PlotB - PlotT);
    private double Y(double p) => YLog(Math.Log10(p));

    private string PathFor(PhaseCurve c)
    {
        var sb = new StringBuilder();
        foreach (var (t, p) in c.Points)
        {
            // Points far off the plot are pinned just outside it; the clip path hides them.
            var lp = p > 0 ? Math.Clamp(Math.Log10(p), selected.MinLogP - 1, selected.MaxLogP + 1) : selected.MinLogP - 1;
            sb.Append(sb.Length == 0 ? 'M' : 'L').Append(F(X(t))).Append(',').Append(F(YLog(lp))).Append(' ');
        }
        return sb.ToString();
    }

    private static string F(double v) => v.ToString("0.#", CultureInfo.InvariantCulture);

    private static double NiceStep(double range)
    {
        var raw = range / 5;
        var mag = Math.Pow(10, Math.Floor(Math.Log10(raw)));
        var f = raw / mag;
        return (f < 1.5 ? 1 : f < 3.5 ? 2 : f < 7.5 ? 5 : 10) * mag;
    }

    private static string DecadeLabel(int d)
    {
        string[] units = ["Pa", "kPa", "MPa", "GPa"];
        var k = Math.Clamp((int)Math.Floor(d / 3.0), 0, units.Length - 1);
        return Math.Pow(10, d - 3 * k).ToString("0.##", CultureInfo.InvariantCulture) + " " + units[k];
    }

    private static string TempText(double t) =>
        PhaseModel.FormatTemperature(t) + (t >= 100 ? $" ({(t - 273.15).ToString("0", CultureInfo.InvariantCulture)} °C)" : "");

    private static string PressureText(double p)
    {
        var atm = p / PhaseSubstance.Atm;
        return PhaseModel.FormatPressure(p) + (atm >= 1e-3 && atm < 1e4 ? $" ({atm.ToString("G3", CultureInfo.InvariantCulture)} atm)" : "");
    }

    private static string MarkerLabel(PhaseMarker m) => m.Name.Replace(" point", "") + (m.Estimate ? " (est.)" : "");

    private static string PhaseName(PhaseKind k) => k switch
    {
        PhaseKind.Solid => "Solid",
        PhaseKind.Liquid => "Liquid",
        PhaseKind.Gas => "Gas",
        PhaseKind.Supercritical => "Supercritical fluid",
        PhaseKind.HeliumI => "Liquid (He I)",
        _ => "Superfluid (He II)",
    };

    private static string PhaseColor(PhaseKind k) => k switch
    {
        PhaseKind.Solid => "#3B82C4",
        PhaseKind.Liquid or PhaseKind.HeliumI => "#13967D",
        PhaseKind.Gas => "#D9661A",
        PhaseKind.Supercritical => "#8E4FB8",
        _ => "#1F8FAD",
    };

    private static string CurveColor(CurveKind k) => k switch
    {
        CurveKind.Melting => "#4A90D9",
        CurveKind.Lambda => "#1F8FAD",
        CurveKind.CriticalEdge => "var(--text-muted)",
        _ => "#E74C3C",
    };

    public async ValueTask DisposeAsync()
    {
        if (svgModule is null) return;
        try { await svgModule.DisposeAsync(); }
        catch { /* JS bridge may already be disposed */ }
    }
}

<style>
    .pd-intro { display: flex; align-items: flex-start; gap: 12px; padding: 14px; }
    .pd-intro p { margin: 0; font-size: 0.9rem; color: var(--text-secondary); line-height: 1.5; }

    .pd-substance-card { padding: 12px 14px; }
    .pd-label { display: block; font-size: 0.75rem; text-transform: uppercase; letter-spacing: 0.5px; color: var(--text-muted); margin-bottom: 6px; font-weight: 700; }
    .pd-subs { display: flex; gap: 6px; flex-wrap: wrap; }
    .pd-sub { padding: 6px 14px; background: var(--bg-surface); border: 1px solid var(--border); border-radius: 14px; font-size: 0.85rem; color: var(--text-secondary); cursor: pointer; }
    .pd-sub.active { background: var(--primary); color: white; border-color: var(--primary); }

    .pd-diagram-card { padding: 14px; }
    .pd-phase-readout { padding: 10px 14px; border-radius: var(--radius-sm); color: white; margin-bottom: 12px; }
    .pd-phase-readout strong { display: block; font-size: 1.05rem; }
    .pd-phase-readout .pd-state { display: block; font-size: 0.8rem; font-weight: 600; opacity: 0.95; margin-bottom: 2px; }
    .pd-phase-readout small { display: block; font-size: 0.78rem; opacity: 0.95; line-height: 1.45; }

    .pd-svg { width: 100%; height: auto; display: block; touch-action: none; user-select: none; -webkit-user-select: none; cursor: crosshair; }
    .pd-sliders { margin-top: 10px; display: flex; flex-direction: column; gap: 8px; }
    .pd-sliders label { display: flex; flex-direction: column; gap: 4px; font-size: 0.8rem; color: var(--text-secondary); font-weight: 600; }
    .pd-sliders input[type=range] { accent-color: var(--primary); }
    .pd-atm { align-self: flex-start; padding: 6px 12px; background: var(--bg-surface); border: 1px solid var(--border); border-radius: 14px; font-size: 0.8rem; color: var(--text-secondary); cursor: pointer; }

    .pd-facts { padding: 14px; }
    .pd-facts h3 { margin: 0 0 8px; font-size: 0.95rem; }
    .pd-facts ul { list-style: none; margin: 0 0 10px; padding: 0; display: flex; flex-direction: column; gap: 4px; }
    .pd-facts li { display: flex; justify-content: space-between; gap: 10px; font-size: 0.82rem; color: var(--text-secondary); }
    .pd-facts li span:last-child { text-align: right; font-variant-numeric: tabular-nums; }
    .pd-facts p { margin: 0; font-size: 0.85rem; color: var(--text-secondary); line-height: 1.5; }
</style>
