@page "/phase-diagram"
@inject IProgressService Progress
@inject NavigationManager Nav

@if (!unlocked)
{
    <div class="page-header">
        <button class="back-btn" aria-label="Back to home" @onclick='() => Nav.NavigateTo("/")'><Icon Name="arrow-left" Size="18" /></button>
        <h1>Phase Diagram Explorer</h1>
    </div>
    <div class="card" style="text-align: center; padding: 40px 24px">
        <Icon Name="lock" Size="40" Stroke="var(--text-muted)" />
        <h2 style="margin-top: 12px">Locked</h2>
        <p style="color: var(--text-secondary)">Purchase "Phase Diagram Explorer" from the Shop to unlock.</p>
        <button class="btn btn-accent" @onclick='() => Nav.NavigateTo("/shop")'>Go to Shop</button>
    </div>
}
else
{
    <div class="page-header">
        <button class="back-btn" aria-label="Back to home" @onclick='() => Nav.NavigateTo("/")'><Icon Name="arrow-left" Size="18" /></button>
        <h1>Phase Diagram Explorer</h1>
    </div>

    <div class="card pd-intro">
        <Icon Name="flask" Size="22" Stroke="var(--accent)" />
        <p>Drag the cursor or use sliders. Watch the substance flip between solid, liquid, gas, and supercritical fluid as temperature and pressure change.</p>
    </div>

    <div class="card pd-substance-card">
        <label class="pd-label">Substance</label>
        <div class="pd-subs">
            @foreach (var s in substances)
            {
                var sx = s;
                <button class="pd-sub @(selected.Name == sx.Name ? "active" : "")" @onclick="() => selected = sx">@sx.Name</button>
            }
        </div>
    </div>

    <div class="card pd-diagram-card">
        @{
            var phase = ComputePhase(temperature, pressure, selected);
            var dotX = TempToX(temperature, selected);
            var dotY = PressureToY(pressure, selected);
        }
        <div class="pd-phase-readout" style="@($"background:{phase.Color}")">
            <strong>@phase.Name</strong>
            <small>@phase.Note</small>
        </div>

        <svg viewBox="0 0 320 240" class="pd-svg" @onclick="OnDiagramClick">
            <rect x="40" y="20" width="260" height="180" fill="var(--bg-surface)" stroke="var(--border)"/>

            @{
                var tp = (X: TempToX(selected.TripleT, selected), Y: PressureToY(selected.TriplePressLog, selected));
                var cp = (X: TempToX(selected.CriticalT, selected), Y: PressureToY(selected.CriticalPressLog, selected));
            }

            <path d="@($"M40,200 L{tp.X.ToString(System.Globalization.CultureInfo.InvariantCulture)},{tp.Y.ToString(System.Globalization.CultureInfo.InvariantCulture)}")" stroke="#7B68EE" stroke-width="2" fill="none"/>
            <path d="@($"M{tp.X.ToString(System.Globalization.CultureInfo.InvariantCulture)},{tp.Y.ToString(System.Globalization.CultureInfo.InvariantCulture)} L{(selected.SolidLiquidSlope > 0 ? cp.X - 30 : cp.X - 80).ToString(System.Globalization.CultureInfo.InvariantCulture)},20")" stroke="#4A90D9" stroke-width="2" fill="none"/>
            <path d="@($"M{tp.X.ToString(System.Globalization.CultureInfo.InvariantCulture)},{tp.Y.ToString(System.Globalization.CultureInfo.InvariantCulture)} Q{((tp.X + cp.X) / 2).ToString(System.Globalization.CultureInfo.InvariantCulture)},{((tp.Y + cp.Y) / 2 - 20).ToString(System.Globalization.CultureInfo.InvariantCulture)} {cp.X.ToString(System.Globalization.CultureInfo.InvariantCulture)},{cp.Y.ToString(System.Globalization.CultureInfo.InvariantCulture)}")" stroke="#E74C3C" stroke-width="2" fill="none"/>

            <circle cx="@tp.X.ToString(System.Globalization.CultureInfo.InvariantCulture)" cy="@tp.Y.ToString(System.Globalization.CultureInfo.InvariantCulture)" r="4" fill="#F39C12"/>
            <text x="@((tp.X + 6).ToString(System.Globalization.CultureInfo.InvariantCulture))" y="@((tp.Y + 4).ToString(System.Globalization.CultureInfo.InvariantCulture))" font-size="9" fill="var(--text-secondary)">Triple</text>

            <circle cx="@cp.X.ToString(System.Globalization.CultureInfo.InvariantCulture)" cy="@cp.Y.ToString(System.Globalization.CultureInfo.InvariantCulture)" r="4" fill="#9B59B6"/>
            <text x="@((cp.X - 30).ToString(System.Globalization.CultureInfo.InvariantCulture))" y="@((cp.Y - 6).ToString(System.Globalization.CultureInfo.InvariantCulture))" font-size="9" fill="var(--text-secondary)">Critical</text>

            <text x="120" y="60" font-size="11" fill="#4A90D9" opacity="0.6">solid</text>
            <text x="180" y="120" font-size="11" fill="#1ABC9C" opacity="0.6">liquid</text>
            <text x="220" y="180" font-size="11" fill="#E67E22" opacity="0.6">gas</text>
            <text x="240" y="50" font-size="10" fill="#9B59B6" opacity="0.6">supercrit.</text>

            <circle cx="@dotX.ToString(System.Globalization.CultureInfo.InvariantCulture)" cy="@dotY.ToString(System.Globalization.CultureInfo.InvariantCulture)" r="7" fill="@phase.Color" stroke="white" stroke-width="2"/>

            <text x="40" y="218" font-size="9" fill="var(--text-muted)">@selected.MinT.ToString("0")K</text>
            <text x="296" y="218" font-size="9" fill="var(--text-muted)" text-anchor="end">@selected.MaxT.ToString("0")K</text>
            <text x="40" y="14" font-size="9" fill="var(--text-muted)">log P</text>
            <text x="160" y="232" font-size="9" fill="var(--text-muted)" text-anchor="middle">Temperature</text>
        </svg>

        <div class="pd-sliders">
            <label>T = @temperature.ToString("0") K
                <input type="range" min="@selected.MinT" max="@selected.MaxT" step="1" @bind="temperature" @bind:event="oninput"/>
            </label>
            <label>log P = @pressure.ToString("0.0")
                <input type="range" min="-3" max="9" step="0.1" @bind="pressure" @bind:event="oninput"/>
            </label>
        </div>
    </div>
}

@code {
    private bool unlocked;
    private double temperature = 300;
    private double pressure = 5;
    private Substance selected = substances[0];

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            var profile = await Progress.GetProfileAsync();
            unlocked = profile.ShopPurchases.Contains("unlock-phase-diagram");
            StateHasChanged();
        }
    }

    private void OnDiagramClick() { /* svg click handled implicitly via sliders for now */ }

    private double TempToX(double t, Substance s) => 40 + (t - s.MinT) / (s.MaxT - s.MinT) * 260;
    private double PressureToY(double logP, Substance s) => 200 - (logP + 3) / 12 * 180;

    private record Phase(string Name, string Note, string Color);
    private record Substance(string Name, double MinT, double MaxT, double TripleT, double TriplePressLog, double CriticalT, double CriticalPressLog, double SolidLiquidSlope, string Trivia);

    private static readonly List<Substance> substances = new()
    {
        new("Water", 200, 700, 273.16, -2.21, 647, 7.34, -1, "Solid-liquid line slopes left -- ice is less dense than water. Almost no other substance does this."),
        new("CO2", 150, 400, 216.6, 5.74, 304, 6.87, 1, "No liquid CO2 below 5.18 bar. Sublimates at atmospheric pressure (\"dry ice\")."),
        new("Helium-4", 0.5, 10, 2.18, 4.4, 5.2, 5.34, 1, "Lambda point at 2.17 K marks transition to superfluid. Doesn't solidify under pressure alone -- requires ~25 bar even at 0 K."),
        new("Iron", 800, 8000, 1810, 4.5, 9250, 8.8, 1, "Earth's inner core is solid iron at ~5500 K -- because pressure is enormous (~360 GPa). Without pressure it would be vapor.")
    };

    private Phase ComputePhase(double t, double logP, Substance s)
    {
        if (t > s.CriticalT && logP > s.CriticalPressLog) return new("Supercritical", "Density of liquid, diffusion of gas. " + s.Trivia, "#9B59B6");
        if (logP < s.TriplePressLog && t < s.CriticalT) return new("Gas", "Loose, fast, incompressible at low P. Below triple-point pressure, no liquid forms.", "#E67E22");
        if (t < s.TripleT) return new("Solid", "Lattice locked. " + s.Trivia, "#4A90D9");
        var sublimateCutoff = s.TriplePressLog + (logP - s.TriplePressLog);
        var meltLine = s.TripleT + (s.SolidLiquidSlope * (logP - s.TriplePressLog) * 8);
        if (t < meltLine) return new("Solid", "Crystal structure stable.", "#4A90D9");
        var vaporLine = s.TripleT + (s.CriticalT - s.TripleT) * (logP - s.TriplePressLog) / Math.Max(0.5, s.CriticalPressLog - s.TriplePressLog);
        if (t < vaporLine) return new("Liquid", "Molecules sliding past each other.", "#1ABC9C");
        return new("Gas", "Fully vaporized.", "#E67E22");
    }
}

<style>
    .pd-intro { display: flex; align-items: flex-start; gap: 12px; padding: 14px; }
    .pd-intro p { margin: 0; font-size: 0.9rem; color: var(--text-secondary); line-height: 1.5; }

    .pd-substance-card { padding: 12px 14px; }
    .pd-label { display: block; font-size: 0.75rem; text-transform: uppercase; letter-spacing: 0.5px; color: var(--text-muted); margin-bottom: 6px; font-weight: 700; }
    .pd-subs { display: flex; gap: 6px; flex-wrap: wrap; }
    .pd-sub { padding: 6px 14px; background: var(--bg-surface); border: 1px solid var(--border); border-radius: 14px; font-size: 0.85rem; color: var(--text-secondary); cursor: pointer; }
    .pd-sub.active { background: var(--primary); color: white; border-color: var(--primary); }

    .pd-diagram-card { padding: 14px; }
    .pd-phase-readout { padding: 10px 14px; border-radius: var(--radius-sm); color: white; margin-bottom: 12px; }
    .pd-phase-readout strong { display: block; font-size: 1.05rem; }
    .pd-phase-readout small { font-size: 0.78rem; opacity: 0.92; line-height: 1.45; }

    .pd-svg { width: 100%; height: auto; max-height: 280px; display: block; }
    .pd-sliders { margin-top: 10px; display: flex; flex-direction: column; gap: 8px; }
    .pd-sliders label { display: flex; flex-direction: column; gap: 4px; font-size: 0.8rem; color: var(--text-secondary); font-weight: 600; }
    .pd-sliders input[type=range] { accent-color: var(--primary); }
</style>
