<style>
    .era-display {
        padding: 12px 14px; margin-bottom: 12px; text-align: center;
    }
    .era-year-row {
        display: flex; align-items: center; justify-content: center; gap: 8px;
    }
    .era-year {
        font-size: 1.6rem; font-weight: 800; color: var(--accent);
        letter-spacing: 0.5px;
    }
    .era-headline {
        margin-top: 4px; color: var(--text-secondary); font-size: 0.85rem; font-style: italic;
    }

    .map-wrap {
        padding: 8px; margin-bottom: 12px; overflow: hidden;
        background: linear-gradient(135deg, #1a1610, #2a2218 60%, #1a1610);
        border: 1px solid rgba(212, 184, 134, 0.25);
        box-shadow: inset 0 0 24px rgba(0,0,0,0.5), 0 4px 18px rgba(0,0,0,0.35);
    }
    .world-svg {
        width: 100%; height: auto; display: block;
        border-radius: var(--radius-sm);
        background: radial-gradient(ellipse at center, #2c4a6c 0%, #1a2f4a 70%, #0d1a2a 100%);
    }
    .continent {
        fill: #d8c89c;
        stroke: #6b5634;
        stroke-width: 1.2;
        stroke-linejoin: round;
    }
    .era-region-group {
        cursor: pointer;
        -webkit-tap-highlight-color: transparent;
        transition: opacity 0.3s ease;
    }
    .era-region-group.dimmed { opacity: 0.35; }
    .era-region-fill {
        fill-opacity: 0.5;
        stroke-opacity: 0.95;
        stroke-width: 1.6;
        stroke-linejoin: round;
        transition: fill-opacity 0.25s ease, stroke-width 0.25s ease, d 0.4s ease;
    }
    .era-region-glow {
        fill: none;
        stroke-opacity: 0.35;
        stroke-width: 6;
        stroke-linejoin: round;
        filter: blur(2px);
        transition: stroke-width 0.25s ease, stroke-opacity 0.25s ease;
    }
    .era-region-group:hover .era-region-fill,
    .era-region-group.selected .era-region-fill {
        fill-opacity: 0.78;
        stroke-width: 2.4;
    }
    .era-region-group:hover .era-region-glow,
    .era-region-group.selected .era-region-glow {
        stroke-opacity: 0.7;
        stroke-width: 9;
    }
    .era-region-hatch {
        fill-opacity: 0.45;
        pointer-events: none;
    }
    .cap-label {
        font-size: 11px; font-weight: 700; fill: #fff7e0;
        font-family: 'Cinzel', Georgia, serif;
        letter-spacing: 0.5px;
    }
    .compass-n { font-size: 9px; font-weight: 700; fill: #d4b886; font-family: 'Cinzel', Georgia, serif; }
    .compass-letter { font-size: 8px; font-weight: 600; fill: #d4b886; font-family: 'Cinzel', Georgia, serif; opacity: 0.85; }
    .scale-text { font-size: 9px; fill: #e8d9b0; font-family: Georgia, serif; opacity: 0.85; }
    .cartouche-era {
        font-size: 14px; font-weight: 700; fill: #f3e3b8;
        font-family: 'Cinzel', Georgia, serif;
        letter-spacing: 1.5px;
    }
    .cartouche-sub {
        font-size: 9px; fill: #d4b886; font-family: Georgia, serif;
        letter-spacing: 0.5px; font-style: italic;
    }

    .legend {
        padding: 12px 14px; margin-bottom: 12px;
    }
    .legend-title {
        display: flex; align-items: center; gap: 6px;
        font-size: 0.8rem; color: var(--text-muted);
        text-transform: uppercase; letter-spacing: 0.5px;
        margin-bottom: 10px;
    }
    .legend-grid {
        display: grid; grid-template-columns: repeat(auto-fill, minmax(140px, 1fr));
        gap: 6px;
    }
    .legend-item {
        display: flex; align-items: center; gap: 8px;
        padding: 6px 8px; border-radius: var(--radius-sm);
        background: var(--bg-card); border: 1px solid var(--border);
        cursor: pointer; transition: all 0.15s ease;
        text-align: left; -webkit-tap-highlight-color: transparent;
    }
    .legend-item:active { transform: scale(0.97); }
    .legend-item.legend-active {
        border-color: var(--primary);
        background: color-mix(in srgb, var(--primary) 8%, transparent);
    }
    .legend-swatch {
        width: 14px; height: 14px; border-radius: 3px; flex-shrink: 0;
        border: 1px solid rgba(0,0,0,0.15);
    }
    .legend-name {
        font-size: 0.82rem; color: var(--text-primary); font-weight: 600;
        white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
    }

    .info-panel {
        padding: 0; margin-bottom: 12px; overflow: hidden;
        animation: slideDown 0.25s ease;
    }
    .info-header {
        display: flex; align-items: center; gap: 10px;
        padding: 10px 12px;
        border-bottom: 2px solid var(--border);
        background: var(--bg-surface);
    }
    .info-swatch {
        width: 18px; height: 18px; border-radius: 4px; flex-shrink: 0;
        border: 1px solid rgba(0,0,0,0.2);
    }
    .info-titles { flex: 1; min-width: 0; }
    .info-titles strong { display: block; font-size: 0.95rem; color: var(--text-primary); }
    .info-titles small { color: var(--text-muted); font-size: 0.78rem; }
    .close-btn {
        background: transparent; border: none; color: var(--text-muted);
        font-size: 1.1rem; font-weight: 700; cursor: pointer;
        width: 28px; height: 28px; border-radius: 50%;
        -webkit-tap-highlight-color: transparent;
    }
    .close-btn:hover { background: var(--bg-card); color: var(--text-primary); }
    .info-desc {
        margin: 0; padding: 12px 14px;
        font-size: 0.88rem; line-height: 1.55;
        color: var(--text-secondary);
    }

    .slider-card {
        padding: 12px 14px; margin-bottom: 16px;
    }
    .slider-row {
        display: flex; align-items: center; gap: 10px;
    }
    .era-slider {
        flex: 1; appearance: none; -webkit-appearance: none;
        height: 6px; border-radius: 3px;
        background: color-mix(in srgb, var(--primary) 30%, var(--bg-surface));
        outline: none;
    }
    .era-slider::-webkit-slider-thumb {
        -webkit-appearance: none; appearance: none;
        width: 20px; height: 20px; border-radius: 50%;
        background: var(--bg-card); border: 2px solid var(--primary);
        cursor: pointer; box-shadow: 0 1px 4px var(--shadow);
    }
    .era-slider::-moz-range-thumb {
        width: 20px; height: 20px; border-radius: 50%;
        background: var(--bg-card); border: 2px solid var(--primary);
        cursor: pointer; box-shadow: 0 1px 4px var(--shadow);
    }
    .slider-count {
        font-size: 0.8rem; color: var(--text-muted); font-weight: 600;
        min-width: 40px; text-align: right;
    }

    .era-ticks {
        display: flex; flex-wrap: wrap; gap: 4px;
        margin-top: 10px; justify-content: center;
    }
    .era-tick {
        padding: 4px 8px; font-size: 0.7rem; font-weight: 600;
        color: var(--text-muted); background: var(--bg-card);
        border: 1px solid var(--border); border-radius: var(--radius-sm);
        cursor: pointer; transition: all 0.15s ease;
        -webkit-tap-highlight-color: transparent;
    }
    .era-tick:hover { color: var(--text-primary); border-color: var(--primary); }
    .era-tick.tick-active {
        background: var(--primary); color: white; border-color: var(--primary);
    }

    .slider-actions {
        display: flex; justify-content: space-between; gap: 8px; margin-top: 10px;
    }
    .slider-actions .btn:last-child :first-child { transform: rotate(180deg); }

    @@keyframes slideDown {
        from { opacity: 0; transform: translateY(-8px); }
        to { opacity: 1; transform: translateY(0); }
    }

    @@media (prefers-reduced-motion: reduce) {
        .info-panel { animation: none; }
        .era-region-group, .era-region-fill, .era-region-glow { transition: none; }
    }
</style>
