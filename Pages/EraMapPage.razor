@page "/era-map"
@inject NavigationManager Nav

<div class="page-header">
    <button class="back-btn" aria-label="Back to home" @onclick='() => Nav.NavigateTo("/")'><Icon Name="arrow-left" Size="18" /></button>
    <h1>Era Map</h1>
</div>

<div class="era-display card">
    <div class="era-year-row">
        <Icon Name="clock" Size="22" Stroke="var(--accent)" />
        <div class="era-year">@CurrentEra.Label</div>
    </div>
    <div class="era-headline">@CurrentEra.Headline</div>
</div>

<div class="map-wrap card">
    <svg viewBox="0 0 1000 500" preserveAspectRatio="xMidYMid meet" class="world-svg" role="img" aria-label="World map">
        <defs>
            <radialGradient id="oceanGrad" cx="50%" cy="50%" r="70%">
                <stop offset="0%" stop-color="#3a6f9c" stop-opacity="0.25" />
                <stop offset="60%" stop-color="#2a4d70" stop-opacity="0.35" />
                <stop offset="100%" stop-color="#1a2f4a" stop-opacity="0.55" />
            </radialGradient>
            <linearGradient id="paperGrad" x1="0" y1="0" x2="1" y2="1">
                <stop offset="0%" stop-color="#e8d9b0" stop-opacity="0.18" />
                <stop offset="50%" stop-color="#d4b886" stop-opacity="0.10" />
                <stop offset="100%" stop-color="#a08858" stop-opacity="0.22" />
            </linearGradient>
            <pattern id="paperTex" x="0" y="0" width="120" height="120" patternUnits="userSpaceOnUse">
                <rect width="120" height="120" fill="url(#paperGrad)" />
                <circle cx="20" cy="30" r="0.8" fill="#000" fill-opacity="0.05" />
                <circle cx="80" cy="60" r="0.6" fill="#000" fill-opacity="0.04" />
                <circle cx="50" cy="100" r="1.0" fill="#000" fill-opacity="0.06" />
                <circle cx="100" cy="20" r="0.5" fill="#000" fill-opacity="0.03" />
                <circle cx="35" cy="80" r="0.7" fill="#000" fill-opacity="0.04" />
            </pattern>
            <pattern id="hatch" x="0" y="0" width="6" height="6" patternUnits="userSpaceOnUse" patternTransform="rotate(45)">
                <line x1="0" y1="0" x2="0" y2="6" stroke="#fff" stroke-width="1" stroke-opacity="0.35" />
            </pattern>
            <filter id="softShadow" x="-20%" y="-20%" width="140%" height="140%">
                <feGaussianBlur in="SourceAlpha" stdDeviation="2" />
                <feOffset dx="1" dy="2" result="off" />
                <feComponentTransfer><feFuncA type="linear" slope="0.35" /></feComponentTransfer>
                <feMerge><feMergeNode /><feMergeNode in="SourceGraphic" /></feMerge>
            </filter>
            <filter id="rough">
                <feTurbulence type="fractalNoise" baseFrequency="0.8" numOctaves="2" seed="3" />
                <feDisplacementMap in="SourceGraphic" scale="1.2" />
            </filter>
            <radialGradient id="vignette" cx="50%" cy="50%" r="75%">
                <stop offset="60%" stop-color="#000" stop-opacity="0" />
                <stop offset="100%" stop-color="#000" stop-opacity="0.35" />
            </radialGradient>
            <pattern id="latlong" x="0" y="0" width="50" height="50" patternUnits="userSpaceOnUse">
                <path d="M 50 0 L 0 0 0 50" fill="none" stroke="#ffffff" stroke-width="0.4" stroke-opacity="0.08" />
            </pattern>
        </defs>

        <rect x="0" y="0" width="1000" height="500" fill="url(#oceanGrad)" />
        <rect x="0" y="0" width="1000" height="500" fill="url(#latlong)" />

        <g class="graticule" opacity="0.18">
            @for (int i = 0; i < 9; i++)
            {
                var cy = 50 + i * 50;
                <ellipse cx="500" cy="@cy" rx="@(490 - Math.Abs(i - 4) * 12)" ry="3" fill="none" stroke="#ffffff" stroke-width="0.3" />
            }
        </g>

        <g class="continents" filter="url(#softShadow)">
            <path class="continent" d="M 60,90 Q 130,75 200,70 Q 245,85 260,110 Q 275,140 270,170 Q 250,195 230,210 Q 215,235 200,260 Q 175,280 150,290 Q 125,280 110,260 Q 90,230 80,200 Q 65,175 60,150 Q 55,120 60,90 Z" />
            <path class="continent" d="M 200,260 Q 220,258 240,260 Q 260,278 270,300 Q 262,318 250,330 Q 232,328 220,320 Q 210,305 205,290 Q 200,275 200,260 Z" />
            <path class="continent" d="M 250,330 Q 282,318 310,310 Q 328,335 340,360 Q 338,392 330,420 Q 312,448 290,470 Q 273,468 260,460 Q 250,432 245,400 Q 240,378 240,360 Q 244,344 250,330 Z" />
            <path class="continent" d="M 320,60 Q 352,52 380,50 Q 395,68 400,90 Q 388,102 370,110 Q 348,108 330,100 Q 322,80 320,60 Z" />
            <path class="continent" d="M 450,90 Q 495,82 540,80 Q 565,88 580,100 Q 590,118 590,140 Q 578,158 560,170 Q 535,172 510,170 Q 488,162 470,150 Q 458,135 450,120 Q 446,105 450,90 Z" />
            <path class="continent" d="M 470,180 Q 515,178 560,180 Q 585,198 600,220 Q 610,253 610,290 Q 602,325 590,360 Q 568,385 540,400 Q 518,402 500,400 Q 482,382 470,360 Q 463,325 460,290 Q 458,258 460,230 Q 463,205 470,180 Z" />
            <path class="continent" d="M 590,170 Q 615,162 640,160 Q 658,178 670,200 Q 666,222 660,240 Q 638,248 620,250 Q 608,238 600,220 Q 593,195 590,170 Z" />
            <path class="continent" d="M 580,70 Q 715,62 850,60 Q 880,78 900,100 Q 893,128 880,150 Q 838,162 800,170 Q 750,167 700,160 Q 658,152 620,140 Q 597,125 580,110 Q 577,90 580,70 Z" />
            <path class="continent" d="M 640,160 Q 700,164 760,170 Q 775,190 780,210 Q 772,232 760,250 Q 728,258 700,260 Q 683,247 670,230 Q 663,215 660,200 Q 648,180 640,160 Z" />
            <path class="continent" d="M 780,150 Q 830,148 880,150 Q 895,175 900,200 Q 892,232 880,260 Q 848,262 820,260 Q 798,248 780,230 Q 773,210 770,190 Q 774,170 780,150 Z" />
            <path class="continent" d="M 780,260 Q 820,264 860,270 Q 870,290 870,310 Q 850,322 830,330 Q 808,322 790,310 Q 783,295 780,280 Q 778,270 780,260 Z" />
            <path class="continent" d="M 700,230 Q 730,234 760,240 Q 762,265 760,290 Q 745,310 730,330 Q 712,322 700,310 Q 692,285 690,260 Q 693,243 700,230 Z" />
            <path class="continent" d="M 900,170 Q 912,168 920,170 Q 924,190 925,210 Q 915,218 905,220 Q 902,195 900,170 Z" />
            <path class="continent" d="M 820,360 Q 870,354 920,350 Q 933,372 940,390 Q 928,408 910,420 Q 880,422 850,420 Q 833,412 820,400 Q 818,378 820,360 Z" />
            <path class="continent" d="M 950,420 Q 962,420 970,420 Q 974,432 975,445 Q 965,449 955,450 Q 952,435 950,420 Z" />
        </g>

        <g class="continents-tex" pointer-events="none">
            <path d="M 60,90 Q 130,75 200,70 Q 245,85 260,110 Q 275,140 270,170 Q 250,195 230,210 Q 215,235 200,260 Q 175,280 150,290 Q 125,280 110,260 Q 90,230 80,200 Q 65,175 60,150 Q 55,120 60,90 Z" fill="url(#paperTex)" />
            <path d="M 250,330 Q 282,318 310,310 Q 328,335 340,360 Q 338,392 330,420 Q 312,448 290,470 Q 273,468 260,460 Q 250,432 245,400 Q 240,378 240,360 Q 244,344 250,330 Z" fill="url(#paperTex)" />
            <path d="M 470,180 Q 515,178 560,180 Q 585,198 600,220 Q 610,253 610,290 Q 602,325 590,360 Q 568,385 540,400 Q 518,402 500,400 Q 482,382 470,360 Q 463,325 460,290 Q 458,258 460,230 Q 463,205 470,180 Z" fill="url(#paperTex)" />
            <path d="M 580,70 Q 715,62 850,60 Q 880,78 900,100 Q 893,128 880,150 Q 838,162 800,170 Q 750,167 700,160 Q 658,152 620,140 Q 597,125 580,110 Q 577,90 580,70 Z" fill="url(#paperTex)" />
            <path d="M 450,90 Q 495,82 540,80 Q 565,88 580,100 Q 590,118 590,140 Q 578,158 560,170 Q 535,172 510,170 Q 488,162 470,150 Q 458,135 450,120 Q 446,105 450,90 Z" fill="url(#paperTex)" />
            <path d="M 820,360 Q 870,354 920,350 Q 933,372 940,390 Q 928,408 910,420 Q 880,422 850,420 Q 833,412 820,400 Q 818,378 820,360 Z" fill="url(#paperTex)" />
        </g>

        <g class="era-regions">
            @foreach (var region in CurrentEra.Regions)
            {
                var r = region;
                var isSelected = selectedRegion?.Name == r.Name;
                var isHover = hoverRegion?.Name == r.Name;
                var pathD = SmoothPath(r.Points);
                var dimmed = (selectedRegion != null && !isSelected) || (hoverRegion != null && !isHover && selectedRegion == null);
                <g class="era-region-group @(dimmed ? "dimmed" : "") @(isSelected ? "selected" : "")"
                   @onclick="() => SelectRegion(r)"
                   @onpointerenter="e => HoverRegion(e, r)"
                   @onpointerleave="() => hoverRegion = null">
                    <path class="era-region-glow" d="@pathD" stroke="@r.Color" />
                    <path class="era-region-fill" d="@pathD" fill="@r.Color" stroke="@r.Color" />
                    @if (isSelected)
                    {
                        <path class="era-region-hatch" d="@pathD" fill="url(#hatch)" />
                    }
                    <title>@r.Name (@r.Dates)</title>
                </g>
            }
        </g>

        <g class="capitals" pointer-events="none">
            @foreach (var region in CurrentEra.Regions)
            {
                var r = region;
                var isSelected = selectedRegion?.Name == r.Name;
                <g transform="translate(@Fmt(r.CapX),@Fmt(r.CapY))">
                    @if (isSelected)
                    {
                        <circle r="9.5" fill="none" stroke="#fff7e0" stroke-width="1.2" stroke-opacity="0.85" />
                    }
                    <circle r="6" fill="@r.Color" stroke="#fff7e0" stroke-width="1.5" />
                    <path d="M -3,-2 L 0,-5 L 3,-2 L 2,2 L -2,2 Z" fill="#fff7e0" stroke="#000" stroke-width="0.3" stroke-opacity="0.4" />
                </g>
            }
        </g>

        @if (hoverRegion != null || selectedRegion != null)
        {
            var lbl = selectedRegion ?? hoverRegion!;
            var lines = LabelLines(lbl.Name);
            var w = lines.Max(LabelWidth) + 14;
            var h = lines.Length * 13 + 5;
            var lx = Math.Clamp(lbl.CapX, 12 + w / 2, 988 - w / 2);
            var top = lbl.CapY - 12 - h < 12 ? lbl.CapY + 12 : lbl.CapY - 12 - h;
            <g class="floating-label" pointer-events="none" transform="translate(@Fmt(lx),@Fmt(top))">
                <rect x="@Fmt(-w / 2)" y="0" width="@Fmt(w)" height="@h" rx="3" fill="rgba(20,18,12,0.85)" stroke="@lbl.Color" stroke-width="1" />
                <text text-anchor="middle" class="cap-label">
                    @for (int i = 0; i < lines.Length; i++)
                    {
                        <tspan x="0" y="@(13 + i * 13)">@lines[i]</tspan>
                    }
                </text>
            </g>
        }

        <g class="compass" transform="translate(940,80)" pointer-events="none">
            <circle r="28" fill="rgba(20,18,12,0.55)" stroke="#d4b886" stroke-width="1" stroke-opacity="0.6" />
            <circle r="22" fill="none" stroke="#d4b886" stroke-width="0.4" stroke-opacity="0.4" />
            <path d="M 0,-22 L 4,0 L 0,22 L -4,0 Z" fill="#d4b886" fill-opacity="0.85" />
            <path d="M -22,0 L 0,4 L 22,0 L 0,-4 Z" fill="#d4b886" fill-opacity="0.55" />
            <path d="M 0,-22 L 4,0 L -4,0 Z" fill="#e8d9b0" />
            <text x="0" y="-30" text-anchor="middle" class="compass-n">N</text>
            <text x="0" y="36" text-anchor="middle" class="compass-letter">S</text>
            <text x="-32" y="3" text-anchor="middle" class="compass-letter">W</text>
            <text x="32" y="3" text-anchor="middle" class="compass-letter">E</text>
        </g>

        <g class="scale-bar" transform="translate(40,460)" pointer-events="none">
            <line x1="0" y1="0" x2="120" y2="0" stroke="#e8d9b0" stroke-width="2" stroke-opacity="0.7" />
            <line x1="0" y1="-4" x2="0" y2="4" stroke="#e8d9b0" stroke-width="1.2" stroke-opacity="0.7" />
            <line x1="40" y1="-3" x2="40" y2="3" stroke="#e8d9b0" stroke-width="1" stroke-opacity="0.7" />
            <line x1="80" y1="-3" x2="80" y2="3" stroke="#e8d9b0" stroke-width="1" stroke-opacity="0.7" />
            <line x1="120" y1="-4" x2="120" y2="4" stroke="#e8d9b0" stroke-width="1.2" stroke-opacity="0.7" />
            <text x="60" y="-8" text-anchor="middle" class="scale-text">~ 5000 km</text>
        </g>

        <rect x="0" y="0" width="1000" height="500" fill="url(#vignette)" pointer-events="none" />
        <rect x="3" y="3" width="994" height="494" fill="none" stroke="#d4b886" stroke-width="1.2" stroke-opacity="0.45" rx="4" pointer-events="none" />
        <rect x="8" y="8" width="984" height="484" fill="none" stroke="#d4b886" stroke-width="0.5" stroke-opacity="0.35" rx="3" pointer-events="none" />

        <g class="map-cartouche" pointer-events="none">
            <rect x="20" y="20" width="190" height="34" rx="3" fill="rgba(20,18,12,0.6)" stroke="#d4b886" stroke-opacity="0.5" />
            <text x="115" y="38" text-anchor="middle" class="cartouche-era">@CurrentEra.Label</text>
            <text x="115" y="49" text-anchor="middle" class="cartouche-sub">@($"{CurrentEra.Regions.Count} civilizations")</text>
        </g>
    </svg>
</div>

<div class="legend card">
    <div class="legend-title"><Icon Name="scroll" Size="16" Stroke="var(--text-muted)" /> Civilizations</div>
    <div class="legend-grid">
        @foreach (var civ in CurrentEra.Regions.GroupBy(r => r.Name).Select(g => g.First()))
        {
            var c = civ;
            <button class="legend-item @(selectedRegion?.Name == c.Name ? "legend-active" : "")"
                    @onclick="() => SelectRegion(c)">
                <span class="legend-swatch" style="background: @c.Color"></span>
                <span class="legend-name">@c.Name</span>
            </button>
        }
    </div>
</div>

@if (selectedRegion != null)
{
    <div class="info-panel card">
        <div class="info-header" style="border-color: @selectedRegion.Color">
            <div class="info-swatch" style="background: @selectedRegion.Color"></div>
            <div class="info-titles">
                <strong>@selectedRegion.Name</strong>
                <small>@selectedRegion.Dates @(string.IsNullOrEmpty(selectedRegion.Capital) ? "" : "  -  " + selectedRegion.Capital)</small>
            </div>
            <button class="close-btn" aria-label="Close" @onclick="() => selectedRegion = null">x</button>
        </div>
        <p class="info-desc">@selectedRegion.Description</p>
    </div>
}

<div class="slider-card card">
    <div class="slider-row">
        <Icon Name="calendar" Size="18" Stroke="var(--text-muted)" />
        <input type="range" min="0" max="@(eras.Count - 1)" step="1" value="@eraIndex"
               @oninput="OnSliderInput" class="era-slider" aria-label="Era slider" />
        <span class="slider-count">@(eraIndex + 1)/@eras.Count</span>
    </div>
    <div class="era-ticks">
        @for (int i = 0; i < eras.Count; i++)
        {
            var idx = i;
            var era = eras[i];
            <button class="era-tick @(idx == eraIndex ? "tick-active" : "")"
                    @onclick="() => JumpToEra(idx)"
                    title="@era.Label">@era.ShortLabel</button>
        }
    </div>
    <div class="slider-actions">
        <button class="btn btn-sm btn-outline" @onclick="StepBack" disabled="@(eraIndex == 0)">
            <Icon Name="arrow-left" Size="14" /> Earlier
        </button>
        <button class="btn btn-sm btn-outline" @onclick="StepForward" disabled="@(eraIndex == eras.Count - 1)">
            Later <Icon Name="arrow-left" Size="14" />
        </button>
    </div>
</div>

@code {
    private int eraIndex = 4; // start at 117 AD (Roman peak)
    private Region? selectedRegion;
    private Region? hoverRegion;

    private Era CurrentEra => eras[eraIndex];

    private void OnSliderInput(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out var v))
            JumpToEra(v);
    }

    private void JumpToEra(int i)
    {
        eraIndex = Math.Clamp(i, 0, eras.Count - 1);
        selectedRegion = null;
        hoverRegion = null;
    }

    private void StepBack() => JumpToEra(eraIndex - 1);
    private void StepForward() => JumpToEra(eraIndex + 1);

    private void SelectRegion(Region r) => selectedRegion = selectedRegion?.Name == r.Name ? null : r;

    // Touch taps also raise pointerenter but no reliable leave, so only a real mouse drives hover.
    private void HoverRegion(PointerEventArgs e, Region r)
    {
        if (e.PointerType == "mouse") hoverRegion = r;
    }

    private static string Fmt(double v) => v.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture);

    private static string[] LabelLines(string name)
    {
        if (name.Length <= 18) return new[] { name };
        var split = name.IndexOf(" (", StringComparison.Ordinal);
        for (int d = 0, mid = name.Length / 2; split < 0 && d <= mid; d++)
        {
            if (name[mid - d] == ' ') split = mid - d;
            else if (mid + d < name.Length && name[mid + d] == ' ') split = mid + d;
        }
        return split > 0 ? new[] { name[..split], name[(split + 1)..] } : new[] { name };
    }

    // Rough advance widths for 11px Cinzel bold plus letter-spacing; SVG text cannot be measured without JS.
    private static double LabelWidth(string s) =>
        s.Sum(ch => ch == ' ' ? 3.8 : char.IsUpper(ch) ? 8.8 : char.IsLetterOrDigit(ch) ? 7.2 : 4.6);

    private static (double x, double y)[] ParsePoints(string points)
    {
        var parts = points.Split(new[] { ' ', ',', '\n', '\r', '\t' }, StringSplitOptions.RemoveEmptyEntries);
        var pts = new List<(double x, double y)>();
        for (int i = 0; i + 1 < parts.Length; i += 2)
        {
            if (double.TryParse(parts[i], System.Globalization.NumberStyles.Any, System.Globalization.CultureInfo.InvariantCulture, out var x)
                && double.TryParse(parts[i + 1], System.Globalization.NumberStyles.Any, System.Globalization.CultureInfo.InvariantCulture, out var y))
                pts.Add((x, y));
        }
        return pts.ToArray();
    }

    private static string SmoothPath(string points)
    {
        var sb = new System.Text.StringBuilder();
        foreach (var ring in points.Split('|'))
        {
            var pts = ParsePoints(ring);
            if (pts.Length < 3) continue;
            var n = pts.Length;
            if (sb.Length > 0) sb.Append(' ');
            sb.Append("M ").Append(Fmt((pts[0].x + pts[n - 1].x) / 2.0)).Append(',').Append(Fmt((pts[0].y + pts[n - 1].y) / 2.0));
            for (int i = 0; i < n; i++)
            {
                var c = pts[i];
                var nxt = pts[(i + 1) % n];
                sb.Append(" Q ").Append(Fmt(c.x)).Append(',').Append(Fmt(c.y))
                  .Append(' ').Append(Fmt((c.x + nxt.x) / 2.0)).Append(',').Append(Fmt((c.y + nxt.y) / 2.0));
            }
            sb.Append(" Z");
        }
        return sb.ToString();
    }

    // Points holds one or more map-space rings separated by '|'; CapX/CapY place the capital marker.
    private record Region(string Name, string Color, string Capital, string Dates, string Description, string Points, double CapX, double CapY);
    private record Era(string Label, string ShortLabel, string Headline, List<Region> Regions);

    // Color palette per civilization family
    private const string C_SUMER     = "#C97B4A";
    private const string C_EGYPT     = "#E0B341";
    private const string C_INDUS     = "#7B68EE";
    private const string C_CHINA     = "#D14545";
    private const string C_HITTITE   = "#8B5E3C";
    private const string C_OLMEC     = "#2E8B57";
    private const string C_PERSIA    = "#3A8FBF";
    private const string C_GREECE    = "#4A90D9";
    private const string C_MAURYA    = "#E67E22";
    private const string C_ROME      = "#9C2B2B";
    private const string C_CARTHAGE  = "#8E3B8A";
    private const string C_SELEUCID  = "#2A9D8F";
    private const string C_PARTHIA   = "#5D4E8C";
    private const string C_KUSHAN    = "#A0522D";
    private const string C_TEOTI     = "#3E8B3E";
    private const string C_BYZANTINE = "#7C3AED";
    private const string C_SASSANID  = "#1E6FA8";
    private const string C_MAYA      = "#2DAB66";
    private const string C_TIWANAKU  = "#B0671A";
    private const string C_CAROLING  = "#1F4FAA";
    private const string C_ABBASID   = "#0D7C66";
    private const string C_PALA      = "#D2691E";
    private const string C_HEIAN     = "#C71585";
    private const string C_MONGOL    = "#4B0082";
    private const string C_SONG      = "#B22222";
    private const string C_AYYUBID   = "#1B7C58";
    private const string C_HRE       = "#444A78";
    private const string C_INCA      = "#CC5500";
    private const string C_OTTOMAN   = "#0E5C2B";
    private const string C_MING      = "#8B0000";
    private const string C_AZTEC     = "#4F8F4F";
    private const string C_SONGHAI   = "#B8860B";
    private const string C_MUGHAL    = "#6A5ACD";
    private const string C_QING      = "#A52A2A";
    private const string C_SPAIN     = "#C0392B";
    private const string C_RUSSIA    = "#2C3E72";
    private const string C_BRITAIN   = "#9B1C31";
    private const string C_FRANCE    = "#1F4FA8";
    private const string C_GERMANY   = "#3A3A3A";
    private const string C_AUSHUN    = "#8E7CC3";
    private const string C_ROC       = "#C0392B";
    private const string C_USSR      = "#7A1E1E";
    private const string C_USA       = "#4A86D8";
    private const string C_USA_M     = "#2c5fb8";
    private const string C_CHINA_M   = "#B33030";
    private const string C_EU        = "#D4A72C";
    private const string C_INDIA_M   = "#E67E22";
    private const string C_BRAZIL    = "#2E8B57";

    // Shared outlines, reused across eras.
    private const string P_GB         = "466,104 477,100 482,110 489,119 488,127 469,129 470,120 464,112";
    private const string P_IRELAND    = "453,114 463,111 466,121 459,128 451,124";
    private const string P_FRANCE     = "470,134 486,130 500,131 504,138 504,150 496,156 474,156 468,146";
    private const string P_IBERIA     = "456,152 476,148 494,154 494,166 482,176 464,176 456,166";
    private const string P_JAPAN      = "898,168 924,166 930,206 920,224 902,224 900,200";
    private const string P_ALASKA     = "60,90 100,80 104,132 90,144 66,138 58,118";
