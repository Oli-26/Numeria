@page "/profile"
@inject IProgressService Progress
@inject IGamificationService Gamification
@inject IAchievementRepository AchievementRepo
@inject IContentRepository Content
@inject IJSRuntime JS
@inject NavigationManager Nav

<div class="profile-page">
@if (profile != null)
{
    <div class="profile-header card">
        <div class="avatar-display">
            <div class="avatar-circle">
                <span class="avatar-letter">@(profile.DisplayName.Length > 0 ? profile.DisplayName[0] : '?')</span>
                <div class="avatar-ring"></div>
            </div>
            <div class="level-badge">Lvl @level</div>
            @if (!string.IsNullOrEmpty(profile.SelectedTitle))
            {
                <div class="title-badge">@profile.SelectedTitle</div>
            }
        </div>
        <h2>@profile.DisplayName</h2>

        <div class="xp-section">
            <div class="xp-bar-labels">
                <small>Level @level</small>
                <small>Level @(level + 1)</small>
            </div>
            <div class="progress-bar-container" style="height: 14px">
                <div class="progress-bar-fill accent animate-in" style="width: @xpPct.ToString("F0")%"></div>
            </div>
            <small class="xp-detail">@xpInLevel / @xpNeeded XP</small>
        </div>

        <div class="quick-stats">
            <div class="quick-stat">
                <span class="streak-fire"><Icon Name="fire" Size="16" /></span> <strong>@profile.CurrentStreak</strong> day streak
            </div>
            <div class="quick-stat">
                <span><Icon Name="star-filled" Size="16" Fill="currentColor" /></span> <strong>@profile.TotalXp</strong> XP
            </div>
            <div class="quick-stat">
                <span><Icon Name="target" Size="16" /></span> <strong>@overallAccuracy%</strong> accuracy
            </div>
        </div>
        <button class="btn btn-sm btn-outline share-profile-btn" @onclick='() => Nav.NavigateTo("/share")'>
            <Icon Name="trending-up" Size="14" /> Share Progress
        </button>
    </div>

    <!-- Hall of Cards banner -->
    <div class="card cards-banner card-clickable" @onclick='() => Nav.NavigateTo("/cards")'>
        <div class="cards-banner-left">
            <span class="cards-banner-icon">🃏</span>
            <div>
                <strong>Hall of Cards</strong>
                <small>@profile.CompletionCards.Count collected</small>
            </div>
        </div>
        <span class="cards-banner-arrow">→</span>
    </div>

    <!-- Tab navigation -->
    <div class="tab-bar">
        <button class="tab @(activeTab == "overview" ? "active" : "")" @onclick='() => SetTab("overview")'>Overview</button>
        <button class="tab @(activeTab == "topics" ? "active" : "")" @onclick='() => SetTab("topics")'>Topics</button>
        <button class="tab @(activeTab == "history" ? "active" : "")" @onclick='() => SetTab("history")'>History</button>
        <button class="tab @(activeTab == "achievements" ? "active" : "")" @onclick='() => SetTab("achievements")'>Awards</button>
    </div>

    @if (activeTab == "overview")
    {
        <div class="stats-grid section stagger-in tab-content" @key='"overview"'>
            <div class="stat-tile card">
                <span class="stat-icon"><Icon Name="star-filled" Size="20" Fill="currentColor" /></span>
                <span class="stat-value" id="cnt-xp">@profile.TotalXp</span>
                <span class="stat-name">Total XP</span>
            </div>
            <div class="stat-tile card">
                <span class="stat-icon"><Icon Name="phi" Size="20" /></span>
                <span class="stat-value" id="cnt-pts">@profile.Points</span>
                <span class="stat-name">φ (Phi)</span>
            </div>
            <div class="stat-tile card">
                <span class="stat-icon"><Icon Name="fire" Size="20" /></span>
                <span class="stat-value streak-val" id="cnt-streak">@profile.CurrentStreak</span>
                <span class="stat-name">Streak</span>
            </div>
            <div class="stat-tile card">
                <span class="stat-icon"><Icon Name="book" Size="20" /></span>
                <span class="stat-value" id="cnt-lessons">@profile.LessonsCompleted.Count</span>
                <span class="stat-name">Lessons</span>
            </div>
            <div class="stat-tile card">
                <span class="stat-icon"><Icon Name="brain" Size="20" /></span>
                <span class="stat-value" id="cnt-questions">@profile.TotalQuestionsAnswered</span>
                <span class="stat-name">Questions</span>
            </div>
            <div class="stat-tile card">
                <span class="stat-icon"><Icon Name="target" Size="20" /></span>
                <span class="stat-value" id="cnt-acc">@overallAccuracy%</span>
                <span class="stat-name">Accuracy</span>
            </div>
        </div>

        <div class="section">
            <h3>Detailed Stats</h3>
            <div class="detail-stats">
                <div class="detail-row">
                    <span><Icon Name="fire" Size="16" /> Longest Streak</span>
                    <strong>@profile.LongestStreak days</strong>
                </div>
                <div class="detail-row">
                    <span><Icon Name="pencil" Size="16" /> Quizzes Taken</span>
                    <strong>@profile.QuizHistory.Count</strong>
                </div>
                <div class="detail-row">
                    <span><Icon Name="trophy" Size="16" /> Best Quiz Score</span>
                    <strong>@(profile.QuizHistory.Count > 0 ? profile.QuizHistory.Max(q => q.Score) : 0)%</strong>
                </div>
                <div class="detail-row">
                    <span><Icon Name="trending-up" Size="16" /> Average Score</span>
                    <strong>@(profile.QuizHistory.Count > 0 ? ((int)profile.QuizHistory.Average(q => q.Score)) : 0)%</strong>
                </div>
                <div class="detail-row">
                    <span><Icon Name="clock" Size="16" /> Study Time</span>
                    <strong>@FormatTime(profile.TotalStudyMinutes)</strong>
                </div>
                <div class="detail-row">
                    <span><Icon Name="award" Size="16" /> Perfect Quizzes</span>
                    <strong>@profile.QuizHistory.Count(q => q.Score == 100)</strong>
                </div>
                <div class="detail-row">
                    <span><Icon Name="lightbulb" Size="16" /> Hints Used</span>
                    <strong>@profile.HintsUsed</strong>
                </div>
            </div>
        </div>

        <!-- Activity heatmap -->
        <div class="section">
            <h3>Activity (Last 4 Weeks)</h3>
            <div class="heatmap">
                @foreach (var day in last28Days)
                {
                    var xp = profile.DailyXpLog.ContainsKey(day.date) ? profile.DailyXpLog[day.date] : 0;
                    var intensity = xp == 0 ? "none" : xp < 50 ? "low" : xp < 150 ? "med" : xp < 300 ? "high" : "max";
                    <div class="heatmap-cell @intensity" title="@day.date: @xp XP">
                        <span class="heatmap-label">@day.label</span>
                    </div>
                }
            </div>
            <div class="heatmap-legend">
                <small>Less</small>
                <div class="heatmap-cell none legend-cell"></div>
                <div class="heatmap-cell low legend-cell"></div>
                <div class="heatmap-cell med legend-cell"></div>
                <div class="heatmap-cell high legend-cell"></div>
                <div class="heatmap-cell max legend-cell"></div>
                <small>More</small>
            </div>
        </div>
    }

    @if (activeTab == "topics")
    {
        <div class="section stagger-in tab-content" @key='"topics"'>
            @if (topics != null)
            {
                @foreach (var topic in topics)
                {
                    var ts = profile.TopicStatistics.ContainsKey(topic.Id) ? profile.TopicStatistics[topic.Id] : null;
                    var accuracy = ts != null && ts.QuestionsAnswered > 0 ? ts.CorrectAnswers * 100 / ts.QuestionsAnswered : 0;
                    var progress = topicProgress.ContainsKey(topic.Id) ? topicProgress[topic.Id] : 0;

                    <div class="card topic-stat-card" style="border-color: @topic.Color">
                        <div class="topic-stat-header">
                            <div style="display:flex;align-items:center;gap:8px">
                                <h3 style="color: @topic.Color; margin: 0">@topic.Name</h3>
                                @if (profile.TopicMastery.GetValueOrDefault(topic.Id, 0) > 0)
                                {
                                    <span class="mastery-badge-sm" title="@GetMasteryName(profile.TopicMastery[topic.Id])" style="background: @GetMasteryColor(profile.TopicMastery[topic.Id])">
                                        <Icon Name="@GetMasteryIcon(profile.TopicMastery[topic.Id])" Size="14" />
                                    </span>
                                }
                            </div>
                            <span class="chip" style="color: @topic.Color; border: 1px solid @topic.Color; background: transparent">@progress.ToString("F0")%</span>
                        </div>
                        <div class="progress-bar-container" style="margin-top: 8px">
                            <div class="progress-bar-fill animate-in" style="width: @progress.ToString("F0")%; background: @topic.Color"></div>
                        </div>
                        <div class="topic-stat-grid">
                            <div class="topic-mini-stat">
                                <span class="mini-val">@(ts?.QuestionsAnswered ?? 0)</span>
                                <span class="mini-label">Questions</span>
                            </div>
                            <div class="topic-mini-stat">
                                <span class="mini-val">@accuracy%</span>
                                <span class="mini-label">Accuracy</span>
                            </div>
                            <div class="topic-mini-stat">
                                <span class="mini-val">@(ts?.QuizzesTaken ?? 0)</span>
                                <span class="mini-label">Quizzes</span>
                            </div>
                            <div class="topic-mini-stat">
                                <span class="mini-val">@(ts?.BestScore ?? 0)%</span>
                                <span class="mini-label">Best</span>
                            </div>
                        </div>
                    </div>
                }
            }
        </div>
    }

    @if (activeTab == "history")
    {
        <div class="section tab-content" @key='"history"'>
            @if (profile.QuizHistory.Count == 0)
            {
                <div class="empty-state">
                    <div class="empty-icon"><Icon Name="pencil" Size="32" /></div>
                    <p>No quizzes taken yet. Start a lesson to see your history!</p>
                </div>
            }
            else
            {
                <div class="stagger-in">
                @foreach (var quiz in profile.QuizHistory.OrderByDescending(q => q.Date).ThenByDescending(q => q.XpEarned).Take(30))
                {
                    var topicName = topics?.FirstOrDefault(t => t.Id == quiz.TopicId)?.Name ?? "Mixed";
                    var topicColor = topics?.FirstOrDefault(t => t.Id == quiz.TopicId)?.Color ?? "var(--primary)";
                    <div class="card history-item">
                        <div class="history-left">
                            <div class="history-score @(quiz.Score >= 80 ? "great" : quiz.Score >= 50 ? "ok" : "low")">
                                @quiz.Score%
                            </div>
                        </div>
                        <div class="history-info">
                            <strong style="color: @topicColor">@topicName</strong>
                            <small>@quiz.CorrectCount/@quiz.QuestionsCount correct</small>
                        </div>
                        <div class="history-right">
                            <span class="history-xp">+@quiz.XpEarned XP</span>
                            <small>@quiz.Date</small>
                        </div>
                    </div>
                }
                </div>
            }
        </div>
    }

    @if (activeTab == "achievements")
    {
        <div class="section tab-content" @key='"achievements"'>
            <div class="achievement-summary">
                <div class="achievement-ring">
                    <svg viewBox="0 0 100 100" class="achievement-ring-svg">
                        <circle cx="50" cy="50" r="42" fill="none" stroke="var(--bg-surface)" stroke-width="8"/>
                        <circle cx="50" cy="50" r="42" fill="none" stroke="var(--primary)" stroke-width="8"
                                stroke-dasharray="@(achievementPct * 2.64) 264"
                                stroke-dashoffset="0" stroke-linecap="round"
                                transform="rotate(-90 50 50)"
                                style="transition: stroke-dasharray 1s ease"/>
                    </svg>
                    <div class="achievement-ring-text">
                        <strong>@profile.AchievementsUnlocked.Count</strong>
                        <small>/ @allAchievements.Count</small>
                    </div>
                </div>
            </div>
            <div class="achievements-grid stagger-in">
                @foreach (var a in allAchievements.OrderByDescending(a => profile.AchievementsUnlocked.Contains(a.Id)))
                {
                    var unlocked = profile.AchievementsUnlocked.Contains(a.Id);
                    <div class="achievement-tile card @(unlocked ? "unlocked" : "locked")">
                        <div class="achievement-icon">@if (unlocked) { <Icon Name="trophy" Size="24" /> } else { <Icon Name="lock" Size="24" /> }</div>
                        <div class="achievement-info">
                            <strong>@a.Name</strong>
                            <small>@a.Description</small>
                            @if (unlocked)
                            {
                                <span class="achievement-xp">+@a.XpReward XP</span>
                            }
                        </div>
                    </div>
                }
            </div>
        </div>
    }
}
else
{
    <div class="skeleton-profile" style="padding-top: 8px">
        <div class="card" style="text-align:center;padding:28px 24px;margin-bottom:16px">
            <div class="skeleton skeleton-circle skeleton-avatar"></div>
            <div class="skeleton skeleton-text medium" style="margin:0 auto 8px;width:40%"></div>
            <div class="skeleton skeleton-text short" style="margin:0 auto 16px;width:25%"></div>
            <div class="skeleton" style="height:14px;max-width:280px;margin:0 auto;border-radius:10px"></div>
        </div>
        <div class="skeleton" style="height:40px;border-radius:var(--radius-md);margin-bottom:16px"></div>
        <div class="skeleton-stats">
            <div class="skeleton skeleton-stat"></div>
            <div class="skeleton skeleton-stat"></div>
            <div class="skeleton skeleton-stat"></div>
            <div class="skeleton skeleton-stat"></div>
            <div class="skeleton skeleton-stat"></div>
            <div class="skeleton skeleton-stat"></div>
        </div>
    </div>
}
</div>

@code {
    private UserProfile? profile;
    private List<Achievement> allAchievements = new();
    private List<Topic>? topics;
    private Dictionary<string, double> topicProgress = new();
    private int level;
    private int xpInLevel;
    private int xpNeeded;
    private double xpPct;
    private int overallAccuracy;
    private double achievementPct;
    private string activeTab = "overview";
    private List<(string date, string label)> last28Days = new();

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            profile = await Progress.GetProfileAsync();
            allAchievements = await AchievementRepo.GetAchievementsAsync();
            topics = await Content.GetTopicsAsync();

            foreach (var topic in topics)
                topicProgress[topic.Id] = await Progress.GetTopicProgressAsync(topic.Id);

            level = Gamification.GetLevel(profile.TotalXp);
            xpInLevel = Gamification.GetXpProgressInLevel(profile.TotalXp);
            xpNeeded = Gamification.GetXpForNextLevel(level);
            xpPct = xpNeeded > 0 ? (double)xpInLevel / xpNeeded * 100 : 0;
            overallAccuracy = profile.TotalQuestionsAnswered > 0
                ? profile.TotalCorrectAnswers * 100 / profile.TotalQuestionsAnswered : 0;
            achievementPct = allAchievements.Count > 0
                ? (double)profile.AchievementsUnlocked.Count / allAchievements.Count * 100 : 0;

            for (int i = 27; i >= 0; i--)
            {
                var d = DateTime.Now.AddDays(-i);
                last28Days.Add((d.ToString("yyyy-MM-dd"), d.ToString("dd")));
            }

            await Progress.TickSessionTimeAsync();
            StateHasChanged();
            await RunCounters();
        }
    }

    private async Task RunCounters()
    {
        await Task.Yield(); // let the DOM update
        try
        {
            await JS.InvokeVoidAsync("AnimCounter.run", "cnt-xp", profile!.TotalXp, 800, "", "");
            await JS.InvokeVoidAsync("AnimCounter.run", "cnt-pts", profile.Points, 700, "", "");
            await JS.InvokeVoidAsync("AnimCounter.run", "cnt-streak", profile.CurrentStreak, 500, "", "");
            await JS.InvokeVoidAsync("AnimCounter.run", "cnt-lessons", profile.LessonsCompleted.Count, 600, "", "");
            await JS.InvokeVoidAsync("AnimCounter.run", "cnt-questions", profile.TotalQuestionsAnswered, 700, "", "");
            await JS.InvokeVoidAsync("AnimCounter.run", "cnt-acc", overallAccuracy, 600, "", "%");
        }
        catch { }
    }

    private async Task SetTab(string tab)
    {
        activeTab = tab;
        try { await JS.InvokeVoidAsync("Sounds.playClick"); } catch { }
    }

    private string GetMasteryName(int tier) => tier switch { 0 => "Unranked", 1 => "Apprentice", 2 => "Adept", 3 => "Master", 4 => "Grandmaster", _ => "" };
    private string GetMasteryIcon(int tier) => tier switch { 1 => "bronze", 2 => "silver", 3 => "gold", 4 => "crown", _ => "sword" };
    private string GetMasteryColor(int tier) => tier switch { 1 => "#CD7F32", 2 => "#C0C0C0", 3 => "#FFD700", 4 => "#FF6B35", _ => "var(--bg-surface)" };

    private string FormatTime(int minutes)
    {
        if (minutes < 60) return $"{minutes}m";
        var h = minutes / 60;
        var m = minutes % 60;
        return m > 0 ? $"{h}h {m}m" : $"{h}h";
    }
}

<style>
    .profile-page { padding-top: 8px; }

    /* Cards banner */
    .cards-banner {
        display: flex; align-items: center; justify-content: space-between;
        padding: 14px 18px; margin-bottom: 16px;
        background: linear-gradient(135deg, rgba(74, 95, 224, 0.06), rgba(180, 140, 255, 0.06));
        border: 1px solid rgba(74, 95, 224, 0.15);
    }
    .cards-banner:hover { transform: none; }
    .cards-banner-left { display: flex; align-items: center; gap: 12px; }
    .cards-banner-icon { font-size: 1.6rem; }
    .cards-banner-left strong { display: block; font-size: 0.95rem; }
    .cards-banner-left small { color: var(--text-muted); font-size: 0.8rem; }
    .cards-banner-arrow { font-size: 1.2rem; color: var(--primary); }

    .profile-header {
        text-align: center;
        padding: 28px 24px 20px;
        margin-bottom: 16px;
        background: linear-gradient(180deg, rgba(74, 95, 224, 0.06) 0%, var(--bg-card) 60%);
    }

    .avatar-display { margin-bottom: 8px; position: relative; display: inline-block; }

    .avatar-circle {
        width: 80px; height: 80px; border-radius: 50%;
        background: linear-gradient(135deg, var(--primary), var(--primary-light));
        color: white; display: flex; align-items: center; justify-content: center;
        font-size: 2.2rem; font-weight: 700; margin: 0 auto;
        position: relative;
    }

    .avatar-ring {
        position: absolute; inset: -4px; border-radius: 50%;
        border: 3px solid transparent;
        background: linear-gradient(135deg, var(--primary), var(--accent)) border-box;
        -webkit-mask: linear-gradient(#fff 0 0) padding-box, linear-gradient(#fff 0 0);
        -webkit-mask-composite: xor; mask-composite: exclude;
        animation: ringRotate 4s linear infinite;
    }

    @@keyframes ringRotate {
        to { transform: rotate(360deg); }
    }

    .level-badge {
        position: absolute; bottom: -4px; right: -8px;
        background: linear-gradient(135deg, var(--accent), var(--accent-light));
        color: var(--xp-text); padding: 2px 8px; border-radius: 10px;
        font-size: 0.7rem; font-weight: 700;
        box-shadow: 0 2px 6px rgba(240, 160, 48, 0.3);
    }

    .title-badge {
        display: inline-block; margin-top: 6px;
        background: linear-gradient(135deg, var(--accent), var(--accent-light));
        color: var(--xp-text); padding: 2px 12px; border-radius: 12px;
        font-size: 0.8rem; font-weight: 600;
    }

    .profile-header h2 { margin: 8px 0 0; }

    .xp-section { max-width: 280px; margin: 12px auto 0; }
    .xp-bar-labels { display: flex; justify-content: space-between; }
    .xp-bar-labels small, .xp-detail { color: var(--text-muted); font-size: 0.75rem; }
    .xp-detail { display: block; text-align: center; margin-top: 4px; }

    .quick-stats {
        display: flex; justify-content: center; gap: 16px; margin-top: 16px;
        padding-top: 16px; border-top: 1px solid var(--border);
    }
    .quick-stat {
        display: flex; align-items: center; gap: 4px; font-size: 0.85rem; color: var(--text-secondary);
    }
    .quick-stat strong { color: var(--text-primary); }

    /* Tabs */
    .tab-bar {
        display: flex; gap: 4px; margin-bottom: 16px;
        background: var(--bg-surface); border-radius: var(--radius-md); padding: 4px;
    }
    .tab {
        flex: 1; padding: 8px 4px; border: none; background: transparent;
        color: var(--text-muted); font-weight: 600; font-size: 0.85rem;
        border-radius: var(--radius-sm); cursor: pointer;
        transition: all 0.25s ease;
        -webkit-tap-highlight-color: transparent;
    }
    .tab:active { transform: scale(0.95); }
    .tab.active {
        background: var(--bg-card); color: var(--primary);
        box-shadow: 0 2px 8px var(--shadow);
    }

    /* Stats grid */
    .stats-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 10px; }
    .stat-tile {
        text-align: center; padding: 16px 8px;
        display: flex; flex-direction: column; align-items: center; gap: 4px;
    }
    .stat-tile:hover { transform: none; }
    .stat-icon { font-size: 1.3rem; margin-bottom: 2px; }
    .stat-value { display: block; font-size: 1.6rem; font-weight: 800; color: var(--primary); line-height: 1.1; }
    .stat-name { font-size: 0.72rem; color: var(--text-muted); text-transform: uppercase; letter-spacing: 0.04em; }
    .streak-val { color: var(--warning); }

    /* Detail stats */
    .detail-stats { display: flex; flex-direction: column; gap: 1px; background: var(--border); border-radius: var(--radius-md); overflow: hidden; }
    .detail-row {
        display: flex; justify-content: space-between; align-items: center;
        padding: 11px 14px; background: var(--bg-card);
        transition: background 0.15s ease;
    }
    .detail-row:active { background: var(--bg-surface); }
    .detail-row span { color: var(--text-secondary); font-size: 0.9rem; }
    .detail-row strong { color: var(--text-primary); }

    /* Heatmap */
    .heatmap { display: grid; grid-template-columns: repeat(7, 1fr); gap: 3px; }
    .heatmap-cell {
        aspect-ratio: 1; border-radius: 4px; position: relative;
        transition: transform 0.15s ease;
    }
    .heatmap-cell:active { transform: scale(1.3); }
    .heatmap-cell.none { background: var(--bg-surface); }
    .heatmap-cell.low { background: rgba(74, 95, 224, 0.2); }
    .heatmap-cell.med { background: rgba(74, 95, 224, 0.4); }
    .heatmap-cell.high { background: rgba(74, 95, 224, 0.65); }
    .heatmap-cell.max { background: var(--primary); }
    .heatmap-label { position: absolute; top: 50%; left: 50%; transform: translate(-50%, -50%); font-size: 0.6rem; color: var(--text-muted); }
    .heatmap-cell.high .heatmap-label, .heatmap-cell.max .heatmap-label { color: white; }
    .heatmap-legend { display: flex; align-items: center; gap: 3px; justify-content: flex-end; margin-top: 6px; }
    .heatmap-legend small { color: var(--text-muted); font-size: 0.7rem; }
    .legend-cell { width: 14px; height: 14px; }

    /* Topic stats */
    .topic-stat-card { margin-bottom: 10px; padding: 14px; }
    .topic-stat-card:hover { transform: none; }
    .topic-stat-header { display: flex; justify-content: space-between; align-items: center; }
    .topic-stat-card small { color: var(--text-muted); font-size: 0.8rem; }
    .topic-stat-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 8px; margin-top: 12px; }
    .topic-mini-stat { text-align: center; }
    .mini-val { display: block; font-weight: 700; font-size: 1.05rem; color: var(--primary); }
    .mini-label { font-size: 0.7rem; color: var(--text-muted); }

    /* History */
    .history-item { display: flex; align-items: center; gap: 12px; padding: 10px 14px; margin-bottom: 8px; }
    .history-item:hover { transform: none; }
