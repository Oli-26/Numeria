@page "/profile"
@inject IProgressService Progress
@inject IGamificationService Gamification
@inject IAchievementRepository AchievementRepo
@inject IContentRepository Content
@inject IJSRuntime JS
@inject NavigationManager Nav

<div class="profile-page">
@if (profile != null)
{
    <div class="profile-header card">
        <button class="profile-settings" aria-label="Settings" @onclick='() => Nav.NavigateTo("/settings")'><Icon Name="settings" Size="20" /></button>
        <div class="avatar-display">
            <button type="button" @key="avatarPops" class="avatar-circle @(avatarCard != null ? "has-card" : "") @(avatarPops > 0 ? "avatar-pop" : "")" aria-label="Choose your avatar" @onclick="() => pickerOpen = true">
                @if (avatarCard != null)
                {
                    <FigureMedallion Card="avatarCard" Size="88" />
                }
                else
                {
                    <span class="avatar-letter">@InitialOf(profile)</span>
                }
                <div class="avatar-ring"></div>
                <span class="avatar-edit" aria-hidden="true"><Icon Name="pencil" Size="12" /></span>
            </button>
            <div class="level-badge">Lvl @level</div>
            @if (!string.IsNullOrEmpty(profile.SelectedTitle))
            {
                <div class="title-badge">@profile.SelectedTitle</div>
            }
        </div>
        <h2>@profile.DisplayName</h2>

        <div class="xp-section">
            <div class="xp-bar-labels">
                <small>Level @level</small>
                <small>Level @(level + 1)</small>
            </div>
            <div class="progress-bar-container" style="height: 14px">
                <div class="progress-bar-fill accent animate-in" style="width: @xpPct.ToString("F0")%"></div>
            </div>
            <small class="xp-detail">@xpInLevel / @xpNeeded XP</small>
        </div>

        <button class="btn btn-sm btn-outline share-profile-btn" @onclick='() => Nav.NavigateTo("/share")'>
            <Icon Name="trending-up" Size="14" /> Share Progress
        </button>
    </div>

    <!-- Hall of Cards banner -->
    <div class="card cards-banner card-clickable" @onclick='() => Nav.NavigateTo("/cards")'>
        <div class="cards-banner-left">
            <span class="cards-fan" aria-hidden="true">
                @if (recentCardTopics.Count == 0)
                {
                    <span class="cards-fan-empty"></span>
                }
                @foreach (var t in recentCardTopics)
                {
                    <TopicCard Topic="t" Mini="true" />
                }
            </span>
            <div>
                <strong>Hall of Cards</strong>
                <small>@profile.CompletionCards.Count collected</small>
            </div>
        </div>
        <span class="cards-banner-arrow">→</span>
    </div>

    <!-- Tab navigation -->
    <div class="tab-bar">
        <button class="tab @(activeTab == "overview" ? "active" : "")" @onclick='() => SetTab("overview")'>Overview</button>
        <button class="tab @(activeTab == "topics" ? "active" : "")" @onclick='() => SetTab("topics")'>Topics</button>
        <button class="tab @(activeTab == "history" ? "active" : "")" @onclick='() => SetTab("history")'>History</button>
        <button class="tab @(activeTab == "achievements" ? "active" : "")" @onclick='() => SetTab("achievements")'>Awards</button>
    </div>

    @if (activeTab == "overview")
    {
        <div class="stats-grid section stagger-in tab-content" @key='"overview"'>
            <div class="stat-tile card">
                <span class="stat-icon"><Icon Name="star-filled" Size="20" Fill="currentColor" /></span>
                <span class="stat-value" id="cnt-xp">@profile.TotalXp</span>
                <span class="stat-name">Total XP</span>
            </div>
            <div class="stat-tile card">
                <span class="stat-icon"><Icon Name="phi" Size="20" /></span>
                <span class="stat-value" id="cnt-pts">@profile.Points</span>
                <span class="stat-name">φ (Phi)</span>
            </div>
            <div class="stat-tile card">
                <span class="stat-icon"><Icon Name="fire" Size="20" /></span>
                <span class="stat-value streak-val" id="cnt-streak">@profile.CurrentStreak</span>
                <span class="stat-name">Streak</span>
            </div>
            <div class="stat-tile card">
                <span class="stat-icon"><Icon Name="book" Size="20" /></span>
                <span class="stat-value" id="cnt-lessons">@profile.LessonsCompleted.Count</span>
                <span class="stat-name">Lessons</span>
            </div>
            <div class="stat-tile card">
                <span class="stat-icon"><Icon Name="brain" Size="20" /></span>
                <span class="stat-value" id="cnt-questions">@profile.TotalQuestionsAnswered</span>
                <span class="stat-name">Questions</span>
            </div>
            <div class="stat-tile card">
                <span class="stat-icon"><Icon Name="target" Size="20" /></span>
                @* No answers yet means no accuracy, not 0%. *@
                <span class="stat-value" id="cnt-acc">@(profile.TotalQuestionsAnswered > 0 ? $"{overallAccuracy}%" : "–")</span>
                <span class="stat-name">Accuracy</span>
            </div>
        </div>

        @* A stat appears once there is something to show, so a new profile is not a list of zeros. *@
        @if (profile.TotalQuizCount > 0 || profile.LongestStreak > 1 || profile.TotalStudyMinutes > 0)
        {
            <div class="section">
                <h3>Detailed Stats</h3>
                <div class="detail-stats">
                    @if (profile.LongestStreak > 1)
                    {
                        <div class="detail-row">
                            <span><Icon Name="fire" Size="16" /> Longest Streak</span>
                            <strong>@profile.LongestStreak days</strong>
                        </div>
                    }
                    @if (profile.TotalQuizCount > 0)
                    {
                        <div class="detail-row">
                            <span><Icon Name="pencil" Size="16" /> Quizzes Taken</span>
                            <strong>@profile.TotalQuizCount</strong>
                        </div>
                        <div class="detail-row">
                            <span><Icon Name="trophy" Size="16" /> Best Quiz Score</span>
                            <strong>@profile.BestQuizScore%</strong>
                        </div>
                        <div class="detail-row">
                            <span><Icon Name="trending-up" Size="16" /> Average Score</span>
                            <strong>@profile.AverageQuizScore%</strong>
                        </div>
                    }
                    @if (profile.TotalStudyMinutes > 0)
                    {
                        <div class="detail-row">
                            <span><Icon Name="clock" Size="16" /> Study Time</span>
                            <strong>@FormatTime(profile.TotalStudyMinutes)</strong>
                        </div>
                    }
                    @if (profile.PerfectQuizCount > 0)
                    {
                        <div class="detail-row">
                            <span><Icon Name="award" Size="16" /> Perfect Quizzes</span>
                            <strong>@profile.PerfectQuizCount</strong>
                        </div>
                    }
                    @if (profile.HintsUsed > 0)
                    {
                        <div class="detail-row">
                            <span><Icon Name="lightbulb" Size="16" /> Hints Used</span>
                            <strong>@profile.HintsUsed</strong>
                        </div>
                    }
                </div>
            </div>
        }

        <!-- Activity heatmap -->
        <div class="section">
            <h3>Activity (Last 4 Weeks)</h3>
            <div class="heatmap">
                @foreach (var day in last28Days)
                {
                    var xp = profile.DailyXpLog.ContainsKey(day.date) ? profile.DailyXpLog[day.date] : 0;
                    var intensity = xp == 0 ? "none" : xp < 50 ? "low" : xp < 150 ? "med" : xp < 300 ? "high" : "max";
                    <div class="heatmap-cell @intensity" title="@day.date: @xp XP">
                        <span class="heatmap-label">@day.label</span>
                    </div>
                }
            </div>
            <div class="heatmap-legend">
                <small>Less</small>
                <div class="heatmap-cell none legend-cell"></div>
                <div class="heatmap-cell low legend-cell"></div>
                <div class="heatmap-cell med legend-cell"></div>
                <div class="heatmap-cell high legend-cell"></div>
                <div class="heatmap-cell max legend-cell"></div>
                <small>More</small>
            </div>
        </div>
    }

    @if (activeTab == "topics")
    {
        <div class="section stagger-in tab-content" @key='"topics"'>
            @if (topics != null && domains != null)
            {
                @* Filter chips *@
                <div class="topics-filter">
                    <button class="topic-filter-chip @(topicFilter == "all" ? "active" : "")" @onclick='() => topicFilter = "all"'>All <small>@topics.Count</small></button>
                    <button class="topic-filter-chip @(topicFilter == "active" ? "active" : "")" @onclick='() => topicFilter = "active"'>Started <small>@topics.Count(t => topicProgress.GetValueOrDefault(t.Id, 0) > 0)</small></button>
                    <button class="topic-filter-chip @(topicFilter == "mastered" ? "active" : "")" @onclick='() => topicFilter = "mastered"'>Mastered <small>@profile.TopicMastery.Count(kv => kv.Value > 0)</small></button>
                </div>

                @* Domain summary chart: only subjects with a started topic, since the rest sit at 0% *@
                var startedDomains = domains.Where(d => topics.Any(t => t.Domain == d.Id && topicProgress.GetValueOrDefault(t.Id, 0) > 0)).ToList();
                @if (startedDomains.Count > 0)
                {
                <div class="card domain-summary-card">
                    <h3 class="domain-summary-title">Domain Progress</h3>
                    @foreach (var d in startedDomains.OrderByDescending(d => DomainAvgProgress(d.Id)))
                    {
                        var domTopics = topics.Where(t => t.Domain == d.Id).ToList();
                        if (domTopics.Count == 0) continue;
                        var avg = DomainAvgProgress(d.Id);
                        var mastered = domTopics.Count(t => profile.TopicMastery.GetValueOrDefault(t.Id, 0) > 0);
                        var hue = SubjectHues.For(d.Id);
                        <div class="domain-row">
                            <div class="domain-row-head">
                                <span class="domain-row-name">@d.Name</span>
                                <span class="domain-row-stats"><strong>@avg.ToString("F0")%</strong> · @mastered/@domTopics.Count</span>
                            </div>
                            <div class="domain-row-bar">
                                <div class="domain-row-fill" style="width: @avg.ToString("F0")%; background: @hue"></div>
                            </div>
                        </div>
                    }
                </div>
                }

                @* Filtered topic list, grouped by domain; each group starts collapsed *@
                @if (!topics.Any(t => FilterMatch(t, topicFilter)))
                {
                    <div class="card topics-empty">
                        <p>@(topicFilter == "mastered" ? "No mastered topics yet. Pass a topic's mastery quiz to earn a rank." : "You haven't started a topic yet.")</p>
                        <a class="btn btn-sm btn-primary" href="/domains">Browse subjects</a>
                    </div>
                }
                @foreach (var d in domains)
                {
                    var domTopics = topics.Where(t => t.Domain == d.Id)
                        .Where(t => FilterMatch(t, topicFilter))
                        .OrderByDescending(t => topicProgress.GetValueOrDefault(t.Id, 0))
                        .ToList();
                    if (domTopics.Count == 0) continue;

                    <details class="topic-domain-group">
                        <summary class="topic-domain-head" style="color: @SubjectHues.For(d.Id)">@d.Name <small>@domTopics.Count</small><span class="topic-domain-chevron"><Icon Name="chevron-down" Size="14" /></span></summary>
                        <div class="topic-rows">
                            @foreach (var topic in domTopics)
                            {
                                var ts = profile.TopicStatistics.GetValueOrDefault(topic.Id);
                                var accuracy = ts != null && ts.QuestionsAnswered > 0 ? ts.CorrectAnswers * 100 / ts.QuestionsAnswered : 0;
                                var progress = topicProgress.GetValueOrDefault(topic.Id, 0);
                                var mastery = profile.TopicMastery.GetValueOrDefault(topic.Id, 0);
                                <a class="topic-row" href="@($"/topic/{topic.Id}")">
                                    <div class="topic-row-body">
                                        <div class="topic-row-line1">
                                            <span class="topic-row-name">@topic.Name</span>
                                            @if (mastery > 0)
                                            {
                                                <span class="topic-row-mastery" title="@GetMasteryName(mastery)" style="color: color-mix(in srgb, @GetMasteryColor(mastery) 70%, var(--text-primary))">
                                                    <Icon Name="@GetMasteryIcon(mastery)" Size="13" />
                                                </span>
                                            }
                                            <span class="topic-row-pct">@progress.ToString("F0")%</span>
                                        </div>
                                        <div class="topic-row-bar">
                                            <div class="topic-row-fill" style="width: @progress.ToString("F0")%; background: @topic.Color"></div>
                                        </div>
                                        @if (ts != null && ts.QuestionsAnswered > 0)
                                        {
                                            <div class="topic-row-line2">
                                                <span>@ts.QuestionsAnswered Q</span>
                                                <span class="dot">·</span>
                                                <span>@accuracy% acc</span>
                                                @if (ts.BestScore > 0)
                                                {
                                                    <span class="dot">·</span>
                                                    <span>best @ts.BestScore%</span>
                                                }
                                            </div>
                                        }
                                    </div>
                                </a>
                            }
                        </div>
                    </details>
                }
            }
        </div>
    }

    @if (activeTab == "history")
    {
        <div class="section tab-content" @key='"history"'>
            @if (profile.QuizHistory.Count == 0)
            {
                <div class="empty-state">
                    <div class="empty-icon"><Icon Name="pencil" Size="32" /></div>
                    <p>No quizzes taken yet. Start a lesson to see your history!</p>
                </div>
            }
            else
            {
                <div class="stagger-in">
                @foreach (var quiz in profile.QuizHistory.OrderByDescending(q => q.Date).ThenByDescending(q => q.XpEarned).Take(30))
                {
                    var topicName = topics?.FirstOrDefault(t => t.Id == quiz.TopicId)?.Name ?? "Mixed";
                    var topicColor = topics?.FirstOrDefault(t => t.Id == quiz.TopicId)?.Color ?? "var(--primary)";
                    <div class="card history-item">
                        <div class="history-left">
                            <div class="history-score @(quiz.Score >= 80 ? "great" : quiz.Score >= 50 ? "ok" : "low")">
                                @quiz.Score%
                            </div>
                        </div>
                        <div class="history-info">
                            <strong class="topic-ink" style="--topic-c: @topicColor">@topicName</strong>
                            <small>@quiz.CorrectCount/@quiz.QuestionsCount correct</small>
                        </div>
                        <div class="history-right">
                            <span class="history-xp">+@quiz.XpEarned XP</span>
                            <small>@quiz.Date</small>
                        </div>
                    </div>
                }
                </div>
            }
        </div>
    }

    @if (activeTab == "achievements")
    {
        <div class="section tab-content" @key='"achievements"'>
            <div class="achievement-summary">
                <div class="achievement-ring">
                    <svg viewBox="0 0 100 100" class="achievement-ring-svg">
                        <circle cx="50" cy="50" r="42" fill="none" stroke="var(--bg-surface)" stroke-width="8"/>
                        <circle cx="50" cy="50" r="42" fill="none" stroke="var(--primary)" stroke-width="8"
                                stroke-dasharray="@(achievementPct * 2.64) 264"
                                stroke-dashoffset="0" stroke-linecap="round"
                                transform="rotate(-90 50 50)"
                                style="transition: stroke-dasharray 1s ease"/>
                    </svg>
                    <div class="achievement-ring-text">
                        <strong>@profile.AchievementsUnlocked.Count</strong>
                        <small>/ @allAchievements.Count</small>
                    </div>
                </div>
            </div>
            <div class="achievements-grid stagger-in">
                @foreach (var a in allAchievements.OrderByDescending(a => profile.AchievementsUnlocked.Contains(a.Id)))
                {
                    var unlocked = profile.AchievementsUnlocked.Contains(a.Id);
                    <div class="achievement-tile card @(unlocked ? "unlocked" : "locked")" title="@a.Description">
                        <div class="achievement-icon">@if (unlocked) { <Icon Name="trophy" Size="22" /> } else { <Icon Name="lock" Size="20" /> }</div>
                        <strong class="achievement-name">@a.Name</strong>
                        @if (unlocked)
                        {
                            <span class="achievement-xp">+@a.XpReward XP</span>
                        }
                        else
                        {
                            <small class="achievement-desc">@a.Description</small>
                        }
                    </div>
                }
            </div>
        </div>
    }

    @if (pickerOpen)
    {
        <div class="sheet-backdrop" @onclick="() => pickerOpen = false"></div>
        <div class="bottom-sheet" role="dialog" aria-modal="true" aria-label="Choose your avatar">
            <div class="bottom-sheet-head">
                <h3>Your avatar</h3>
                <button type="button" class="btn btn-sm btn-outline" @onclick="() => pickerOpen = false">Done</button>
            </div>
            <div class="avatar-grid">
                <button type="button" class="avatar-choice @(avatarCard == null ? "on" : "")" @onclick="() => ChooseAvatar(null)">
                    <span class="avatar-initial">@InitialOf(profile)</span>
                    <small>Your initial</small>
                </button>
            </div>
            @if (topicCards.Count > 0)
            {
                <h4 class="avatar-group">Your topic cards</h4>
                <div class="avatar-grid">
                    @foreach (var c in topicCards)
                    {
                        var card = c;
                        <button type="button" class="avatar-choice @(HallOfFame.Same(card, avatarCard) ? "on" : "")" @onclick="() => ChooseAvatar(card)">
                            <FigureMedallion Card="card" Size="56" />
                            <small>@card.Name</small>
                        </button>
                    }
                </div>
            }
            @foreach (var group in unlockedCards.GroupBy(c => c.Domain))
            {
                <h4 class="avatar-group">@HallOfFame.Label(group.Key)</h4>
                <div class="avatar-grid">
                    @foreach (var c in group)
                    {
                        var card = c;
                        <button type="button" class="avatar-choice @(HallOfFame.Same(card, avatarCard) ? "on" : "")" @onclick="() => ChooseAvatar(card)">
                            <FigureMedallion Card="card" Size="56" />
                            <small>@card.Name</small>
                        </button>
                    }
                </div>
            }
            @if (unlockedCards.Count == 0 && topicCards.Count == 0)
            {
                <p class="avatar-empty">Finish every lesson in a topic to earn its card, or unlock a Hall of Fame in the Shop. Either becomes an avatar you can wear here.</p>
                <button type="button" class="btn btn-accent" @onclick='() => Nav.NavigateTo("/shop")'>Go to Shop</button>
            }
        </div>
    }
}
else
{
    <div class="skeleton-profile" style="padding-top: 8px">
        <div class="card" style="text-align:center;padding:28px 24px;margin-bottom:16px">
            <div class="skeleton skeleton-circle skeleton-avatar"></div>
            <div class="skeleton skeleton-text medium" style="margin:0 auto 8px;width:40%"></div>
            <div class="skeleton skeleton-text short" style="margin:0 auto 16px;width:25%"></div>
            <div class="skeleton" style="height:14px;max-width:280px;margin:0 auto;border-radius:10px"></div>
        </div>
        <div class="skeleton" style="height:40px;border-radius:var(--radius-md);margin-bottom:16px"></div>
        <div class="skeleton-stats">
            <div class="skeleton skeleton-stat"></div>
            <div class="skeleton skeleton-stat"></div>
            <div class="skeleton skeleton-stat"></div>
            <div class="skeleton skeleton-stat"></div>
            <div class="skeleton skeleton-stat"></div>
            <div class="skeleton skeleton-stat"></div>
        </div>
    </div>
}
</div>

@code {
    private UserProfile? profile;
    private HallOfFame.AvatarCard? avatarCard;
    private List<HallOfFame.AvatarCard> unlockedCards = new();
    private List<Topic> recentCardTopics = new();
    private List<HallOfFame.AvatarCard> topicCards = new();
    private bool pickerOpen;
    // Bumped on each equip; as the avatar button's @key it rebuilds the button, which replays the pop.
    private int avatarPops;
    private List<Achievement> allAchievements = new();
    private List<Topic>? topics;
    private List<Domain>? domains;
    private Dictionary<string, double> topicProgress = new();
    private int level;
    private int xpInLevel;
    private int xpNeeded;
    private double xpPct;
    private int overallAccuracy;
    private double achievementPct;
    private string activeTab = "overview";
    private string topicFilter = "active";
    private List<(string date, string label)> last28Days = new();

    private static char InitialOf(UserProfile p) => p.DisplayName.Length > 0 ? p.DisplayName[0] : '?';

    private async Task ChooseAvatar(HallOfFame.AvatarCard? card)
    {
        if (profile == null) return;
        avatarCard = card;
        profile.SelectedAvatar = card?.Id ?? "default";
        pickerOpen = false;
        avatarPops++;
        await Progress.SaveProfileAsync(profile);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            profile = await Progress.GetProfileAsync();
            var topicIndex = (await Content.GetTopicsAsync()).ToDictionary(t => t.Id);
            avatarCard = HallOfFame.Resolve(profile.SelectedAvatar, topicIndex);
            unlockedCards = HallOfFame.Unlocked(profile);
            topicCards = HallOfFame.EarnedTopicCards(profile, topicIndex);
            recentCardTopics = topicCards.Take(3).Select(c => topicIndex[c.TopicId!]).Reverse().ToList();
            allAchievements = await AchievementRepo.GetAchievementsAsync();
            topics = await Content.GetTopicsAsync();
            domains = await Content.GetDomainsAsync();

            foreach (var topic in topics)
                topicProgress[topic.Id] = await Progress.GetTopicProgressAsync(topic.Id);

            var lp = Gamification.GetLevelProgress(profile.TotalXp);
            (level, xpInLevel, xpNeeded, xpPct) = (lp.Level, lp.XpInLevel, lp.XpNeeded, lp.Percent);
            overallAccuracy = profile.TotalQuestionsAnswered > 0
                ? profile.TotalCorrectAnswers * 100 / profile.TotalQuestionsAnswered : 0;
            achievementPct = allAchievements.Count > 0
                ? (double)profile.AchievementsUnlocked.Count / allAchievements.Count * 100 : 0;

            for (int i = 27; i >= 0; i--)
            {
                var d = DateTime.Now.AddDays(-i);
                last28Days.Add((d.ToString("yyyy-MM-dd"), d.ToString("dd")));
            }

            await Progress.TickSessionTimeAsync();
            StateHasChanged();
            await RunCounters();
        }
    }

    private async Task RunCounters()
    {
        await Task.Yield(); // let the DOM update
        try
        {
            await JS.InvokeVoidAsync("AnimCounter.run", "cnt-xp", profile!.TotalXp, 800, "", "");
            await JS.InvokeVoidAsync("AnimCounter.run", "cnt-pts", profile.Points, 700, "", "");
            await JS.InvokeVoidAsync("AnimCounter.run", "cnt-streak", profile.CurrentStreak, 500, "", "");
            await JS.InvokeVoidAsync("AnimCounter.run", "cnt-lessons", profile.LessonsCompleted.Count, 600, "", "");
            await JS.InvokeVoidAsync("AnimCounter.run", "cnt-questions", profile.TotalQuestionsAnswered, 700, "", "");
            if (profile.TotalQuestionsAnswered > 0)
                await JS.InvokeVoidAsync("AnimCounter.run", "cnt-acc", overallAccuracy, 600, "", "%");
        }
        catch (Exception ex) { await JS.LogErrorAsync("ProfilePage.AnimCounter", ex); }
    }

    private async Task SetTab(string tab)
    {
        activeTab = tab;
        await JS.TryInvokeVoidAsync("Sounds.playClick");
    }

    private double DomainAvgProgress(string domainId)
    {
        if (topics == null) return 0;
        var dts = topics.Where(t => t.Domain == domainId).ToList();
        if (dts.Count == 0) return 0;
        return dts.Average(t => topicProgress.GetValueOrDefault(t.Id, 0));
    }

    private bool FilterMatch(Topic t, string filter) => filter switch
    {
        "active" => topicProgress.GetValueOrDefault(t.Id, 0) > 0,
        "mastered" => profile!.TopicMastery.GetValueOrDefault(t.Id, 0) > 0,
        _ => true
    };

    private string GetMasteryName(int tier) => tier switch { 0 => "Unranked", 1 => "Apprentice", 2 => "Adept", 3 => "Master", 4 => "Grandmaster", _ => "" };
    private string GetMasteryIcon(int tier) => tier switch { 1 => "bronze", 2 => "silver", 3 => "gold", 4 => "crown", _ => "sword" };
    private string GetMasteryColor(int tier) => tier switch { 1 => "#A06542", 2 => "#807A6E", 3 => "#C4813A", 4 => "var(--primary)", _ => "var(--bg-surface)" };

    private string FormatTime(int minutes)
    {
        if (minutes < 60) return $"{minutes}m";
        var h = minutes / 60;
        var m = minutes % 60;
        return m > 0 ? $"{h}h {m}m" : $"{h}h";
    }
}

<style>
    .profile-page { padding-top: 8px; }

    /* Cards banner */
