@page "/shop"
@page "/shop/{InitialTab?}"
@inject IShopRepository ShopRepo
@inject IProgressService Progress
@inject IGamificationService Gamification
@inject IThemeService ThemeService
@inject IJSRuntime JS

<div class="shop-header">
    <div class="shop-title-wrap">
        <h1>Shop</h1>
        @if (profile != null)
        {
            <span class="domain-badge">@CapitalizeDomain(profile.CurrentDomain)</span>
        }
    </div>
    @if (profile != null)
    {
        <div class="balance-card">
            <span class="balance-icon"><Icon Name="phi" Size="18" /></span>
            <span class="balance-amount">@profile.Points</span>
        </div>
    }
</div>

@if (profile != null)
{
    <div class="tab-bar">
        @foreach (var cat in visibleCategories)
        {
            <button class="tab @(activeCategory == cat ? "active" : "")" @onclick="() => SwitchCategory(cat)">
                <Icon Name="@GetCategoryIcon(cat)" Size="16" /> @GetCategoryName(cat)
            </button>
        }
    </div>

    <div class="shop-grid stagger-in tab-content" @key="activeCategory">
        @foreach (var item in domainItems.Where(i => i.Category == activeCategory))
        {
            var owned = profile.ShopPurchases.Contains(item.Id);
            var active = IsActive(item);
            var canAfford = profile.Points >= item.Price;
            var isPowerup = item.Category == "powerup";

            <div class="card shop-card @(active ? "active-item" : owned && !isPowerup ? "owned-item" : "")">
                <div class="shop-card-main">
                    <div class="shop-icon-wrap @(active ? "equipped" : "")">
                        <Icon Name="@GetItemIcon(item)" Size="24" />
                    </div>
                    <div class="shop-card-info">
                        <strong>@item.Name</strong>
                        <small>@item.Description</small>
                    </div>
                </div>
                <div class="shop-card-action">
                    @if (active)
                    {
                        <span class="equipped-badge">Equipped</span>
                    }
                    else if (owned && !isPowerup)
                    {
                        <button class="btn btn-sm btn-primary equip-btn" @onclick="() => ActivateItem(item)">Equip</button>
                    }
                    else
                    {
                        <button class="btn btn-sm buy-btn @(canAfford ? "affordable" : "unaffordable")"
                                disabled="@(!canAfford)"
                                @onclick="() => BuyItem(item)">
                            <span class="buy-price"><Icon Name="phi" Size="14" /> @item.Price</span>
                            <span class="buy-label">@(isPowerup && owned ? "Buy Again" : "Buy")</span>
                        </button>
                    }
                </div>
            </div>
        }
    </div>

    @if (activeCategory == "powerup" && profile != null)
    {
        <div class="section" style="margin-top: 20px">
            <h3>Your Inventory</h3>
            <div class="inventory stagger-in">
                <div class="card inventory-card">
                    <div class="inv-icon-wrap"><Icon Name="lightbulb" Size="22" /></div>
                    <div class="inv-info">
                        <strong>Hints</strong>
                        <small>Reveal answers in quizzes</small>
                    </div>
                    <div class="inv-count-wrap">
                        <span class="inv-count">@GetHintCount()</span>
                    </div>
                </div>
                <div class="card inventory-card">
                    <div class="inv-icon-wrap"><Icon Name="rocket" Size="22" /></div>
                    <div class="inv-info">
                        <strong>XP Boosts</strong>
                        <small>Quizzes remaining</small>
                    </div>
                    <div class="inv-count-wrap">
                        <span class="inv-count">@profile.XpBoostsActive</span>
                    </div>
                </div>
                <div class="card inventory-card">
                    <div class="inv-icon-wrap"><Icon Name="shield" Size="22" /></div>
                    <div class="inv-info">
                        <strong>Streak Freezes</strong>
                        <small>Protection days</small>
                    </div>
                    <div class="inv-count-wrap">
                        <span class="inv-count">@GetFreezeCount()</span>
                    </div>
                </div>
            </div>
        </div>
    }
}
else
{
    <div>
        <div class="skeleton" style="height:40px;border-radius:var(--radius-md);margin-bottom:16px"></div>
        @for (int i = 0; i < 4; i++)
        {
            <div class="skeleton skeleton-card" style="margin-bottom:10px;height:80px"></div>
        }
    </div>
}

@code {
    [Parameter] public string? InitialTab { get; set; }

    private UserProfile? profile;
    private List<ShopItem> items = new();
    private List<ShopItem> domainItems = new();
    private List<string> categories = new();
    private List<string> visibleCategories = new();
    private string activeCategory = "theme";

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            profile = await Progress.GetProfileAsync();
            items = await ShopRepo.GetShopItemsAsync();
            RefreshDomainFilter();
            if (!string.IsNullOrEmpty(InitialTab) && visibleCategories.Contains(InitialTab))
                activeCategory = InitialTab;
            else if (visibleCategories.Count > 0)
                activeCategory = visibleCategories[0];
            StateHasChanged();
        }
    }

    private void RefreshDomainFilter()
    {
        var domain = profile?.CurrentDomain ?? "math";
        domainItems = items
            .Where(i => i.Domain == null || i.Domain == domain)
            .ToList();
        // Preserve category ordering: theme, avatar, title, powerup, feature
        var allCategories = new[] { "theme", "avatar", "title", "powerup", "feature" };
        categories = items.Select(i => i.Category).Distinct().ToList();
        visibleCategories = allCategories
            .Where(c => domainItems.Any(i => i.Category == c))
            .ToList();
        // Clamp active category to a visible one
        if (!visibleCategories.Contains(activeCategory) && visibleCategories.Count > 0)
            activeCategory = visibleCategories[0];
    }

    private async Task SwitchCategory(string cat)
    {
        activeCategory = cat;
        try { await JS.InvokeVoidAsync("Sounds.playClick"); } catch { }
    }

    private string GetCategoryName(string cat) => cat switch
    {
        "theme" => "Themes",
        "avatar" => "Avatars",
        "title" => "Titles",
        "powerup" => "Power-ups",
        "feature" => "Features",
        _ => cat
    };

    private string GetCategoryIcon(string cat) => cat switch
    {
        "theme" => "palette",
        "avatar" => "user-grad",
        "title" => "scroll",
        "powerup" => "bolt",
        "feature" => "unlock",
        _ => "star"
    };

    private string GetItemIcon(ShopItem item)
    {
        if (item.UnlockData.ContainsKey("hints")) return "lightbulb";
        if (item.UnlockData.ContainsKey("boostMultiplier")) return "rocket";
        if (item.UnlockData.ContainsKey("freezeDays")) return "shield";
        if (item.UnlockData.ContainsKey("feature")) return item.Id switch
        {
            "unlock-proofs" => "puzzle",
            "unlock-mistakes" => "search",
            _ => "unlock"
        };
        return item.Category switch
        {
            "theme" => item.Id switch
            {
                "theme-dark" => "moon",
                "theme-chalkboard" => "chalkboard",
                "theme-neon" => "neon",
                "theme-blueprint" => "blueprint",
                _ => "palette"
            },
            "avatar" => "user-grad",
            "title" => "medal",
            _ => "star"
        };
    }

    private bool IsActive(ShopItem item)
    {
        if (profile == null) return false;
        return item.Category switch
        {
            "theme" => profile.SelectedTheme == item.Id.Replace("theme-", ""),
            "avatar" => profile.SelectedAvatar == item.Id,
            "title" => item.UnlockData.ContainsKey("title") && profile.SelectedTitle == item.UnlockData["title"],
            _ => false
        };
    }

    private int GetHintCount()
    {
        if (profile == null) return 0;
        var totalBought = 0;
        foreach (var purchase in profile.ShopPurchases)
        {
            var item = items.FirstOrDefault(i => i.Id == purchase);
            if (item?.UnlockData.ContainsKey("hints") == true && int.TryParse(item.UnlockData["hints"], out var h))
                totalBought += h;
        }
        return totalBought - profile.HintsUsed;
    }

    private int GetFreezeCount()
    {
        return profile?.StreakFreezeDays ?? 0;
    }

    private async Task BuyItem(ShopItem item)
    {
        if (profile == null) return;
        var success = await Gamification.SpendPointsAsync(item.Price);
        if (success)
        {
            profile.ShopPurchases.Add(item.Id);

            if (item.UnlockData.ContainsKey("boostMultiplier") && int.TryParse(item.UnlockData.GetValueOrDefault("boostQuizzes"), out var quizzes))
            {
                profile.XpBoostsActive += quizzes;
                if (int.TryParse(item.UnlockData["boostMultiplier"], out var mult) && mult > profile.XpBoostMultiplier)
                    profile.XpBoostMultiplier = mult;
            }

            if (item.UnlockData.ContainsKey("freezeDays") && int.TryParse(item.UnlockData["freezeDays"], out var days))
            {
                profile.StreakFreezeDays += days;
            }

            await Progress.SaveProfileAsync(profile);
            await JS.InvokeVoidAsync("showToast", $"Purchased {item.Name}!", "");
            try { await JS.InvokeVoidAsync("Sounds.playPurchase"); } catch { }
            try { await JS.InvokeVoidAsync("Confetti.launch", 30); } catch { }

            if (item.Category != "powerup")
                await ActivateItem(item);

            profile = await Progress.GetProfileAsync();
            StateHasChanged();
        }
    }

    private async Task ActivateItem(ShopItem item)
    {
        if (profile == null) return;
        switch (item.Category)
        {
            case "theme":
                var themeId = item.Id.Replace("theme-", "");
                await ThemeService.ApplyThemeAsync(themeId);
                break;
            case "avatar":
                profile.SelectedAvatar = item.Id;
                await Progress.SaveProfileAsync(profile);
                break;
            case "title":
                if (item.UnlockData.ContainsKey("title"))
                {
                    profile.SelectedTitle = item.UnlockData["title"];
                    await Progress.SaveProfileAsync(profile);
                }
                break;
        }
        try { await JS.InvokeVoidAsync("Sounds.playClick"); } catch { }
        StateHasChanged();
    }

    private static string CapitalizeDomain(string domain) =>
        string.IsNullOrEmpty(domain) ? "" : char.ToUpper(domain[0]) + domain[1..];
}

<style>
    .shop-header {
        display: flex; justify-content: space-between; align-items: center; margin-bottom: 16px;
    }
    .shop-header h1 { margin: 0; }

    .shop-title-wrap {
        display: flex; align-items: center; gap: 10px;
    }
    .domain-badge {
        font-size: 0.75rem; font-weight: 700; letter-spacing: 0.04em;
        padding: 3px 10px; border-radius: 20px;
        background: rgba(74, 95, 224, 0.12);
        color: var(--primary);
        border: 1px solid rgba(74, 95, 224, 0.25);
    }

    .balance-card {
        display: flex; align-items: center; gap: 6px;
        background: linear-gradient(135deg, rgba(74, 95, 224, 0.1), rgba(180, 140, 255, 0.1));
        border: 1px solid rgba(74, 95, 224, 0.2);
        padding: 8px 16px; border-radius: 20px;
    }
    .balance-icon { font-size: 1.1rem; }
    .balance-amount { font-size: 1.1rem; font-weight: 800; color: var(--primary); }

    /* Tabs */
    .tab-bar {
        display: flex; gap: 4px; margin-bottom: 16px;
        background: var(--bg-surface); border-radius: var(--radius-md); padding: 4px;
        overflow-x: auto;
    }
    .tab {
        flex: 1; padding: 8px 6px; border: none; background: transparent;
        color: var(--text-muted); font-weight: 600; font-size: 0.8rem;
        border-radius: var(--radius-sm); cursor: pointer;
        transition: all 0.25s ease; white-space: nowrap;
        -webkit-tap-highlight-color: transparent;
    }
    .tab:active { transform: scale(0.95); }
    .tab.active {
        background: var(--bg-card); color: var(--primary);
        box-shadow: 0 2px 8px var(--shadow);
    }

    /* Shop grid */
    .shop-grid { display: flex; flex-direction: column; gap: 10px; }

    .shop-card {
        display: flex; flex-direction: column; gap: 12px; padding: 16px;
        transition: border-color 0.25s ease, box-shadow 0.25s ease;
    }
    .shop-card:hover { transform: none; }

    .shop-card.active-item {
        border-color: var(--success);
        box-shadow: 0 0 0 1px var(--success), 0 2px 12px rgba(76, 175, 80, 0.12);
    }
    .shop-card.owned-item { border-color: var(--primary-light); }

    .shop-card-main { display: flex; gap: 14px; align-items: center; }

    .shop-icon-wrap {
        width: 48px; height: 48px; border-radius: var(--radius-sm);
        background: var(--bg-surface); display: flex; align-items: center; justify-content: center;
        font-size: 1.6rem; flex-shrink: 0;
        transition: all 0.3s ease;
    }
    .shop-icon-wrap.equipped {
        background: rgba(76, 175, 80, 0.12);
    }

    .shop-card-info { flex: 1; }
    .shop-card-info strong { display: block; font-size: 0.95rem; }
    .shop-card-info small { display: block; color: var(--text-muted); font-size: 0.8rem; margin-top: 2px; }

    .shop-card-action { display: flex; justify-content: flex-end; }

    /* Buy button */
    .buy-btn {
        display: flex; flex-direction: column; align-items: center; gap: 1px;
        padding: 8px 18px; border-radius: var(--radius-sm); border: 2px solid var(--border);
        background: var(--bg-card); cursor: pointer;
        transition: all 0.2s ease; min-width: 80px;
        -webkit-tap-highlight-color: transparent;
    }
    .buy-btn:active:not(:disabled) { transform: scale(0.95); }
    .buy-btn.affordable {
        border-color: var(--accent); background: linear-gradient(135deg, var(--accent), #E09020);
        color: white;
    }
    .buy-btn.affordable .buy-price { color: rgba(255,255,255,0.9); }
    .buy-btn.unaffordable { opacity: 0.5; cursor: not-allowed; }
    .buy-price { font-size: 0.8rem; font-weight: 700; }
    .buy-label { font-size: 0.7rem; font-weight: 600; }

    .equipped-badge {
        display: inline-flex; align-items: center; gap: 4px;
        padding: 6px 14px; border-radius: 20px;
        background: rgba(76, 175, 80, 0.12); color: var(--success);
        font-weight: 700; font-size: 0.8rem;
    }

    .equip-btn { min-width: 70px; }

    /* Inventory */
    .inventory { display: flex; flex-direction: column; gap: 8px; }

    .inventory-card {
        display: flex; align-items: center; gap: 14px; padding: 14px;
    }
    .inventory-card:hover { transform: none; }

    .inv-icon-wrap {
        width: 40px; height: 40px; border-radius: 50%;
        background: var(--bg-surface); display: flex; align-items: center; justify-content: center;
        font-size: 1.3rem;
    }
    .inv-info { flex: 1; }
    .inv-info strong { display: block; font-size: 0.9rem; }
    .inv-info small { color: var(--text-muted); font-size: 0.8rem; }
    .inv-count-wrap { flex-shrink: 0; }
    .inv-count {
        display: flex; align-items: center; justify-content: center;
        width: 36px; height: 36px; border-radius: 50%;
        background: linear-gradient(135deg, var(--primary), var(--primary-light));
        color: white; font-weight: 800; font-size: 1rem;
    }
</style>
