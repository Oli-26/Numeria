@implements IAsyncDisposable
@inject IProgressService Progress
@inject IContentRepository Content
@inject ICourseService Courses
@inject IReviewService ReviewService
@inject IConnectionsService Connections
@inject NavigationManager Nav
@inject IJSRuntime JS

@if (visible)
{
    <div class="hub-backdrop @(closing ? "closing" : "")" @onclick="RequestClose"></div>
    <div class="hub-sheet @(closing ? "closing" : "")" role="dialog" aria-modal="true" aria-label="Today" tabindex="-1" @ref="sheetEl">
        <div class="hub-grabber"></div>

        @if (profile != null)
        {
            <div class="hub-top">
                <span class="hub-streak"><span style="color: var(--warning)"><Icon Name="fire" Size="16" /></span><strong>@(profile.CurrentStreak)-day</strong> streak</span>
                <a class="hub-shop" href="/shop" @onclick:preventDefault @onclick='() => Go("/shop")'>
                    <Icon Name="phi" Size="15" />
                    <strong>@profile.Points</strong>
                    <span>Shop</span>
                </a>
            </div>

            <div class="hub-actions">
                @if (dailyDone)
                {
                    <div class="hub-action done">
                        <span class="hub-action-icon"><Icon Name="checkmark-circle" Size="22" /></span>
                        <span>Done</span>
                    </div>
                }
                else
                {
                    <button class="hub-action" @onclick='() => Go("/daily")'>
                        <span class="hub-action-icon" style="color: var(--accent)"><Icon Name="star-filled" Size="22" Fill="currentColor" /></span>
                        <span>Daily</span>
                    </button>
                }
                <button class="hub-action" @onclick='() => Go("/quiz/mixed/all")'>
                    <span class="hub-action-icon" style="color: var(--primary)"><Icon Name="zap" Size="22" /></span>
                    <span>Quick quiz</span>
                </button>
                @if (reviewDueCount > 0)
                {
                    <button class="hub-action" @onclick='() => Go("/review")'>
                        <span class="hub-action-icon" style="color: var(--success)">
                            <Icon Name="brain" Size="22" />
                            <span class="hub-badge">@reviewDueCount</span>
                        </span>
                        <span>Review</span>
                    </button>
                }
                <button class="hub-action" @onclick='() => Go("/synthesis")'>
                    <span class="hub-action-icon" style="color: var(--primary)"><Icon Name="network" Size="22" /></span>
                    <span>Synthesis</span>
                </button>
                @foreach (var c in courses)
                {
                    var url = $"/course/{c.Id}";
                    <button class="hub-action" @onclick='() => Go(url)'>
                        <span class="hub-action-icon hub-scratch-icon" style="--course-c: @c.Accent">@((MarkupString)TopicArt.For(c.Icon))</span>
                        <span>@c.Title</span>
                    </button>
                }
            </div>

            @if (dailyPick != null || upNext.Count > 0)
            {
                <h3 class="hub-label">Up next</h3>
                <div class="hub-list">
                    @if (dailyPick != null)
                    {
                        var pickUrl = $"/topic/{dailyPick.Topic.Id}/lesson/{dailyPick.Lesson.Id}";
                        <a class="hub-row" href="@pickUrl" @onclick:preventDefault @onclick="() => Go(pickUrl)">
                            <span class="hub-dot" style="background: @dailyPick.Topic.Color"></span>
                            <span class="hub-row-text">
                                <small>Today's pick · @dailyPick.Topic.Name</small>
                                <strong class="hub-pick-hook">@dailyPick.Hook</strong>
                            </span>
                            <span class="hub-chevron"><Icon Name="chevron-right" Size="16" /></span>
                        </a>
                    }
                    @foreach (var row in upNext)
                    {
                        var url = $"/topic/{row.Topic.Id}";
                        <a class="hub-row" href="@url" @onclick:preventDefault @onclick="() => Go(url)">
                            <span class="hub-dot" style="background: @row.Topic.Color"></span>
                            <span class="hub-row-text">
                                <strong>@row.Topic.Name</strong>
                                <small>@row.Detail</small>
                            </span>
                            <span class="hub-chevron"><Icon Name="chevron-right" Size="16" /></span>
                        </a>
                    }
                </div>
            }
        }
    </div>
}

@code {
    [Parameter] public bool Open { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }

    // Matches the hubDown animation so the sheet leaves the DOM once it has slid away.
    private const int CloseMs = 200;
    private const int MaxRows = 4;

    private bool visible;
    private bool closing;
    private bool jsBound;
    // Bumped on every open and close, so a close timer only finishes the close that started it.
    private int closeGen;
    private ElementReference sheetEl;
    private DotNetObjectReference<HubSheet>? selfRef;

    private sealed record UpNextRow(Topic Topic, string Detail);

    private UserProfile? profile;
    private int reviewDueCount;
    private bool dailyDone;
    private DailyPick? dailyPick;
    private List<UpNextRow> upNext = new();
    private List<Domain> allDomains = new();
    private List<Course> courses = new();

    private string DomainName(string id) => allDomains.FirstOrDefault(d => d.Id == id)?.Name ?? id;

    protected override async Task OnParametersSetAsync()
    {
        if (Open && (!visible || closing))
        {
            closeGen++;
            visible = true;
            closing = false;
            await LoadAsync();
        }
        else if (!Open && visible && !closing)
        {
            var gen = ++closeGen;
            closing = true;
            jsBound = false;
            await JS.TryInvokeVoidAsync("NousSheet.close");
            StateHasChanged();
            await Task.Delay(CloseMs);
            if (gen == closeGen)
            {
                visible = false;
                closing = false;
            }
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (visible && !closing && !jsBound)
        {
            jsBound = true;
            selfRef ??= DotNetObjectReference.Create(this);
            await JS.TryInvokeVoidAsync("NousSheet.open", selfRef, sheetEl);
        }
    }

    // Reloaded on every open so streak and due reviews reflect what just happened elsewhere in the app.
    // Each source fails on its own, and a failure clears it rather than leaving an earlier open's data.
    private async Task LoadAsync()
    {
        profile = await Progress.GetProfileAsync();
        dailyDone = profile.DailyChallengeDoneOn(DateTime.Now);
        reviewDueCount = await ReviewService.GetDueCountAsync();
        try { courses = await Courses.GetCoursesAsync(); }
        catch (Exception ex)
        {
            courses = new();
            Console.Error.WriteLine($"HubSheet courses: {ex.Message}");
        }
        StateHasChanged();

        try { dailyPick = await Connections.GetDailyPickAsync(profile, DateTime.Now); }
        catch (Exception ex)
        {
            dailyPick = null;
            Console.Error.WriteLine($"HubSheet daily pick: {ex.Message}");
        }

        try
        {
            var all = await Content.GetTopicsAsync();
            allDomains = await Content.GetDomainsAsync();
            var edges = (await Connections.GetGraphAsync()).Edges;

            // What's in progress first, then same-subject neighbours, then one cross-subject link.
            upNext = Recommender.Continue(all, profile, take: 2)
                .Select(t => new UpNextRow(t, $"Continue · {DomainName(t.Domain)}"))
                .Concat(Recommender.NextSteps(all, edges, profile, otherFields: false, take: 2)
                    .Select(s => new UpNextRow(s.Topic, s.Reason)))
                .Concat(Recommender.NextSteps(all, edges, profile, otherFields: true, take: 1)
                    .Select(s => new UpNextRow(s.Topic, $"{DomainName(s.Topic.Domain)} · {s.Reason}")))
                .Where(r => r.Topic.Id != dailyPick?.Topic.Id)
                .DistinctBy(r => r.Topic.Id)
                .Take(dailyPick != null ? MaxRows - 1 : MaxRows)
                .ToList();
        }
        catch (Exception ex)
        {
            upNext = new();
            Console.Error.WriteLine($"HubSheet recommendations: {ex.Message}");
        }
    }

    [JSInvokable]
    public Task RequestClose() => OnClose.InvokeAsync();

    private async Task Go(string url)
    {
        await OnClose.InvokeAsync();
        Nav.NavigateTo(url);
    }

    public async ValueTask DisposeAsync()
    {
        if (jsBound) await JS.TryInvokeVoidAsync("NousSheet.close");
        selfRef?.Dispose();
    }
}

<style>
    /* Sits under the bottom bar (z-index 100) so the bar stays tappable and the sheet appears to rise out of it. */
    .hub-backdrop {
        position: fixed;
        inset: 0;
        z-index: 90;
        background: rgba(20, 18, 15, 0.38);
        animation: hubFadeIn 0.2s ease;
    }

    .hub-backdrop.closing { animation: hubFadeOut 0.2s ease forwards; }

    .hub-sheet {
        position: fixed;
        left: 0;
        right: 0;
        bottom: 0;
        z-index: 95;
        max-width: 640px;
        max-height: 82vh;
        max-height: 82dvh;
        margin: 0 auto;
        overflow-y: auto;
        overscroll-behavior: contain;
        background: var(--bg-main);
        border-radius: var(--radius-lg) var(--radius-lg) 0 0;
        box-shadow: 0 -8px 30px var(--shadow);
        padding: 8px 20px calc(104px + env(safe-area-inset-bottom));
        transition: transform 0.2s ease;
        animation: hubUp 0.28s var(--ease-spring);
    }

    .hub-sheet:focus { outline: none; }
    .hub-sheet.closing { animation: hubDown 0.2s ease forwards; }

    @@keyframes hubUp { from { transform: translateY(100%); } }
    @@keyframes hubDown {
        from { transform: translateY(var(--hub-drag, 0px)); }
        to { transform: translateY(100%); }
    }
    @@keyframes hubFadeIn { from { opacity: 0; } }
    @@keyframes hubFadeOut { to { opacity: 0; } }

    .hub-grabber {
        width: 40px;
        height: 4px;
        border-radius: 2px;
        background: var(--border);
        margin: 0 auto 18px;
    }

    .hub-sheet a, .hub-sheet button { color: inherit; text-decoration: none; font: inherit; -webkit-tap-highlight-color: transparent; }
    .hub-sheet button { background: none; border: 0; padding: 0; cursor: pointer; }

    .hub-top { display: flex; align-items: center; justify-content: space-between; gap: 16px; margin-bottom: 16px; color: var(--text-secondary); font-size: 0.9rem; }
    .hub-streak { display: inline-flex; align-items: center; gap: 5px; }
    .hub-streak > span { display: flex; }
    .hub-streak strong { color: var(--text-primary); }
    .hub-shop {
        display: inline-flex; align-items: center; gap: 5px; padding: 5px 11px 5px 9px;
        border-radius: 999px; border: 1px solid var(--border); background: var(--bg-card); font-size: 0.85rem;
    }
    .hub-sheet .hub-shop { color: var(--primary); }
    .hub-shop strong { color: var(--text-primary); }

    /* One card for all actions; individual tiles have no borders of their own. */
    .hub-actions {
        display: grid; grid-auto-flow: column; grid-auto-columns: 1fr; margin-bottom: 24px;
        border-radius: var(--radius-md); background: var(--bg-card); border: 1px solid var(--border); overflow: hidden;
    }
    .hub-sheet .hub-action {
        display: flex; flex-direction: column; align-items: center; gap: 6px; padding: 14px 4px 12px;
        color: var(--text-secondary); font-size: 0.78rem; font-weight: 600; text-align: center;
    }
    .hub-sheet .hub-action:active, .hub-row:active { background: var(--bg-surface); }
    .hub-action.done { opacity: 0.5; color: var(--text-muted); }
    .hub-action-icon { position: relative; display: flex; }
    .hub-badge {
        position: absolute; top: -6px; right: -11px; min-width: 17px; height: 17px; padding: 0 4px;
        border-radius: 9px; background: var(--success); color: white;
        font-size: 0.68rem; font-weight: 700; line-height: 17px; text-align: center;
    }

    .hub-label { font-size: 0.8rem; font-weight: 600; color: var(--text-muted); margin: 0 0 8px 2px; }
    .hub-list { border-radius: var(--radius-md); background: var(--bg-card); border: 1px solid var(--border); overflow: hidden; }
    .hub-row { display: flex; align-items: center; gap: 12px; padding: 11px 12px 11px 14px; }
    .hub-row + .hub-row { border-top: 1px solid var(--border); }
    .hub-dot { width: 8px; height: 8px; border-radius: 50%; flex-shrink: 0; }
    .hub-row-text { flex: 1; min-width: 0; display: flex; flex-direction: column; gap: 1px; }
    .hub-row-text strong { font-size: 0.9rem; color: var(--text-primary); }
    .hub-row-text small { font-size: 0.78rem; color: var(--text-muted); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
    .hub-pick-hook { display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; line-height: 1.35; }
    .hub-chevron { display: flex; flex-shrink: 0; color: var(--text-muted); }

    /* Desktop has a sidebar instead of a bottom bar, so the sheet becomes a dialog centred over the content. */
    @@media (min-width: 1024px) {
        .hub-backdrop { z-index: 110; }

        .hub-sheet {
            z-index: 120;
            top: 50%;
            left: calc(50% + 110px);
            right: auto;
            bottom: auto;
            width: min(520px, calc(100vw - 260px));
            max-height: 80vh;
            margin: 0;
            border-radius: var(--radius-lg);
            padding: 24px 28px 28px;
            transform: translate(-50%, -50%);
            animation: hubPop 0.22s var(--ease-spring);
        }

        .hub-sheet.closing { animation: hubPopOut 0.2s ease forwards; }
        .hub-grabber { display: none; }
        .hub-sheet .hub-action:hover, .hub-row:hover { background: var(--bg-surface); }

        @@keyframes hubPop { from { opacity: 0; transform: translate(-50%, -48%) scale(0.97); } }
        @@keyframes hubPopOut { to { opacity: 0; transform: translate(-50%, -48%) scale(0.97); } }
    }
</style>
