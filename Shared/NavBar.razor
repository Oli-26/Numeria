@implements IDisposable
@inject NavigationManager Nav
@inject IGamificationService Gamification
@inject IProgressService Progress
@inject IReviewService ReviewService
@inject IJSRuntime JS

<nav class="bottom-nav">
    <div class="nav-brand" @onclick='() => Navigate("/")'>
        <img class="nav-brand-icon" src="nous-mark.svg" alt="" />
        <span class="nav-brand-name" role="img" aria-label="Nous"></span>
        @if (level > 0)
        {
            <div class="nav-level-badge">
                <span class="nav-level">Lvl @level</span>
                <div class="nav-xp-bar">
                    <div class="nav-xp-fill" style="width: @xpPct.ToString("F0")%"></div>
                </div>
            </div>
        }
    </div>
    <a class="nav-item @(IsActive("/") ? "active" : "")" href="/" @onclick:preventDefault @onclick='() => Navigate("/")'>
        <span class="nav-icon"><Icon Name="home" Size="22" /></span>
        <span class="nav-label">Home</span>
    </a>
    <a class="nav-item @(IsActive("/domains") ? "active" : "")" href="/domains" @onclick:preventDefault @onclick='() => Navigate("/domains")'>
        <span class="nav-icon"><Icon Name="book" Size="22" /></span>
        <span class="nav-label">Subjects</span>
    </a>
    <button class="nav-item nav-hub @(hubOpen ? "open" : "")" aria-expanded="@(hubOpen ? "true" : "false")" @onclick="ToggleHub">
        <span class="nav-hub-disc">
            <Icon Name="@(hubOpen ? "x-mark" : "sparkles")" Size="22" />
            @if (hubDot && !hubOpen)
            {
                <span class="nav-hub-dot"></span>
            }
        </span>
        <span class="nav-label">Today</span>
    </button>
    <a class="nav-item @(IsActive("/leaderboard") ? "active" : "")" href="/leaderboard" @onclick:preventDefault @onclick='() => Navigate("/leaderboard")'>
        <span class="nav-icon"><Icon Name="trophy" Size="22" /></span>
        <span class="nav-label">Ranks</span>
    </a>
    <a class="nav-item @(IsActive("/profile") ? "active" : "")" href="/profile" @onclick:preventDefault @onclick='() => Navigate("/profile")'>
        <span class="nav-icon"><Icon Name="user" Size="22" /></span>
        <span class="nav-label">Profile</span>
    </a>
    <a class="nav-item nav-item-wide @(IsActive("/shop") ? "active" : "")" href="/shop" @onclick:preventDefault @onclick='() => Navigate("/shop")'>
        <span class="nav-icon"><Icon Name="phi" Size="22" /></span>
        <span class="nav-label">Shop</span>
    </a>
    <a class="nav-item nav-item-wide @(IsActive("/settings") ? "active" : "")" href="/settings" @onclick:preventDefault @onclick='() => Navigate("/settings")'>
        <span class="nav-icon"><Icon Name="settings" Size="22" /></span>
        <span class="nav-label">Settings</span>
    </a>
</nav>

<HubSheet Open="hubOpen" OnClose="CloseHub" />

@if (IsActive("/") && level > 0)
{
    var ringLabel = $"Level {level}, {xpInLevel} of {xpNeeded} XP to level {level + 1}";
    <a class="level-ring" href="/profile" aria-label="@ringLabel" title="@ringLabel" @onclick:preventDefault @onclick='() => Navigate("/profile")'>
        <svg width="42" height="42" viewBox="0 0 42 42" aria-hidden="true">
            <circle class="level-ring-track" cx="21" cy="21" r="18" />
            <circle class="level-ring-fill" cx="21" cy="21" r="18" pathLength="100" stroke-dasharray="@xpPct.ToString("F0") 100" transform="rotate(-90 21 21)" />
        </svg>
        <span class="level-ring-text"><small>LVL</small><strong>@level</strong></span>
    </a>
}

@code {
    private string currentUri = "";
    private int level;
    private int xpInLevel;
    private int xpNeeded;
    private double xpPct;
    private bool hubOpen;
    private bool hubDot;
    private EventHandler<Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs>? _locationChangedHandler;

    protected override void OnInitialized()
    {
        currentUri = Nav.ToBaseRelativePath(Nav.Uri);
        _locationChangedHandler = (_, e) => _ = OnLocationChanged(e);
        Nav.LocationChanged += _locationChangedHandler;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await LoadStats();
            StateHasChanged();
        }
    }

    private async Task LoadStats()
    {
        var profile = await Progress.GetProfileAsync();
        level = Gamification.GetLevel(profile.TotalXp);
        xpInLevel = Gamification.GetXpProgressInLevel(profile.TotalXp);
        xpNeeded = Gamification.GetXpForNextLevel(level);
        xpPct = xpNeeded > 0 ? (double)xpInLevel / xpNeeded * 100 : 0;

        var today = DateTime.Now.ToString("yyyy-MM-dd");
        var dailyDone = profile.DailyChallengeDate == today && profile.DailyChallengeCompleted;
        hubDot = !dailyDone || await ReviewService.GetDueCountAsync() > 0;
    }

    private async Task ToggleHub()
    {
        await JS.TryInvokeVoidAsync("Haptics.select");
        hubOpen = !hubOpen;
    }

    private void CloseHub() => hubOpen = false;

    private async Task OnLocationChanged(Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs e)
    {
        try
        {
            hubOpen = false;
            currentUri = Nav.ToBaseRelativePath(Nav.Uri);
            await LoadStats();
            await InvokeAsync(StateHasChanged);
        }
        catch (Exception ex)
        {
            Console.Error.WriteLine($"NavBar OnLocationChanged: {ex}");
        }
    }

    public void Dispose()
    {
        if (_locationChangedHandler != null)
            Nav.LocationChanged -= _locationChangedHandler;
    }

    private bool IsActive(string path)
    {
        var relative = "/" + currentUri;
        if (path == "/") return relative == "/";
        return relative.StartsWith(path);
    }

    private async Task Navigate(string path)
    {
        await JS.TryInvokeVoidAsync("Sounds.playNav");
        await JS.TryInvokeVoidAsync("Haptics.select");
        Nav.NavigateTo(path);
    }
}

<style>
    .bottom-nav {
        position: fixed;
        bottom: 0;
        left: 0;
        right: 0;
        display: flex;
        justify-content: space-around;
        background: var(--bg-card);
        border-top: 1px solid var(--border);
        padding: 6px 0 calc(6px + env(safe-area-inset-bottom));
        z-index: 100;
        box-shadow: 0 -2px 10px var(--shadow);
    }

    .nav-item {
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        text-decoration: none;
        color: var(--text-muted);
        font-size: 0.7rem;
        padding: 8px 6px;
        min-width: 44px;
        min-height: 44px;
        border-radius: 8px;
        transition: color 0.25s ease, transform 0.15s ease;
        -webkit-tap-highlight-color: transparent;
        position: relative;
    }

    .nav-item:active {
        transform: scale(0.9);
    }

    .nav-item.active {
        color: var(--primary);
    }

    /* Phones reach Settings from Profile; the sidebar has room for it. */
    .nav-item-wide { display: none; }

    .nav-icon {
        font-size: 1.4rem;
        margin-bottom: 2px;
        transition: transform 0.25s ease;
    }


    .nav-label {
        font-weight: 500;
    }

    /* Bottom-aligned so its label lines up with the other tabs whatever the raised disc's height. */
    .nav-hub {
        justify-content: flex-end;
        background: none;
        border: 0;
        font-family: inherit;
        cursor: pointer;
    }

    .nav-hub.open { color: var(--primary); }

    .nav-hub-disc {
        position: relative;
        display: flex;
        align-items: center;
        justify-content: center;
        width: 50px;
        height: 50px;
        margin: -28px 0 4px;
        border-radius: 50%;
        background: var(--primary);
        color: white;
        box-shadow: 0 4px 12px color-mix(in srgb, var(--primary) 35%, transparent), 0 0 0 4px var(--bg-card);
        transition: transform 0.2s var(--ease-spring), background 0.2s ease;
    }

    .nav-hub:active .nav-hub-disc { transform: scale(0.92); }
    .nav-hub.open .nav-hub-disc { background: var(--text-primary); }

    .nav-hub-dot {
        position: absolute;
        top: 2px;
        right: 2px;
        width: 11px;
        height: 11px;
        border-radius: 50%;
        background: var(--accent-light);
        border: 2px solid var(--primary);
    }

    /* Home only, pinned like the bottom bar; desktop shows level in the sidebar brand instead. */
    .level-ring {
        position: fixed;
        top: calc(8px + env(safe-area-inset-top));
        right: 12px;
        z-index: 80;
        display: flex;
        align-items: center;
        justify-content: center;
        width: 48px;
        height: 48px;
        border-radius: 50%;
        background: var(--bg-card);
        box-shadow: 0 2px 10px var(--shadow);
        text-decoration: none;
        transition: transform 0.15s ease;
        -webkit-tap-highlight-color: transparent;
    }

    .level-ring:active { transform: scale(0.92); }
    .level-ring svg { position: absolute; inset: 3px; }
    .level-ring-track { fill: none; stroke: var(--bg-surface); stroke-width: 4; }
    .level-ring-fill { fill: none; stroke: var(--accent); stroke-width: 4; stroke-linecap: round; transition: stroke-dasharray 0.5s ease; }
    .level-ring-text { position: relative; display: flex; flex-direction: column; align-items: center; line-height: 1; }
    .level-ring-text small { font-size: 0.5rem; font-weight: 700; letter-spacing: 0.06em; color: var(--text-muted); }
    .level-ring-text strong { font-size: 0.95rem; color: var(--text-primary); }

    /* Brand - hidden on mobile */
    .nav-brand { display: none; }

    /* Desktop: convert to sidebar */
    @@media (min-width: 1024px) {
        .bottom-nav {
            position: fixed;
            top: 0;
            left: 0;
            bottom: 0;
            right: auto;
            width: 220px;
            flex-direction: column;
            justify-content: flex-start;
            padding: 16px 12px;
            gap: 4px;
            border-top: none;
            border-right: 1px solid var(--border);
            box-shadow: none;
        }

        .nav-item-wide { display: flex; }
        .level-ring { display: none; }

        .nav-brand {
            display: flex;
            flex-direction: column;
            align-items: center;
            gap: 6px;
            padding: 12px 8px 16px;
            margin-bottom: 8px;
            border-bottom: 1px solid var(--border);
            cursor: pointer;
            -webkit-tap-highlight-color: transparent;
        }

        .nav-brand-icon {
            width: 44px;
            height: 44px;
            object-fit: contain;
        }

        /* Masked so the wordmark takes the theme's text colour. */
        .nav-brand-name {
            display: block;
            height: 22px;
            aspect-ratio: 395 / 120;
            background: var(--text-primary);
            -webkit-mask: url(nous-wordmark.svg) center / contain no-repeat;
            mask: url(nous-wordmark.svg) center / contain no-repeat;
        }

        .nav-level-badge {
            width: 100%;
            text-align: center;
        }

        .nav-level {
            font-size: 0.7rem;
            font-weight: 600;
            color: var(--text-muted);
        }

        .nav-xp-bar {
            height: 4px;
            background: var(--bg-surface);
            border-radius: 2px;
            margin-top: 4px;
            overflow: hidden;
        }

        .nav-xp-fill {
            height: 100%;
            background: var(--primary);
            border-radius: 2px;
            transition: width 0.5s ease;
        }

        .nav-item {
            flex-direction: row;
            justify-content: flex-start;
            gap: 12px;
            padding: 12px 16px;
            border-radius: var(--radius-sm);
            font-size: 0.9rem;
            width: 100%;
        }

        .nav-item:hover {
            background: var(--bg-surface);
        }

        .nav-item.active {
            background: color-mix(in srgb, var(--primary) 8%, transparent);
        }

        .nav-icon {
            font-size: 1.3rem;
            margin-bottom: 0;
        }

        .nav-hub-disc {
            width: auto;
            height: auto;
            margin: 0;
            background: none;
            color: inherit;
            box-shadow: none;
        }

        .nav-hub.open .nav-hub-disc { background: none; }

        .nav-hub-dot {
            top: -2px;
            right: -4px;
            width: 8px;
            height: 8px;
            border: 0;
            background: var(--primary);
        }
    }
</style>
