@implements IDisposable
@inject NavigationManager Nav
@inject IGamificationService Gamification
@inject IProgressService Progress
@inject IJSRuntime JS

<nav class="bottom-nav">
    <div class="nav-brand" @onclick='() => Navigate("/")'>
        <span class="nav-brand-icon">N</span>
        <span class="nav-brand-name">Numeria</span>
        @if (level > 0)
        {
            <div class="nav-level-badge">
                <span class="nav-level">Lvl @level</span>
                <div class="nav-xp-bar">
                    <div class="nav-xp-fill" style="width: @xpPct.ToString("F0")%"></div>
                </div>
            </div>
        }
    </div>
    <a class="nav-item @(IsActive("/") ? "active" : "")" href="/" @onclick:preventDefault @onclick='() => Navigate("/")'>
        <span class="nav-icon"><Icon Name="home" Size="22" /></span>
        <span class="nav-label">Home</span>
    </a>
    <a class="nav-item @(IsActive("/profile") ? "active" : "")" href="/profile" @onclick:preventDefault @onclick='() => Navigate("/profile")'>
        <span class="nav-icon"><Icon Name="user" Size="22" /></span>
        <span class="nav-label">Profile</span>
    </a>
    <a class="nav-item @(IsActive("/leaderboard") ? "active" : "")" href="/leaderboard" @onclick:preventDefault @onclick='() => Navigate("/leaderboard")'>
        <span class="nav-icon"><Icon Name="trophy" Size="22" /></span>
        <span class="nav-label">Ranks</span>
    </a>
    <a class="nav-item @(IsActive("/shop") ? "active" : "")" href="/shop" @onclick:preventDefault @onclick='() => Navigate("/shop")'>
        <span class="nav-icon"><Icon Name="phi" Size="22" /></span>
        <span class="nav-label">Shop</span>
    </a>
    <a class="nav-item @(IsActive("/settings") ? "active" : "")" href="/settings" @onclick:preventDefault @onclick='() => Navigate("/settings")'>
        <span class="nav-icon"><Icon Name="settings" Size="22" /></span>
        <span class="nav-label">Settings</span>
    </a>
</nav>

@code {
    private string currentUri = "";
    private int level;
    private double xpPct;

    protected override void OnInitialized()
    {
        currentUri = Nav.ToBaseRelativePath(Nav.Uri);
        Nav.LocationChanged += OnLocationChanged;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await LoadStats();
            StateHasChanged();
        }
    }

    private async Task LoadStats()
    {
        var profile = await Progress.GetProfileAsync();
        level = Gamification.GetLevel(profile.TotalXp);
        var xpInLevel = Gamification.GetXpProgressInLevel(profile.TotalXp);
        var xpNeeded = Gamification.GetXpForNextLevel(level);
        xpPct = xpNeeded > 0 ? (double)xpInLevel / xpNeeded * 100 : 0;
    }

    private async void OnLocationChanged(object? sender, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs e)
    {
        currentUri = Nav.ToBaseRelativePath(Nav.Uri);
        await LoadStats();
        await InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        Nav.LocationChanged -= OnLocationChanged;
    }

    private bool IsActive(string path)
    {
        var relative = "/" + currentUri;
        if (path == "/") return relative == "/";
        return relative.StartsWith(path);
    }

    private async Task Navigate(string path)
    {
        try { await JS.InvokeVoidAsync("Sounds.playNav"); } catch { }
        Nav.NavigateTo(path);
    }
}

<style>
    .bottom-nav {
        position: fixed;
        bottom: 0;
        left: 0;
        right: 0;
        display: flex;
        justify-content: space-around;
        background: var(--bg-card);
        border-top: 1px solid var(--border);
        padding: 8px 0;
        z-index: 100;
        box-shadow: 0 -2px 10px var(--shadow);
    }

    .nav-item {
        display: flex;
        flex-direction: column;
        align-items: center;
        text-decoration: none;
        color: var(--text-muted);
        font-size: 0.75rem;
        padding: 4px 12px;
        border-radius: 8px;
        transition: color 0.25s ease, transform 0.15s ease;
        -webkit-tap-highlight-color: transparent;
        position: relative;
    }

    .nav-item:active {
        transform: scale(0.9);
    }

    .nav-item.active {
        color: var(--primary);
    }

    .nav-item.active::before {
        content: '';
        position: absolute;
        top: -8px;
        left: 50%;
        transform: translateX(-50%);
        width: 20px;
        height: 3px;
        background: var(--primary);
        border-radius: 0 0 3px 3px;
        animation: navIndicator 0.3s ease;
    }

    @@keyframes navIndicator {
        from { width: 0; opacity: 0; }
        to { width: 20px; opacity: 1; }
    }

    .nav-icon {
        font-size: 1.4rem;
        margin-bottom: 2px;
        transition: transform 0.25s ease;
    }

    .nav-item.active .nav-icon {
        animation: navBounce 0.4s ease;
    }

    @@keyframes navBounce {
        0% { transform: scale(1); }
        40% { transform: scale(1.25); }
        70% { transform: scale(0.95); }
        100% { transform: scale(1); }
    }

    .nav-label {
        font-weight: 500;
    }

    /* Brand - hidden on mobile */
    .nav-brand { display: none; }

    /* Desktop: convert to sidebar */
    @@media (min-width: 1024px) {
        .bottom-nav {
            position: fixed;
            top: 0;
            left: 0;
            bottom: 0;
            right: auto;
            width: 220px;
            flex-direction: column;
            justify-content: flex-start;
            padding: 16px 12px;
            gap: 4px;
            border-top: none;
            border-right: 1px solid var(--border);
            box-shadow: none;
        }

        .nav-brand {
            display: flex;
            flex-direction: column;
            align-items: center;
            gap: 6px;
            padding: 12px 8px 16px;
            margin-bottom: 8px;
            border-bottom: 1px solid var(--border);
            cursor: pointer;
            -webkit-tap-highlight-color: transparent;
        }

        .nav-brand-icon {
            width: 44px;
            height: 44px;
            border-radius: 12px;
            background: linear-gradient(135deg, var(--primary), var(--primary-dark));
            color: white;
            font-family: 'Cinzel', Georgia, serif;
            font-size: 1.5rem;
            font-weight: 700;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .nav-brand-name {
            font-family: 'Cinzel', Georgia, serif;
            font-size: 1.1rem;
            font-weight: 700;
            letter-spacing: 0.08em;
            color: var(--text-primary);
        }

        .nav-level-badge {
            width: 100%;
            text-align: center;
        }

        .nav-level {
            font-size: 0.7rem;
            font-weight: 600;
            color: var(--text-muted);
        }

        .nav-xp-bar {
            height: 4px;
            background: var(--bg-surface);
            border-radius: 2px;
            margin-top: 4px;
            overflow: hidden;
        }

        .nav-xp-fill {
            height: 100%;
            background: var(--primary);
            border-radius: 2px;
            transition: width 0.5s ease;
        }

        .nav-item {
            flex-direction: row;
            justify-content: flex-start;
            gap: 12px;
            padding: 12px 16px;
            border-radius: var(--radius-sm);
            font-size: 0.9rem;
            width: 100%;
        }

        .nav-item:hover {
            background: var(--bg-surface);
        }

        .nav-item.active {
            background: rgba(74, 95, 224, 0.08);
        }

        .nav-item.active::before {
            top: 50%;
            left: 0;
            transform: translateY(-50%);
            width: 3px;
            height: 20px;
            border-radius: 0 3px 3px 0;
        }

        .nav-icon {
            font-size: 1.3rem;
            margin-bottom: 0;
        }
    }
</style>
