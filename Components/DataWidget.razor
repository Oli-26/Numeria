    .dw-table-toggle {
        margin-top: 8px; background: none; border: none; padding: 0; color: var(--primary);
        font-size: 0.75rem; cursor: pointer; font-family: inherit; text-decoration: underline;
    }
    .dw-table, .dw-matrix { width: 100%; border-collapse: collapse; font-size: 0.8rem; }
    .dw-table td, .dw-table th, .dw-matrix td, .dw-matrix th { border: 1px solid var(--border); padding: 6px 8px; text-align: left; }
    .dw-matrix th { color: var(--text-primary); background: var(--bg-surface); font-weight: 600; }
