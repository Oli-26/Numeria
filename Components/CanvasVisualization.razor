            (1,2), (1,5),          // B connects to C, F
            (2,3), (2,5),          // C connects to D, F
            (3,4), (3,5),          // D connects to E, F
        };

        // Draw edges first
        foreach (var (a, b) in edges)
        {
            await Viz.DrawFunctionAsync(CanvasId,
                new[] { new[] { vertices[a].x, vertices[a].y }, new[] { vertices[b].x, vertices[b].y } },
                "rgba(100, 100, 120, 0.3)", 1.5);
        }

        // Draw vertices
        foreach (var (x, y, label, color) in vertices)
        {
            await Viz.DrawPointAsync(CanvasId, x, y, 16, color);
            await Viz.DrawTextAsync(CanvasId, label, x, y + 5, "#FFF", 13, "center");
        }

        // Legend
        var colors = new (string name, string color)[] {
            ("R", "#E74C3C"), ("B", "#3498DB"), ("G", "#2ECC71"), ("Y", "#F39C12")
        };
        double legendX = 24;
        for (int i = 0; i < colors.Length; i++)
        {
            await Viz.DrawPointAsync(CanvasId, legendX + i * 28, Height - 14, 6, colors[i].color);
        }

        await Viz.DrawTextAsync(CanvasId, "4-coloring: no adjacent vertices share a color", Width / 2, 16, "#4A5FE0", 11);
        await Viz.DrawTextAsync(CanvasId, "χ(G) ≤ 4 for planar graphs", Width / 2, Height - 8, "#888", 10);
    }

    private async Task DrawChainRuleViz()
    {
        // Chain rule: f(g(x)) with g(x) = x^2 and f(u) = sin(u)
        // Show two plots side by side with connecting arrows
        double gap = 12;
        double plotW = (Width - gap) / 2.0;
        double plotH = Height - 60;
        double plotY = 36;

        // Left panel: g(x) = x^2
        double lCx = plotW / 2.0, lCy = plotY + plotH / 2.0;
        double scaleL = 25;
        // Draw mini axes for left panel
        await Viz.DrawFunctionAsync(CanvasId,
            new[] { new[] { 4.0, lCy }, new[] { plotW - 4, lCy } }, "rgba(26,26,46,0.2)", 1);
        await Viz.DrawFunctionAsync(CanvasId,
            new[] { new[] { lCx, plotY + 4 }, new[] { lCx, plotY + plotH - 4 } }, "rgba(26,26,46,0.2)", 1);

        // Plot g(x) = x^2 on left
        Func<double, double> g = x => x * x;
        int samplesL = 80;
        var gPoints = new double[samplesL][];
        for (int i = 0; i < samplesL; i++)
        {
            double x = -3.0 + 6.0 * i / (samplesL - 1);
            double sx = lCx + x * scaleL;
            double sy = lCy - g(x) * scaleL;
            gPoints[i] = new[] { sx, sy };
        }
        await Viz.DrawFunctionAsync(CanvasId, gPoints, "#4A90D9", 2);
        await Viz.DrawTextAsync(CanvasId, "g(x) = x²", lCx, plotY + plotH + 14, "#4A90D9", 11);

        // Right panel: f(u) = sin(u)
        double rCx = plotW + gap + plotW / 2.0, rCy = plotY + plotH / 2.0;
        double scaleR = 22;
        await Viz.DrawFunctionAsync(CanvasId,
            new[] { new[] { plotW + gap + 4, rCy }, new[] { Width - 4.0, rCy } }, "rgba(26,26,46,0.2)", 1);
        await Viz.DrawFunctionAsync(CanvasId,
            new[] { new[] { rCx, plotY + 4 }, new[] { rCx, plotY + plotH - 4 } }, "rgba(26,26,46,0.2)", 1);

        // Plot f(u) = sin(u) on right
        Func<double, double> f = u => Math.Sin(u);
        int samplesR = 100;
        var fPoints = new double[samplesR][];
        for (int i = 0; i < samplesR; i++)
        {
            double u = -4.0 + 8.0 * i / (samplesR - 1);
            double sx = rCx + u * scaleR;
            double sy = rCy - f(u) * scaleR * 2;
            fPoints[i] = new[] { sx, sy };
        }
        await Viz.DrawFunctionAsync(CanvasId, fPoints, "#E74C3C", 2);
        await Viz.DrawTextAsync(CanvasId, "f(u) = sin(u)", rCx, plotY + plotH + 14, "#E74C3C", 11);

        // Show the chain: pick x=1.2 -> g(1.2)=1.44 -> f(1.44)=sin(1.44)
        double xVal = 1.2;
        double gVal = g(xVal);
        double fVal = f(gVal);

        // Mark x on left
        double xPxL = lCx + xVal * scaleL;
        double yPxL = lCy - gVal * scaleL;
        await Viz.DrawPointAsync(CanvasId, xPxL, yPxL, 5, "#EF5350", "");
        await Viz.DrawTextAsync(CanvasId, $"x={xVal:F1}", xPxL, lCy + 14, "#EF5350", 9);

        // Intermediate value: draw dashed horizontal line from g output to f input
        double uPxR = rCx + gVal * scaleR;
        double vPxR = rCy - fVal * scaleR * 2;
        await Viz.DrawPointAsync(CanvasId, uPxR, vPxR, 5, "#EF5350", "");

        // Arrow connecting the two panels
        await Viz.DrawVectorAsync(CanvasId, xPxL + 8, yPxL, plotW + gap - 4, rCy - gVal * scaleR * 0.3, "#9B59B6", "");
        await Viz.DrawTextAsync(CanvasId, $"g={gVal:F2}", (xPxL + plotW + gap) / 2.0, yPxL - 10, "#9B59B6", 9);

        // Title
        await Viz.DrawTextAsync(CanvasId, "Chain rule: d/dx f(g(x)) = f'(g(x))·g'(x)", Width / 2, 14, "#4A5FE0", 11);
    }

    private async Task DrawDotProductViz()
    {
        await Viz.DrawAxesAsync(CanvasId, Scale, Scale);

        // Vector a is fixed along x-axis
        double aLen = 3.0;
        double bLen = 2.5;
        double thetaRad = dotAngleDeg * Math.PI / 180.0;

        double ax = aLen, ay = 0;
        double bx = bLen * Math.Cos(thetaRad), by = bLen * Math.Sin(thetaRad);

        // Draw vector a
        await Viz.DrawVectorAsync(CanvasId, CX, CY, ToScreenX(ax), ToScreenY(ay), "#4A90D9", "a");

        // Draw vector b
        await Viz.DrawVectorAsync(CanvasId, CX, CY, ToScreenX(bx), ToScreenY(by), "#E74C3C", "b");

        // Projection of b onto a: proj = (a.b / a.a) * a
        double dotProd = ax * bx + ay * by;
        double projScalar = dotProd / (ax * ax + ay * ay);
        double projX = projScalar * ax;
        double projY = projScalar * ay;

        // Draw projection (dashed via short segments)
        // Projection point on a-line
        await Viz.DrawPointAsync(CanvasId, ToScreenX(projX), ToScreenY(projY), 4, "#9B59B6", "");

        // Dashed line from b tip to projection point
        int dashes = 10;
        for (int i = 0; i < dashes; i += 2)
        {
            double t0 = i / (double)dashes;
            double t1 = (i + 1) / (double)dashes;
            var dashLine = new double[][] {
                new[] { ToScreenX(bx + (projX - bx) * t0), ToScreenY(by + (projY - by) * t0) },
                new[] { ToScreenX(bx + (projX - bx) * t1), ToScreenY(by + (projY - by) * t1) }
            };
            await Viz.DrawFunctionAsync(CanvasId, dashLine, "#9B59B6", 1.5);
        }

        // Draw projection vector (shadow on a)
        if (Math.Abs(projScalar) > 0.01)
        {
            await Viz.DrawVectorAsync(CanvasId, CX, CY, ToScreenX(projX), ToScreenY(projY), "rgba(155,89,182,0.6)", "proj");
        }

        // Angle arc
        int arcSteps = 16;
        double arcR = 0.6;
        var arcPoints = new double[arcSteps + 1][];
        for (int i = 0; i <= arcSteps; i++)
        {
            double a2 = thetaRad * i / arcSteps;
            arcPoints[i] = new[] { ToScreenX(arcR * Math.Cos(a2)), ToScreenY(arcR * Math.Sin(a2)) };
        }
        await Viz.DrawFunctionAsync(CanvasId, arcPoints, "#F39C12", 1.5);
        // Angle label
        double labelAngle = thetaRad / 2;
        await Viz.DrawTextAsync(CanvasId, "θ", ToScreenX(0.85 * Math.Cos(labelAngle)), ToScreenY(0.85 * Math.Sin(labelAngle)), "#F39C12", 12);

        // Display dot product value
        double cosTheta = Math.Cos(thetaRad);
        double dotValue = aLen * bLen * cosTheta;
        await Viz.DrawTextAsync(CanvasId, $"a·b = |a||b|cosθ = {dotValue:F2}", Width / 2, 20, "#4A5FE0", 12);
    }

    // ── Fractal visualizations ──────────────────────────────────

    private async Task DrawKochSnowflake()
    {
        // Draw Koch snowflake starting from an equilateral triangle
        double cx = Width / 2.0, cy = Height / 2.0 + 10;
        double r = Math.Min(Width, Height) / 2.0 - 30;

        // Three vertices of equilateral triangle (pointing up)
        double ax = cx, ay = cy - r;
        double bx = cx - r * Math.Sin(Math.PI / 3), by = cy + r * 0.5;
        double cxp = cx + r * Math.Sin(Math.PI / 3), cyp = cy + r * 0.5;

        // Build Koch curve segments for each side
        var allPoints = new List<double[]>();
        var side1 = KochCurvePoints(ax, ay, bx, by, kochIterations);
        var side2 = KochCurvePoints(bx, by, cxp, cyp, kochIterations);
        var side3 = KochCurvePoints(cxp, cyp, ax, ay, kochIterations);

        allPoints.AddRange(side1);
        allPoints.AddRange(side2);
        allPoints.AddRange(side3);
        allPoints.Add(new[] { ax, ay }); // close the shape

        // Draw filled shape with gradient-like effect
        await Viz.DrawShapeAsync(CanvasId, allPoints.ToArray(), "rgba(142, 68, 173, 0.12)", "#8E44AD", 2);

        // Draw the outline with a brighter color
        await Viz.DrawFunctionAsync(CanvasId, allPoints.ToArray(), "#9B59B6", 2);

        await Viz.DrawTextAsync(CanvasId, $"Koch Snowflake (iteration {kochIterations})", Width / 2, 16, "#8E44AD", 12);
    }

    private List<double[]> KochCurvePoints(double x1, double y1, double x2, double y2, int depth)
    {
        var points = new List<double[]>();
        if (depth == 0)
        {
            points.Add(new[] { x1, y1 });
            return points;
        }

        // Divide segment into thirds
        double dx = x2 - x1, dy = y2 - y1;
        double ax = x1 + dx / 3, ay = y1 + dy / 3;
        double bx = x1 + 2 * dx / 3, by = y1 + 2 * dy / 3;

        // Peak of equilateral triangle on the middle third
        double px = (ax + bx) / 2 - (by - ay) * Math.Sqrt(3) / 2;
        double py = (ay + by) / 2 + (bx - ax) * Math.Sqrt(3) / 2;

        // Recurse on 4 segments
        points.AddRange(KochCurvePoints(x1, y1, ax, ay, depth - 1));
        points.AddRange(KochCurvePoints(ax, ay, px, py, depth - 1));
        points.AddRange(KochCurvePoints(px, py, bx, by, depth - 1));
        points.AddRange(KochCurvePoints(bx, by, x2, y2, depth - 1));

        return points;
    }

    private async Task DrawSierpinski()
    {
        double cx = Width / 2.0;
        double margin = 20;
        double side = Math.Min(Width - 2 * margin, Height - 50);
        double h = side * Math.Sqrt(3) / 2;

        // Top vertex, bottom-left, bottom-right
        double topX = cx, topY = 30;
        double blX = cx - side / 2, blY = 30 + h;
        double brX = cx + side / 2, brY = 30 + h;

        // Draw the filled background triangle
        await Viz.DrawShapeAsync(CanvasId,
            new[] { new[] { topX, topY }, new[] { blX, blY }, new[] { brX, brY } },
            "rgba(142, 68, 173, 0.06)", null, 0);

        // Recursively draw Sierpinski
        await DrawSierpinskiTriangle(topX, topY, blX, blY, brX, brY, sierpinskiIterations);

        await Viz.DrawTextAsync(CanvasId, $"Sierpinski Triangle (iteration {sierpinskiIterations})", Width / 2, Height - 6, "#8E44AD", 11);
    }

    private async Task DrawSierpinskiTriangle(double x1, double y1, double x2, double y2, double x3, double y3, int depth)
    {
        if (depth == 0)
        {
            // Draw filled triangle
            await Viz.DrawShapeAsync(CanvasId,
                new[] { new[] { x1, y1 }, new[] { x2, y2 }, new[] { x3, y3 } },
                "rgba(155, 89, 182, 0.35)", "#9B59B6", 1);
            return;
        }

        // Midpoints
        double mx12 = (x1 + x2) / 2, my12 = (y1 + y2) / 2;
        double mx23 = (x2 + x3) / 2, my23 = (y2 + y3) / 2;
        double mx13 = (x1 + x3) / 2, my13 = (y1 + y3) / 2;

        // Recurse on 3 corner triangles (skip middle)
        await DrawSierpinskiTriangle(x1, y1, mx12, my12, mx13, my13, depth - 1);
        await DrawSierpinskiTriangle(mx12, my12, x2, y2, mx23, my23, depth - 1);
        await DrawSierpinskiTriangle(mx13, my13, mx23, my23, x3, y3, depth - 1);
    }

    private async Task DrawMandelbrotSimple()
    {
        // Render a low-res Mandelbrot set with escape-time coloring
        int pixW = 175, pixH = 140;
        double xMin = -2.2, xMax = 0.8, yMin = -1.2, yMax = 1.2;
        int maxIter = 50;

        double pxW = (double)Width / pixW;
        double pxH = (double)Height / pixH;

        // Color palette: deep purple → magenta → gold → white for escape, black for set
        string[] palette = new string[]
        {
            "#1a0533", "#2d0a4e", "#4a0e6b", "#6b1488", "#8E44AD",
            "#a855c7", "#c471db", "#d68fe0", "#e0a0e8", "#C39BD3",
            "#e8b84d", "#f0c74d", "#f5d76e", "#f9e084", "#fceabb",
            "#FFF"
        };

        for (int py = 0; py < pixH; py++)
        {
            for (int px = 0; px < pixW; px++)
            {
                double cr = xMin + (xMax - xMin) * px / pixW;
                double ci = yMin + (yMax - yMin) * py / pixH;

                double zr = 0, zi = 0;
                int iter = 0;
                while (iter < maxIter && zr * zr + zi * zi <= 4)
                {
                    double tmp = zr * zr - zi * zi + cr;
                    zi = 2 * zr * zi + ci;
                    zr = tmp;
                    iter++;
                }

                string color;
                if (iter == maxIter)
                {
                    color = "#0a0014"; // deep black-purple for the set
                }
                else
                {
                    int idx = (int)((double)iter / maxIter * (palette.Length - 1));
                    color = palette[Math.Min(idx, palette.Length - 1)];
                }

                await Viz.DrawRectAsync(CanvasId, px * pxW, py * pxH, pxW + 0.5, pxH + 0.5, color, null);
            }
        }

        await Viz.DrawTextAsync(CanvasId, "Mandelbrot Set", Width / 2, 16, "rgba(255,255,255,0.85)", 13);
    }

    private async Task DrawJuliaSet()
    {
        // Render Julia set for c = -0.7 + 0.27i with escape-time coloring
        int pixW = 175, pixH = 140;
        double xMin = -1.6, xMax = 1.6, yMin = -1.2, yMax = 1.2;
        int maxIter = 50;
        double cReal = -0.7, cImag = 0.27;

        double pxW = (double)Width / pixW;
        double pxH = (double)Height / pixH;

        // Color palette: teal → cyan → blue → indigo for escape, dark for set
        string[] palette = new string[]
        {
            "#0a1628", "#0d2137", "#133a5c", "#16A085", "#1ABC9C",
            "#48C9B0", "#76D7C4", "#A3E4D7", "#55BFD6", "#4A90D9",
            "#7B68EE", "#9B59B6", "#D2B4DE", "#E8DAEF", "#F5EEF8",
            "#FFF"
        };

        for (int py = 0; py < pixH; py++)
        {
            for (int px = 0; px < pixW; px++)
            {
                double zr = xMin + (xMax - xMin) * px / pixW;
                double zi = yMin + (yMax - yMin) * py / pixH;

                int iter = 0;
                while (iter < maxIter && zr * zr + zi * zi <= 4)
                {
                    double tmp = zr * zr - zi * zi + cReal;
                    zi = 2 * zr * zi + cImag;
                    zr = tmp;
                    iter++;
                }

                string color;
                if (iter == maxIter)
                {
                    color = "#05050f"; // very dark for the set
                }
                else
                {
                    int idx = (int)((double)iter / maxIter * (palette.Length - 1));
                    color = palette[Math.Min(idx, palette.Length - 1)];
                }

                await Viz.DrawRectAsync(CanvasId, px * pxW, py * pxH, pxW + 0.5, pxH + 0.5, color, null);
            }
        }

        await Viz.DrawTextAsync(CanvasId, "Julia Set (c = -0.7 + 0.27i)", Width / 2, 16, "rgba(255,255,255,0.85)", 13);
    }

    private async Task DrawLogisticMap()
    {
        // Bifurcation diagram for logistic map x → rx(1-x)
        double rMin = 2.5, rMax = 4.0;
        int rSteps = 300;
        int warmup = 200;
        int plotIter = 100;

        double marginL = 30, marginR = 10, marginT = 30, marginB = 24;
        double plotW = Width - marginL - marginR;
        double plotH = Height - marginT - marginB;

        // Draw axes
        await Viz.DrawFunctionAsync(CanvasId,
            new[] { new[] { marginL, marginT }, new[] { marginL, Height - marginB }, new[] { Width - marginR, Height - marginB } },
            "rgba(142, 68, 173, 0.4)", 1);

        // Axis labels
        await Viz.DrawTextAsync(CanvasId, "2.5", marginL, Height - 10, "#888", 9);
        await Viz.DrawTextAsync(CanvasId, "4.0", Width - marginR, Height - 10, "#888", 9);
        await Viz.DrawTextAsync(CanvasId, "r", Width / 2, Height - 6, "#8E44AD", 10);
        await Viz.DrawTextAsync(CanvasId, "1", marginL - 12, marginT + 4, "#888", 9);
        await Viz.DrawTextAsync(CanvasId, "0", marginL - 12, Height - marginB + 4, "#888", 9);

        for (int ri = 0; ri < rSteps; ri++)
        {
            double r = rMin + (rMax - rMin) * ri / rSteps;
            double x = 0.3; // initial condition

            // Warmup: let transients die out
            for (int i = 0; i < warmup; i++)
                x = r * x * (1 - x);

            // Plot the attractor points
            double screenX = marginL + plotW * ri / rSteps;
            for (int i = 0; i < plotIter; i++)
            {
                x = r * x * (1 - x);
                double screenY = marginT + plotH * (1 - x);

                // Color based on r: purple in stable region, transitioning to magenta/gold in chaos
                double t = (r - rMin) / (rMax - rMin);
                string color;
                if (t < 0.4)
                    color = "rgba(142, 68, 173, 0.6)";
                else if (t < 0.7)
                    color = "rgba(192, 57, 43, 0.4)";
                else
                    color = "rgba(230, 126, 34, 0.35)";

                await Viz.DrawRectAsync(CanvasId, screenX, screenY, 1.2, 1.2, color, null);
            }
        }

        await Viz.DrawTextAsync(CanvasId, "Bifurcation Diagram: x → rx(1-x)", Width / 2, 14, "#8E44AD", 12);
    }

