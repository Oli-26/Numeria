        // False negative (disease + test negative)
        await Viz.DrawRectAsync(CanvasId, left, top + diseasePosH, diseaseW, diseaseNegH,
            "rgba(231, 76, 60, 0.15)", "#E74C3C");
        await Viz.DrawTextAsync(CanvasId, "FN", left + diseaseW / 2, top + diseasePosH + diseaseNegH / 2 + 4, "#C0392B", 9);

        // Healthy column
        // False positive (healthy + test positive) -- also highlighted for comparison
        await Viz.DrawRectAsync(CanvasId, left + diseaseW, top, healthyW, healthyPosH,
            "rgba(230, 126, 34, 0.4)", "#E67E22");
        await Viz.DrawTextAsync(CanvasId, "FP", left + diseaseW + healthyW / 2, top + healthyPosH / 2 + 4, "#FFF", 11);

        // True negative (healthy + test negative)
        await Viz.DrawRectAsync(CanvasId, left + diseaseW, top + healthyPosH, healthyW, healthyNegH,
            "rgba(46, 204, 113, 0.15)", "#2ECC71");
        await Viz.DrawTextAsync(CanvasId, "TN", left + diseaseW + healthyW / 2, top + healthyPosH + healthyNegH / 2 + 4, "#2ECC71", 11);

        // Labels
        await Viz.DrawTextAsync(CanvasId, "Disease 1%", left + diseaseW / 2, top - 6, "#E74C3C", 10);
        await Viz.DrawTextAsync(CanvasId, "Healthy 99%", left + diseaseW + healthyW / 2, top - 6, "#2ECC71", 10);

        // Horizontal line showing "all positives"
        var posLineY = top + Math.Max(diseasePosH, healthyPosH) + 4;
        await Viz.DrawFunctionAsync(CanvasId, new double[][] {
