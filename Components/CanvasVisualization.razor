        double left = 20, top = 36, w = Width - 40, h = Height - 56;

        // Disease prevalence = 1%
        double diseaseW = w * 0.20; // exaggerated width for visibility, labeled 1%
        double healthyW = w - diseaseW;

        // Test sensitivity = 95%, specificity = 95%
        double diseasePosH = h * 0.95;  // true positive
        double diseaseNegH = h - diseasePosH;
        double healthyPosH = h * 0.05;  // false positive
        double healthyNegH = h - healthyPosH;

