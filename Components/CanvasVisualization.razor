    private async Task DrawFactorTree()
    {
        // Factor tree: 60 -> 2 * 30 -> 2 * 15 -> 3 * 5
        var primeColor = "#2ECC71";
        var compositeColor = "#4A90D9";
        double midX = Width / 2.0;

        // Node positions: (x, y, label, isPrime)
        var nodes = new (double x, double y, string label, bool isPrime)[]
        {
            (midX, 36, "60", false),           // 0: root
            (midX - 80, 100, "2", true),       // 1: left child
            (midX + 50, 100, "30", false),     // 2: right child
            (midX, 164, "2", true),            // 3: 30's left child
            (midX + 100, 164, "15", false),    // 4: 30's right child
            (midX + 55, 228, "3", true),       // 5: 15's left child
            (midX + 145, 228, "5", true),      // 6: 15's right child
        };

        // Edges: parent -> child
        var edges = new[] { (0,1), (0,2), (2,3), (2,4), (4,5), (4,6) };
        foreach (var (p, c) in edges)
        {
            var line = new double[][] {
