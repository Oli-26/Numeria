        await Viz.DrawTextAsync(CanvasId, $"P(disease|+) = TP/(TP+FP) ≈ {pDiseaseGivenPos:P0}", Width / 2, Height - 6, "#E74C3C", 11);
    }

    private async Task DrawBellCurve()
    {
        await Viz.DrawAxesAsync(CanvasId, Scale, Scale);

        double sigma = bellSigma;
        double mu = 0;
        Func<double, double> normal = x =>
            (1.0 / (sigma * Math.Sqrt(2 * Math.PI))) * Math.Exp(-0.5 * Math.Pow((x - mu) / sigma, 2));

        // Shade 3-sigma region (99.7%) - lightest
        var shade3 = new List<double[]>();
        shade3.Add(new[] { ToScreenX(-3 * sigma), ToScreenY(0) });
        for (double x = -3 * sigma; x <= 3 * sigma; x += 0.05)
        {
            shade3.Add(new[] { ToScreenX(x), ToScreenY(normal(x)) });
        }
        shade3.Add(new[] { ToScreenX(3 * sigma), ToScreenY(0) });
        await Viz.DrawShapeAsync(CanvasId, shade3.ToArray(), "rgba(52, 152, 219, 0.10)", null, 0);

        // Shade 2-sigma region (95%)
        var shade2 = new List<double[]>();
        shade2.Add(new[] { ToScreenX(-2 * sigma), ToScreenY(0) });
        for (double x = -2 * sigma; x <= 2 * sigma; x += 0.05)
        {
            shade2.Add(new[] { ToScreenX(x), ToScreenY(normal(x)) });
        }
        shade2.Add(new[] { ToScreenX(2 * sigma), ToScreenY(0) });
        await Viz.DrawShapeAsync(CanvasId, shade2.ToArray(), "rgba(52, 152, 219, 0.15)", null, 0);

        // Shade 1-sigma region (68%)
        var shade1 = new List<double[]>();
        shade1.Add(new[] { ToScreenX(-sigma), ToScreenY(0) });
        for (double x = -sigma; x <= sigma; x += 0.05)
        {
            shade1.Add(new[] { ToScreenX(x), ToScreenY(normal(x)) });
        }
        shade1.Add(new[] { ToScreenX(sigma), ToScreenY(0) });
        await Viz.DrawShapeAsync(CanvasId, shade1.ToArray(), "rgba(52, 152, 219, 0.25)", null, 0);

        // Draw the bell curve itself
        var curvePoints = PlotFunction(normal, -4, 4);
        await Viz.DrawFunctionAsync(CanvasId, curvePoints, "#3498DB", 2.5);

        // Labels for sigma regions
        double peakY = normal(0);
        double labelY = ToScreenY(peakY * 0.3);
        await Viz.DrawTextAsync(CanvasId, "68%", Width / 2, labelY, "#2980B9", 11);
        if (sigma <= 2.0)
        {
            await Viz.DrawTextAsync(CanvasId, "95%", ToScreenX(1.5 * sigma), labelY + 16, "rgba(41,128,185,0.7)", 10);
            await Viz.DrawTextAsync(CanvasId, "99.7%", ToScreenX(2.5 * sigma), labelY + 30, "rgba(41,128,185,0.5)", 9);
        }

        await Viz.DrawTextAsync(CanvasId, $"Normal(μ=0, σ={sigma:F1})", Width / 2, 16, "#3498DB", 12);
    }

    private async Task DrawPermutationCycle()
    {
        // 4 numbered circles in a row, showing permutation (1 3 4 2): 1->3, 2->1, 3->4, 4->2
        double startX = 45, spacing = (Width - 90) / 3.0;
        double y = Height / 2.0 - 10;
        double r = 22;

        var positions = new (double x, double y)[]
        {
            (startX, y),
            (startX + spacing, y),
            (startX + 2 * spacing, y),
            (startX + 3 * spacing, y),
        };

        // Draw circles and labels
        for (int i = 0; i < 4; i++)
        {
            await Viz.DrawPointAsync(CanvasId, positions[i].x, positions[i].y, r, "rgba(74, 95, 224, 0.12)");
            await Viz.DrawPointAsync(CanvasId, positions[i].x, positions[i].y, r - 2, "rgba(74, 95, 224, 0.08)");
            await Viz.DrawTextAsync(CanvasId, (i + 1).ToString(), positions[i].x, positions[i].y + 5, "#4A5FE0", 16, "center");
        }

        // Permutation: 1->3, 2->1, 3->4, 4->2
        // Cycles: (1 3 4 2)
        var arrows = new (int from, int to, string color)[]
        {
            (0, 2, "#E74C3C"),  // 1 -> 3
            (1, 0, "#2ECC71"),  // 2 -> 1
            (2, 3, "#9B59B6"),  // 3 -> 4
            (3, 1, "#E67E22"),  // 4 -> 2
        };

        foreach (var (from, to, color) in arrows)
        {
            var fx = positions[from].x;
            var fy = positions[from].y;
            var tx = positions[to].x;
            var ty = positions[to].y;

            // Create a curved arrow above (for right-going) or below (for left-going)
            bool goesRight = to > from;
            double midX = (fx + tx) / 2.0;
            double dist = Math.Abs(tx - fx);
            double curveHeight = Math.Min(dist * 0.45, 70);
            double curveY = goesRight ? fy - r - curveHeight : fy + r + curveHeight;

            // Build curve points using quadratic bezier approximation
            int steps = 16;
            var curvePoints = new double[steps + 1][];
            for (int i = 0; i <= steps; i++)
            {
                double t = i / (double)steps;
                double startPx = fx + (goesRight ? r * 0.7 : -r * 0.7);
                double endPx = tx + (goesRight ? -r * 0.7 : r * 0.7);
                double startPy = goesRight ? fy - r * 0.7 : fy + r * 0.7;
                double endPy = goesRight ? ty - r * 0.7 : ty + r * 0.7;
                // Quadratic bezier: P = (1-t)^2*P0 + 2(1-t)t*P1 + t^2*P2
                double bx = (1 - t) * (1 - t) * startPx + 2 * (1 - t) * t * midX + t * t * endPx;
                double by = (1 - t) * (1 - t) * startPy + 2 * (1 - t) * t * curveY + t * t * endPy;
                curvePoints[i] = new[] { bx, by };
            }
            await Viz.DrawFunctionAsync(CanvasId, curvePoints, color, 2);

            // Arrowhead at the end
            var lastPt = curvePoints[steps];
            var prevPt = curvePoints[steps - 1];
            double angle = Math.Atan2(lastPt[1] - prevPt[1], lastPt[0] - prevPt[0]);
            double headLen = 10;
            var arrowPts = new double[][] {
                lastPt,
                new[] { lastPt[0] - headLen * Math.Cos(angle - 0.4), lastPt[1] - headLen * Math.Sin(angle - 0.4) },
                new[] { lastPt[0] - headLen * Math.Cos(angle + 0.4), lastPt[1] - headLen * Math.Sin(angle + 0.4) }
            };
            await Viz.DrawShapeAsync(CanvasId, arrowPts, color, color, 1);
        }

        // Labels
        await Viz.DrawTextAsync(CanvasId, "Permutation (1 3 4 2): one 4-cycle", Width / 2, 16, "#4A5FE0", 12);
        await Viz.DrawTextAsync(CanvasId, "1→3  2→1  3→4  4→2", Width / 2, Height - 12, "#666", 11);
    }

    private async Task DrawEulerBridges()
    {
        // Konigsberg: 4 landmasses, 7 bridges
        // Layout: top land, bottom land, left land, right land
        double cx = Width / 2.0, cy = Height / 2.0;

        // Landmass positions and sizes
        var lands = new (double x, double y, double w, double h, string label, int degree)[]
        {
            (cx, cy - 70, 60, 32, "A (deg 3)", 3),   // top
            (cx, cy + 70, 60, 32, "B (deg 3)", 3),   // bottom
            (cx - 110, cy, 50, 32, "C (deg 5)", 5),   // left
            (cx + 110, cy, 50, 32, "D (deg 3)", 3),   // right
        };

        // Draw landmasses
        var oddColor = "#E74C3C";
        foreach (var (x, y, w, h, label, deg) in lands)
        {
            // All vertices have odd degree in Konigsberg
            await Viz.DrawRectAsync(CanvasId, x - w / 2, y - h / 2, w, h, "rgba(231, 76, 60, 0.15)", oddColor);
            await Viz.DrawTextAsync(CanvasId, label, x, y + 4, oddColor, 10, "center");
        }

        // Bridges (edges): 7 total
        // A-C, A-C (two bridges), A-D, B-C, B-C (two bridges), B-D
        // Actually Konigsberg: C-A x2, C-B x2, A-D, B-D, A-B
        var bridges = new (int from, int to, double offsetX, double offsetY)[]
        {
            (2, 0, 0, -10),   // C-A bridge 1
            (2, 0, 0, 10),    // C-A bridge 2
            (2, 1, 0, -10),   // C-B bridge 1
            (2, 1, 0, 10),    // C-B bridge 2
            (0, 3, 0, 0),     // A-D
            (1, 3, 0, 0),     // B-D
            (0, 1, 12, 0),    // A-B
        };

        for (int i = 0; i < bridges.Length; i++)
        {
            var (from, to, offX, offY) = bridges[i];
            var line = new double[][] {
                new[] { lands[from].x + offX, lands[from].y + offY },
                new[] { lands[to].x + offX, lands[to].y + offY }
            };
            await Viz.DrawFunctionAsync(CanvasId, line, "#4A90D9", 3);
            // Bridge label
            double mx = (lands[from].x + lands[to].x) / 2.0 + offX;
            double my = (lands[from].y + lands[to].y) / 2.0 + offY;
            await Viz.DrawPointAsync(CanvasId, mx, my, 3, "#4A90D9");
        }

        await Viz.DrawTextAsync(CanvasId, "Königsberg: all vertices odd → no Euler path", Width / 2, 16, "#E74C3C", 11);
        await Viz.DrawTextAsync(CanvasId, "7 bridges, 4 landmasses", Width / 2, Height - 8, "#4A90D9", 10);
    }

