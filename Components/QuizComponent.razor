@inject IQuizEngine QuizEngine
@inject IGamificationService Gamification
@inject IProgressService Progress
@inject ISessionStateService SessionState
@inject IReviewService ReviewService
@inject NavigationManager Nav
@inject IJSRuntime JS

@if (quizState == QuizState.Loading)
{
    <div class="loading">
        <div class="spinner"></div>
        <span>Preparing quiz...</span>
    </div>
}
else if (quizState == QuizState.Empty)
{
    <div class="card" style="text-align: center; padding: 32px 24px;">
        <h2>No Questions Available</h2>
        <p style="color: var(--text-muted); margin: 8px 0 16px;">There aren't enough questions for this quiz yet. Try another topic or complete more lessons.</p>
        <button class="btn btn-primary" @onclick="() => OnComplete.InvokeAsync(0)">Go Back</button>
    </div>
}
else if (quizState == QuizState.InProgress && currentIndex < questions.Count)
{
    <Notepad />
    <div class="quiz-container">
        <div class="quiz-header">
            <span class="quiz-progress">Question @(currentIndex + 1) / @questions.Count</span>
            <div class="quiz-score">
                <span class="correct-count">@correctCount correct</span>
                <span class="wrong-count">@wrongCount wrong</span>
            </div>
        </div>

        <div class="progress-bar-container" style="margin-bottom: 16px">
            <div class="progress-bar-fill" style="width: @(((double)(currentIndex) / questions.Count * 100).ToString("F0"))%"></div>
        </div>

        @{
            var q = questions[currentIndex];
        }

        <div class="question-section question-enter" @key="currentIndex">
            <p class="question-prompt">@q.Prompt</p>

            @if (q.MathExpression != null)
            {
                <div class="math-display" id="quiz-math-@currentIndex"></div>
            }
            @if (!answerSubmitted && !hintShown && hintsAvailable > 0 && q.CorrectAnswer != null)
            {
                <button class="hint-btn" @onclick="UseHint"><Icon Name="lightbulb" Size="16" /> Use Hint (@hintsAvailable left)</button>
            }
            @if (!answerSubmitted && fiftyFiftyTokens > 0 && q.Options != null && q.CorrectAnswer != null
                 && (q.Type == QuestionType.MultipleChoice || q.Type == QuestionType.VisualIdentify)
                 && eliminatedOptions.Count == 0 && q.Options.Count >= 4)
            {
                <button class="hint-btn" @onclick="UseFiftyFifty"><Icon Name="target" Size="16" /> 50/50 (@fiftyFiftyTokens left)</button>
            }
            @if (!answerSubmitted && skipTokens > 0)
            {
                <button class="hint-btn" @onclick="UseSkip"><Icon Name="arrow-right" Size="16" /> Skip (@skipTokens left)</button>
            }
            @if (hintShown && q.CorrectAnswer != null)
            {
                <div class="hint-reveal">Answer: <strong>@q.CorrectAnswer</strong></div>
            }
        </div>

        @if (q.Type == QuestionType.MultipleChoice || q.Type == QuestionType.VisualIdentify)
        {
            <div class="options-grid">
                @if (q.Options != null)
                {
                    @foreach (var option in q.Options)
                    {
                        var optionClass = GetOptionClass(option);
                        var isEliminated = eliminatedOptions.Contains(option);
                        <button class="option-btn @optionClass @(isEliminated ? "eliminated" : "")"
                                @onclick="() => SelectOption(option)"
                                disabled="@(answerSubmitted || isEliminated)">
                            @option
                        </button>
                    }
                }
            </div>
        }
        else if (q.Type == QuestionType.FillIn)
        {
            <div class="fill-in-section">
                <input type="text" class="fill-input" @bind="fillInAnswer" @bind:event="oninput"
                       placeholder="Type your answer..." disabled="@answerSubmitted"
                       @onkeydown="HandleFillInKeydown" />
                @if (!answerSubmitted)
                {
                    <button class="btn btn-primary" @onclick="SubmitFillIn"
                            disabled="@string.IsNullOrWhiteSpace(fillInAnswer)">Submit</button>
                }
            </div>
        }
        else if (q.Type == QuestionType.NumericInput)
        {
            <div class="fill-in-section">
                <input type="text" inputmode="decimal" class="fill-input" @bind="fillInAnswer" @bind:event="oninput"
                       placeholder="@(q.Unit != null ? $"Number ({q.Unit})" : "Number")"
                       disabled="@answerSubmitted" @onkeydown="HandleFillInKeydown" />
                @if (q.Unit != null) { <span class="num-unit">@q.Unit</span> }
                @if (!answerSubmitted)
                {
                    <button class="btn btn-primary" @onclick="SubmitFillIn"
                            disabled="@string.IsNullOrWhiteSpace(fillInAnswer)">Submit</button>
                }
            </div>
        }
        else if (q.Type == QuestionType.MultipleSelect)
        {
            <div class="ms-section">
                <p class="ms-hint">Select all that apply:</p>
                @if (q.Options != null)
                {
                    <div class="options-grid">
                        @foreach (var option in q.Options)
                        {
                            var isPicked = msSelected.Contains(option);
                            var isCorrect = q.AcceptableAnswers?.Contains(option, StringComparer.OrdinalIgnoreCase) == true;
                            var cls = answerSubmitted
                                ? (isCorrect ? "correct" : (isPicked ? "incorrect" : ""))
                                : (isPicked ? "active" : "");
                            <button class="option-btn ms-option @cls"
                                    @onclick="() => ToggleMultiSelect(option)"
                                    disabled="@answerSubmitted">
                                <span class="ms-checkbox">@(isPicked ? "✓" : "")</span>
                                @option
                            </button>
                        }
                    </div>
                }
                @if (!answerSubmitted)
                {
                    <button class="btn btn-primary" style="width: 100%; margin-top: 12px"
                            @onclick="SubmitMultiSelect"
                            disabled="@(msSelected.Count == 0)">Submit</button>
                }
            </div>
        }
        else if (q.Type == QuestionType.Categorize)
        {
            <div class="cat-section">
                <p class="matching-hint">
                    @if (catSelectedItem == null)
                    { <span>Tap an item, then tap a category.</span> }
                    else
                    { <span>Now tap a category for <strong>@catSelectedItem</strong></span> }
                </p>

                @if (q.CategoryItems != null)
                {
                    <div class="cat-items-row">
                        @foreach (var item in catItemsShuffled)
                        {
                            var assigned = catAssignments.ContainsKey(item);
                            var isSel = catSelectedItem == item;
                            var cls = isSel ? "active" : assigned ? "matched" : "";
                            var resCls = answerSubmitted && q.CategoryItems.TryGetValue(item, out var truth)
                                ? (catAssignments.TryGetValue(item, out var got) && got == truth ? "correct" : "incorrect")
                                : "";
                            <button class="match-item @cls @resCls"
                                    @onclick="() => SelectCatItem(item)"
                                    disabled="@answerSubmitted">
                                @item
                                @if (assigned) { <small>→ @catAssignments[item]</small> }
                            </button>
                        }
                    </div>
                }

                @if (q.Categories != null && !answerSubmitted)
                {
                    <div class="cat-buckets">
                        @foreach (var bucket in q.Categories)
                        {
                            <button class="cat-bucket @(catSelectedItem != null ? "available" : "")"
                                    @onclick="() => AssignCatBucket(bucket)"
                                    disabled="@(catSelectedItem == null)">
                                @bucket
                            </button>
                        }
                    </div>
                }

                @if (!answerSubmitted && q.CategoryItems != null && catAssignments.Count == q.CategoryItems.Count)
                {
                    <button class="btn btn-primary" style="width: 100%; margin-top: 12px" @onclick="SubmitCategorize">Check</button>
                }
            </div>
        }
        else if (q.Type == QuestionType.ProofOrdering)
        {
            <div class="ordering-section">
                <p class="ordering-hint">Tap items to move them up in order:</p>
                @for (int i = 0; i < orderedSteps.Count; i++)
                {
                    var idx = i;
                    <div class="order-item @(answerSubmitted ? (IsStepCorrect(idx) ? "correct" : "incorrect") : "")"
                         @onclick="() => MoveStepUp(idx)">
                        <span class="order-num">@(idx + 1)</span>
                        <span>@orderedSteps[idx]</span>
                    </div>
                }
                @if (!answerSubmitted)
                {
                    <button class="btn btn-primary" style="margin-top: 12px" @onclick="SubmitOrdering">Check Order</button>
                }
            </div>
        }
        else if (q.Type == QuestionType.ConceptMatch)
        {
            <div class="matching-section">
                <p class="matching-hint">
                    @if (selectedLeft == null)
                    {
                        <span>Tap an item on the left to start matching</span>
                    }
                    else
                    {
                        <span>Now tap the matching item on the right for <strong>@selectedLeft</strong></span>
                    }
                </p>

                @if (q.Pairs != null)
                {
                    <div class="match-pairs-list">
                        @foreach (var pair in q.Pairs)
                        {
                            var left = pair.Left;
                            var isLeftSelected = selectedLeft == left;
                            var hasMatch = userMatches.ContainsKey(left);
                            var matchedRight = hasMatch ? userMatches[left] : null;
                            var leftClass = isLeftSelected ? "active" : hasMatch ? "matched" : "";
                            var resultClass = answerSubmitted && matchResults.ContainsKey(left)
                                ? (matchResults[left] ? "correct" : "incorrect") : "";

                            <div class="match-row @resultClass">
                                <button class="match-item left @leftClass"
                                        @onclick="() => SelectLeft(left)"
                                        disabled="@answerSubmitted">
                                    @left
                                </button>
                                <span class="match-arrow @(hasMatch ? "connected" : "")">
                                    @(hasMatch ? "↔" : "•••")
                                </span>
                                @if (hasMatch)
                                {
                                    <span class="match-item right matched" @onclick="() => ClearMatch(left)">
                                        @matchedRight
                                    </span>
                                }
                                else
                                {
                                    <span class="match-item right empty">?</span>
                                }
                            </div>
                        }
                    </div>

                    @if (!answerSubmitted)
                    {
                        <div class="match-options">
                            <p class="matching-label">Available answers:</p>
                            <div class="match-options-grid">
                                @foreach (var right in shuffledRights)
                                {
                                    var isUsed = userMatches.ContainsValue(right);
                                    <button class="match-option-btn @(isUsed ? "used" : "") @(selectedLeft != null && !isUsed ? "available" : "")"
                                            @onclick="() => SelectRight(right)"
                                            disabled="@(answerSubmitted || selectedLeft == null || isUsed)">
                                        @right
                                    </button>
                                }
                            </div>
                        </div>
                    }

                    @if (!answerSubmitted && userMatches.Count == q.Pairs.Count)
                    {
                        <button class="btn btn-primary" style="width: 100%; margin-top: 12px" @onclick="SubmitMatching">Check Matches</button>
                    }
                }
            </div>
        }
        else if (q.Type == QuestionType.TrueOrFalse)
        {
            <div class="tf-section">
                <div class="tf-buttons">
                    <button class="tf-btn true-btn @(answerSubmitted && q.CorrectAnswer == "True" ? "correct" : answerSubmitted && q.CorrectAnswer != "True" ? "incorrect" : "")"
                            @onclick='() => SelectOption("True")'
                            disabled="@answerSubmitted">
                        <Icon Name="check" Size="18" /> True
                    </button>
                    <button class="tf-btn false-btn @(answerSubmitted && q.CorrectAnswer == "False" ? "correct" : answerSubmitted && q.CorrectAnswer != "False" ? "incorrect" : "")"
                            @onclick='() => SelectOption("False")'
                            disabled="@answerSubmitted">
                        <Icon Name="x-mark" Size="18" /> False
                    </button>
                </div>
            </div>
        }
        else if (q.Type == QuestionType.FindTheError)
        {
            <div class="find-error-section">
                <p class="error-hint">Find the first mistake — later steps will be wrong too. Tap the step where the error first appears:</p>
                @if (q.Steps != null)
                {
                    @for (int i = 0; i < q.Steps.Count; i++)
                    {
                        var idx = i;
                        var stepNum = i + 1;
                        var isSelected = errorSelectedStep == idx;
                        var showResult = answerSubmitted;
                        var isTheError = q.CorrectAnswer == stepNum.ToString();
                        <div class="error-step @(isSelected && !showResult ? "selected" : "") @(showResult && isTheError ? "error-found" : "") @(showResult && isSelected && !isTheError ? "wrong-pick" : "")"
                             @onclick="() => SelectErrorStep(idx)">
                            <span class="error-step-num">@stepNum</span>
                            <span>@q.Steps[idx]</span>
                        </div>
                    }
                }
                @if (!answerSubmitted && errorSelectedStep >= 0)
                {
                    <button class="btn btn-primary" style="width: 100%; margin-top: 12px" @onclick="SubmitFindError">
                        Submit
                    </button>
                }
            </div>
        }

        @if (answerSubmitted)
        {
            <div class="feedback @(lastCorrect ? "feedback-correct anim-correct" : "feedback-incorrect anim-incorrect")">
                <span class="feedback-icon">@if (lastCorrect) { <Icon Name="check" Size="18" /> } else { <Icon Name="x-mark" Size="18" /> }</span>
                <span>@(lastCorrect ? "Correct!" : "Incorrect")</span>
                @if (!lastCorrect && q.CorrectAnswer != null)
                {
                    <span class="correct-answer">Answer: @q.CorrectAnswer</span>
                }
            </div>
            @if (q.Explanation != null)
            {
                <div class="explanation">@q.Explanation</div>
            }
            @if (!lastCorrect && TopicId != null && q.LessonId != null)
            {
                <button class="btn btn-sm btn-outline review-concept-btn" @onclick="() => ReviewConcept(q.LessonId)">
                    <Icon Name="book" Size="16" /> Review this concept
                </button>
            }
            @if (!lastCorrect && secondChanceTokens > 0)
            {
                <button class="btn btn-sm btn-outline" style="width: 100%; margin-top: 8px" @onclick="UseSecondChance">
                    <Icon Name="rotate" Size="16" /> Second Chance (@secondChanceTokens left)
                </button>
            }
            <button class="btn btn-primary" style="width: 100%; margin-top: 8px" @onclick="NextQuestion">
                @(currentIndex < questions.Count - 1 ? "Next Question" : "See Results")
            </button>
        }
    </div>
}
else if (quizState == QuizState.Complete)
{
    <div class="quiz-results card count-up">
        <h2>Quiz Complete!</h2>

        <div class="results-stats stagger-in">
            <div class="stat-card correct-stat count-up">
                <span class="stat-number">@correctCount</span>
                <span class="stat-label">Correct</span>
            </div>
            <div class="stat-card wrong-stat count-up">
                <span class="stat-number">@wrongCount</span>
                <span class="stat-label">Wrong</span>
            </div>
            <div class="stat-card score-stat count-up">
                <span class="stat-number">@(questions.Count > 0 ? (correctCount * 100 / questions.Count) : 0)%</span>
                <span class="stat-label">Score</span>
            </div>
        </div>

        <div class="xp-earned pulse">
            <span class="xp-badge" style="font-size: 1.1rem; padding: 8px 16px">+@totalXpEarned XP</span>
        </div>

        @if (quizEvent?.LeveledUp == true)
        {
            <div class="level-up-banner level-up-burst">
                Level Up! You're now Level @quizEvent.NewLevel
            </div>
        }

        @if (quizEvent?.NewAchievements.Count > 0)
        {
            <div class="new-achievements">
                @foreach (var a in quizEvent.NewAchievements)
                {
                    <div class="achievement-unlock achievement-pop">
                        @a.Name -- @a.Description
                    </div>
                }
            </div>
        }

        <button class="btn btn-primary btn-lg" style="width: 100%; margin-top: 16px" @onclick="Finish">
            Continue
        </button>
    </div>
}

@code {
    [Parameter] public string? TopicId { get; set; }
    [Parameter] public string? LessonId { get; set; }
    [Parameter] public EventCallback<int> OnComplete { get; set; }

    private enum QuizState { Loading, InProgress, Complete, Empty }
    private QuizState quizState = QuizState.Loading;

    private List<Question> questions = new();
    private List<QuizResult> results = new();
    private int currentIndex;
    private int correctCount;
    private int wrongCount;
    private bool answerSubmitted;
    private bool lastCorrect;
    private string fillInAnswer = "";
    private int totalXpEarned;
    private GamificationEvent? quizEvent;

    // Matching state
    private string? selectedLeft;
    private Dictionary<string, string> userMatches = new();
    private Dictionary<string, bool> matchResults = new();
    private List<string> shuffledRights = new();

    // Hint state
    private int hintsAvailable;
    private bool hintShown;
    private bool showHintsByDefault;

    // Powerup state
    private int skipTokens;
    private int fiftyFiftyTokens;
    private int secondChanceTokens;
    private HashSet<string> eliminatedOptions = new();

    // Find the error state
    private int errorSelectedStep = -1;

    // Ordering state
    private List<string> orderedSteps = new();

    // MultipleSelect state
    private HashSet<string> msSelected = new();

    // Categorize state
    private List<string> catItemsShuffled = new();
    private Dictionary<string, string> catAssignments = new();
    private string? catSelectedItem;

    private static readonly Random _random = new();

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            // Try to restore saved quiz state
            var session = await SessionState.LoadSessionStateAsync();
            var restored = false;

            if (session?.QuizState != null && session.InQuiz)
            {
                var qs = session.QuizState;
                if (qs.TopicId == TopicId && qs.LessonId == LessonId && qs.QuestionIds.Count > 0)
                {
                    // Reload the same questions in the same order
                    List<Question> allQuestions;
                    if (TopicId != null)
                    {
                        allQuestions = await QuizEngine.GenerateQuizAsync(TopicId, LessonId, 100);
                    }
                    else
                    {
                        var p = await Progress.GetProfileAsync();
                        allQuestions = await QuizEngine.GenerateLearnedQuizAsync(
                            p.LessonsCompleted,
                            p.TopicsCompleted,
                            p.TopicStatistics.Keys,
                            100);
                    }

                    var questionLookup = allQuestions.ToDictionary(q => q.Id);
                    var restoredQuestions = new List<Question>();
                    foreach (var id in qs.QuestionIds)
                    {
                        if (questionLookup.TryGetValue(id, out var q))
                            restoredQuestions.Add(q);
                    }

                    if (restoredQuestions.Count == qs.QuestionIds.Count)
                    {
                        questions = restoredQuestions;
                        currentIndex = qs.CurrentIndex;
                        correctCount = qs.CorrectCount;
                        wrongCount = qs.WrongCount;

                        // Rebuild results from saved data
                        for (int i = 0; i < Math.Min(qs.UserAnswers.Count, qs.Results.Count); i++)
                        {
                            results.Add(new QuizResult
                            {
                                Question = questions[i],
                                UserAnswer = qs.UserAnswers[i],
                                IsCorrect = qs.Results[i],
                                XpEarned = qs.Results[i] ? questions[i].XpReward : 0
                            });
                        }

                        quizState = QuizState.InProgress;
                        await InitQuestion();
                        restored = true;
                    }
                }
            }

            if (!restored)
            {
                if (TopicId != null && LessonId != null)
                    questions = await QuizEngine.GenerateQuizAsync(TopicId, LessonId, 5);
                else if (TopicId != null)
                    questions = await QuizEngine.GenerateQuizAsync(TopicId, null, 5);
                else
                {
                    var profile = await Progress.GetProfileAsync();
                    questions = await QuizEngine.GenerateLearnedQuizAsync(
                        profile.LessonsCompleted,
                        profile.TopicsCompleted,
                        profile.TopicStatistics.Keys,
                        5);
                }

                if (questions.Count > 0)
                {
                    quizState = QuizState.InProgress;
                    await InitQuestion();
                    await SaveQuizState();
                }
                else
                {
                    quizState = QuizState.Empty;
                }
            }

            await LoadHintCount();
            StateHasChanged();
        }

        if (quizState == QuizState.InProgress && currentIndex < questions.Count)
        {
            var q = questions[currentIndex];
            if (q.MathExpression != null)
            {
                await JS.InvokeVoidAsync("renderMath", $"quiz-math-{currentIndex}", q.MathExpression, true);
            }
        }
    }

    private async Task SaveQuizState()
    {
        await SessionState.SaveQuizStateAsync(new QuizSessionState
        {
            TopicId = TopicId,
            LessonId = LessonId,
            QuestionIds = questions.Select(q => q.Id).ToList(),
            CurrentIndex = currentIndex,
            CorrectCount = correctCount,
            WrongCount = wrongCount,
            UserAnswers = results.Select(r => r.UserAnswer).ToList(),
            Results = results.Select(r => r.IsCorrect).ToList()
        });
    }

    private async Task LoadHintCount()
    {
        var p = await Progress.GetProfileAsync();
        showHintsByDefault = p.ShowHintsByDefault;
        var totalBought = 0;
        foreach (var purchase in p.ShopPurchases)
        {
            if (purchase == "hint-pack-10") totalBought += 10;
            else if (purchase == "hint-pack-3") totalBought += 3;
        }
        hintsAvailable = totalBought - p.HintsUsed;
        skipTokens = p.SkipTokens;
        fiftyFiftyTokens = p.FiftyFiftyTokens;
        secondChanceTokens = p.SecondChanceTokens;
    }

    private async Task UseHint()
    {
        if (hintsAvailable <= 0 || answerSubmitted) return;
        hintShown = true;
        hintsAvailable--;
        var p = await Progress.GetProfileAsync();
        p.HintsUsed++;
        await Progress.SaveProfileAsync(p);
    }

    private async Task UseSkip()
    {
        if (skipTokens <= 0 || answerSubmitted) return;
        var p = await Progress.GetProfileAsync();
        if (p.SkipTokens <= 0) return;
        p.SkipTokens--;
        skipTokens = p.SkipTokens;
        await Progress.SaveProfileAsync(p);
        await JS.TryInvokeVoidAsync("Sounds.playClick");
        await NextQuestion();
    }

    private async Task UseFiftyFifty()
    {
        if (fiftyFiftyTokens <= 0 || answerSubmitted) return;
        var q = questions[currentIndex];
        if (q.Options == null || q.CorrectAnswer == null) return;
        var wrong = q.Options.Where(o => o != q.CorrectAnswer).OrderBy(_ => _random.Next()).Take(2).ToList();
        if (wrong.Count == 0) return;
        foreach (var w in wrong) eliminatedOptions.Add(w);
        var p = await Progress.GetProfileAsync();
        if (p.FiftyFiftyTokens <= 0) return;
        p.FiftyFiftyTokens--;
        fiftyFiftyTokens = p.FiftyFiftyTokens;
        await Progress.SaveProfileAsync(p);
        await JS.TryInvokeVoidAsync("Sounds.playClick");
    }

    private async Task UseSecondChance()
    {
        if (secondChanceTokens <= 0 || !answerSubmitted || lastCorrect) return;
        var p = await Progress.GetProfileAsync();
        if (p.SecondChanceTokens <= 0) return;
        p.SecondChanceTokens--;
        secondChanceTokens = p.SecondChanceTokens;
        await Progress.SaveProfileAsync(p);

        // Roll back the last wrong answer
        if (results.Count > 0) results.RemoveAt(results.Count - 1);
        if (wrongCount > 0) wrongCount--;
        answerSubmitted = false;
        fillInAnswer = "";
        msSelected.Clear();
        catAssignments.Clear();
        catSelectedItem = null;
        errorSelectedStep = -1;
        await JS.TryInvokeVoidAsync("Sounds.playClick");
    }

    private async Task InitQuestion()
    {
        answerSubmitted = false;
        fillInAnswer = "";
        selectedLeft = null;
        hintShown = false;
        errorSelectedStep = -1;
        eliminatedOptions.Clear();
        userMatches.Clear();
        matchResults.Clear();
        msSelected.Clear();
        catAssignments.Clear();
        catSelectedItem = null;
        catItemsShuffled.Clear();
        shuffledRights.Clear();

        var q = questions[currentIndex];
        if (showHintsByDefault && hintsAvailable > 0 && q.CorrectAnswer != null)
        {
            hintShown = true;
            hintsAvailable--;
            await DeductHintAsync();
        }

        if (q.Type == QuestionType.ProofOrdering && q.Steps != null)
        {
            orderedSteps = q.Steps.OrderBy(_ => _random.Next()).ToList();
        }
        if (q.Type == QuestionType.ConceptMatch && q.Pairs != null)
        {
            shuffledRights = q.Pairs.Select(p => p.Right).OrderBy(_ => _random.Next()).ToList();
        }
        if (q.Type == QuestionType.Categorize && q.CategoryItems != null)
        {
            catItemsShuffled = q.CategoryItems.Keys.OrderBy(_ => _random.Next()).ToList();
        }
    }

    private void ToggleMultiSelect(string option)
    {
        if (answerSubmitted) return;
        if (!msSelected.Add(option)) msSelected.Remove(option);
    }

    private async Task SubmitMultiSelect()
    {
        if (answerSubmitted || msSelected.Count == 0) return;
        var q = questions[currentIndex];
        var joined = string.Join("|", msSelected);
        var result = QuizEngine.ValidateAnswer(q, joined);
        result.UserAnswer = string.Join(", ", msSelected);
        await RecordResult(result);
    }

    private void SelectCatItem(string item)
    {
        if (answerSubmitted) return;
        catSelectedItem = catSelectedItem == item ? null : item;
    }

    private void AssignCatBucket(string bucket)
    {
        if (answerSubmitted || catSelectedItem == null) return;
        catAssignments[catSelectedItem] = bucket;
        catSelectedItem = null;
    }

    private async Task SubmitCategorize()
    {
        if (answerSubmitted) return;
        var q = questions[currentIndex];
        var joined = string.Join(";", catAssignments.Select(kv => $"{kv.Key}=>{kv.Value}"));
        var result = QuizEngine.ValidateAnswer(q, joined);
        result.UserAnswer = string.Join(", ", catAssignments.Select(kv => $"{kv.Key}→{kv.Value}"));
        await RecordResult(result);
    }

    private async Task DeductHintAsync()
    {
        var p = await Progress.GetProfileAsync();
        p.HintsUsed++;
        await Progress.SaveProfileAsync(p);
    }

    private async Task SelectOption(string option)
    {
        if (answerSubmitted) return;
        var result = QuizEngine.ValidateAnswer(questions[currentIndex], option);
        await RecordResult(result);
    }

    private async Task SubmitFillIn()
    {
        if (answerSubmitted || string.IsNullOrWhiteSpace(fillInAnswer)) return;
        var result = QuizEngine.ValidateAnswer(questions[currentIndex], fillInAnswer);
        await RecordResult(result);
    }

    private async Task HandleFillInKeydown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") await SubmitFillIn();
    }

    private async Task SubmitOrdering()
    {
        var q = questions[currentIndex];
        bool correct = q.Steps != null && orderedSteps.SequenceEqual(q.Steps);
        var result = new QuizResult
        {
            Question = q,
            UserAnswer = string.Join(" -> ", orderedSteps),
            IsCorrect = correct,
            XpEarned = correct ? q.XpReward : 0
        };
        await RecordResult(result);
    }

    private void SelectErrorStep(int idx)
    {
        if (answerSubmitted) return;
        errorSelectedStep = idx;
    }

    private async Task SubmitFindError()
    {
        if (answerSubmitted || errorSelectedStep < 0) return;
        var q = questions[currentIndex];
        var userPick = (errorSelectedStep + 1).ToString();
        bool correct = userPick == q.CorrectAnswer;
        var result = new QuizResult
        {
            Question = q,
            UserAnswer = $"Step {userPick}",
            IsCorrect = correct,
            XpEarned = correct ? q.XpReward : 0
        };
        await RecordResult(result);
    }

    private async Task SubmitMatching()
    {
        var q = questions[currentIndex];
        int correctMatches = 0;
        matchResults.Clear();
        if (q.Pairs != null)
        {
            foreach (var pair in q.Pairs)
            {
                var isCorrect = userMatches.ContainsKey(pair.Left) && userMatches[pair.Left] == pair.Right;
                matchResults[pair.Left] = isCorrect;
                if (isCorrect) correctMatches++;
            }
        }
        bool allCorrect = correctMatches == (q.Pairs?.Count ?? 0);
        var result = new QuizResult
        {
            Question = q,
            UserAnswer = string.Join(", ", userMatches.Select(kv => $"{kv.Key}={kv.Value}")),
            IsCorrect = allCorrect,
            XpEarned = allCorrect ? q.XpReward : 0
        };
        await RecordResult(result);
    }

    private async Task RecordResult(QuizResult result)
    {
        results.Add(result);
        lastCorrect = result.IsCorrect;
        answerSubmitted = true;
        if (result.IsCorrect) correctCount++;
        else wrongCount++;
        await Progress.RecordQuestionAnsweredAsync(TopicId, result.IsCorrect);

        // Feed into spaced repetition
        if (TopicId != null)
        {
            await ReviewService.AddToReviewAsync(result.Question.Id, TopicId, result.Question.LessonId, result.IsCorrect);
        }

        await SaveQuizState();
        await JS.TryInvokeVoidAsync(lastCorrect ? "Sounds.playCorrect" : "Sounds.playWrong");
        await JS.TryInvokeVoidAsync(lastCorrect ? "Haptics.success" : "Haptics.error");
    }

    private void ReviewConcept(string lessonId)
    {
        if (TopicId != null)
            Nav.NavigateTo($"/topic/{TopicId}/lesson/{lessonId}");
    }

    private async Task NextQuestion()
    {
        currentIndex++;
        if (currentIndex >= questions.Count)
        {
            await FinishQuiz();
        }
        else
        {
            await InitQuestion();
        }
    }

    private async Task FinishQuiz()
    {
        var profile = await Progress.GetProfileAsync();
        totalXpEarned = QuizEngine.CalculateQuizXp(results, profile.CurrentStreak);

        if (profile.XpBoostsActive > 0 && profile.XpBoostMultiplier > 1)
        {
            totalXpEarned *= profile.XpBoostMultiplier;
            profile.XpBoostsActive--;
            if (profile.XpBoostsActive <= 0)
                profile.XpBoostMultiplier = 1;
            await Progress.SaveProfileAsync(profile);
        }

        quizEvent = await Gamification.AwardXpAsync(totalXpEarned);

        // Phi Magnet: +50% bonus φ on top of awarded points
        if (profile.PhiMagnetActive > 0)
        {
            var bonusPhi = totalXpEarned / 2;
            var p2 = await Progress.GetProfileAsync();
            p2.Points += bonusPhi;
            p2.PhiMagnetActive--;
            await Progress.SaveProfileAsync(p2);
        }

        var score = questions.Count > 0 ? correctCount * 100 / questions.Count : 0;
        var quizId = LessonId ?? TopicId ?? "mixed";
        await Progress.RecordQuizResultAsync(quizId, TopicId, score, correctCount, questions.Count, totalXpEarned);

        quizState = QuizState.Complete;
        await SessionState.ClearSessionStateAsync();
        await JS.TryInvokeVoidAsync("Sounds.playComplete");
        await JS.TryInvokeVoidAsync("XpFloat.show", totalXpEarned, null, null);
        if (quizEvent.LeveledUp)
        {
            await JS.TryInvokeVoidAsync("Sounds.playLevelUp");
            await JS.TryInvokeVoidAsync("Haptics.heavy");
        }
        if (quizEvent.NewAchievements.Count > 0)
        {
            await JS.TryInvokeVoidAsync("Sounds.playAchievement");
            await JS.TryInvokeVoidAsync("Haptics.medium");
        }
        if (score >= 80)
            await JS.TryInvokeVoidAsync("Confetti.launch", score == 100 ? 80 : 40);
    }

    private async Task Finish()
    {
        await OnComplete.InvokeAsync(totalXpEarned);
    }

    private string GetOptionClass(string option)
    {
        if (!answerSubmitted) return "";
        var q = questions[currentIndex];
        if (option == q.CorrectAnswer) return "correct";
        if (results.LastOrDefault()?.UserAnswer == option && !lastCorrect) return "incorrect";
        return "";
    }

    private void MoveStepUp(int index)
    {
        if (answerSubmitted || index == 0) return;
        (orderedSteps[index], orderedSteps[index - 1]) = (orderedSteps[index - 1], orderedSteps[index]);
    }

    private bool IsStepCorrect(int index)
    {
        var q = questions[currentIndex];
        return q.Steps != null && index < q.Steps.Count && orderedSteps[index] == q.Steps[index];
    }

    private void SelectLeft(string left)
    {
        if (answerSubmitted) return;
        // Toggle: tap again to deselect
        if (selectedLeft == left)
            selectedLeft = null;
        else
            selectedLeft = left;
    }

    private void SelectRight(string right)
    {
        if (answerSubmitted || selectedLeft == null) return;
        // If this right was already matched to something else, remove that match
        var existingKey = userMatches.FirstOrDefault(kv => kv.Value == right).Key;
        if (existingKey != null)
            userMatches.Remove(existingKey);
        userMatches[selectedLeft] = right;
        selectedLeft = null;
    }

    private void ClearMatch(string left)
    {
        if (answerSubmitted) return;
        userMatches.Remove(left);
    }
}

