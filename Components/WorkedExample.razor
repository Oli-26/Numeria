@inject IJSRuntime JS

<div class="worked-example">
    <div class="we-header">
        <Icon Name="pencil" Size="16" /> Worked Example
    </div>

    <div class="we-problem">
        <strong>@Problem</strong>
        @if (ProblemMath != null)
        {
            <div class="math-display" id="we-problem-math"></div>
        }
    </div>

    <div class="we-steps">
        @for (int i = 0; i <= Math.Min(currentStep, Steps.Count - 1); i++)
        {
            var idx = i;
            var step = Steps[idx];
            var isActive = idx == currentStep && !completed;
            var isAnswered = idx < currentStep || completed;

            <div class="we-step @(isActive ? "active" : "") @(isAnswered ? "answered" : "")">
                <div class="we-step-num">@(idx + 1)</div>
                <div class="we-step-content">
                    <p class="we-step-prompt">@step.Prompt</p>

                    @if (step.Math != null && isAnswered)
                    {
                        <div class="math-display" id="@($"we-step-math-{idx}")"></div>
                    }

                    @if (isActive && !stepAnswered)
                    {
                        @if (step.Type == "choice")
                        {
                            <div class="we-choices">
                                @if (step.Options != null)
                                {
                                    @foreach (var opt in step.Options)
                                    {
                                        <button class="option-btn we-option" @onclick="() => AnswerChoice(opt)">@opt</button>
                                    }
                                }
                            </div>
                        }
                        else if (step.Type == "fillin")
                        {
                            <div class="we-fillin">
                                <input type="text" class="fill-input" @bind="stepInput" @bind:event="oninput"
                                       placeholder="Your answer..." @onkeydown="HandleKey" />
                                <button class="btn btn-sm btn-primary" @onclick="SubmitFillIn"
                                        disabled="@string.IsNullOrWhiteSpace(stepInput)">Check</button>
                            </div>
                        }
                    }
                    else if (isActive && stepAnswered)
                    {
                        <div class="we-feedback @(stepCorrect ? "correct" : "incorrect")">
                            @if (stepCorrect)
                            {
                                <Icon Name="check" Size="16" /> <span>Correct!</span>
                            }
                            else
                            {
                                <Icon Name="x-mark" Size="16" /> Answer: <strong>@step.Answer</strong>
                            }
                        </div>
                        @if (step.Explanation != null)
                        {
                            <p class="we-explanation">@step.Explanation</p>
                        }
                    }
                    else if (isAnswered)
                    {
                        <div class="we-revealed">
                            <strong>@step.Answer</strong>
                            @if (step.Explanation != null)
                            {
                                <small>@step.Explanation</small>
                            }
                        </div>
                    }
                </div>
            </div>
        }
    </div>

    @if (stepAnswered && !completed)
    {
        <button class="btn btn-primary" style="width: 100%; margin-top: 10px" @onclick="NextStep">
            @(currentStep < Steps.Count - 1 ? "Next Step" : "Complete")
        </button>
    }

    @if (completed)
    {
        <div class="we-complete">
            <Icon Name="checkmark-circle" Size="24" Stroke="var(--success)" />
            <span>@correctSteps / @Steps.Count steps correct. +@XpReward XP</span>
        </div>
        <button class="btn btn-primary" style="width: 100%; margin-top: 8px" @onclick="() => OnComplete.InvokeAsync(xpEarned)">
            Continue
        </button>
    }
</div>

@code {
    [Parameter] public string Problem { get; set; } = "";
    [Parameter] public string? ProblemMath { get; set; }
    [Parameter] public List<WorkedStep> Steps { get; set; } = new();
    [Parameter] public int XpReward { get; set; } = 40;
    [Parameter] public EventCallback<int> OnComplete { get; set; }

    private int currentStep;
    private bool stepAnswered;
    private bool stepCorrect;
    private bool completed;
    private string stepInput = "";
    private int correctSteps;
    private int xpEarned;

    public record WorkedStep(string Prompt, string Type, string Answer, List<string>? Options, string? Explanation, string? Math, List<string>? AcceptableAnswers);

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (ProblemMath != null)
        {
            try { await JS.InvokeVoidAsync("renderMath", "we-problem-math", ProblemMath, true); } catch { }
        }
        for (int i = 0; i <= Math.Min(currentStep, Steps.Count - 1); i++)
        {
            if (Steps[i].Math != null && (i < currentStep || completed))
            {
                try { await JS.InvokeVoidAsync("renderMath", $"we-step-math-{i}", Steps[i].Math, true); } catch { }
            }
        }
    }

    private void AnswerChoice(string choice)
    {
        if (stepAnswered) return;
        var step = Steps[currentStep];
        stepCorrect = choice == step.Answer;
        if (stepCorrect) correctSteps++;
        stepAnswered = true;
    }

    private void SubmitFillIn()
    {
        if (stepAnswered || string.IsNullOrWhiteSpace(stepInput)) return;
        var step = Steps[currentStep];
        var norm = stepInput.Trim().ToLowerInvariant().Replace(" ", "");
        var answers = new List<string> { step.Answer.ToLowerInvariant().Replace(" ", "") };
        if (step.AcceptableAnswers != null)
            answers.AddRange(step.AcceptableAnswers.Select(a => a.ToLowerInvariant().Replace(" ", "")));
        stepCorrect = answers.Contains(norm);
        if (stepCorrect) correctSteps++;
        stepAnswered = true;
    }

    private void HandleKey(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") SubmitFillIn();
    }

    private void NextStep()
    {
        if (currentStep >= Steps.Count - 1)
        {
            completed = true;
            xpEarned = (int)(XpReward * ((double)correctSteps / Steps.Count));
        }
        else
        {
            currentStep++;
            stepAnswered = false;
            stepCorrect = false;
            stepInput = "";
        }
    }
}

<style>
    .worked-example { background: var(--bg-card); border: 1px solid var(--border); border-radius: var(--radius-md); padding: 16px; }

    .we-header { display: flex; align-items: center; gap: 6px; font-weight: 700; color: var(--primary); font-size: 0.85rem; margin-bottom: 10px; }

    .we-problem { margin-bottom: 14px; padding-bottom: 14px; border-bottom: 1px solid var(--border); }
    .we-problem strong { font-size: 1rem; line-height: 1.5; }

    .we-steps { display: flex; flex-direction: column; gap: 2px; }

    .we-step { display: flex; gap: 10px; padding: 8px; border-radius: var(--radius-sm); transition: background 0.2s ease; }
    .we-step.active { background: rgba(74, 95, 224, 0.05); }
    .we-step.answered { opacity: 0.85; }

    .we-step-num {
        width: 24px; height: 24px; border-radius: 50%; background: var(--bg-surface);
        color: var(--text-muted); display: flex; align-items: center; justify-content: center;
        font-size: 0.75rem; font-weight: 700; flex-shrink: 0; margin-top: 2px;
    }
    .we-step.active .we-step-num { background: var(--primary); color: white; }
    .we-step.answered .we-step-num { background: var(--success); color: white; }

    .we-step-content { flex: 1; min-width: 0; }
    .we-step-prompt { margin: 0 0 6px; font-size: 0.9rem; color: var(--text-secondary); line-height: 1.4; }

    .we-choices { display: flex; flex-direction: column; gap: 6px; }
    .we-option { font-size: 0.85rem; padding: 8px 12px; }

    .we-fillin { display: flex; gap: 8px; }
    .we-fillin .fill-input { flex: 1; padding: 8px 12px; font-size: 0.9rem; }

    .we-feedback { display: flex; align-items: center; gap: 6px; font-weight: 600; font-size: 0.85rem; padding: 6px 0; }
    .we-feedback.correct { color: var(--success); }
    .we-feedback.incorrect { color: var(--error); }

    .we-explanation { font-size: 0.8rem; color: var(--text-muted); margin: 4px 0 0; line-height: 1.4; }

    .we-revealed { font-size: 0.85rem; color: var(--text-secondary); }
    .we-revealed small { display: block; color: var(--text-muted); font-size: 0.78rem; margin-top: 2px; }

    .we-complete {
        display: flex; align-items: center; justify-content: center; gap: 8px;
        padding: 12px; background: rgba(76, 175, 80, 0.08); border-radius: var(--radius-sm);
        font-weight: 600; color: var(--success); margin-top: 10px;
    }
</style>
